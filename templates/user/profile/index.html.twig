{% extends 'user/base.html.twig' %}

{% block title %}Profile{% endblock %}

{% block user_body %}
<div class="container mx-auto px-6 py-10 space-y-12">

    <!-- ================= PROFILE INFORMATION ================= -->
    <section class="bg-white border border-gray-200 rounded-lg shadow-md p-6">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b pb-4 mb-6">
            <h1 class="text-2xl font-bold text-gray-800">My Profile</h1>

            <a href="{{ path('user_profile_edit_show', {'id': user.id}) }}"
               class="inline-flex items-center gap-2 px-4 py-2 bg-yellow-500 text-white font-medium rounded-md shadow hover:bg-yellow-600 focus:ring-2 focus:ring-yellow-300 transition text-sm">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
                    <path d="M21.731 2.269a2.625 2.625 0 0 0-3.712 0l-1.157 1.157 3.712 3.712 1.157-1.157a2.625 2.625 0 0 0 0-3.712Z" />
                    <path d="M19.513 8.199l-3.712-3.712-12.15 12.15a5.25 5.25 0 0 0-1.32 2.214l-.8 2.685a.75.75 0 0 0 .933.933l2.685-.8a5.25 5.25 0 0 0 2.214-1.32L19.513 8.2Z" />
                </svg>
                <span>Edit Profile</span>
            </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
                <p class="text-sm text-gray-500">First Name</p>
                <p class="font-semibold text-gray-800">{{ user.firstName|default('Not set') }}</p>
            </div>
            <div>
                <p class="text-sm text-gray-500">Last Name</p>
                <p class="font-semibold text-gray-800">{{ user.lastName|default('Not set') }}</p>
            </div>
            <div>
                <p class="text-sm text-gray-500">Username</p>
                <p class="font-semibold text-gray-800">{{ user.username }}</p>
            </div>
            <div>
                <p class="text-sm text-gray-500">Roles</p>
                <div class="flex flex-wrap gap-2 mt-1">
                    {% for role in user.roles %}
                        <span class="bg-blue-100 text-blue-800 text-xs px-2 py-1 rounded-full">{{ role }}</span>
                    {% else %}
                        <span class="text-gray-400 text-sm">No roles assigned</span>
                    {% endfor %}
                </div>
            </div>
        </div>
    </section>

    <!-- ================= FAVORITES SECTION ================= -->
    <section class="space-y-6">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
            <h2 class="text-2xl font-bold text-gray-800">
                My Favorites ({{ user.favorites|length }})
            </h2>

            <!-- View Toggle -->
            <div class="flex border border-gray-300 rounded-md overflow-hidden" id="viewToggle">
                <button id="listViewBtn" class="p-2 text-gray-500 hover:bg-gray-100 transition">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                         stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M8.25 6.75h7.5M8.25 12h7.5m-7.5 5.25h7.5M3.75 6.75h.007v.008H3.75zM3.75 12h.007v.008H3.75zM3.75 17.25h.007v.008H3.75z" />
                    </svg>
                    <span class="sr-only">List view</span>
                </button>

                <button id="gridViewBtn" class="p-2 border-l border-gray-300 bg-gray-200 text-gray-800 transition">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                         stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25A2.25 2.25 0 018.25 10.5H6A2.25 2.25 0 013.75 8.25V6zM13.5 6A2.25 2.25 0 0115.75 3.75H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25A2.25 2.25 0 0113.5 8.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 018.25 20.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 15.75A2.25 2.25 0 0115.75 13.5H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" />
                    </svg>
                    <span class="sr-only">Grid view</span>
                </button>
            </div>
        </div>

        {% if user.favorites is not empty %}
            <!-- GRID VIEW -->
            <div id="gridView" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
                {% for favorite in user.favorites %}
                    {% set product = favorite.product %}
                    <div class="bg-white border border-gray-200 rounded-lg shadow-sm hover:shadow-md overflow-hidden transition">
                        <a href="{{ path('app_user_shop_show', {'id': product.id}) }}" class="block">
                            <div class="w-full h-48 bg-gray-100">
                                {% set img = product.imagePath ?: '/images/default-product.png' %}
                                <img src="{{ asset(img) }}" alt="{{ product.name|default('Product image') }}"
                                     class="w-full h-full object-cover group-hover:opacity-80 transition">
                            </div>
                            <div class="p-4">
                                <h3 class="text-sm font-medium text-gray-800 truncate">{{ product.name|default('Unnamed Product') }}</h3>
                                <p class="mt-1 text-lg font-semibold text-green-600">
                                    PHP {{ product.price|number_format(2, '.', ',') }}
                                </p>
                            </div>
                        </a>
                    </div>
                {% endfor %}
            </div>

            <!-- LIST VIEW -->
            <div id="listView" class="hidden bg-white border border-gray-200 rounded-lg shadow overflow-hidden mt-4">
                <table class="min-w-full">
                    <tbody class="divide-y divide-gray-200">
                    {% for favorite in user.favorites %}
                        {% set product = favorite.product %}
                        <tr class="hover:bg-gray-50">
                            <td class="p-4 w-20">
                                <div class="w-16 h-16 bg-gray-100 border rounded overflow-hidden">
                                    {% set img = product.imagePath ?: '/images/default-product.png' %}
                                    <img src="{{ asset(img) }}" alt="{{ product.name|default('Product') }}" class="w-full h-full object-cover">
                                </div>
                            </td>
                            <td class="p-4 align-middle">
                                <a href="{{ path('app_user_shop_show', {'id': product.id}) }}"
                                   class="font-medium text-gray-800 hover:text-indigo-600">
                                    {{ product.name|default('Unnamed Product') }}
                                </a>
                                <p class="text-sm text-gray-500">{{ product.brand|default('Unknown Brand') }}</p>
                            </td>
                            <td class="p-4 text-right align-middle">
                                <p class="font-semibold text-green-600">
                                    PHP {{ product.price|number_format(2, '.', ',') }}
                                </p>
                            </td>
                            <td class="p-4 text-right align-middle">
                                <form method="post" action="{{ path('app_user_favorite_toggle', {'id': product.id}) }}">
                                    <button type="submit"
                                            class="text-red-500 hover:text-red-700 font-medium text-sm">
                                        Remove
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <!-- EMPTY STATE -->
            <div class="text-center py-12 bg-gray-50 border-2 border-dashed rounded-lg">
                <svg xmlns="http://www.w3.org/2000/svg" class="mx-auto h-12 w-12 text-gray-400" fill="none"
                     viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                </svg>
                <h3 class="mt-3 text-sm font-medium text-gray-900">No favorites yet</h3>
                <p class="mt-1 text-sm text-gray-500">You haven’t added any products to your favorites.</p>
                <div class="mt-6">
                    <a href="{{ path('app_user_shop') }}"
                       class="inline-flex items-center px-4 py-2 bg-indigo-600 text-white rounded-md shadow hover:bg-indigo-700 text-sm font-medium">
                        Start Shopping
                    </a>
                </div>
            </div>
        {% endif %}
    </section>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const gridBtn = document.getElementById('gridViewBtn');
    const listBtn = document.getElementById('listViewBtn');
    const gridView = document.getElementById('gridView');
    const listView = document.getElementById('listView');

    if (!gridBtn || !listBtn || !gridView || !listView) return;

    const savedView = localStorage.getItem('favoriteView') || 'grid';
    applyView(savedView);

    function applyView(view) {
        if (view === 'list') {
            listView.classList.remove('hidden');
            gridView.classList.add('hidden');
            listBtn.classList.add('bg-gray-200', 'text-gray-800');
            gridBtn.classList.remove('bg-gray-200', 'text-gray-800');
            gridBtn.classList.add('text-gray-500');
        } else {
            gridView.classList.remove('hidden');
            listView.classList.add('hidden');
            gridBtn.classList.add('bg-gray-200', 'text-gray-800');
            listBtn.classList.remove('bg-gray-200', 'text-gray-800');
            listBtn.classList.add('text-gray-500');
        }
    }

    gridBtn.addEventListener('click', () => {
        applyView('grid');
        localStorage.setItem('favoriteView', 'grid');
    });

    listBtn.addEventListener('click', () => {
        applyView('list');
        localStorage.setItem('favoriteView', 'list');
    });

    console.log('✅ Favorite toggle script loaded');
});
</script>
{% endblock %}
