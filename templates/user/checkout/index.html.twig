{% extends 'user/base.html.twig' %}

{% block title %}Checkout{% endblock %}

{% block user_body %}
<div class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-8 text-gray-800">Checkout</h1>

    {% if items is empty %}
        <div class="bg-yellow-100 border-l-4 border-yellow-500 text-yellow-700 p-4 rounded-lg" role="alert">
            <p class="font-bold">Your cart is empty!</p>
            <p>You cannot proceed to checkout with an empty cart.
                <a href="{{ path('app_home') }}" class="font-semibold underline">Go shopping</a>.
            </p>
        </div>
    {% else %}
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <div class="lg:col-span-2 space-y-8">
                <div class="bg-white p-6 rounded-lg shadow-md">
                    <h2 class="text-xl font-semibold mb-4 border-b pb-3">Shipping Address</h2>
                    {% if addresses is not empty %}
                        <form action="{{ path('app_checkout_process') }}" method="post" id="checkout-form">
                            <div class="space-y-4">
                                {% for address in addresses %}
                                    <label class="flex items-center p-4 border rounded-lg cursor-pointer hover:bg-gray-50 transition-colors">
                                        <input type="radio" name="shipping_address_id" value="{{ address.id }}" class="h-5 w-5 text-blue-600 border-gray-300 focus:ring-blue-500" {{ loop.first ? 'checked' : '' }}>
                                        <span class="ml-4 text-gray-700">
                                            <strong class="block">{{ app.user.firstName }} {{ app.user.lastName }}</strong>
                                            {{ address.fullAddress }}
                                        </span>
                                    </label>
                                {% endfor %}
                            </div>
                        </form>
                    {% else %}
                        <p class="text-red-600">You have no saved addresses.
                            Please <a href="{{ path('app_address_new') }}" class="font-semibold underline">add an address</a> to proceed.
                        </p>
                    {% endif %}
                </div>

                <div class="bg-white p-6 rounded-lg shadow-md">
                    <h2 class="text-xl font-semibold mb-4 border-b pb-3">Order Summary</h2>
                    <div class="space-y-4">
                        {% for item in items %}
                            <div class="flex items-center justify-between">
                                <div class="flex items-center">
                                    {% set img = item.product.imagePath ?: '/images/default-product.png' %}
                                    <img src="{{ asset(img) }}" alt="{{ item.product.name }}" class="w-16 h-16 object-cover rounded mr-4">
                                    <div>
                                        <p class="font-semibold">{{ item.product.name }}</p>
                                        <p class="text-sm text-gray-600">Qty: {{ item.quantity }}</p>
                                    </div>
                                </div>
                                <p class="font-semibold">€{{ (item.product.price * item.quantity)|number_format(2, '.', ',') }}</p>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <div class="lg:col-span-1">
                <div class="bg-white p-6 rounded-lg shadow-md sticky top-8">
                    {# Removed duplicate Order Summary/Product list section from here (Sources 17-21) #}
                    
                    <h2 class="text-xl font-semibold mb-4 border-b pb-3">Total</h2>
                    <div class="space-y-2">
                        <div class="flex justify-between">
                            <span>Subtotal</span>
                            <span>€{{ total|number_format(2, '.', ',') }}</span>
                        </div>
                        <div class="flex justify-between">
                            <span>Shipping</span>
                            <span class="text-green-600 font-semibold">Free</span>
                        </div>
                        <div class="flex justify-between font-bold text-lg pt-2 border-t mt-2">
                            <span>Total</span>
                            <span>€{{ total|number_format(2, '.', ',') }}</span>
                        </div>
                    </div>
                    {# The button now submits the form defined in the shipping address section #}
                    <button type="submit" form="checkout-form" class="w-full bg-green-600 text-white py-3 rounded-lg font-semibold hover:bg-green-700 transition-colors mt-6 {% if addresses is empty %}disabled:opacity-50 cursor-not-allowed{% endif %}" {% if addresses is empty %}disabled{% endif %}>
                        Place Order
                    </button>
                </div>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}