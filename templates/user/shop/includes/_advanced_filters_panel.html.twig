{# Advanced Filters Panel Component #}
<div id="advanced-filters" class="hidden bg-white dark:bg-gray-900 border-2 border-gray-200 dark:border-gray-800 rounded-2xl shadow-lg dark:shadow-xl mb-8 overflow-hidden">
    <div class="p-8">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- Price Range Filter -->
            <div class="space-y-6">
                <div>
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4 flex items-center">
                        <svg class="h-5 w-5 text-green-600 dark:text-green-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        Price Range
                    </h3>
                    <div class="space-y-4">
                        <div class="relative pt-1">
                            <input type="range" min="0" max="5000" value="0" 
                                   class="w-full h-2 bg-gray-200 dark:bg-gray-700 rounded-lg appearance-none cursor-pointer slider-thumb"
                                   id="price-min">
                            <input type="range" min="0" max="5000" value="5000" 
                                   class="w-full h-2 bg-gray-200 dark:bg-gray-700 rounded-lg appearance-none cursor-pointer slider-thumb mt-2"
                                   id="price-max">
                            <div class="absolute h-2 bg-green-500 dark:bg-green-600 rounded-lg left-0 right-0 top-1/2 transform -translate-y-1/2 pointer-events-none"></div>
                        </div>
                        <div class="flex items-center justify-between pt-4">
                            <div class="flex-1 mr-4">
                                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Min Price</label>
                                <div class="relative">
                                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                        <span class="text-gray-500 dark:text-gray-400">AED</span>
                                    </div>
                                    <input type="number" 
                                           class="w-full pl-12 pr-4 py-2 border-2 border-gray-200 dark:border-gray-700 dark:bg-gray-800 dark:text-white rounded-lg focus:border-green-500 dark:focus:border-green-400 focus:ring-2 focus:ring-green-100 dark:focus:ring-green-900"
                                           value="0"
                                           id="price-min-input">
                                </div>
                            </div>
                            <div class="flex-1">
                                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Max Price</label>
                                <div class="relative">
                                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                        <span class="text-gray-500 dark:text-gray-400">AED</span>
                                    </div>
                                    <input type="number" 
                                           class="w-full pl-12 pr-4 py-2 border-2 border-gray-200 dark:border-gray-700 dark:bg-gray-800 dark:text-white rounded-lg focus:border-green-500 dark:focus:border-green-400 focus:ring-2 focus:ring-green-100 dark:focus:ring-green-900"
                                           value="5000"
                                           id="price-max-input">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Category Filter -->
            <div class="space-y-6">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4 flex items-center">
                    <svg class="h-5 w-5 text-green-600 dark:text-green-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
                    </svg>
                    Categories
                </h3>
                <div class="grid grid-cols-2 gap-3">
                    {% if categories is defined %}
                        {% for category in categories|slice(0, 6) %}
                        <label class="flex items-center p-3 border-2 border-gray-200 dark:border-gray-700 dark:bg-gray-800 rounded-xl hover:border-green-400 dark:hover:border-green-600 hover:bg-green-50 dark:hover:bg-green-900/20 cursor-pointer transition-all duration-200">
                            <input type="checkbox" name="categories[]" value="{{ category.id }}"
                                   class="h-5 w-5 text-green-600 dark:text-green-400 border-gray-300 dark:border-gray-600 rounded focus:ring-green-500 dark:focus:ring-green-400">
                            <span class="ml-3 text-gray-700 dark:text-gray-300 font-medium">{{ category.name }}</span>
                        </label>
                        {% endfor %}
                    {% endif %}
                </div>
                {% if categories is defined and categories|length > 6 %}
                <button type="button" 
                        onclick="toggleMoreCategories()"
                        class="text-sm font-medium text-green-600 dark:text-green-400 hover:text-green-700 dark:hover:text-green-300 flex items-center transition-colors">
                    Show all categories
                    <svg class="h-4 w-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                    </svg>
                </button>
                {% endif %}
            </div>
            
            <!-- Additional Filters -->
            <div class="space-y-6">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4 flex items-center">
                    <svg class="h-5 w-5 text-green-600 dark:text-green-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path>
                    </svg>
                    More Filters
                </h3>
                <div class="space-y-4">
                    <!-- Rating Filter -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Minimum Rating</label>
                        <div class="flex items-center space-x-1">
                            {% for i in 5..1 %}
                            <button type="button" 
                                    class="p-2 text-yellow-400 hover:text-yellow-500 transition-colors"
                                    data-rating="{{ i }}">
                                <svg class="h-6 w-6 fill-current" viewBox="0 0 24 24">
                                    <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"></path>
                                </svg>
                            </button>
                            {% endfor %}
                            <span class="ml-2 text-sm text-gray-600 dark:text-gray-400">& above</span>
                        </div>
                    </div>
                    
                    <!-- Availability Filter -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Availability</label>
                        <div class="space-y-2">
                            <label class="flex items-center">
                                <input type="checkbox" class="h-4 w-4 text-green-600 dark:text-green-400 border-gray-300 dark:border-gray-600 rounded focus:ring-green-500 dark:focus:ring-green-400">
                                <span class="ml-2 text-gray-700 dark:text-gray-300">In Stock</span>
                                <span class="ml-auto text-sm text-gray-500 dark:text-gray-400">({{ random(50, 150) }})</span>
                            </label>
                            <label class="flex items-center">
                                <input type="checkbox" class="h-4 w-4 text-green-600 dark:text-green-400 border-gray-300 dark:border-gray-600 rounded focus:ring-green-500 dark:focus:ring-green-400">
                                <span class="ml-2 text-gray-700 dark:text-gray-300">On Sale</span>
                                <span class="ml-auto text-sm text-gray-500 dark:text-gray-400">({{ random(10, 30) }})</span>
                            </label>
                            <label class="flex items-center">
                                <input type="checkbox" class="h-4 w-4 text-green-600 dark:text-green-400 border-gray-300 dark:border-gray-600 rounded focus:ring-green-500 dark:focus:ring-green-400">
                                <span class="ml-2 text-gray-700 dark:text-gray-300">Fast Delivery</span>
                                <span class="ml-auto text-sm text-gray-500 dark:text-gray-400">({{ random(80, 120) }})</span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Filter Actions -->
        <div class="mt-8 pt-8 border-t border-gray-100 dark:border-gray-800 flex justify-between">
            <button type="button" 
                    onclick="resetAdvancedFilters()"
                    class="px-6 py-3 border-2 border-gray-300 dark:border-gray-700 text-gray-700 dark:text-gray-300 font-medium rounded-xl hover:bg-gray-50 dark:hover:bg-gray-800 transition-all duration-300">
                Reset All Filters
            </button>
            <div class="space-x-4">
                <button type="button" 
                        onclick="toggleAdvancedFilters()"
                        class="px-6 py-3 border-2 border-gray-300 dark:border-gray-700 text-gray-700 dark:text-gray-300 font-medium rounded-xl hover:bg-gray-50 dark:hover:bg-gray-800 transition-all duration-300">
                    Cancel
                </button>
                <button type="submit" 
                        class="px-8 py-3 bg-gradient-to-r from-green-600 to-emerald-600 dark:from-green-600 dark:to-emerald-600 text-white font-semibold rounded-xl hover:from-green-700 hover:to-emerald-700 dark:hover:from-green-700 dark:hover:to-emerald-700 hover:shadow-lg dark:hover:shadow-xl transition-all duration-300">
                    Apply Filters
                </button>
            </div>
        </div>
    </div>
</div>
