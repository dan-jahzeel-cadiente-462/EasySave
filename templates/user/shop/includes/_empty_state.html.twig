{# Empty State Component #}
<div class="col-span-full py-20 text-center">
    <div class="max-w-md mx-auto">
        <svg class="h-24 w-24 mx-auto text-gray-300 mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <h3 class="text-2xl font-bold text-gray-600 mb-3">No products found</h3>
        <p class="text-gray-500 mb-8">
            {% if app.request.query.get('q') or app.request.query.get('category') %}
                Try adjusting your search or filter to find what you're looking for.
            {% else %}
                Our collection is currently being updated. Check back soon!
            {% endif %}
        </p>
        {% if app.request.query.get('q') or app.request.query.get('category') %}
        <a href="{{ path('app_user_shop') }}"
           class="inline-flex items-center px-8 py-3 bg-gradient-to-r from-indigo-600 to-purple-600 text-white font-semibold rounded-xl hover:from-indigo-700 hover:to-purple-700 hover:shadow-lg transition-all duration-300">
            Clear all filters
            <svg class="h-5 w-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
        </a>
        {% endif %}
    </div>
</div>
