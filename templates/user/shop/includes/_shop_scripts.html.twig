{# Shop Page Scripts #}
<script>
// Toggle Advanced Filters Panel
function toggleAdvancedFilters() {
    const panel = document.getElementById('advanced-filters');
    const isVisible = !panel.classList.contains('hidden');
    
    if (isVisible) {
        panel.classList.add('hidden');
    } else {
        panel.classList.remove('hidden');
        panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
}

// Price Range Slider Sync
function initPriceSliders() {
    const minSlider = document.getElementById('price-min');
    const maxSlider = document.getElementById('price-max');
    const minInput = document.getElementById('price-min-input');
    const maxInput = document.getElementById('price-max-input');
    
    if (!minSlider || !maxSlider || !minInput || !maxInput) return;
    
    function updateSliders() {
        const min = parseInt(minSlider.value);
        const max = parseInt(maxSlider.value);
        
        if (min > max) {
            minSlider.value = max;
            minInput.value = max;
        }
        
        minInput.value = minSlider.value;
        maxInput.value = maxSlider.value;
        updateFilterCount();
    }
    
    [minSlider, maxSlider].forEach(slider => {
        slider.addEventListener('input', updateSliders);
    });
    
    [minInput, maxInput].forEach(input => {
        input.addEventListener('change', function() {
            const value = parseInt(this.value) || 0;
            if (this === minInput) {
                minSlider.value = Math.min(value, parseInt(maxSlider.value));
            } else {
                maxSlider.value = Math.max(value, parseInt(minSlider.value));
            }
            updateSliders();
        });
    });
}

// Rating Selection
function initRatingSelection() {
    const ratingButtons = document.querySelectorAll('[data-rating]');
    let selectedRating = 0;
    
    ratingButtons.forEach(button => {
        button.addEventListener('click', function() {
            const rating = parseInt(this.getAttribute('data-rating'));
            selectedRating = rating;
            
            ratingButtons.forEach((btn, index) => {
                const btnRating = parseInt(btn.getAttribute('data-rating'));
                if (btnRating <= rating) {
                    btn.classList.add('text-yellow-500');
                    btn.classList.remove('text-yellow-400');
                } else {
                    btn.classList.remove('text-yellow-500');
                    btn.classList.add('text-yellow-400');
                }
            });
            
            updateFilterCount();
        });
    });
}

// Toggle More Categories
function toggleMoreCategories() {
    const grid = document.querySelector('.grid.grid-cols-2.gap-3');
    if (grid) {
        grid.classList.toggle('expanded');
        const button = event.target.closest('button');
        if (button) {
            button.innerHTML = grid.classList.contains('expanded') 
                ? 'Show less categories' 
                : 'Show all categories';
        }
    }
}

// Reset All Filters
function resetAdvancedFilters() {
    document.querySelectorAll('input[type="checkbox"]').forEach(cb => {
        cb.checked = false;
    });
    
    document.querySelectorAll('input[type="radio"]').forEach(rb => {
        rb.checked = false;
    });
    
    const minSlider = document.getElementById('price-min');
    const maxSlider = document.getElementById('price-max');
    const minInput = document.getElementById('price-min-input');
    const maxInput = document.getElementById('price-max-input');
    
    if (minSlider && maxSlider && minInput && maxInput) {
        minSlider.value = 0;
        maxSlider.value = 5000;
        minInput.value = 0;
        maxInput.value = 5000;
    }
    
    document.querySelectorAll('[data-rating]').forEach(btn => {
        btn.classList.remove('text-yellow-500');
        btn.classList.add('text-yellow-400');
    });
    
    updateFilterCount();
}

// Update filter count badge
function updateFilterCount() {
    const badge = document.getElementById('filter-count');
    if (!badge) return;
    
    let count = 0;
    
    const minPrice = document.getElementById('price-min')?.value || 0;
    const maxPrice = document.getElementById('price-max')?.value || 5000;
    if (minPrice > 0 || maxPrice < 5000) count++;
    
    const checkedBoxes = document.querySelectorAll('input[type="checkbox"]:checked').length;
    count += checkedBoxes;
    
    const ratingButtons = document.querySelectorAll('[data-rating].text-yellow-500');
    if (ratingButtons.length > 0) count++;
    
    badge.textContent = count || '0';
    badge.classList.toggle('bg-indigo-600', count > 0);
    badge.classList.toggle('bg-gray-400', count === 0);
}

// View toggle function
function setView(viewType) {
    const url = new URL(window.location);
    url.searchParams.set('view', viewType);
    window.location.href = url.toString();
}

// Initialize everything when DOM is loaded
document.addEventListener('DOMContentLoaded', function() {
    initPriceSliders();
    initRatingSelection();
    updateFilterCount();

    document.querySelectorAll('input[name="sort"]').forEach(input => {
        input.addEventListener('change', function() {
            this.closest('form').submit();
        });
    });

    document.querySelectorAll('input[name="categories[]"]').forEach(checkbox => {
        checkbox.addEventListener('change', function() {
            this.closest('form').submit();
        });
    });
});

// Add custom slider thumb styles
