    background: transparent;
}

.slider-thumb::-webkit-slider-runnable-track {
    height: 8px;
    background: transparent;
    border-radius: 9999px;
}

.slider-thumb::-moz-range-track {
    height: 8px;
    background: transparent;
    border-radius: 9999px;
}

.slider-thumb::-webkit-slider-thumb {
    appearance: none;
    height: 20px;
    width: 20px;
    border-radius: 50%;
