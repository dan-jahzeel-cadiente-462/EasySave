    max-height: calc(100vh - 200px);
    overflow-y: auto;
}

#advanced-filters::-webkit-scrollbar {
    width: 6px;
}

#advanced-filters::-webkit-scrollbar-track {
    background: #f1f1f1;
    border-radius: 10px;
}

#advanced-filters::-webkit-scrollbar-thumb {
    background: #c7d2fe;
    border-radius: 10px;
}

#advanced-filters::-webkit-scrollbar-thumb:hover {
    background: #a5b4fc;
