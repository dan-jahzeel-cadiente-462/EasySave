{% extends 'user/base.html.twig' %}

{% block user_body %}
<div class="max-w-7xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
    <h1 class="text-3xl font-extrabold text-gray-900 mb-8 border-b pb-2">Shop Our Collection</h1>
    
    {# 💡 E-COMMERCE IMPROVEMENT: Filter and Sort Section #}
    <div class="bg-gray-50 p-4 rounded-lg shadow-sm mb-8">
        <form method="get" action="{{ path('app_user_shop') }}" class="flex flex-col sm:flex-row gap-4 justify-between items-center">
            
            {# Search Input #}
            <div class="w-full sm:w-1/3">
                <input type="search" name="q" placeholder="Search products..." 
                       value="{{ app.request.query.get('q') }}"
                       class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-indigo-500 focus:border-indigo-500">
            </div>

            {# Category Filter #}
            <div class="w-full sm:w-1/4">
                <select name="category" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-indigo-500 focus:border-indigo-500">
                    <option value="">All Categories</option>
                    {% set current_category = app.request.query.get('category') %}
                    {% for category in categories|default([]) %}
                        <option value="{{ category.id }}" {% if current_category == category.id %}selected{% endif %}>
                            {{ category.name }}
                        </option>
                    {% endfor %}
                </select>
            </div>

            {# Sort By #}
            <div class="w-full sm:w-1/4">
                <select name="sort" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-indigo-500 focus:border-indigo-500">
                    {% set current_sort = app.request.query.get('sort') %}
                    <option value="name" {% if current_sort == 'name' %}selected{% endif %}>Sort by Name (A-Z)</option>
                    <option value="price_asc" {% if current_sort == 'price_asc' %}selected{% endif %}>Price: Low to High</option>
                    <option value="price_desc" {% if current_sort == 'price_desc' %}selected{% endif %}>Price: High to Low</option>
                </select>
            </div>

            <button type="submit" class="w-full sm:w-auto px-6 py-2 bg-indigo-600 text-white font-semibold rounded-md hover:bg-indigo-700 transition">
                Filter
            </button>
        </form>
    </div>
    
    {# Product Grid #}
    <div class="mt-8 grid grid-cols-1 gap-y-10 sm:grid-cols-2 gap-x-6 lg:grid-cols-4 xl:gap-x-8">
        {% for product in products %}
            {% set is_favorited = product.id in favoriteProductIds %}
            
            <div class="group relative bg-white border border-gray-200 rounded-lg overflow-hidden shadow-md hover:shadow-lg transition">
                <div class="w-full h-56 bg-gray-200 overflow-hidden group-hover:opacity-75 relative">
                    {% set img = product.imagePath ?: '/images/default-product.png' %}
                    <img src="{{ asset(img) }}" alt="{{ product.name }}" class="w-full h-full object-cover object-center">
                    
                    {# FAVORITE TOGGLE BUTTON #}
                    {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                        <form method="post" action="{{ path('app_user_favorite_toggle', {'id': product.id}) }}" class="absolute top-3 right-3 z-10">
                            <button type="submit" 
                                    aria-label="Toggle favorite"
                                    class="p-2 rounded-full bg-white bg-opacity-80 text-gray-400 hover:text-red-500 transition">
                                {% if is_favorited %}
                                    <svg class="h-6 w-6 text-red-500 fill-current" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                                {% else %}
                                    <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                                {% endif %}
                            </button>
                        </form>
                    {% endif %}
                </div>
                
                <div class="p-4 flex flex-col flex-1">
                    <h3 class="text-sm text-gray-700">
                        <a href="{{ path('app_user_shop_show', {'id': product.id}) }}" class="font-medium hover:text-indigo-600">
                            {{ product.name }}
                        </a>
                    </h3>
                    <p class="mt-1 text-sm text-gray-500">{{ product.brand }}</p>
                    <p class="mt-3 text-2xl font-extrabold text-gray-900">{{ product.price|number_format(2, '.', ',') }} AED</p>
                    
                    {# Add to Cart Button #}
                    <div class="mt-4">
                         {% if product.stock > 0 %}
                            <form method="post" action="{{ path('app_user_cart_add', {'id': product.id}) }}" class="w-full">
                                <button type="submit" 
                                        class="w-full flex items-center justify-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 transition disabled:opacity-50 disabled:cursor-not-allowed">
                                    Add to Cart
                                </button>
                            </form>
                        {% else %}
                            <button disabled class="w-full flex items-center justify-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-gray-400 cursor-not-allowed">
                                Sold Out
                            </button>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% else %}
            <p class="text-gray-500 col-span-full py-12 text-center text-lg">
                No products found matching your criteria.
            </p>
        {% endfor %}
    </div>
</div>
{% endblock %}