{% extends 'user/base.html.twig' %}

{% block user_body %}

<!-- Include reusable components -->
{% include 'user/shop/includes/_search_navbar.html.twig' %}

<div class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
    {% include 'user/shop/includes/_advanced_filters_panel.html.twig' %}
    {% include 'user/shop/includes/_active_filters_bar.html.twig' %}
    
    <!-- 💎 Premium Product Grid/List -->
    <div class="{% if view == 'list' %}space-y-6{% else %}grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8{% endif %}">
        {% for product in products %}
            {% set is_favorited = product.id in favoriteProductIds %}
            {% set discount = (product.id % 25) %}
            {% set is_new = (product.id % 2 == 0) %}
            {% set rating = 3 + (product.id % 3) %}

            {% if view == 'list' %}
                {% include 'user/shop/includes/_product_list_card.html.twig' %}
            {% else %}
                {% include 'user/shop/includes/_product_grid_card.html.twig' %}
            {% endif %}
        {% else %}
            {% include 'user/shop/includes/_empty_state.html.twig' %}
        {% endfor %}
    </div>
    
    {% include 'user/shop/includes/_pagination.html.twig' %}
</div>

{% include 'user/shop/includes/_shop_scripts.html.twig' %}

{% endblock %}
