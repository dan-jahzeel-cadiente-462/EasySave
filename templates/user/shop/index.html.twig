<script>
    (function setUserHeaderHeight(){
        function update() {
            const header = document.querySelector('header');
            if (header) {
                document.documentElement.style.setProperty('--user-header-height', header.offsetHeight + 'px');
            }
        }

        // Update on load and resize
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', update);
        } else {
            update();
        }
        window.addEventListener('resize', update);

        // Also observe header for DOM/size changes (mobile menu expand/collapse)
        const header = document.querySelector('header');
        if (header && window.MutationObserver) {
            const mo = new MutationObserver(() => update());
            mo.observe(header, { attributes: true, childList: true, subtree: true });
        }

        // If there's a mobile menu toggle button, update when clicked
        const mobileToggle = document.getElementById('mobile-menu-toggle');
        if (mobileToggle) {
            mobileToggle.addEventListener('click', function () {
                // Delay slightly to allow menu animation to complete, then update
                setTimeout(update, 140);
            });
        }
    })();
</script>
