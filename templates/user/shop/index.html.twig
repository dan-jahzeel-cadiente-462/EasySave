{% extends 'user/base.html.twig' %}

{% block user_body %}
<!-- 💎 Sticky Premium Navbar (sticks below the user header) -->
<nav class="sticky z-40 bg-white border-b border-gray-200 shadow-sm" style="top: var(--user-header-height, 3rem);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
        <div class="flex flex-col lg:flex-row lg:items-center lg:space-x-6">
            <!-- Premium Search Bar -->
            <div class="flex-1 mb-0 lg:mb-0 mr-4">
                <div class="relative">
                    <form method="GET" action="/search" class="w-full">
                        <div class="relative flex items-center">
                            <!-- Search Icon -->
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none z-10">
                                <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                                </svg>
                            </div>

                            <!-- Search Input -->
                            <input 
                                type="search"
                                name="q"
                                placeholder="Search"
                                value="{{ app.request.query.get('q') }}"
                                autocomplete="off"
                                class="w-full pl-12 pr-24 py-2 bg-white border-2 border-gray-200 rounded-l-xl focus:border-green-500 focus:ring-2 focus:ring-green-100 transition-all duration-200 placeholder-gray-500 text-gray-900 focus:outline-none hover:border-gray-300"
                            >
                            
                            <!-- Search Button -->
                            <button 
                                type="submit" 
                                class="absolute inset-y-0 right-0 bg-green-600 rounded-r-xl px-6 py-2 hover:bg-green-700 transition-all duration-200 cursor-pointer text-white flex items-center justify-center border-2 border-transparent hover:border-green-800 focus:outline-none focus:ring-2 focus:ring-green-300 focus:ring-offset-2"
                                aria-label="Search"
                            >
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                                </svg>
                                <span class="ml-2 font-medium hidden sm:inline">Search</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
            
            <!-- Premium Sort Dropdown -->
            <div class="relative group mr-4">
                <button type="button"
                        class="flex items-center justify-between px-5 py-2 bg-white border-2 border-gray-200 rounded-xl hover:border-indigo-400 hover:shadow-md transition-all duration-300 min-w-[180px]">
                    <div class="flex items-center">
                        <svg class="h-5 w-5 text-gray-500 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4h13M3 8h9m-9 4h9m5-4v12m0 0l-4-4m4 4l4-4"></path>
                        </svg>
                        <span class="font-medium text-gray-700">
                            {% set current_sort = app.request.query.get('sort') %}
                            {% if current_sort == 'price_asc' %}
                                Price: Low to High
                            {% elseif current_sort == 'price_desc' %}
                                Price: High to Low
                            {% elseif current_sort == 'name' %}
                                Name (A-Z)
                            {% elseif current_sort == 'newest' %}
                                Newest First
                            {% elseif current_sort == 'popular' %}
                                Most Popular
                            {% else %}
                                Sort by
                            {% endif %}
                        </span>
                    </div>
                    <svg class="h-5 w-5 text-gray-400 transition-transform duration-300 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                    </svg>
                </button>
                
                <!-- Sort Dropdown Menu -->
                <div class="absolute z-50 hidden group-hover:block w-full mt-2">
                    <div class="bg-white border-2 border-gray-200 rounded-2xl shadow-xl overflow-hidden">
                        <div class="py-2">
                            <label class="flex items-center px-5 py-2 hover:bg-indigo-50 cursor-pointer transition-colors">
                                <input type="radio" name="sort" value="popular"
                                       {% if current_sort == 'popular' %}checked{% endif %}
                                       class="h-4 w-4 text-indigo-600 border-gray-300 focus:ring-indigo-500">
                                <div class="ml-4">
                                    <span class="font-medium text-gray-900">Most Popular</span>
                                    <span class="block text-sm text-gray-500">Top rated products</span>
                                </div>
                            </label>
                            <label class="flex items-center px-5 py-3 hover:bg-indigo-50 cursor-pointer transition-colors">
                                <input type="radio" name="sort" value="newest"
                                       {% if current_sort == 'newest' %}checked{% endif %}
                                       class="h-4 w-4 text-indigo-600 border-gray-300 focus:ring-indigo-500">
                                <div class="ml-4">
                                    <span class="font-medium text-gray-900">Newest First</span>
                                    <span class="block text-sm text-gray-500">Recently added</span>
                                </div>
                            </label>
                            <label class="flex items-center px-5 py-3 hover:bg-indigo-50 cursor-pointer transition-colors">
                                <input type="radio" name="sort" value="price_asc"
                                       {% if current_sort == 'price_asc' %}checked{% endif %}
                                       class="h-4 w-4 text-indigo-600 border-gray-300 focus:ring-indigo-500">
                                <div class="ml-4">
                                    <span class="font-medium text-gray-900">Price: Low to High</span>
                                    <span class="block text-sm text-gray-500">Budget friendly</span>
                                </div>
                            </label>
                            <label class="flex items-center px-5 py-3 hover:bg-indigo-50 cursor-pointer transition-colors">
                                <input type="radio" name="sort" value="price_desc"
                                       {% if current_sort == 'price_desc' %}checked{% endif %}
                                       class="h-4 w-4 text-indigo-600 border-gray-300 focus:ring-indigo-500">
                                <div class="ml-4">
                                    <span class="font-medium text-gray-900">Price: High to Low</span>
                                    <span class="block text-sm text-gray-500">Premium selection</span>
                                </div>
                            </label>
                            <label class="flex items-center px-5 py-3 hover:bg-indigo-50 cursor-pointer transition-colors">
                                <input type="radio" name="sort" value="name"
                                       {% if current_sort == 'name' %}checked{% endif %}
                                       class="h-4 w-4 text-indigo-600 border-gray-300 focus:ring-indigo-500">
                                <div class="ml-4">
                                    <span class="font-medium text-gray-900">Name (A-Z)</span>
                                    <span class="block text-sm text-gray-500">Alphabetical order</span>
                                </div>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- View Toggle -->
            <div class="flex items-center space-x-2 mr-4">
                <button type="button"
                        onclick="setView('grid')"
                        class="p-2 rounded-lg {{ view == 'grid' ? 'bg-indigo-100 text-indigo-700' : 'text-gray-500 hover:bg-gray-100' }} transition-colors">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path>
                    </svg>
                </button>
                <button type="button"
                        onclick="setView('list')"
                        class="p-2 rounded-lg {{ view == 'list' ? 'bg-indigo-100 text-indigo-700' : 'text-gray-500 hover:bg-gray-100' }} transition-colors">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path>
                    </svg>
                </button>
            </div>

            <!-- Advanced Filters Toggle -->
            <button type="button"
                    onclick="toggleAdvancedFilters()"
                    class="flex items-center px-5 py-2 bg-gradient-to-r from-indigo-50 to-purple-50 border-2 border-indigo-100 text-indigo-700 font-semibold rounded-xl hover:from-indigo-100 hover:to-purple-100 hover:border-indigo-200 hover:shadow-md transition-all duration-300 group">
                <svg class="h-5 w-5 mr-3 group-hover:rotate-90 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path>
                </svg>
                Filters
                <span id="filter-count" class="ml-2 bg-indigo-600 text-white text-xs font-bold rounded-full h-6 w-6 flex items-center justify-center">
                    2
                </span>
            </button>
        </div>
        
        <!-- Active Filters Bar -->
        {% if app.request.query.get('q') or app.request.query.get('category') or app.request.query.get('sort') %}
        <div class="mt-4 pt-4 border-t border-gray-100">
            <div class="flex items-center justify-between">
                <div class="flex items-center space-x-2">
                    <span class="text-sm font-medium text-gray-700">Active filters:</span>
                    {% if app.request.query.get('q') %}
                    <span class="inline-flex items-center px-3 py-1.5 rounded-full text-sm bg-blue-100 text-blue-800">
                        Search: "{{ app.request.query.get('q') }}"
                        <button type="button" class="ml-2 text-blue-600 hover:text-blue-800">
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                        </button>
                    </span>
                    {% endif %}
                    {% if app.request.query.get('category') and categories is defined %}
                        {% for category in categories %}
                            {% if category.id == app.request.query.get('category') %}
                            <span class="inline-flex items-center px-3 py-1.5 rounded-full text-sm bg-green-100 text-green-800">
                                {{ category.name }}
                                <button type="button" class="ml-2 text-green-600 hover:text-green-800">
                                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                                    </svg>
                                </button>
                            </span>
                            {% endif %}
                        {% endfor %}
                    {% endif %}
                </div>
                <a href="{{ path('app_user_shop') }}"
                   class="text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors">
                    Clear all filters
                </a>
            </div>
        </div>
        {% endif %}
    </div>
</nav>

<div class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
    <!-- 🎛️ Collapsible Advanced Filters Panel -->
    <div id="advanced-filters" class="hidden bg-white border-2 border-gray-200 rounded-2xl shadow-lg mb-8 overflow-hidden">
        <div class="p-8">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                <!-- Price Range Filter -->
                <div class="space-y-6">
                    <div>
                        <h3 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
                            <svg class="h-5 w-5 text-indigo-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            Price Range
                        </h3>
                        <div class="space-y-4">
                            <div class="relative pt-1">
                                <input type="range" min="0" max="5000" value="0" 
                                       class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer slider-thumb"
                                       id="price-min">
                                <input type="range" min="0" max="5000" value="5000" 
                                       class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer slider-thumb mt-2"
                                       id="price-max">
                                <div class="absolute h-2 bg-indigo-500 rounded-lg left-0 right-0 top-1/2 transform -translate-y-1/2 pointer-events-none"></div>
                            </div>
                            <div class="flex items-center justify-between pt-4">
                                <div class="flex-1 mr-4">
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Min Price</label>
                                    <div class="relative">
                                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                            <span class="text-gray-500">AED</span>
                                        </div>
                                        <input type="number" 
                                               class="w-full pl-12 pr-4 py-2 border-2 border-gray-200 rounded-lg focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
                                               value="0"
                                               id="price-min-input">
                                    </div>
                                </div>
                                <div class="flex-1">
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Max Price</label>
                                    <div class="relative">
                                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                            <span class="text-gray-500">AED</span>
                                        </div>
                                        <input type="number" 
                                               class="w-full pl-12 pr-4 py-2 border-2 border-gray-200 rounded-lg focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
                                               value="5000"
                                               id="price-max-input">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Category Filter -->
                <div class="space-y-6">
                    <h3 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
                        <svg class="h-5 w-5 text-indigo-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
                        </svg>
                        Categories
                    </h3>
                    <div class="grid grid-cols-2 gap-3">
                        {% if categories is defined %}
                            {% for category in categories|slice(0, 6) %}
                            <label class="flex items-center p-3 border-2 border-gray-200 rounded-xl hover:border-indigo-400 hover:bg-indigo-50 cursor-pointer transition-all duration-200">
                                <input type="checkbox" name="categories[]" value="{{ category.id }}"
                                       class="h-5 w-5 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500">
                                <span class="ml-3 text-gray-700 font-medium">{{ category.name }}</span>
                            </label>
                            {% endfor %}
                        {% endif %}
                    </div>
                    {% if categories is defined and categories|length > 6 %}
                    <button type="button" 
                            onclick="toggleMoreCategories()"
                            class="text-sm font-medium text-indigo-600 hover:text-indigo-700 flex items-center transition-colors">
                        Show all categories
                        <svg class="h-4 w-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                        </svg>
                    </button>
                    {% endif %}
                </div>
                
                <!-- Additional Filters -->
                <div class="space-y-6">
                    <h3 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
                        <svg class="h-5 w-5 text-indigo-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path>
                        </svg>
                        More Filters
                    </h3>
                    <div class="space-y-4">
                        <!-- Rating Filter -->
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Minimum Rating</label>
                            <div class="flex items-center space-x-1">
                                {% for i in 5..1 %}
                                <button type="button" 
                                        class="p-2 text-yellow-400 hover:text-yellow-500 transition-colors"
                                        data-rating="{{ i }}">
                                    <svg class="h-6 w-6 fill-current" viewBox="0 0 24 24">
                                        <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"></path>
                                    </svg>
                                </button>
                                {% endfor %}
                                <span class="ml-2 text-sm text-gray-600">& above</span>
                            </div>
                        </div>
                        
                        <!-- Availability Filter -->
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Availability</label>
                            <div class="space-y-2">
                                <label class="flex items-center">
                                    <input type="checkbox" class="h-4 w-4 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500">
                                    <span class="ml-2 text-gray-700">In Stock</span>
                                    <span class="ml-auto text-sm text-gray-500">({{ random(50, 150) }})</span>
                                </label>
                                <label class="flex items-center">
                                    <input type="checkbox" class="h-4 w-4 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500">
                                    <span class="ml-2 text-gray-700">On Sale</span>
                                    <span class="ml-auto text-sm text-gray-500">({{ random(10, 30) }})</span>
                                </label>
                                <label class="flex items-center">
                                    <input type="checkbox" class="h-4 w-4 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500">
                                    <span class="ml-2 text-gray-700">Fast Delivery</span>
                                    <span class="ml-auto text-sm text-gray-500">({{ random(80, 120) }})</span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Filter Actions -->
            <div class="mt-8 pt-8 border-t border-gray-100 flex justify-between">
                <button type="button" 
                        onclick="resetAdvancedFilters()"
                        class="px-6 py-3 border-2 border-gray-300 text-gray-700 font-medium rounded-xl hover:bg-gray-50 transition-all duration-300">
                    Reset All Filters
                </button>
                <div class="space-x-4">
                    <button type="button" 
                            onclick="toggleAdvancedFilters()"
                            class="px-6 py-3 border-2 border-gray-300 text-gray-700 font-medium rounded-xl hover:bg-gray-50 transition-all duration-300">
                        Cancel
                    </button>
                    <button type="submit" 
                            class="px-8 py-3 bg-gradient-to-r from-indigo-600 to-purple-600 text-white font-semibold rounded-xl hover:from-indigo-700 hover:to-purple-700 hover:shadow-lg transition-all duration-300">
                        Apply Filters
                    </button>
                </div>
            </div>
        </div>
    </div>
    
    <!-- 💎 Premium Product Grid/List -->
    <div class="{% if view == 'list' %}space-y-6{% else %}grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8{% endif %}">
        {% for product in products %}
            {% set is_favorited = product.id in favoriteProductIds %}
            {% set discount = random(0, 30) %}
            {% set is_new = random(0, 1) %}
            {% set rating = random(3, 5) %}

            {% if view == 'list' %}
            <!-- List View -->
            <div class="group relative bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-500">
                <div class="flex">
                    <!-- Product Image -->
                    <div class="relative w-48 h-48 flex-shrink-0 overflow-hidden rounded-l-2xl">
                        {% set img = product.imagePath ?: '/images/default-product.png' %}
                        <img src="{{ asset(img) }}"
                             alt="{{ product.name }}"
                             class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700">

                        <!-- Product Badges -->
                        <div class="absolute top-4 left-4 space-y-2">
                            {% if discount > 0 %}
                            <span class="inline-block px-3 py-1 bg-red-500 text-white text-sm font-bold rounded-full shadow-lg">
                                -{{ discount }}%
                            </span>
                            {% endif %}
                            {% if is_new %}
                            <span class="inline-block px-3 py-1 bg-emerald-500 text-white text-sm font-bold rounded-full shadow-lg">
                                NEW
                            </span>
                            {% endif %}
                            {% if product.stock <= 10 and product.stock > 0 %}
                            <span class="inline-block px-3 py-1 bg-orange-500 text-white text-sm font-bold rounded-full shadow-lg">
                                Only {{ product.stock }} left
                            </span>
                            {% endif %}
                        </div>

                        <!-- Favorite Button -->
                        {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                        <form method="post" action="{{ path('app_user_favorite_toggle', {'id': product.id}) }}"
                              class="absolute top-4 right-4 z-10">
                            <button type="submit"
                                    aria-label="Toggle favorite"
                                    class="p-3 bg-white/90 backdrop-blur-sm rounded-full shadow-lg hover:shadow-xl transition-all duration-300 group/fav">
                                {% if is_favorited %}
                                <svg class="h-6 w-6 text-red-500 fill-current group-hover/fav:scale-110 transition-transform" viewBox="0 0 24 24">
                                    <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"></path>
                                </svg>
                                {% else %}
                                <svg class="h-6 w-6 text-gray-400 group-hover/fav:text-red-400 group-hover/fav:scale-110 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                                </svg>
                                {% endif %}
                            </button>
                        </form>
                        {% endif %}
                    </div>

                    <!-- Product Info -->
                    <div class="flex-1 p-6">
                        <!-- Category & Brand -->
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-xs font-medium text-indigo-600 uppercase tracking-wide">
                                {{ product.brand }}
                            </span>
                            <!-- Star Rating -->
                            <div class="flex items-center">
                                {% for i in 1..5 %}
                                    {% if i <= rating %}
                                    <svg class="h-4 w-4 text-yellow-400 fill-current" viewBox="0 0 20 20">
