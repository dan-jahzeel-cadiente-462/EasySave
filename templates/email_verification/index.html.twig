{% extends 'base.html.twig' %}

{% block title %}Email Verification - EasySave{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 py-12 px-4">
    <div class="max-w-md mx-auto bg-white shadow-lg rounded-lg p-8">
        <div class="text-center mb-6">
            <svg class="w-16 h-16 mx-auto text-blue-600 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            <h1 class="text-2xl font-bold text-gray-800">Check Your Email</h1>
        </div>

        {% if app.user and not app.user.isVerified %}
            <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-6">
                <p class="text-gray-700 text-center">
                    We've sent a verification link to <strong class="text-blue-600">{{ app.user.email }}</strong>
                </p>
            </div>

            <div class="space-y-4 text-gray-700">
                <p>To verify your email:</p>
                <ol class="list-decimal list-inside space-y-2 ml-2">
                    <li>Check your email (<strong>{{ app.user.email }}</strong>)</li>
                    <li>Look for the email from EasySave</li>
                    <li>Click the "Verify Email Address" button in the email</li>
                    <li>You'll be redirected here to confirm verification</li>
                </ol>
            </div>

            <div class="mt-6 pt-6 border-t border-gray-200">
                <p class="text-sm text-gray-600 mb-4">Didn't receive the email?</p>
                <div class="space-y-3">
                    <p class="text-sm text-gray-500">✓ Check your spam folder</p>
                    <p class="text-sm text-gray-500">✓ The link expires in 24 hours</p>
                </div>
            </div>

            <div class="mt-8">
                <a href="{{ path('app_logout') }}" class="block w-full text-center bg-gray-200 text-gray-800 py-2 px-4 rounded-lg hover:bg-gray-300 transition">
                    Log Out
                </a>
            </div>
        {% elseif app.user %}
            <div class="bg-green-50 border border-green-200 rounded-lg p-4 mb-6">
                <div class="flex items-center">
                    <svg class="w-6 h-6 text-green-600 mr-2" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                    <span class="text-green-700 font-semibold">Email Verified!</span>
                </div>
            </div>

            <p class="text-gray-700 text-center mb-6">
                Your email has been successfully verified. You can now enjoy all features of EasySave.
            </p>

            <a href="{{ path('app_dashboard') }}" class="block w-full text-center bg-blue-600 text-white py-2 px-4 rounded-lg hover:bg-blue-700 transition">
                Go to Dashboard
            </a>
        {% else %}
            <p class="text-gray-700 text-center mb-4">
                Please log in to verify your email address.
            </p>
            <a href="{{ path('app_login') }}" class="block w-full text-center bg-blue-600 text-white py-2 px-4 rounded-lg hover:bg-blue-700 transition">
                Log In
            </a>
        {% endif %}

        <div class="mt-8 pt-6 border-t border-gray-200 text-xs text-gray-500 text-center">
            <p>© 2026 EasySave. All rights reserved.</p>
        </div>
    </div>
</div>
{% endblock %}
