{% extends 'base.html.twig' %}

{% block title %}Resend Verification Email - EasySave{% endblock %}

{% block body %}
<section class="min-h-screen flex items-center justify-center py-12 px-4">
    <div class="max-w-md w-full glass-form shadow-xl rounded-2xl p-8">
        <h1 class="text-2xl font-bold mb-2 text-gray-800 dark:text-white transition-colors duration-300">Resend Verification Email</h1>
        <p class="text-sm text-gray-600 dark:text-gray-400 mb-6">Enter your email address and we'll send you a new verification link.</p>

        {# Show flash messages #}
        {% for message in app.flashes('success') %}
            <div class="mb-4 p-3 text-sm text-green-700 bg-green-100 dark:text-green-300 dark:bg-green-900/30 rounded-lg transition-colors duration-300">
                ✓ {{ message }}
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="mb-4 p-3 text-sm text-red-700 bg-red-100 dark:text-red-300 dark:bg-red-900/30 rounded-lg transition-colors duration-300">
                ✗ {{ message }}
            </div>
        {% endfor %}

        {% for message in app.flashes('warning') %}
            <div class="mb-4 p-3 text-sm text-yellow-700 bg-yellow-100 dark:text-yellow-300 dark:bg-yellow-900/30 rounded-lg transition-colors duration-300">
                ⓘ {{ message }}
            </div>
        {% endfor %}

        {% for message in app.flashes('info') %}
            <div class="mb-4 p-3 text-sm text-blue-700 bg-blue-100 dark:text-blue-300 dark:bg-blue-900/30 rounded-lg transition-colors duration-300">
                ℹ {{ message }}
            </div>
        {% endfor %}

        <form method="post" class="space-y-4">
            <div>
                <label for="email" class="block text-gray-700 dark:text-gray-300 font-medium mb-2 transition-colors duration-300">Email Address</label>
                <input 
                    type="email" 
                    name="email" 
                    id="email" 
                    class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-green-500 dark:focus:ring-green-400 transition-colors duration-300"
                    placeholder="your.email@example.com"
                    required
                    autofocus
                >
            </div>

            <button 
                type="submit" 
                class="w-full bg-green-600 dark:bg-green-700 text-white py-2 px-4 rounded-lg hover:bg-green-700 dark:hover:bg-green-600 transition duration-300 font-medium"
            >
                Send Verification Link
            </button>
        </form>

        <div class="mt-6 pt-6 border-t border-gray-200 dark:border-gray-700 space-y-3">
            <div class="text-sm text-gray-600 dark:text-gray-400">
                <p class="font-medium mb-2">💡 Tips:</p>
                <ul class="space-y-1 text-xs">
                    <li>✓ Check your spam/junk folder</li>
                    <li>✓ The link is valid for 24 hours</li>
                    <li>✓ If you don't have an account, <a href="{{ path('app_register') }}" class="text-green-600 dark:text-green-400 hover:underline">register here</a></li>
                </ul>
            </div>
        </div>

        <div class="mt-6 text-center">
            <p class="text-sm text-gray-600 dark:text-gray-400">
                <a href="{{ path('app_user_login') }}" class="text-green-600 dark:text-green-400 hover:underline font-medium">Back to login</a>
            </p>
        </div>
    </div>
</section>
{% endblock %}
