{% extends 'base.html.twig' %}

{% block title %}About EasySave{% endblock %}

{% block body %}
<section class="py-12 md:py-20 lg:py-24 transition-colors duration-300 bg-gradient-to-br from-green-50/50 to-emerald-50/50">
    <div class="max-w-screen-xl px-4 sm:px-6 lg:px-8 mx-auto">
        {# Hero Section #}
        <div class="text-center max-w-4xl mx-auto mb-20 lg:mb-24">
            <div class="glass-badge inline-flex items-center gap-2 px-4 py-2 rounded-full mb-8 mx-auto w-fit backdrop-blur-sm">
                <span class="text-sm font-semibold tracking-wide text-emerald-700">🚀 Our Story</span>
            </div>
            <h1 class="text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-black bg-gradient-to-r from-gray-900 to-slate-900 bg-clip-text text-transparent mb-6 md:mb-8 leading-tight">
                Protecting What<br class="hidden md:inline">Matters Most
            </h1>
            <p class="text-xl md:text-2xl lg:text-3xl text-gray-700 leading-relaxed max-w-3xl mx-auto mb-10">
                EasySave was founded in 2020 with one mission: make enterprise-grade data backup 
                effortless and accessible for everyone. Today, we protect critical data for 5,000+ businesses.
            </p>
        </div>

        {# Stats Row #}
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 lg:gap-8 mb-24 py-12 rounded-3xl glass-container backdrop-blur-xl mx-auto max-w-4xl border" style="border-color: rgba(59, 173, 89, 0.2);">
            <div class="text-center group hover:scale-105 transition-all duration-300">
                <div class="text-4xl lg:text-5xl font-black bg-gradient-to-r from-emerald-600 to-emerald-700 bg-clip-text text-transparent mb-2">5K+</div>
                <div class="text-sm lg:text-base text-gray-600 font-semibold uppercase tracking-wide">Active Users</div>
            </div>
            <div class="text-center group hover:scale-105 transition-all duration-300">
                <div class="text-4xl lg:text-5xl font-black bg-gradient-to-r from-emerald-600 to-emerald-700 bg-clip-text text-transparent mb-2">99.9%</div>
                <div class="text-sm lg:text-base text-gray-600 font-semibold uppercase tracking-wide">Uptime SLA</div>
            </div>
            <div class="text-center group hover:scale-105 transition-all duration-300">
                <div class="text-4xl lg:text-5xl font-black bg-gradient-to-r from-emerald-600 to-emerald-700 bg-clip-text text-transparent mb-2">24/7</div>
                <div class="text-sm lg:text-base text-gray-600 font-semibold uppercase tracking-wide">Support</div>
            </div>
            <div class="text-center group hover:scale-105 transition-all duration-300">
                <div class="text-4xl lg:text-5xl font-black bg-gradient-to-r from-emerald-600 to-emerald-700 bg-clip-text text-transparent mb-2">50+</div>
                <div class="text-sm lg:text-base text-gray-600 font-semibold uppercase tracking-wide">Enterprise Clients</div>
            </div>
        </div>

        {# Core Values #}
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center mb-24">
            <div class="order-2 lg:order-1">
                <div class="glass-badge inline-flex items-center gap-2 px-4 py-2 rounded-full mb-8 w-fit backdrop-blur-sm">
                    <span class="text-sm font-semibold tracking-wide text-emerald-700">🧭 Our Principles</span>
                </div>
                <h2 class="text-3xl md:text-4xl lg:text-5xl font-black text-gray-900 mb-8 leading-tight">
                    Built on Trust,<br>Security, Simplicity
                </h2>
                <div class="space-y-6">
                    <div class="flex items-start gap-4 p-6 rounded-2xl glass-container hover:shadow-2xl hover:scale-[1.02] transition-all duration-300 border" style="border-color: rgba(59, 173, 89, 0.2);">
                        <div class="flex-shrink-0 w-12 h-12 mt-1 rounded-2xl bg-gradient-to-br from-emerald-500 to-emerald-600 flex items-center justify-center shadow-lg">
                            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2V7a2 2 0 00-2-2H6a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                            </svg>
                        </div>
                        <div>
                            <h3 class="text-2xl font-bold text-gray-900 mb-2">Security First</h3>
                            <p class="text-lg text-gray-600 leading-relaxed">AES-256 encryption, ISO 27001 certified infrastructure, and end-to-end zero-knowledge encryption available.</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-4 p-6 rounded-2xl glass-container hover:shadow-2xl hover:scale-[1.02] transition-all duration-300 border" style="border-color: rgba(59, 173, 89, 0.2);">
                        <div class="flex-shrink-0 w-12 h-12 mt-1 rounded-2xl bg-gradient-to-br from-emerald-500 to-emerald-600 flex items-center justify-center shadow-lg">
                            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                            </svg>
                        </div>
                        <div>
                            <h3 class="text-2xl font-bold text-gray-900 mb-2">Lightning Fast</h3>
                            <p class="text-lg text-gray-600 leading-relaxed">Incremental backups 10x faster than traditional solutions with intelligent deduplication.</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-4 p-6 rounded-2xl glass-container hover:shadow-2xl hover:scale-[1.02] transition-all duration-300 border" style="border-color: rgba(59, 173, 89, 0.2);">
                        <div class="flex-shrink-0 w-12 h-12 mt-1 rounded-2xl bg-gradient-to-br from-emerald-500 to-emerald-600 flex items-center justify-center shadow-lg">
                            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.314a1 1 0 01-1.414 0l-.707-.707m5.657 0a1 1 0 01-1.414 0l-.707-.707m0-2.828l-.707.707a1 1 0 01-1.414 0l-.707-.707m0 2.828l.707.707a1 1 0 001.414 0l.707-.707m-2.828 0l-.707.707a1 1 0 01-1.414 0l-.707-.707m5.657-3.343l-.707-.707m0 2.828l.707.707a1 1 0 001.414 0l.707-.707m-3.343 5.657l-.707-.707m0-2.828l.707.707a1 1 0 001.414 0l.707-.707"/>
                            </svg>
                        </div>
                        <div>
                            <h3 class="text-2xl font-bold text-gray-900 mb-2">Always Available</h3>
                            <p class="text-lg text-gray-600 leading-relaxed">99.9% uptime guarantee with geo-redundant storage across 3 continents.</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="order-1 lg:order-2">
                <div class="relative rounded-3xl overflow-hidden shadow-2xl glass-container backdrop-blur-xl h-[500px] lg:h-[600px] bg-gradient-to-br from-emerald-500/20 via-transparent to-emerald-600/20">
                    <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80" alt="EasySave Team" class="w-full h-full object-cover hover:scale-110 transition-transform duration-1000 group-hover:scale-110">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/20 via-transparent to-transparent"></div>
                </div>
            </div>
        </div>

        {# Team Section #}
        {% include "about/sections/teams.html.twig" %}

        {# CTA Section #}
        <div class="text-center rounded-3xl p-12 lg:p-20 mt-20 lg:mt-32 glass-container backdrop-blur-xl max-w-4xl mx-auto hover:shadow-2xl transition-all duration-500 border-4" style="border-color: rgba(59, 173, 89, 0.3);">
            <div class="glass-badge inline-flex items-center gap-3 px-6 py-3 rounded-2xl mb-8 mx-auto w-fit backdrop-blur-sm text-lg font-semibold">
                <span class="text-emerald-700">💼 Join Our Mission</span>
            </div>
            <h3 class="text-3xl lg:text-4xl xl:text-5xl font-black text-gray-900 mb-6 leading-tight">
                Ready to Build the Future<br>of Data Protection?
            </h3>
            <p class="text-xl text-gray-600 max-w-2xl mx-auto mb-10 lg:mb-12 leading-relaxed">
                We're hiring passionate engineers, designers, and security experts to help us protect 
                the world's most important data. Your next big opportunity awaits.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
                <a href="{{ path('app_contact') }}" class="group inline-flex items-center gap-3 px-8 py-4 rounded-2xl font-bold text-lg transition-all duration-300 hover:shadow-2xl hover:scale-105 bg-gradient-to-r from-emerald-600 to-emerald-700 text-white shadow-lg">
                    View Careers
                    <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                    </svg>
                </a>
                <a href="{{ path('app_help') }}" class="inline-flex items-center gap-2 px-8 py-4 rounded-2xl font-semibold text-lg border-2 border-emerald-600 text-emerald-700 hover:bg-emerald-600 hover:text-white transition-all duration-300 hover:shadow-xl">
                    Learn More About Us
                </a>
            </div>
        </div>
    </div>
</section>
{% endblock %}
