{% extends 'base.html.twig' %}

{% block title %}Hello AboutController!
{% endblock %}

{% block body %}
	{# 
		EasySave About Us Page - Twig Template
		Anonymized team members with silhouette images
		Consistent branding with #3bad59 green accents
		Fully responsive (mobile → tablet → desktop)
		Dark/Light theme support
	#}

	<section class="py-12 md:py-20 transition-colors duration-300">
		<div class="max-w-screen-xl px-4 sm:px-6 mx-auto">
			{# Hero Section #}
			<div class="text-center max-w-3xl mx-auto mb-16">
				<div class="glass-badge inline-flex items-center gap-2 px-3 py-1 rounded-full mb-6">
					<span class="text-xs font-semibold tracking-wide">🆘 Help Center</span>
				</div>
				<h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-black dark:text-white mb-6 leading-tight">
					How Can We<br>Help You?
				</h1>
				<p class="text-lg md:text-xl text-gray-700 dark:text-gray-300 leading-relaxed max-w-2xl mx-auto">
					Find answers, troubleshooting guides, and expert resources for all your EasySave questions.
				</p>

				{# Search Bar #}
				<div class="max-w-2xl mx-auto mt-8">
					<div class="relative">
						<svg class="absolute left-4 top-1/2 transform -translate-y-1/2 w-5 h-5 text-black/40" fill="none" stroke="currentColor" viewbox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
						</svg>
						<input type="text" id="help-search" placeholder="Search for articles, guides, or questions..." class="w-full pl-12 pr-4 py-4 rounded-xl border focus:outline-none focus:ring-2 transition text-black" style="border-color: rgba(59, 173, 89, 0.3); background: white; focus:ring-color: #3bad59;">
					</div>
				</div>
			</div>

			{# Support Categories Grid #}
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-20">
				<a href="#" class="group p-6 rounded-2xl text-center transition-all duration-300 hover:shadow-lg" style="background: white; border: 1px solid rgba(59, 173, 89, 0.2);">
					<div class="w-14 h-14 mx-auto rounded-full flex items-center justify-center mb-4 transition-colors group-hover:bg-opacity-20" style="background-color: rgba(59, 173, 89, 0.1);">
						<svg class="w-7 h-7" style="color: #3bad59;" fill="none" stroke="currentColor" viewbox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
						</svg>
					</div>
					<h3 class="font-bold text-black mb-1">Getting Started</h3>
					<p class="text-sm text-black/50">Setup & installation guides</p>
				</a>
				<a href="#" class="group p-6 rounded-2xl text-center transition-all duration-300 hover:shadow-lg" style="background: white; border: 1px solid rgba(59, 173, 89, 0.2);">
					<div class="w-14 h-14 mx-auto rounded-full flex items-center justify-center mb-4 transition-colors group-hover:bg-opacity-20" style="background-color: rgba(59, 173, 89, 0.1);">
						<svg class="w-7 h-7" style="color: #3bad59;" fill="none" stroke="currentColor" viewbox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
						</svg>
					</div>
					<h3 class="font-bold text-black mb-1">Security & Privacy</h3>
					<p class="text-sm text-black/50">Encryption, compliance, best practices</p>
				</a>
				<a href="#" class="group p-6 rounded-2xl text-center transition-all duration-300 hover:shadow-lg" style="background: white; border: 1px solid rgba(59, 173, 89, 0.2);">
					<div class="w-14 h-14 mx-auto rounded-full flex items-center justify-center mb-4 transition-colors group-hover:bg-opacity-20" style="background-color: rgba(59, 173, 89, 0.1);">
						<svg class="w-7 h-7" style="color: #3bad59;" fill="none" stroke="currentColor" viewbox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
						</svg>
					</div>
					<h3 class="font-bold text-black mb-1">Troubleshooting</h3>
					<p class="text-sm text-black/50">Fix common issues & errors</p>
				</a>
				<a href="#" class="group p-6 rounded-2xl text-center transition-all duration-300 hover:shadow-lg" style="background: white; border: 1px solid rgba(59, 173, 89, 0.2);">
					<div class="w-14 h-14 mx-auto rounded-full flex items-center justify-center mb-4 transition-colors group-hover:bg-opacity-20" style="background-color: rgba(59, 173, 89, 0.1);">
						<svg class="w-7 h-7" style="color: #3bad59;" fill="none" stroke="currentColor" viewbox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M6 6h12M6 18h12M4 4h16a2 2 0 012 2v12a2 2 0 01-2 2H4a2 2 0 01-2-2V6a2 2 0 012-2z"></path>
						</svg>
					</div>
					<h3 class="font-bold text-black mb-1">Billing & Plans</h3>
					<p class="text-sm text-black/50">Pricing, invoices, subscriptions</p>
				</a>
			</div>
			{# Hero Section - Company Story #}
			<div class="text-center max-w-3xl mx-auto mb-16">
				<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full mb-6" style="background-color: rgba(59, 173, 89, 0.12); border: 1px solid rgba(59, 173, 89, 0.3);">
					<span class="text-xs font-semibold tracking-wide" style="color: #3bad59;">📖 Our Story</span>
				</div>
				<h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-black mb-6 leading-tight">
					Protecting What<br>Matters Most
				</h1>
				<p class="text-lg md:text-xl text-black/70 leading-relaxed">
					EasySave was founded with a simple mission: to make data backup effortless, 
										                secure, and accessible for everyone. Since 2020, we've helped thousands of 
										                businesses sleep better at night knowing their critical data is safe.
				</p>
			</div>

			{# Stats / Milestones Row - responsive flex wrap #}
			<div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-20 py-8 border-y" style="border-color: rgba(59, 173, 89, 0.2);">
				<div class="text-center">
					<div class="text-3xl md:text-4xl font-black" style="color: #3bad59;">5k+</div>
					<div class="text-sm text-black/60 mt-1">Active Users</div>
				</div>
				<div class="text-center">
					<div class="text-3xl md:text-4xl font-black" style="color: #3bad59;">99.9%</div>
					<div class="text-sm text-black/60 mt-1">Uptime SLA</div>
				</div>
				<div class="text-center">
					<div class="text-3xl md:text-4xl font-black" style="color: #3bad59;">24/7</div>
					<div class="text-sm text-black/60 mt-1">Support Coverage</div>
				</div>
				<div class="text-center">
					<div class="text-3xl md:text-4xl font-black" style="color: #3bad59;">50+</div>
					<div class="text-sm text-black/60 mt-1">Enterprise Clients</div>
				</div>
			</div>

			{# Two-column layout: Our Values + Image (responsive stacking) #}
			<div class="grid lg:grid-cols-2 gap-12 items-center mb-24">
				<div>
					<h2 class="text-2xl md:text-3xl font-bold text-black mb-4">Our Core Values</h2>
					<div class="space-y-4 mt-6">
						<div class="flex gap-3">
							<div class="flex-shrink-0 w-6 h-6 mt-1 rounded-full flex items-center justify-center" style="background-color: #3bad59;">
								<svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewbox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
								</svg>
							</div>
							<div>
								<h3 class="font-semibold text-black">Security First</h3>
								<p class="text-black/60 text-sm">AES-256 encryption & ISO 27001 certified infrastructure.</p>
							</div>
						</div>
						<div class="flex gap-3">
							<div class="flex-shrink-0 w-6 h-6 mt-1 rounded-full flex items-center justify-center" style="background-color: #3bad59;">
								<svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewbox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
								</svg>
							</div>
							<div>
								<h3 class="font-semibold text-black">Simplicity</h3>
								<p class="text-black/60 text-sm">Intuitive interface that just works — no complex setup.</p>
							</div>
						</div>
						<div class="flex gap-3">
							<div class="flex-shrink-0 w-6 h-6 mt-1 rounded-full flex items-center justify-center" style="background-color: #3bad59;">
								<svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewbox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
								</svg>
							</div>
							<div>
								<h3 class="font-semibold text-black">Innovation</h3>
								<p class="text-black/60 text-sm">AI-driven backup optimization and real-time monitoring.</p>
							</div>
						</div>
					</div>
				</div>
				<div class="rounded-2xl overflow-hidden shadow-lg">
					<img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=800&h=500&fit=crop" alt="EasySave team collaborating" class="w-full h-auto object-cover">
				</div>
			</div>

			{% include "about/sections/teams.html.twig" %}

			{# Call to Action - Join the team (consistent branding) #}
			<div class="text-center rounded-2xl p-8 md:p-12 mt-8" style="background: linear-gradient(135deg, rgba(59,173,89,0.08) 0%, rgba(59,173,89,0.02) 100%); border: 1px solid rgba(59,173,89,0.2);">
				<h3 class="text-2xl md:text-3xl font-bold text-black mb-3">Join Our Mission</h3>
				<p class="text-black/70 max-w-2xl mx-auto mb-6">We're always looking for passionate people to help us build the future of data protection.</p>
				<a href="#" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg font-semibold transition-all hover:shadow-lg" style="background-color: #3bad59; color: white;">
					View Open Positions
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewbox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
					</svg>
				</a>
			</div>
		</div>
	</section>
{% endblock %}
