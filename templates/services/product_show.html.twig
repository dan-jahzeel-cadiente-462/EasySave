{% set user_base = is_granted('IS_AUTHENTICATED_FULLY') ? 'user/base.html.twig' : 'base.html.twig' %}
{% extends user_base %}

{% block title %}{{ product.name }} | Product Details{% endblock %}

{% block body %}
<div class="bg-gray-100 min-h-screen py-10">
    <div class="max-w-3xl mx-auto bg-white rounded-lg shadow-lg p-8">
        <nav class="mb-6 text-sm" aria-label="Breadcrumb">
            <a href="{{ path('app_services') }}" class="text-blue-600 hover:underline">← Back to Services</a>
        </nav>
        <div class="flex flex-col md:flex-row gap-8 items-start">
            <div class="w-full md:w-1/2 flex-shrink-0">
                {% set img = product.imagePath ?: '/images/default-product.png' %}
                <img src="{{ asset(img) }}" alt="{{ product.name }}" class="w-full h-64 object-cover rounded-lg border">
            </div>
            <div class="flex-1">
                <h1 class="text-3xl font-bold text-gray-900 mb-2">{{ product.name }}</h1>
                <p class="text-gray-600 mb-2">Brand: <span class="font-semibold">{{ product.brand }}</span></p>
                <p class="text-gray-700 mb-4">{{ product.description }}</p>
                <div class="mb-4">
                    <span class="text-lg font-bold text-green-600">{{ product.price|number_format(2) }} AED</span>
                    <span class="ml-4 text-gray-500">Stock: {{ product.stock }}</span>
                </div>
                <div class="flex gap-4 mt-6">
                    {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                        <a href="{{ path('app_cart_add', {'id': product.id}) }}" class="px-6 py-2 bg-green-600 text-white rounded hover:bg-green-700 font-semibold">Add to cart</a>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="px-6 py-2 bg-gray-400 text-white rounded font-semibold">Login to buy</a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
