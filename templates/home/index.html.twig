{# index.html.twig - EasySave Landing Page #}
{% extends 'base.html.twig' %}

{% block title %}EasySave - Secure Backup Solution{% endblock %}

{% block body %}
<!-- Hero Section -->
<section class="relative overflow-hidden">
    <div class="grid max-w-screen-xl px-4 pt-20 pb-8 mx-auto lg:gap-8 xl:gap-0 lg:py-16 lg:grid-cols-2 lg:pt-28">
        <!-- Left Column: Content -->
        <div class="mr-auto place-self-center">
            <!-- Badge -->
            <div class="inline-flex items-center gap-2 mb-6 px-4 py-2 rounded-full bg-green-50 dark:bg-green-900/30 border border-green-200 dark:border-green-800">
                <span class="w-2 h-2 rounded-full bg-green-600 dark:bg-green-400 animate-pulse"></span>
                <span class="text-sm font-semibold text-green-700 dark:text-green-400">🚀 Trusted by 5000+ Users Worldwide</span>
            </div>

            <!-- Main Heading -->
            <h1 class="mb-4 text-4xl font-bold leading-tight md:text-5xl xl:text-6xl text-gray-900 dark:text-white">
                Secure Your Data.<br><span class="bg-gradient-to-r from-green-600 to-emerald-600 dark:from-green-400 dark:to-emerald-400 bg-clip-text text-transparent">Effortlessly.</span>
            </h1>

            <!-- Subheading -->
            <p class="mb-6 text-lg md:text-xl text-gray-600 dark:text-gray-400 max-w-xl">
                EasySave delivers enterprise-grade automated backups with military-grade encryption, real-time monitoring, and intelligent file prioritization—all with a single click.
            </p>

            <!-- CTA Buttons -->
            <div class="flex flex-col sm:flex-row gap-4 mb-12">
                <a href="{{ path('app_register') }}" class="inline-flex items-center justify-center px-6 py-3 bg-green-600 dark:bg-green-600 text-white font-semibold rounded-lg hover:bg-green-700 dark:hover:bg-green-700 transition-all duration-200 shadow-lg hover:shadow-xl transform hover:scale-105">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                    </svg>
                    Get Started Free
                </a>
                <a href="{{ path('app_catalog') }}" class="inline-flex items-center justify-center px-6 py-3 border-2 border-green-600 dark:border-green-400 text-green-600 dark:text-green-400 font-semibold rounded-lg hover:bg-green-50 dark:hover:bg-green-900/20 transition-all duration-200">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    Explore Products
                </a>
            </div>

            <!-- Trust Badges -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-8 border-t border-gray-200 dark:border-gray-800">
                <div class="flex items-center gap-3">
                    <div class="flex-shrink-0">
                        <svg class="h-6 w-6 text-green-600 dark:text-green-400" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                        </svg>
                    </div>
                    <div>
                        <p class="font-semibold text-gray-900 dark:text-white">AES-256 Encryption</p>
                        <p class="text-sm text-gray-600 dark:text-gray-400">Military-grade security</p>
                    </div>
                </div>
                <div class="flex items-center gap-3">
                    <div class="flex-shrink-0">
                        <svg class="h-6 w-6 text-green-600 dark:text-green-400" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                        </svg>
                    </div>
                    <div>
                        <p class="font-semibold text-gray-900 dark:text-white">Real-Time Sync</p>
                        <p class="text-sm text-gray-600 dark:text-gray-400">Instant updates</p>
                    </div>
                </div>
                <div class="flex items-center gap-3">
                    <div class="flex-shrink-0">
                        <svg class="h-6 w-6 text-green-600 dark:text-green-400" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                        </svg>
                    </div>
                    <div>
                        <p class="font-semibold text-gray-900 dark:text-white">99.9% Uptime</p>
                        <p class="text-sm text-gray-600 dark:text-gray-400">Reliable service</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Visual -->
        <div class="hidden lg:flex lg:justify-end lg:items-center">
            <div class="relative">
                <!-- Animated background circles -->
                <div class="absolute -top-8 -right-8 w-72 h-72 bg-gradient-to-br from-green-400 to-emerald-400 rounded-full opacity-10 blur-3xl dark:opacity-5"></div>
                <div class="absolute -bottom-8 -left-8 w-72 h-72 bg-gradient-to-tr from-green-400 to-blue-400 rounded-full opacity-10 blur-3xl dark:opacity-5"></div>
                
                <!-- Feature showcase card -->
                <div class="relative z-10 bg-white dark:bg-gray-800 rounded-2xl shadow-2xl dark:shadow-2xl p-8 border border-gray-100 dark:border-gray-700 max-w-md">
                    <div class="space-y-6">
                        <div class="flex items-center gap-4 p-4 bg-green-50 dark:bg-green-900/20 rounded-xl">
                            <div class="flex-shrink-0 w-12 h-12 bg-green-600 rounded-lg flex items-center justify-center">
                                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                                </svg>
                            </div>
                            <div>
                                <p class="font-semibold text-gray-900 dark:text-white">Secure Storage</p>
                                <p class="text-sm text-gray-600 dark:text-gray-400">End-to-end encrypted</p>
                            </div>
                        </div>

                        <div class="flex items-center gap-4 p-4 bg-green-50 dark:bg-green-900/20 rounded-xl">
                            <div class="flex-shrink-0 w-12 h-12 bg-green-600 rounded-lg flex items-center justify-center">
                                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                                </svg>
                            </div>
                            <div>
                                <p class="font-semibold text-gray-900 dark:text-white">Lightning Fast</p>
                                <p class="text-sm text-gray-600 dark:text-gray-400">Optimized performance</p>
                            </div>
                        </div>

                        <div class="flex items-center gap-4 p-4 bg-green-50 dark:bg-green-900/20 rounded-xl">
                            <div class="flex-shrink-0 w-12 h-12 bg-green-600 rounded-lg flex items-center justify-center">
                                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                                </svg>
                            </div>
                            <div>
                                <p class="font-semibold text-gray-900 dark:text-white">Smart Analytics</p>
                                <p class="text-sm text-gray-600 dark:text-gray-400">Detailed insights</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="py-20 bg-gray-50 dark:bg-gray-900/50 transition-colors duration-300">
    <div class="max-w-screen-xl px-4 mx-auto">
        <div class="text-center mb-16">
            <h2 class="text-4xl font-bold text-gray-900 dark:text-white mb-4">Powerful Features</h2>
            <p class="text-xl text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">Everything you need to protect your data</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {% set features = [
                {
                    'title': 'Automated Backups',
                    'description': 'Schedule backups at your preferred times. Never worry about manual backups again.',
                    'icon': '⏰'
                },
                {
                    'title': 'Multi-Destination',
                    'description': 'Backup to cloud, local drives, or network storage. Complete flexibility.',
                    'icon': '🌐'
                },
                {
                    'title': 'Priority-Based Handling',
                    'description': 'Important files get backed up first. Intelligent prioritization system.',
                    'icon': '⭐'
                },
                {
                    'title': 'Real-Time Monitoring',
                    'description': 'Live status updates and instant notifications for all activities.',
                    'icon': '👁️'
                },
                {
                    'title': 'Version Control',
                    'description': 'Keep multiple versions of your files. Restore to any point in time.',
                    'icon': '↩️'
                },
                {
                    'title': 'Advanced Reporting',
                    'description': 'Detailed insights and analytics about your backup activities.',
                    'icon': '📊'
                }
            ] %}
            
            {% for feature in features %}
            <div class="p-8 bg-white dark:bg-gray-800 rounded-2xl border border-gray-100 dark:border-gray-700 shadow-lg hover:shadow-xl dark:hover:shadow-2xl transition-all duration-300 hover:-translate-y-1">
                <div class="text-4xl mb-4">{{ feature.icon }}</div>
                <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">{{ feature.title }}</h3>
                <p class="text-gray-600 dark:text-gray-400">{{ feature.description }}</p>
            </div>
            {% endfor %}
        </div>
    </div>
</section>

<!-- Categories Section -->
{% if categories is defined and categories|length > 0 %}
<section class="py-20">
    <div class="max-w-screen-xl px-4 mx-auto">
        <div class="text-center mb-16">
            <h2 class="text-4xl font-bold text-gray-900 dark:text-white mb-4">Our Products</h2>
            <p class="text-xl text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">Choose the backup solution that fits your needs</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            {% for category in categories %}
            <a href="{{ path('app_catalog', { category: category.id }) }}" class="group block bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-lg dark:shadow-xl border border-gray-100 dark:border-gray-700 hover:shadow-2xl dark:hover:shadow-2xl transition-all duration-300 hover:-translate-y-1">
                <div class="flex items-start justify-between mb-4">
                    <div class="w-12 h-12 rounded-xl bg-green-50 dark:bg-green-900/30 flex items-center justify-center group-hover:bg-green-100 dark:group-hover:bg-green-900/50 transition-colors">
                        <svg class="w-6 h-6 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
                        </svg>
                    </div>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 dark:bg-green-900/40 text-green-700 dark:text-green-400">
                        {{ category.products|length }} items
                    </span>
                </div>
                <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2 group-hover:text-green-600 dark:group-hover:text-green-400 transition-colors">
                    {{ category.name }}
                </h3>
                {% if category.description %}
                <p class="text-sm text-gray-600 dark:text-gray-400 line-clamp-2 mb-4">{{ category.description }}</p>
                {% endif %}
                <div class="flex items-center text-sm font-medium text-green-600 dark:text-green-400 group-hover:translate-x-1 transition-transform">
                    Shop Now
                    <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                </div>
            </a>
            {% endfor %}
        </div>

        <div class="mt-12 text-center">
            <a href="{{ path('app_catalog') }}" class="inline-flex items-center justify-center px-8 py-3 border-2 border-green-600 dark:border-green-400 text-green-600 dark:text-green-400 font-semibold rounded-lg hover:bg-green-50 dark:hover:bg-green-900/20 transition-all duration-200">
                View All Products
                <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
            </a>
        </div>
    </div>
</section>
{% endif %}

<!-- CTA Section -->
<section class="py-20 bg-green-600 dark:bg-green-900/30 transition-colors duration-300">
    <div class="max-w-screen-xl px-4 mx-auto text-center">
        <h2 class="text-4xl font-bold text-white dark:text-white mb-6">Ready to Secure Your Data?</h2>
        <p class="text-xl text-green-50 dark:text-gray-300 max-w-2xl mx-auto mb-8">Join thousands of users who trust EasySave to protect their critical data. Start for free today.</p>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="{{ path('app_register') }}" class="inline-flex items-center justify-center px-8 py-4 bg-white text-green-600 font-bold rounded-lg hover:bg-gray-100 transition-all duration-200 shadow-lg hover:shadow-xl">
                Get Started Free
                <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
            </a>
            <a href="{{ path('app_help') }}" class="inline-flex items-center justify-center px-8 py-4 border-2 border-white text-white font-bold rounded-lg hover:bg-white/10 transition-all duration-200">
                Learn More
            </a>
        </div>
    </div>
</section>
{% endblock %}
