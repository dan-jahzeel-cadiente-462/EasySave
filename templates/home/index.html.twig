{# index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Hello HomeController!
{% endblock %}

{% block body %}
	<section class="transition-colors duration-300">
		<div class="grid max-w-screen-xl px-4 pt-20 pb-8 mx-auto lg:gap-8 xl:gap-0 lg:py-16 lg:grid-cols-12 lg:pt-28">
			<div class="mr-auto place-self-center lg:col-span-7">
				<!-- Badge / EasySave tagline -->
				<div class="glass-badge inline-flex items-center gap-2 mb-6 px-3 py-1 rounded-full">
					<span class="text-xs font-semibold tracking-wide">🚀 EasySave — Trusted Backup Solution</span>
				</div>

				<h1 class="max-w-2xl mb-4 text-4xl font-extrabold leading-none tracking-tight md:text-5xl xl:text-6xl text-black dark:text-white">
					Secure, Smart &amp;<br>Effortless Backups
				</h1>

				<p class="max-w-2xl mb-6 font-light lg:mb-8 md:text-lg lg:text-xl text-gray-700 dark:text-gray-300">
					EasySave provides automated, encrypted, and intelligent backup solutions for businesses and individuals. 
					Seamlessly protect your critical data with real-time monitoring, priority-based file handling, and 
					multi-destination storage — all from a single, intuitive interface.
				</p>

				<div class="space-y-4 sm:flex sm:space-y-0 sm:space-x-4">
					<!-- Primary CTA: filled with green -->
					<a href="#" class="glass-button inline-flex items-center justify-center w-full px-5 py-3 text-sm font-medium text-center rounded-lg sm:w-auto transition-all duration-200 hover:shadow-lg">
						<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path>
						</svg>
						Download EasySave
					</a>

					<!-- Secondary CTA: outlined with green -->
					<a href="#" class="inline-flex items-center justify-center w-full px-5 py-3 text-sm font-medium text-center border rounded-lg sm:w-auto transition-colors hover:bg-gray-100 dark:hover:bg-gray-700 text-gray-900 dark:text-white border-green-500 dark:border-green-400">
						<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
						</svg>
						Watch Demo
					</a>
				</div>

				<!-- Trust indicators / stats row -->
				<div class="mt-8 flex flex-wrap gap-6 text-sm">
					<div class="flex items-center gap-2">
						<svg class="w-4 h-4" style="color: #3bad59;" fill="currentColor" viewbox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
							<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
						</svg>
						<span class="text-black dark:text-white">5000+ happy users</span>
					</div>
					<div class="flex items-center gap-2">
						<svg class="w-4 h-4" style="color: #3bad59;" fill="currentColor" viewbox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
							<path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
						</svg>
						<span class="text-black dark:text-white">AES-256 encryption</span>
					</div>
					<div class="flex items-center gap-2">
						<svg class="w-4 h-4" style="color: #3bad59;" fill="currentColor" viewbox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
							<path d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z"></path>
						</svg>
						<span class="text-black dark:text-white">Real-time monitoring</span>
					</div>
				</div>
			</div>

			<div class="hidden lg:mt-0 lg:col-span-5 lg:flex lg:justify-end">
				<div
					class="relative">
					<!-- Decorative green circle behind image -->
					<div class="absolute -top-6 -right-6 w-64 h-64 rounded-full opacity-20" style="background-color: #3bad59; z-index: -1;"></div>
					<div class="absolute -bottom-6 -left-6 w-48 h-48 rounded-full opacity-10" style="background-color: #3bad59; z-index: -1;"></div>
					<img src="https://demo.themesberg.com/landwind/images/hero.png" alt="EasySave dashboard preview" class="relative z-10 rounded-2xl shadow-xl">
				</div>
			</div>
		</div>
	</section>

	<!-- Categories Grid Section (e-commerce style, no images) -->
	{% if categories is defined and categories|length > 0 %}
	<section class="py-16 bg-gray-50 dark:bg-gray-900">
		<div class="max-w-screen-xl px-4 mx-auto">
			<div class="text-center mb-12">
				<h2 class="text-3xl font-extrabold text-gray-900 dark:text-white mb-4">Browse Categories</h2>
				<p class="text-lg text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">Explore our wide range of products organized by category</p>
			</div>

			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
				{% for category in categories %}
					<a href="{{ path('app_catalog', { category: category.id }) }}"
                       class="group block bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-sm border border-gray-100 dark:border-gray-700 hover:shadow-xl hover:border-green-300 dark:hover:border-green-600 transition-all duration-300 hover:-translate-y-1">
						<div class="flex items-start justify-between mb-4">
							<div class="w-12 h-12 rounded-xl bg-green-50 dark:bg-green-900/30 flex items-center justify-center group-hover:bg-green-100 dark:group-hover:bg-green-900/50 transition-colors">
								<svg class="w-6 h-6 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
								</svg>
							</div>
							<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400">
                                {{ category.products|length }} items
                            </span>
						</div>
						<h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2 group-hover:text-green-600 dark:group-hover:text-green-400 transition-colors">
                            {{ category.name }}
                        </h3>
						{% if category.description %}
							<p class="text-sm text-gray-500 dark:text-gray-400 line-clamp-2">{{ category.description }}</p>
						{% endif %}
						<div class="mt-4 flex items-center text-sm font-medium text-green-600 dark:text-green-400 group-hover:translate-x-1 transition-transform">
							Shop Now
							<svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
							</svg>
						</div>
					</a>
				{% endfor %}
			</div>
		</div>
	</section>
	{% endif %}

	<!-- Additional note: The background remains fully transparent, all text is black except green accent links/badges -->
{% endblock %}
