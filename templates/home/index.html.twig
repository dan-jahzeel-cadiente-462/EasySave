{% extends 'base.html.twig' %}

{% block title %}Hello HomeController!{% endblock %}

{% block body %}
<style>
    .hero-section {
        background-color: #f8f9fa;
        color: #333;
        text-align: center;
        padding: 5rem 2rem;
    }

    .hero-section h1 {
        font-size: 3rem;
        margin-bottom: 0.5rem;
        font-weight: bold;
    }

    .hero-section p {
        font-size: 1.25rem;
        max-width: 600px;
        margin: 0 auto 1.5rem auto;
    }

    .cta-button {
        background-color: #007bff;
        color: white;
        padding: 0.75rem 2rem;
        text-decoration: none;
        border-radius: 50px;
        font-size: 1rem;
        transition: background-color 0.3s ease;
    }

    .cta-button:hover {
        background-color: #0056b3;
    }
</style>

    <div class="hero-section">
        <h1>Explore Our Newest Collection</h1>
        <p>
            Find a wide range of products tailored for your needs.
            From fashion to technology, we have it all.
        </p>
        <a href="#" class="cta-button">Shop All Products</a>
    </div>

{% endblock %}
