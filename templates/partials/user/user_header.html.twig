<!-- User Header Navigation -->
<header class="bg-white border-b border-gray-200 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
            <!-- Logo -->
            <div class="flex items-center">
                <a href="{{ path('app_user_dashboard') }}" class="flex items-center gap-2">
                    <img src="{{ asset('images/logos/EasySave sidebar logo.png') }}" alt="EasySave" class="h-8 w-auto">
                    <span class="text-xl font-bold text-gray-800">EasySave</span>
                </a>
            </div>

            <!-- Navigation Links -->
            <nav class="hidden md:flex items-center gap-8">
                <a href="{{ path('app_user_shop') }}" class="text-gray-700 hover:text-gray-900 transition">Shop</a>
                <a href="{{ path('app_user_cart') }}" class="text-gray-700 hover:text-gray-900 transition">Cart</a>
                <a href="{{ path('app_user_profile') }}" class="text-gray-700 hover:text-gray-900 transition">Profile</a>
            </nav>

            <!-- User Profile & Logout -->
            <div class="flex items-center gap-4">
                {% if app.user %}
                    <span class="text-sm text-gray-700">{{ app.user.username }}</span>
                    <form method="post" action="{{ path('app_logout') }}" class="inline">
                        <button type="submit" class="px-4 py-2 bg-red-600 text-white rounded hover:bg-red-700 transition text-sm">
                            Logout
                        </button>
                    </form>
                {% else %}
                    <a href="{{ path('app_login') }}" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition text-sm">
                        Login
                    </a>
                {% endif %}
            </div>
        </div>
    </div>
</header>
