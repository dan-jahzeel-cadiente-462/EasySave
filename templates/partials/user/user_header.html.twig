{# User Header Navigation #}
<header 
    class="sticky top-0 z-50 w-full bg-white dark:bg-gray-900 border-b border-gray-200 dark:border-gray-800 shadow-sm transition-colors duration-300"
    x-data="{ mobileMenuOpen: false, darkMode: localStorage.getItem('darkMode') === 'true' }"
    x-init="
        $watch('darkMode', val => {
            localStorage.setItem('darkMode', val ? 'true' : 'false');
            const html = document.documentElement;
            if (val) {
                html.classList.add('dark');
            } else {
                html.classList.remove('dark');
            }
        });
        if (darkMode) document.documentElement.classList.add('dark');
    "
>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
            <!-- Logo -->
            <div class="flex items-center">
                <a href="{{ path('app_user_dashboard') }}" class="flex items-center gap-2">
                    <img src="{{ asset('images/logos/EasySave sidebar logo.png') }}" alt="EasySave" class="h-8 w-auto">
                    <span class="text-xl font-bold text-gray-800 dark:text-white">EasySave</span>
                </a>
            </div>

            <!-- Desktop Navigation -->
            <nav class="hidden md:flex items-center gap-6">
                <a href="{{ path('app_user_shop') }}" class="text-sm font-medium text-gray-700 dark:text-gray-300 hover:text-green-600 dark:hover:text-green-400 transition-colors duration-200">Shop</a>
                <a href="{{ path('app_user_cart') }}" class="text-sm font-medium text-gray-700 dark:text-gray-300 hover:text-green-600 dark:hover:text-green-400 transition-colors duration-200">Cart</a>
                <a href="{{ path('app_user_profile') }}" class="text-sm font-medium text-gray-700 dark:text-gray-300 hover:text-green-600 dark:hover:text-green-400 transition-colors duration-200">Profile</a>
            </nav>

            <!-- Desktop: User Profile, Dark Mode & Logout -->
            <div class="hidden md:flex items-center gap-3">
                {% if app.user %}
                    <span class="text-sm text-gray-700 dark:text-gray-300">{{ app.user.username }}</span>
                {% endif %}
                
                <!-- Dark Mode Toggle -->
                <button
                    @click="darkMode = !darkMode"
                    type="button"
                    class="p-2 text-gray-600 dark:text-gray-400 hover:text-green-600 dark:hover:text-green-400 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-lg transition-colors duration-200"
                    aria-label="Toggle dark mode"
                >
                    <svg x-show="!darkMode" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
                    </svg>
                    <svg x-show="darkMode" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" x-cloak>
                        <path d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
                    </svg>
                </button>

                {% if app.user %}
                    <form method="post" action="{{ path('app_logout') }}" class="inline">
                        <button type="submit" class="px-4 py-2 bg-red-600 dark:bg-red-600 text-white text-sm font-medium rounded-lg hover:bg-red-700 dark:hover:bg-red-700 transition-colors duration-200">
                            Logout
                        </button>
                    </form>
                {% else %}
<a href="{{ path('app_user_login') }}" class="px-4 py-2 bg-green-600 dark:bg-green-600 text-white text-sm font-medium rounded-lg hover:bg-green-700 dark:hover:bg-green-700 transition-colors duration-200">
                        Login
                    </a>
                {% endif %}
            </div>

            <!-- Mobile: Menu Toggle & Dark Mode -->
            <div class="flex md:hidden items-center gap-2">
                <button
                    @click="darkMode = !darkMode"
                    type="button"
                    class="p-2 text-gray-600 dark:text-gray-400 hover:text-green-600 dark:hover:text-green-400 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-lg transition-colors duration-200"
                    aria-label="Toggle dark mode"
                >
                    <svg x-show="!darkMode" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
                    </svg>
                    <svg x-show="darkMode" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" x-cloak>
                        <path d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
                    </svg>
                </button>
                <button
                    @click="mobileMenuOpen = !mobileMenuOpen"
                    type="button"
                    class="p-2 text-gray-600 dark:text-gray-400 hover:text-green-600 dark:hover:text-green-400 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-lg transition-colors duration-200"
                    aria-label="Toggle menu"
                >
                    <svg x-show="!mobileMenuOpen" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                    </svg>
                    <svg x-show="mobileMenuOpen" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" x-cloak>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>
        </div>
    </div>

    <!-- Mobile Menu -->
    <div
        x-show="mobileMenuOpen"
        x-cloak
        x-transition:enter="transition ease-out duration-200"
        x-transition:enter-start="opacity-0 scale-95"
        x-transition:enter-end="opacity-100 scale-100"
        x-transition:leave="transition ease-in duration-150"
        x-transition:leave-start="opacity-100 scale-100"
        x-transition:leave-end="opacity-0 scale-95"
        class="md:hidden bg-white dark:bg-gray-900 border-b border-gray-200 dark:border-gray-800"
    >
        <div class="px-4 pt-2 pb-4 space-y-1">
            <a href="{{ path('app_user_shop') }}" class="block px-3 py-2 text-gray-700 dark:text-gray-300 hover:text-green-600 dark:hover:text-green-400 hover:bg-gray-50 dark:hover:bg-gray-800 rounded-lg transition-colors duration-200 text-sm font-medium">
                Shop
            </a>
            <a href="{{ path('app_user_cart') }}" class="block px-3 py-2 text-gray-700 dark:text-gray-300 hover:text-green-600 dark:hover:text-green-400 hover:bg-gray-50 dark:hover:bg-gray-800 rounded-lg transition-colors duration-200 text-sm font-medium">
                Cart
            </a>
            <a href="{{ path('app_user_profile') }}" class="block px-3 py-2 text-gray-700 dark:text-gray-300 hover:text-green-600 dark:hover:text-green-400 hover:bg-gray-50 dark:hover:bg-gray-800 rounded-lg transition-colors duration-200 text-sm font-medium">
                Profile
            </a>

            <!-- Mobile Auth -->
            <div class="border-t border-gray-200 dark:border-gray-800 pt-4 mt-4 space-y-2">
                {% if app.user %}
                    <div class="px-3 py-2 text-sm text-gray-700 dark:text-gray-300">
                        Signed in as <span class="font-medium">{{ app.user.username }}</span>
                    </div>
                    <form method="post" action="{{ path('app_logout') }}">
                        <button type="submit" class="w-full px-3 py-2 text-center text-sm font-medium text-white bg-red-600 rounded-lg hover:bg-red-700 transition-colors duration-200">
                            Logout
                        </button>
                    </form>
                {% else %}
<a href="{{ path('app_user_login') }}" class="block px-3 py-2 text-center text-sm font-medium text-white bg-green-600 dark:bg-green-600 rounded-lg hover:bg-green-700 dark:hover:bg-green-700 transition-colors duration-200">
                        Login
                    </a>
                {% endif %}
            </div>
        </div>
    </div>
</header>

<style>
    [x-cloak] {
        display: none !important;
    }
</style>
