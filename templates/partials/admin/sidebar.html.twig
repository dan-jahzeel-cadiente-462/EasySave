<!-- Sidebar Backdrop (Mobile Only) -->
<div x-show="sidebarOpen && window.innerWidth < 1024"
     @click="sidebarOpen = false"
     class="fixed inset-0 z-20 bg-black bg-opacity-50 transition-opacity duration-300 lg:hidden"
     x-transition.opacity
     x-cloak></div>

<!-- Sidebar -->
<div x-show="sidebarOpen"
     x-transition:enter="transition ease-in-out duration-300"
     x-transition:enter-start="-translate-x-full"
     x-transition:enter-end="translate-x-0"
     x-transition:leave="transition ease-in-out duration-300"
     x-transition:leave-start="translate-x-0"
     x-transition:leave-end="-translate-x-full"
     class="fixed inset-y-0 left-0 z-30 w-64 bg-white border-r transform transition-transform duration-300 ease-in-out 
            lg:translate-x-0 lg:static lg:inset-0 dark:bg-gray-900 dark:border-gray-800"
     x-cloak>

	<!-- Logo -->
	<a href="{{ path('admin') }}" class="block px-4 mt-7">
		<div class="flex items-center justify-center">
			<img src="{{ asset('images/logos/Brand Logo without Text.png') }}" alt="Brand Logo" class="h-16 w-auto">
		</div>
	</a>

