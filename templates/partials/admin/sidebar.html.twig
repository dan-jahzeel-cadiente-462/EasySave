<!-- Sidebar Backdrop (Mobile Only) -->
<div x-show="sidebarOpen && !isDesktop"
	@click="sidebarOpen = false"
     class="fixed inset-0 z-20 bg-white bg-opacity-50 transition-opacity duration-300 lg:hidden"
     x-transition.opacity></div>

<!-- Sidebar -->
<div id="admin-sidebar" 
     :class="{
         'translate-x-0': sidebarOpen || isDesktop,
         '-translate-x-full': !sidebarOpen && !isDesktop,
         'lg:static lg:translate-x-0': isDesktop,
         'fixed': !isDesktop
     }"
     class="inset-y-0 left-0 z-30 w-80 bg-white border-r border-gray-200 transform transition-transform duration-300 ease-in-out h-screen overflow-y-auto flex flex-col"
     x-cloak>

	<!-- Logo -->
	<a href="{{ path('app_admin_dashboard') }}" class="block px-4 mt-6">
		<div class="flex items-center justify-center">
			<img src="{{ asset('images/logos/EasySave sidebar logo.png') }}" alt="Brand Logo" class="h-7 w-auto">
		</div>
	</a>

	<!-- Navigation -->
	<nav class="flex-1 overflow-y-auto"
		 @click="if (!isDesktop && $event.target.closest('a')) sidebarOpen = false">

		<!-- Dashboard -->
		<h3 class="text-xs font-semibold text-gray-600 uppercase tracking-wider mt-4 mb-2 ml-4">Dashboard</h3>
		<ul class="space-y-1">
			<li class="p-2 text-sm ml-2 mr-2 rounded {{ app.request.get('_route') == 'app_admin_dashboard' ? 'bg-gray-200 text-gray-900 font-bold border-l-4 border-blue-500' : 'text-gray-700 hover:bg-gray-100 hover:text-gray-900' }}">
				<a href="{{ path('app_admin_dashboard') }}" class="flex items-center gap-3">
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
						stroke-width="1.5" stroke="currentColor" class="size-5" width="16" height="16">
						<path stroke-linecap="round" stroke-linejoin="round"
							d="M10.5 6a7.5 7.5 0 1 0 7.5 7.5h-7.5V6Z" />
						<path stroke-linecap="round" stroke-linejoin="round"
							d="M13.5 10.5H21A7.5 7.5 0 0 0 13.5 3v7.5Z" />
					</svg>
					Dashboard
				</a>
			</li>
			<li class="p-2 text-sm ml-2 mr-2 rounded {{ app.request.get('_route') == 'app_admin_account_profile' ? 'bg-gray-200 text-gray-900 font-bold border-l-4 border-blue-500' : 'text-gray-700 hover:bg-gray-100 hover:text-gray-900' }}">
