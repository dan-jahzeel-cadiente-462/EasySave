{% extends 'admin/index.html.twig' %}

{% block title %}Products{% endblock %}

{% block body %}
<div class="container mx-auto px-4 sm:px-6 lg:px-8 py-8" x-data="{ view: 'list', open:false, id:null, name:'', stock:0, price:'', token:'', action:'' , openModal(el){ this.id = el.dataset.id; this.name = el.dataset.name; this.stock = el.dataset.stock; this.price = el.dataset.price; this.token = el.dataset.token; this.action = el.dataset.action; this.open = true; }, closeModal(){ this.open = false; }, submitForm(e){ const add = Number(e.target.add_quantity.value || 0); const rem = Number(e.target.remove_quantity.value || 0); if (add < 0 || rem < 0){ alert('Quantities must be >= 0'); e.preventDefault(); return false;} return true; } }">
    <!-- Title -->
    <h1 class="text-2xl font-bold mb-6 text-gray-800">Products</h1>

    <!-- Header Controls -->
    <div class="flex flex-col sm:flex-row justify-between items-stretch sm:items-center gap-4 mb-6">
        <div class="flex flex-wrap gap-3">
            <!-- Create Button -->
            <a href="{{ path('app_product_new') }}"
               class="flex items-center justify-center gap-2 px-4 py-2 bg-green-600 text-white font-medium rounded-md shadow 
                      hover:bg-green-700 focus:ring-2 focus:ring-green-400 transition w-full sm:w-auto">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
                Create New
            </a>

            <!-- Data Backup Dropdown -->
            <div x-data="{ open: false }" @click.away="open = false" class="relative">
                <button @click="open = !open" class="flex items-center justify-center gap-2 px-4 py-2 bg-gray-600 text-white font-medium rounded-md shadow hover:bg-gray-700 focus:ring-2 focus:ring-gray-400 transition w-full sm:w-auto">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
                    </svg>
                    <span>Data Backup</span>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 transition-transform" :class="{'rotate-180': open}">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                    </svg>
                </button>

                <div x-show="open"
                     x-transition:enter="transition ease-out duration-100"
                     x-transition:enter-start="transform opacity-0 scale-95"
                     x-transition:enter-end="transform opacity-100 scale-100"
                     x-transition:leave="transition ease-in duration-75"
                     x-transition:leave-start="transform opacity-100 scale-100"
                     x-transition:leave-end="transform opacity-0 scale-95"
                     class="absolute left-0 sm:right-0 sm:left-auto mt-2 w-48 origin-top-right bg-white rounded-md shadow-lg z-20 ring-1 ring-black ring-opacity-5 focus:outline-none"
                     style="display: none;">
                    <div class="py-1">
                        {# In a real application, these would point to actual export routes #}
                        <a href="#" class="flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
                            Export as CSV
                        </a>
                        <a href="#" class="flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
                            Export as JSON
                        </a>
                        <a href="#" class="flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
                            Export as PDF
                        </a>
                    </div>
                </div>
            </div>

            <!-- View Toggles -->
            <div class="flex items-center border border-gray-300 rounded-md">
                <button @click="view = 'list'" :class="{ 'bg-gray-200 text-gray-800': view === 'list', 'text-gray-500 hover:bg-gray-100': view !== 'list' }" class="p-2 rounded-l-md transition">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h7.5M8.25 12h7.5m-7.5 5.25h7.5M3.75 6.75h.007v.008H3.75V6.75zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zM3.75 12h.007v.008H3.75V12zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm-.375 5.25h.007v.008H3.75v-.008zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
                    </svg>
                    <span class="sr-only">List view</span>
                </button>
                <button @click="view = 'grid'" :class="{ 'bg-gray-200 text-gray-800': view === 'grid', 'text-gray-500 hover:bg-gray-100': view !== 'grid' }" class="p-2 rounded-r-md border-l border-gray-300 transition">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 8.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 018.25 20.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" />
                    </svg>
                    <span class="sr-only">Grid view</span>
                </button>
            </div>
        </div>

        <!-- Filter & Search Form -->
        <form method="get"
              action="{{ path('app_product_index') }}"
              class="flex flex-wrap gap-3 items-center justify-start sm:justify-end">

            <div class="relative flex items-center">
                <input type="text"
                    name="q"
                    value="{{ q|default('') }}"
                    placeholder="Search products..."
                    class="flex-1 sm:flex-none min-w-[180px] w-full 
                            pl-10 pr-3 py-2 border border-gray-300 rounded-md 
                            focus:outline-none focus:ring-2 focus:ring-blue-400 text-sm">
                
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" 
                    class="size-5 absolute left-3 text-gray-400 pointer-events-none">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                </svg>
            </div>

            <!-- Category Dropdown -->
            <select name="category"
                    class="min-w-[140px] px-3 py-2 border border-gray-300 rounded-md text-sm 
                           focus:outline-none focus:ring-2 focus:ring-blue-400">
                <option value="">All Categories</option>
                {% for cat in categories is defined ? product.categories : [] %}
                    <option value="{{ cat.id }}"
                            {% if selectedCategory is defined and selectedCategory == cat.id %}selected{% endif %}>
                        {{ cat.name }}
                    </option>
                {% endfor %}
            </select>

            <!-- Sort Dropdown -->
            <select name="sort"
                    class="min-w-[130px] px-3 py-2 border border-gray-300 rounded-md text-sm 
                           focus:outline-none focus:ring-2 focus:ring-blue-400">
                <option value="">Sort</option>
                <option value="price_asc" {% if sort == 'price_asc' %}selected{% endif %}>Price: Low → High</option>
                <option value="price_desc" {% if sort == 'price_desc' %}selected{% endif %}>Price: High → Low</option>
                <option value="name" {% if sort == 'name' %}selected{% endif %}>Name</option>
            </select>

            <!-- Filter Button -->
            <button type="submit"
                    class="px-4 py-2 bg-green-600 text-white rounded-md shadow hover:bg-green-700">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 1 1-3 0m3 0a1.5 1.5 0 1 0-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-9.75 0h9.75" />
                </svg>
            </button>
        </form>
    </div>

    <!-- List View (Table) -->
    <div x-show="view === 'list'" class="overflow-x-auto bg-white shadow rounded-lg border border-gray-200">
        <table class="min-w-full text-left text-gray-700">
            <tbody>
            {% for product in products %}
                <tr class="border-b hover:bg-gray-50 transition">
                    {# <td class="px-4 py-3 whitespace-nowrap">{{ product.id }}</td> #}

                    <!-- Product Image -->
                    <td class="px-8 py-3">
                        {% set img = product.imagePath ?: '/images/default-product.png' %}
                        <div class="w-14 h-14 bg-gray-100 border rounded overflow-hidden flex items-center justify-center">
                            <img src="{{ asset(img) }}" alt="{{ product.name }}" class="w-full h-full object-cover">
                        </div>
                    </td>

                    <!-- Product Info -->
                    <td class="py-3">
                        <!-- Product Name -->
                        <h1 class="text-base font-semibold text-gray-800">{{ product.name }}</h1>
                        <p class="text-sm text-green-600 font-semibold mt-1">PHP{{ product.price|number_format(2) }}</p>

                        
                        <!-- Category Badge -->
                        <div class="mt-2 text-xs text-gray-600 flex items-center flex-wrap">
                            {% set breadcrumbs = [] %}
                            {% set current_category = product.category %}
                            {% for i in 1..10 %} {# Limit to 10 levels to prevent infinite loops #}
                                {% if current_category %}
                                    {% set breadcrumbs = [current_category] | merge(breadcrumbs) %}
                                    {% set current_category = current_category.parent %}
                                {% endif %}
                            {% endfor %}

                            {% for category in breadcrumbs %}
                                <a href="{{ path('app_category_show', {'id': category.id}) }}" class="text-blue-600 hover:underline">{{ category.name }}</a>
                                {% if not loop.last %}<span class="mx-1 text-gray-400">/</span>{% endif %}
                            {% endfor %}
                        </div>

                        <!-- Brand -->
                        <p class="text-sm text-gray-600 mt-1">
                            Brand: <span class="font-medium text-gray-800">{{ product.brand }}</span>
                        </p>

                        <!-- Description -->
                        <p class="text-sm text-gray-500 mt-1 truncate">
                            {{ product.description|u.truncate(50, '...') }}
                        </p>
                    </td>

                    {# Stock Management Cell #}
                    <td class="px-4 py-3 text-center">
                        <div class="flex items-center justify-center gap-1">
                            
                            {#
                            <!-- Decrease Stock Button (Form) -->
                            <form method="post" action="{{ path('app_product_decrease_stock', {'id': product.id}) }}" class="inline-block m-0"
                                onsubmit="return confirm('Are you sure you want to decrease the stock for {{ product.name }}?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('stock_decrease' ~ product.id) }}">
                                <button type="submit" title="Decrease Stock"
                                        class="p-1 w-6 h-6 flex items-center justify-center text-xs font-bold rounded bg-red-500 text-white hover:bg-red-600 disabled:opacity-50 transition"
                                        {{ product.stock <= 0 ? 'disabled' : '' }}>
                                    -
                                </button>
                            </form>
                            #}

                            {# Current Stock Value #}
                            <span class="px-2 py-1 font-semibold text-sm rounded {{ product.stock <= 5 ? 'text-red-700 bg-red-100' : 'text-gray-800' }}">
                                {{ product.stock }} in Stock
                            </span>

                            {#
                            <-- Increase Stock Button (Form) -->
                            <form method="post" action="{{ path('app_product_increase_stock', {'id': product.id}) }}" class="inline-block m-0"
                                onsubmit="return confirm('Are you sure you want to increase the stock for {{ product.name }}?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('stock_increase' ~ product.id) }}">
                                <button type="submit" title="Increase Stock"
                                        class="p-1 w-6 h-6 flex items-center justify-center text-xs font-bold rounded bg-green-500 text-white hover:bg-green-600 transition">
                                    +
                                </button>
                            </form>
                            #}

                        </div>
                    </td>

                    <!-- Actions -->
                    <td class="px-4 py-3 text-center">
                        <div class="flex justify-center gap-2 flex-wrap">
                            <a href="{{ path('app_product_show', {'id': product.id}) }}"
                               class="text-indigo-600 hover:text-indigo-900"
                               title="Show">
                               <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                                </svg>
                                <span class="sr-only">Show</span>
                            </a>
                            <a href="{{ path('app_product_edit', {'id': product.id}) }}"
                               class="text-yellow-600 hover:text-yellow-900"
                               title="Show">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
                                </svg>
                                <span class="sr-only">Edit</span>
                            </a>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="11" class="px-4 py-6 text-center text-gray-500">No products found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <!-- Grid View -->
    <div x-show="view === 'grid'" style="display: none;">
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            {% for product in products %}
                <div class="bg-white rounded-lg shadow border border-gray-200 overflow-hidden flex flex-col">
                    {% set img = product.imagePath ?: '/images/default-product.png' %}
                    <div class="h-40 bg-gray-100">
                        <img src="{{ asset(img) }}" alt="{{ product.name }}" class="w-full h-full object-cover">
                    </div>
                    <div class="p-4 flex flex-col flex-1">
                        <h3 class="font-semibold text-gray-800 truncate">{{ product.name }}</h3>
                        <p class="text-sm text-gray-500">{{ product.brand }}</p>
                        <div class="mt-2 flex-1 text-xs text-gray-600 flex items-center flex-wrap">
                            {% set breadcrumbs = [] %}
                            {% set current_category = product.category %}
                            {% for i in 1..10 %} {# Limit to 10 levels to prevent infinite loops #}
                                {% if current_category %}
                                    {% set breadcrumbs = [current_category] | merge(breadcrumbs) %}
                                    {% set current_category = current_category.parent %}
                                {% endif %}
                            {% endfor %}

                            {% for category in breadcrumbs %}
                                <a href="{{ path('app_category_show', {'id': category.id}) }}" class="text-blue-600 hover:underline">{{ category.name }}</a>
                                {% if not loop.last %}<span class="mx-1 text-gray-400">/</span>{% endif %}
                            {% endfor %}
                        </div>
                        <div class="mt-3 flex justify-between items-center">
                            <p class="text-base font-bold text-green-600">PHP{{ product.price|number_format(2) }}</p>
                            <span class="text-sm font-medium rounded-full px-2 py-1 {{ product.stock <= 5 ? 'text-red-700 bg-red-100' : 'text-gray-600 bg-gray-100' }}">
                                {{ product.stock }} left
                            </span>
                        </div>
                    </div>
                    <div class="p-3 bg-gray-50 border-t border-gray-200 flex justify-end gap-3">
                        <a href="{{ path('app_product_show', {'id': product.id}) }}" class="text-gray-500 hover:text-indigo-600 transition" title="Show">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                            </svg>
                        </a>
                        <a href="{{ path('app_product_edit', {'id': product.id}) }}" class="text-gray-500 hover:text-yellow-600 transition" title="Edit">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z" />
                            </svg>
                        </a>
                    </div>
                </div>
            {% else %}
                <div class="sm:col-span-2 md:col-span-3 lg:col-span-4 text-center py-10 text-gray-500">
                    No products found.
                </div>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
