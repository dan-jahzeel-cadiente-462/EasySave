{% extends 'admin/index.html.twig' %}

{% block title %}Edit Product{% endblock %}

{% block body %}
<div class="container mx-auto px-6 py-8">
    <h1 class="text-3xl font-bold mb-6 text-gray-800">Edit Product</h1>

    <div class="bg-white shadow-md rounded-lg p-6 space-y-4">
        {{ include('product/_form.html.twig', {'button_label': 'Update'}) }}

        {# Product Images Section #}
        <div class="pt-6 border-t border-gray-200">
            <h2 class="text-xl font-semibold text-gray-700 mb-4">Product Images</h2>

            {# Display Existing Images #}
            {% set images = product.productImages|default([]) %}
            {% if images is not empty %}
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4 mb-6">
                    {# Inside the loop for existing images #}
            {% for image in images %}
                <div class="relative group border rounded-lg overflow-hidden">
                    <img src="{{ asset(image.imagePath) }}" alt="Product image {{ loop.index }}" class="w-full h-32 object-cover">
                    <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-50 transition-all flex items-center justify-center">
                        {# Form to delete an image: THIS IS THE FIX #}
                        <form method="post" action="{{ path('app_product_image_delete', {'id': product.id, 'imageId': image.id}) }}"
                            onsubmit="return confirm('Are you sure you want to delete this image?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ image.id) }}">
                            <button type="submit"
                                    class="text-white opacity-0 group-hover:opacity-100 hover:text-red-400 p-2 rounded-full transition-opacity">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.938a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.54 48.54 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m-2.26 0 1.232-5.182c.168-.684.755-1.154 1.432-1.154h1.758c.708 0 1.305.474 1.472 1.18l.8 3.5m-3.957 0h7.125m-7.125 0V7.5M12 9.75v6.75"/>
                                </svg>
                            </button>
                        </form>
                    </div>
                </div>
            {% endfor %}
                </div>
            {% else %}
                <p class="text-gray-500 mb-6">No images have been uploaded for this product yet.</p>
            {% endif %}

            {# Form to Add New Images #}
            <h3 class="text-lg font-medium text-gray-700 mb-2">Add New Images</h3>
            <form method="post" action="{{ path('app_product_image_add', {'id': product.id}) }}" enctype="multipart/form-data">
                <input type="hidden" name="_token" value="{{ csrf_token('add_image' ~ product.id) }}">
                <div class="flex items-center gap-4">
                    <input type="file" name="images[]" multiple required
                           class="block w-full text-sm text-gray-500
                                  file:mr-4 file:py-2 file:px-4
                                  file:rounded-md file:border-0
                                  file:text-sm file:font-semibold
                                  file:bg-blue-50 file:text-blue-700
                                  hover:file:bg-blue-100">
                    <button type="submit" class="px-4 py-2 bg-blue-600 text-white font-medium rounded-md shadow hover:bg-blue-700 focus:ring-2 focus:ring-blue-400 transition">Upload</button>
                </div>
            </form>
        </div>

        <div class="flex justify-between items-center mt-4">
            <a href="{{ path('app_product_index') }}"
               class="text-blue-600 hover:underline">
               ← Back to list
            </a>

            {{ include('product/_delete_form.html.twig') }}
        </div>
    </div>
</div>
{% endblock %}
