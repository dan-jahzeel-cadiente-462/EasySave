{% extends 'base.html.twig' %}

{% block title %}Product Catalog{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50">
    <!-- Breadcrumb -->
    <div class="bg-white border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
            <div class="flex items-center space-x-2 text-sm">
                <a href="{{ path('app_home') }}" class="text-blue-600 hover:text-blue-800">Home</a>
                <span class="text-gray-400">/</span>
                <span class="text-gray-600">Catalog</span>
            </div>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Page Header -->
        <div class="mb-8">
            <h1 class="text-4xl font-bold text-gray-900 mb-2">Product Catalog</h1>
            <p class="text-gray-600">Browse our complete selection of products</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
            <!-- Sidebar Filters -->
            <aside class="lg:col-span-1">
                <div class="bg-white rounded-lg shadow-sm p-6 sticky top-24">
                    <h2 class="text-lg font-semibold text-gray-900 mb-6">Filters</h2>

                    <!-- Search -->
                    <form method="GET" class="mb-6">
                        <label class="block text-sm font-medium text-gray-700 mb-2">Search</label>
                        <input 
                            type="text" 
                            name="q" 
                            value="{{ search }}" 
                            placeholder="Search products..."
                            class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"
                        >
                        <button type="submit" class="w-full mt-2 bg-green-600 text-white py-2 rounded-lg hover:bg-green-700 transition text-sm font-medium">
                            Search
                        </button>
                    </form>

                    <!-- Category Filter -->
                    <div class="mb-6">
                        <h3 class="text-sm font-semibold text-gray-900 mb-3">Categories</h3>
                        <div class="space-y-2">
                            <div>
                                <label class="flex items-center">
                                    <input 
                                        type="radio" 
                                        name="category" 
                                        value="" 
                                        {% if categoryId == 0 %}checked{% endif %}
                                        class="form-radio text-green-600"
                                        onchange="this.form.submit()"
                                    >
                                    <span class="ml-2 text-sm text-gray-700">All Categories</span>
                                </label>
                            </div>
                            {% for category in categories %}
                                <div>
                                    <label class="flex items-center">
                                        <input 
                                            type="radio" 
                                            name="category" 
                                            value="{{ category.id }}"
                                            {% if categoryId == category.id %}checked{% endif %}
                                            class="form-radio text-green-600"
                                            onchange="this.form.submit()"
                                        >
                                        <span class="ml-2 text-sm text-gray-700">{{ category.name }}</span>
                                    </label>
                                </div>
                                {% if category.children|length > 0 %}
                                    {% for subcategory in category.children %}
                                        <div class="ml-4">
                                            <label class="flex items-center">
                                                <input 
                                                    type="radio" 
                                                    name="category" 
                                                    value="{{ subcategory.id }}"
                                                    {% if categoryId == subcategory.id %}checked{% endif %}
                                                    class="form-radio text-green-600"
                                                    onchange="this.form.submit()"
                                                >
                                                <span class="ml-2 text-sm text-gray-700">{{ subcategory.name }}</span>
                                            </label>
                                        </div>
                                    {% endfor %}
                                {% endif %}
                            {% endfor %}
                        </div>
                    </div>

                    <!-- Sort -->
                    <div>
                        <h3 class="text-sm font-semibold text-gray-900 mb-3">Sort By</h3>
                        <select name="sort" onchange="window.location.href='{{ path('app_catalog') }}' + '?sort=' + this.value{% if search %}&q={{ search }}{% endif %}{% if categoryId %}&category={{ categoryId }}{% endif %}';" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500 text-sm">
                            <option value="newest" {% if sort == 'newest' %}selected{% endif %}>Newest</option>
                            <option value="price_low" {% if sort == 'price_low' %}selected{% endif %}>Price: Low to High</option>
                            <option value="price_high" {% if sort == 'price_high' %}selected{% endif %}>Price: High to Low</option>
                            <option value="popular" {% if sort == 'popular' %}selected{% endif %}>Most Popular</option>
                        </select>
                    </div>
                </div>
            </aside>

            <!-- Products Grid -->
            <main class="lg:col-span-3">
                {% if products|length > 0 %}
                    <!-- Results Info -->
                    <div class="mb-6 flex items-center justify-between">
                        <p class="text-gray-600">
                            Showing <strong>{{ products|length }}</strong> of <strong>{{ total }}</strong> products
                            {% if search %} for &quot;<strong>{{ search }}</strong>&quot;{% endif %}
                        </p>
                    </div>

                    <!-- Products Grid -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                        {% for product in products %}
                            {% set activeDiscount = product.discounts|filter(d => d.isActive)|first %}
                            <div class="bg-white rounded-lg shadow-sm hover:shadow-lg transition-shadow duration-300 overflow-hidden flex flex-col">
                                <!-- Image -->
                                <div class="relative overflow-hidden bg-gray-100 aspect-square">
                                    {% if product.imagePath %}
                                        <img 
                                            src="{{ asset(product.imagePath) }}" 
                                            alt="{{ product.name }}" 
                                            class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                                        >
                                    {% else %}
                                        <div class="w-full h-full flex items-center justify-center text-gray-400">
                                            No Image
                                        </div>
                                    {% endif %}

                                    <!-- Discount Badge -->
                                    {% if activeDiscount %}
                                        <div class="absolute top-2 right-2 bg-red-500 text-white px-2 py-1 rounded text-xs font-semibold">
                                            {% if activeDiscount.type == 'percentage' %}
                                                -{{ activeDiscount.value }}%
                                            {% else %}
                                                -PHP {{ activeDiscount.value }}
                                            {% endif %}
                                        </div>
                                    {% endif %}

                                    <!-- Stock Status -->
                                    {% if product.stock == 0 %}
                                        <div class="absolute inset-0 bg-black/40 flex items-center justify-center">
                                            <span class="text-white font-bold text-lg">Out of Stock</span>
                                        </div>
                                    {% endif %}
                                </div>

                                <!-- Content -->
                                <div class="p-4 flex-1 flex flex-col">
                                    <!-- Brand -->
                                    <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">{{ product.brand }}</p>

                                    <!-- Name -->
                                    <h3 class="text-lg font-semibold text-gray-900 mb-2 line-clamp-2">
                                        <a href="{{ path('app_product_show', {'id': product.id}) }}" class="hover:text-green-600 transition">
                                            {{ product.name }}
                                        </a>
                                    </h3>

                                    <!-- Description -->
                                    <p class="text-sm text-gray-600 mb-4 line-clamp-2">{{ product.description }}</p>

                                    <!-- Stock Info -->
                                    <div class="mb-4">
                                        <div class="flex items-center justify-between mb-1">
                                            <span class="text-xs text-gray-600">Stock Available</span>
                                            <span class="text-xs font-semibold text-gray-900">{{ product.stock }} units</span>
                                        </div>
                                        <div class="w-full bg-gray-200 rounded-full h-2">
                                            <div 
                                                class="bg-green-600 h-2 rounded-full transition-all"
                                                style="width: {{ min(100, (product.stock / 100) * 100) }}%"
                                            ></div>
                                        </div>
                                    </div>

                                    <!-- Price -->
                                    <div class="mt-auto">
                                        <div class="flex items-center gap-2 mb-3">
                                            {% if activeDiscount %}
                                                {% set discountedPrice = product.price %}
                                                {% if activeDiscount.type == 'percentage' %}
                                                    {% set discountedPrice = product.price * (1 - (activeDiscount.value / 100)) %}
                                                {% else %}
                                                    {% set discountedPrice = product.price - activeDiscount.value %}
                                                {% endif %}
                                                <span class="text-2xl font-bold text-green-600">PHP {{ discountedPrice|number_format(2) }}</span>
                                                <span class="text-sm line-through text-gray-500">PHP {{ product.price|number_format(2) }}</span>
                                            {% else %}
                                                <span class="text-2xl font-bold text-gray-900">PHP {{ product.price|number_format(2) }}</span>
                                            {% endif %}
                                        </div>

                                        <!-- Actions -->
                                        <div class="flex gap-2">
                                            <a 
                                                href="{{ path('app_product_show', {'id': product.id}) }}" 
                                                class="flex-1 bg-green-600 text-white py-2 rounded-lg hover:bg-green-700 transition text-center font-medium text-sm"
                                            >
                                                View Details
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>

                    <!-- Pagination -->
                    {% if pages > 1 %}
                        <div class="mt-12 flex justify-center items-center gap-2">
                            {% if page > 1 %}
                                <a href="{{ path('app_catalog', { page: page - 1, q: search, category: categoryId, sort: sort }) }}" class="px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-100 transition">
                                    Previous
                                </a>
                            {% endif %}

                            {% for i in 1..pages %}
                                {% if i == page %}
                                    <span class="px-4 py-2 bg-green-600 text-white rounded-lg">{{ i }}</span>
                                {% else %}
                                    <a href="{{ path('app_catalog', { page: i, q: search, category: categoryId, sort: sort }) }}" class="px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-100 transition">
                                        {{ i }}
                                    </a>
                                {% endif %}
                            {% endfor %}

                            {% if page < pages %}
                                <a href="{{ path('app_catalog', { page: page + 1, q: search, category: categoryId, sort: sort }) }}" class="px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-100 transition">
                                    Next
                                </a>
                            {% endif %}
                        </div>
                    {% endif %}
                {% else %}
                    <!-- Empty State -->
                    <div class="bg-white rounded-lg shadow-sm p-12 text-center">
                        <svg class="w-12 h-12 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z" />
                        </svg>
                        <h3 class="text-lg font-semibold text-gray-900 mb-2">No products found</h3>
                        <p class="text-gray-600 mb-4">
                            {% if search %}
                                No products match your search for &quot;<strong>{{ search }}</strong>&quot;. Try different keywords.
                            {% else %}
                                No products available in this category.
                            {% endif %}
                        </p>
                        <a href="{{ path('app_catalog') }}" class="inline-block bg-green-600 text-white px-6 py-2 rounded-lg hover:bg-green-700 transition font-medium">
                            View All Products
                        </a>
                    </div>
                {% endif %}
            </main>
        </div>
    </div>
</div>
{% endblock %}
