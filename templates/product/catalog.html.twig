{% extends 'base.html.twig' %}

{% block title %}Product Catalog{% endblock %}

{% block body %}
<div class="min-h-screen bg-transparent transition-colors duration-300">
    <!-- Hero Section with Dark Mode Support -->
    <div class="relative bg-gradient-to-r from-green-600/80 to-green-700/80 dark:from-green-800/80 dark:to-green-900/80 backdrop-blur-md text-white py-12 sm:py-16 border-b border-green-500/20">
        <div class="absolute inset-0 bg-black opacity-20 dark:opacity-40"></div>
        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold mb-3 sm:mb-4 animate-fade-in">Product Catalog</h1>
            <p class="text-sm sm:text-base md:text-lg lg:text-2xl text-green-100 max-w-3xl mx-auto animate-slide-up px-2">
                Discover our carefully curated collection of premium products
            </p>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
        <!-- Enhanced Filters Bar with Dark Mode -->
        <div class="bg-white/70 dark:bg-gray-800/50 backdrop-blur-md dark:backdrop-blur-md rounded-2xl shadow-xl dark:shadow-2xl mb-6 sm:mb-8 p-4 sm:p-6 transition-colors duration-300 border border-white/20 dark:border-gray-700/30">
            <form method="GET" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4 items-end" id="filterForm">
                <!-- Search Input -->
                <div class="sm:col-span-1">
                    <label class="block text-xs sm:text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1 sm:mb-2">Search Products</label>
                    <div class="relative">
                        <svg class="absolute left-3 top-1/2 transform -translate-y-1/2 w-5 h-5 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                        <input 
                            type="text" 
                            name="q" 
                            id="searchInput"
                            value="{{ search }}" 
                            placeholder="Search by name, brand, or description..."
                            class="w-full pl-10 pr-4 py-3 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-xl focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent transition"
                            autocomplete="off"
                        >
                        <!-- Clear search button -->
                        {% if search %}
                            <button type="button" onclick="clearSearch()" class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400 hover:text-gray-600 dark:hover:text-gray-300">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                                </svg>
                            </button>
                        {% endif %}
                    </div>
                </div>

                <!-- Category Select -->
                <div>
                    <label class="block text-xs sm:text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1 sm:mb-2">Category</label>
                    <select name="category" id="categorySelect" onchange="this.form.submit()" class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-xl focus:outline-none focus:ring-2 focus:ring-green-500 bg-white dark:bg-gray-800 transition">
                        <option value="">All Categories</option>
                        {% for category in categories %}
                            <option value="{{ category.id }}" {% if categoryId == category.id %}selected{% endif %}>{{ category.name }}</option>
                            {% if category.children|length > 0 %}
                                {% for subcategory in category.children %}
                                    <option value="{{ subcategory.id }}" {% if categoryId == subcategory.id %}selected{% endif %}>-- {{ subcategory.name }}</option>
                                {% endfor %}
                            {% endif %}
                        {% endfor %}
                    </select>
                </div>

                <!-- Sort Select -->
                <div>
                    <label class="block text-xs sm:text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1 sm:mb-2">Sort By</label>
                    <select name="sort" id="sortSelect" onchange="this.form.submit()" class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white rounded-xl focus:outline-none focus:ring-2 focus:ring-green-500 bg-white dark:bg-gray-800 transition">
                        <option value="newest" {% if sort == 'newest' %}selected{% endif %}>✨ Newest First</option>
                        <option value="price_low" {% if sort == 'price_low' %}selected{% endif %}>💰 Price: Low to High</option>
                        <option value="price_high" {% if sort == 'price_high' %}selected{% endif %}>💰 Price: High to Low</option>
                        <option value="popular" {% if sort == 'popular' %}selected{% endif %}>⭐ Most Popular</option>
                    </select>
                </div>

                <!-- Hidden submit button for accessibility -->
                <button type="submit" class="hidden">Apply Filters</button>
            </form>

            <!-- Active Filters Display with Dark Mode -->
            {% if search or categoryId %}
                <div class="mt-4 pt-4 border-t border-gray-200 dark:border-gray-700 flex flex-wrap gap-2 items-center">
                    <span class="text-sm text-gray-600 dark:text-gray-400">Active filters:</span>
                    {% if search %}
                        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400">
                            Search: "{{ search }}"
                            <a href="{{ path('app_catalog', { category: categoryId, sort: sort }) }}" class="ml-2 hover:text-green-900 dark:hover:text-green-300">&times;</a>
                        </span>
                    {% endif %}
                    {% if categoryId %}
                        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400">
                            Category filter applied
                            <a href="{{ path('app_catalog', { q: search, sort: sort }) }}" class="ml-2 hover:text-green-900 dark:hover:text-green-300">&times;</a>
                        </span>
                    {% endif %}
                    <a href="{{ path('app_catalog') }}" class="text-sm text-green-600 dark:text-green-400 hover:text-green-700 dark:hover:text-green-300 font-medium">Clear all</a>
                </div>
            {% endif %}
        </div>

        <!-- Results Stats -->
        <div class="mb-6 sm:mb-8 flex flex-col sm:flex-row flex-wrap items-start sm:items-center justify-between gap-3 sm:gap-4">
            <div class="flex items-center space-x-2 w-full sm:w-auto">
                <div class="w-1 h-8 bg-green-600 dark:bg-green-500 rounded-full"></div>
                <div>
                    <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-400">
                        Showing <span class="font-semibold text-gray-900 dark:text-white">{{ products|length }}</span> of 
                        <span class="font-semibold text-gray-900 dark:text-white">{{ total }}</span> products
                        {% if search %} for "<span class="font-semibold text-gray-900 dark:text-white">{{ search }}</span>"{% endif %}
                    </p>
                </div>
            </div>
            
            <!-- View Toggle -->
            <div class="flex items-center gap-2 ml-0 sm:ml-auto">
                <span class="text-xs sm:text-sm text-gray-500 dark:text-gray-400">View:</span>
                <button onclick="toggleView('grid')" class="view-btn p-2 rounded-lg bg-green-600 dark:bg-green-500 text-white transition" data-view="grid">
                    <svg class="w-4 sm:w-5 h-4 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
                    </svg>
                </button>
                <button onclick="toggleView('list')" class="view-btn p-2 rounded-lg bg-gray-200 dark:bg-gray-700 text-gray-600 dark:text-gray-400 transition" data-view="list">
                    <svg class="w-4 sm:w-5 h-4 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
                    </svg>
                </button>
            </div>
        </div>

        {% if products|length > 0 %}
            <!-- Products Grid/List Container -->
            <div id="products-container" class="transition-all duration-300">
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 lg:gap-8" id="products-grid">
                    {% for product in products %}
                        {% set activeDiscount = product.discounts|filter(d => d.isActive)|first %}
                        <div class="product-card group bg-white/70 dark:bg-gray-800/70 backdrop-blur-sm rounded-2xl shadow-lg dark:shadow-xl hover:shadow-2xl dark:hover:shadow-2xl transition-all duration-300 overflow-hidden transform hover:-translate-y-2 border border-white/20 dark:border-gray-700/30">
                            <!-- Image Container -->
                            <div class="relative overflow-hidden bg-gradient-to-br from-gray-100 to-gray-200 dark:from-gray-700 dark:to-gray-800 aspect-square">
                                {% if product.imagePath %}
                                    <img 
                                        src="{{ asset(product.imagePath) }}" 
                                        alt="{{ product.name }}" 
                                        class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                                        loading="lazy"
                                    >
                                {% else %}
                                    <div class="w-full h-full flex items-center justify-center text-gray-400 dark:text-gray-500">
                                        <svg class="w-20 h-20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                        </svg>
                                    </div>
                                {% endif %}

                                <!-- Badges -->
                                <div class="absolute top-4 left-4 flex flex-col gap-2">
                                    {% if activeDiscount %}
                                        <div class="bg-gradient-to-r from-red-500 to-red-600 text-white px-3 py-1 rounded-full text-xs font-bold shadow-lg animate-pulse">
                                            {% if activeDiscount.type == 'percentage' %}
                                                🔥 -{{ activeDiscount.value }}% OFF
                                            {% else %}
                                                💰 -PHP {{ activeDiscount.value }}
                                            {% endif %}
                                        </div>
                                    {% endif %}
                                    
                                    {% if product.stock < 10 and product.stock > 0 %}
                                        <div class="bg-yellow-500 dark:bg-yellow-600 text-white px-3 py-1 rounded-full text-xs font-bold shadow-lg">
                                            ⚡ Only {{ product.stock }} left!
                                        </div>
                                    {% endif %}

                                    <!-- New Badge (if created within last 7 days) -->
                                    {% if product.createdAt and product.createdAt|date('U') > date('-7 days')|date('U') %}
                                        <div class="bg-blue-500 text-white px-3 py-1 rounded-full text-xs font-bold shadow-lg">
                                            🆕 New Arrival
                                        </div>
                                    {% endif %}
                                </div>

                                <!-- Wishlist Button -->
                                <button onclick="toggleWishlist({{ product.id }})" class="absolute top-4 right-4 bg-white/90 dark:bg-gray-800/90 backdrop-blur-sm p-2 rounded-full shadow-lg hover:scale-110 transition-transform">
                                    <svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                                    </svg>
                                </button>

                                <!-- Quick View Button -->
                                <button onclick="quickView({{ product.id }})" class="absolute bottom-4 left-1/2 transform -translate-x-1/2 bg-white/90 dark:bg-gray-800/90 backdrop-blur-sm text-gray-900 dark:text-white px-6 py-2 rounded-full font-medium opacity-0 group-hover:opacity-100 transition-all duration-300 hover:bg-green-600 hover:text-white shadow-lg">
                                    Quick View
                                </button>

                                <!-- Stock Status Overlay -->
                                {% if product.stock == 0 %}
                                    <div class="absolute inset-0 bg-black/60 backdrop-blur-sm flex items-center justify-center">
                                        <span class="text-white font-bold text-xl px-4 py-2 bg-red-600 rounded-full">Out of Stock</span>
                                    </div>
                                {% endif %}
                            </div>

                            <!-- Content -->
                            <div class="p-4 sm:p-6">
                                <!-- Brand and Rating -->
                                <div class="flex items-center justify-between mb-2 sm:mb-3">
                                    <span class="text-xs font-semibold text-green-600 dark:text-green-400 uppercase tracking-wider">{{ product.brand }}</span>
                                    <div class="flex items-center gap-1">
                                        <div class="flex">
                                            {% set rating = product.avgRating|default(0) %}
                                            {% for i in 1..5 %}
                                                <svg class="w-3 sm:w-4 h-3 sm:h-4 {% if i <= rating %}text-yellow-400{% else %}text-gray-300 dark:text-gray-600{% endif %} fill-current" viewBox="0 0 20 20">
                                                    <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/>
                                                </svg>
                                            {% endfor %}
                                        </div>
                                        <span class="text-xs sm:text-sm text-gray-600 dark:text-gray-400">({{ product.reviewsCount|default(0) }})</span>
                                    </div>
                                </div>

                                <!-- Product Name -->
                                <h3 class="text-lg sm:text-xl font-bold text-gray-900 dark:text-white mb-1 sm:mb-2 line-clamp-2 group-hover:text-green-600 dark:group-hover:text-green-400 transition">
                                    <a href="{{ path('app_product_show', {'id': product.id}) }}">
                                        {{ product.name }}
                                    </a>
                                </h3>

                                <!-- Description -->
                                <p class="text-gray-600 dark:text-gray-400 text-xs sm:text-sm mb-3 sm:mb-4 line-clamp-2">{{ product.description }}</p>

                                <!-- Stock Progress Bar -->
                                <div class="mb-3 sm:mb-4">
                                    <div class="flex items-center justify-between mb-1">
                                        <span class="text-xs text-gray-500 dark:text-gray-500">Availability</span>
                                        <span class="text-xs font-semibold text-gray-900 dark:text-gray-300">{{ product.stock }} units</span>
                                    </div>
                                    <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2 overflow-hidden">
                                        <div 
                                            class="bg-gradient-to-r from-green-500 to-green-600 h-2 rounded-full transition-all duration-500"
                                            style="width: {{ min(100, (product.stock / 100) * 100) }}%"
                                        ></div>
                                    </div>
                                </div>

                                <!-- Price and Actions -->
                                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between mt-3 sm:mt-4 pt-3 sm:pt-4 border-t border-gray-100 dark:border-gray-700 gap-3 sm:gap-0">
                                    <div>
                                        {% if activeDiscount %}
                                            {% set discountedPrice = product.price %}
                                            {% if activeDiscount.type == 'percentage' %}
                                                {% set discountedPrice = product.price * (1 - (activeDiscount.value / 100)) %}
                                            {% else %}
                                                {% set discountedPrice = product.price - activeDiscount.value %}
                                            {% endif %}
                                            <div class="flex flex-col">
                                                <span class="text-xl sm:text-2xl font-bold text-green-600 dark:text-green-400">PHP {{ discountedPrice|number_format(2) }}</span>
                                                <span class="text-xs line-through text-gray-400 dark:text-gray-500">PHP {{ product.price|number_format(2) }}</span>
                                            </div>
                                        {% else %}
                                            <span class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white">PHP {{ product.price|number_format(2) }}</span>
                                        {% endif %}
                                    </div>
                                    
                                    <div class="flex gap-2 w-full sm:w-auto">
                                        {% if product.stock > 0 %}
                                            <button onclick="addToCart({{ product.id }})" class="flex-1 sm:flex-initial bg-green-600 dark:bg-green-500 text-white px-3 sm:px-4 py-2 rounded-xl hover:bg-green-700 dark:hover:bg-green-600 transition-all hover:shadow-lg font-medium text-xs sm:text-sm flex items-center justify-center sm:justify-start gap-2">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-1.5 6M17 13l1.5 6M9 21h6M12 15v6" />
                                                </svg>
                                                <span class="hidden sm:inline">Add</span>
                                            </button>
                                        {% endif %}
                                        <a 
                                            href="{{ path('app_product_show', {'id': product.id}) }}" 
                                            class="flex-1 sm:flex-initial bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 px-3 sm:px-4 py-2 rounded-xl hover:bg-gray-200 dark:hover:bg-gray-600 transition-all font-medium text-xs sm:text-sm flex items-center justify-center gap-2"
                                        >
                                            <span class="hidden sm:inline">View</span>
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                            </svg>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>

            <!-- Enhanced Pagination with Dark Mode -->
            {% if pages > 1 %}
                <div class="mt-8 sm:mt-12 flex justify-center overflow-x-auto">
                    <nav class="flex items-center gap-1 sm:gap-2 bg-white/70 dark:bg-gray-800/50 backdrop-blur-md rounded-full shadow-lg dark:shadow-xl px-2 sm:px-3 py-2 border border-white/20 dark:border-gray-700/30">
                        <!-- First Page -->
                        {% if page > 1 %}
                            <a href="{{ path('app_catalog', { page: 1, q: search, category: categoryId, sort: sort }) }}" class="w-8 h-8 sm:w-10 sm:h-10 flex items-center justify-center rounded-full hover:bg-gray-100 dark:hover:bg-gray-700 transition text-sm">
                                <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 19l-7-7 7-7m8 14l-7-7 7-7" />
                                </svg>
                            </a>
                        {% endif %}

                        <!-- Previous -->
                        {% if page > 1 %}
                            <a href="{{ path('app_catalog', { page: page - 1, q: search, category: categoryId, sort: sort }) }}" class="px-2 sm:px-4 py-2 rounded-full hover:bg-gray-100 dark:hover:bg-gray-700 transition text-sm">
                                <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                                </svg>
                            </a>
                        {% endif %}

                        {% set startPage = max(1, page - 2) %}
                        {% set endPage = min(pages, page + 2) %}

                        {% if startPage > 1 %}
                            <a href="{{ path('app_catalog', { page: 1, q: search, category: categoryId, sort: sort }) }}" class="w-8 h-8 sm:w-10 sm:h-10 flex items-center justify-center rounded-full hover:bg-gray-100 dark:hover:bg-gray-700 transition text-xs sm:text-sm">1</a>
                            {% if startPage > 2 %}
                                <span class="px-1 sm:px-2 text-gray-500 dark:text-gray-400 text-xs">...</span>
                            {% endif %}
                        {% endif %}

                        {% for i in startPage..endPage %}
                            {% if i == page %}
                                <span class="w-8 h-8 sm:w-10 sm:h-10 flex items-center justify-center bg-gradient-to-r from-green-600 to-green-700 dark:from-green-500 dark:to-green-600 text-white rounded-full shadow-md text-xs sm:text-sm">{{ i }}</span>
                            {% else %}
                                <a href="{{ path('app_catalog', { page: i, q: search, category: categoryId, sort: sort }) }}" class="w-8 h-8 sm:w-10 sm:h-10 flex items-center justify-center rounded-full hover:bg-gray-100 dark:hover:bg-gray-700 transition text-xs sm:text-sm">{{ i }}</a>
                            {% endif %}
                        {% endfor %}

                        {% if endPage < pages %}
                            {% if endPage < pages - 1 %}
                                <span class="px-1 sm:px-2 text-gray-500 dark:text-gray-400 text-xs">...</span>
                            {% endif %}
                            <a href="{{ path('app_catalog', { page: pages, q: search, category: categoryId, sort: sort }) }}" class="w-8 h-8 sm:w-10 sm:h-10 flex items-center justify-center rounded-full hover:bg-gray-100 dark:hover:bg-gray-700 transition text-xs sm:text-sm">{{ pages }}</a>
                        {% endif %}

                        <!-- Next -->
                        {% if page < pages %}
                            <a href="{{ path('app_catalog', { page: page + 1, q: search, category: categoryId, sort: sort }) }}" class="px-2 sm:px-4 py-2 rounded-full hover:bg-gray-100 dark:hover:bg-gray-700 transition text-sm">
                                <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                </svg>
                            </a>
                        {% endif %}

                        <!-- Last Page -->
                        {% if page < pages %}
                            <a href="{{ path('app_catalog', { page: pages, q: search, category: categoryId, sort: sort }) }}" class="w-8 h-8 sm:w-10 sm:h-10 flex items-center justify-center rounded-full hover:bg-gray-100 dark:hover:bg-gray-700 transition text-sm">
                                <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 5l7 7-7 7" />
                                </svg>
                            </a>
                        {% endif %}
                    </nav>
                </div>
            {% endif %}
        {% else %}
            <!-- Enhanced Empty State with Dark Mode -->
            <div class="bg-white/70 dark:bg-gray-800/50 backdrop-blur-md rounded-2xl shadow-xl dark:shadow-2xl p-8 sm:p-16 text-center border border-white/20 dark:border-gray-700/30">
                <div class="max-w-md mx-auto">
                    <div class="w-24 h-24 sm:w-32 sm:h-32 mx-auto mb-4 sm:mb-6 bg-gradient-to-br from-gray-100 to-gray-200 dark:from-gray-700 dark:to-gray-800 rounded-full flex items-center justify-center">
                        <svg class="w-12 h-12 sm:w-16 sm:h-16 text-gray-400 dark:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z" />
                        </svg>
                    </div>
                    <h3 class="text-lg sm:text-2xl font-bold text-gray-900 dark:text-white mb-2 sm:mb-3">No products found</h3>
                    <p class="text-gray-600 dark:text-gray-400 text-sm sm:text-base mb-6 sm:mb-8">
                        {% if search %}
                            We couldn't find any products matching "<strong class="text-gray-900 dark:text-white">{{ search }}</strong>".
                        {% else %}
                            No products are available in this category at the moment.
                        {% endif %}
                    </p>
                    <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center">
                        <a href="{{ path('app_catalog') }}" class="inline-flex items-center justify-center gap-2 bg-green-600 dark:bg-green-500 text-white px-6 sm:px-8 py-2 sm:py-3 rounded-xl hover:bg-green-700 dark:hover:bg-green-600 transition-all hover:shadow-lg font-medium text-sm sm:text-base">
                            <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                            </svg>
                            Browse All Products
                        </a>
                        {% if search %}
                            <a href="{{ path('app_catalog') }}" class="inline-flex items-center justify-center gap-2 bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 px-6 sm:px-8 py-2 sm:py-3 rounded-xl hover:bg-gray-300 dark:hover:bg-gray-600 transition font-medium text-sm sm:text-base">
                                Clear Search
                            </a>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
</div>

<!-- Quick View Modal with Dark Mode -->
<div id="quickViewModal" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 hidden items-center justify-center p-4 transition-all">
    <div class="bg-white/95 dark:bg-gray-800/95 backdrop-blur-md rounded-2xl max-w-4xl w-full max-h-[90vh] overflow-y-auto border border-white/20 dark:border-gray-700/30">
        <div class="sticky top-0 bg-white/95 dark:bg-gray-800/95 backdrop-blur-md border-b border-gray-200/50 dark:border-gray-700/50 p-4 flex justify-between">
            <h3 class="text-xl font-bold text-gray-900 dark:text-white">Quick View</h3>
            <button onclick="closeQuickView()" class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
        <div id="quickViewContent" class="p-6">
            <!-- Content loaded via AJAX -->
        </div>
    </div>
</div>

<!-- Toast Notification -->
<div id="toast" class="fixed bottom-4 right-4 bg-white/90 dark:bg-gray-800/90 backdrop-blur-md shadow-lg rounded-lg p-4 transform translate-y-full opacity-0 transition-all duration-300 z-50 max-w-sm border border-white/20 dark:border-gray-700/30">
    <div class="flex items-center gap-3">
        <div id="toastIcon" class="w-6 h-6"></div>
        <p id="toastMessage" class="text-gray-900 dark:text-white"></p>
    </div>
</div>

<style>
    @keyframes fade-in {
        from { opacity: 0; }
        to { opacity: 1; }
    }
    
    @keyframes slide-up {
        from { 
            opacity: 0;
            transform: translateY(20px);
        }
        to { 
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    .animate-fade-in {
        animation: fade-in 1s ease-out;
    }
    
    .animate-slide-up {
        animation: slide-up 0.8s ease-out;
    }
    
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    
    /* Smooth transitions for dark mode */
    * {
        transition: background-color 0.3s ease, border-color 0.3s ease;
    }
</style>

<script>
    // Clear search
    function clearSearch() {
        window.location.href = '{{ path('app_catalog') }}' + '?category={{ categoryId }}&sort={{ sort }}';
    }
    
    // View toggle functionality
    function toggleView(view) {
        const grid = document.getElementById('products-grid');
        const buttons = document.querySelectorAll('.view-btn');
        
        buttons.forEach(btn => {
            if (btn.dataset.view === view) {
                btn.classList.remove('bg-gray-200', 'dark:bg-gray-700', 'text-gray-600', 'dark:text-gray-400');
                btn.classList.add('bg-green-600', 'dark:bg-green-500', 'text-white');
            } else {
                btn.classList.remove('bg-green-600', 'dark:bg-green-500', 'text-white');
                btn.classList.add('bg-gray-200', 'dark:bg-gray-700', 'text-gray-600', 'dark:text-gray-400');
            }
        });
        
        if (view === 'list') {
            grid.classList.remove('grid-cols-1', 'sm:grid-cols-2', 'lg:grid-cols-3');
            grid.classList.add('flex', 'flex-col', 'gap-4');
            document.querySelectorAll('.product-card').forEach(card => {
                card.classList.add('flex', 'flex-row', 'max-h-48');
                const imgContainer = card.querySelector('.aspect-square');
                if (imgContainer) {
                    imgContainer.classList.add('w-48', 'flex-shrink-0');
                }
            });
        } else {
            grid.classList.remove('flex', 'flex-col', 'gap-4');
            grid.classList.add('grid', 'grid-cols-1', 'sm:grid-cols-2', 'lg:grid-cols-3');
            document.querySelectorAll('.product-card').forEach(card => {
                card.classList.remove('flex', 'flex-row', 'max-h-48');
                const imgContainer = card.querySelector('.aspect-square');
                if (imgContainer) {
                    imgContainer.classList.remove('w-48', 'flex-shrink-0');
                }
            });
        }
        
        localStorage.setItem('catalogView', view);
    }
    
    // Load saved view preference
    const savedView = localStorage.getItem('catalogView');
    if (savedView) {
        toggleView(savedView);
    }
    
    // Quick view function
    function quickView(productId) {
        const modal = document.getElementById('quickViewModal');
        const content = document.getElementById('quickViewContent');
        
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
        
        // Fetch product details via AJAX
        fetch(`/product/${productId}/quick-view`)
            .then(response => response.text())
            .then(html => {
                content.innerHTML = html;
            })
            .catch(error => {
                content.innerHTML = '<div class="text-center p-8 text-red-500">Failed to load product details</div>';
            });
    }
    
    function closeQuickView() {
        const modal = document.getElementById('quickViewModal');
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.style.overflow = '';
    }
    
    // Add to cart function
    function addToCart(productId) {
        fetch('/cart/add', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify({ id: productId, quantity: 1 })
        })
        .then(response => response.json())
        .then(data => {
            showToast('Product added to cart!', 'success');
            // Update cart count if function exists
            if (typeof updateCartCount === 'function') {
                updateCartCount(data.cartCount);
            }
        })
        .catch(() => {
            showToast('Failed to add product to cart', 'error');
        });
    }
    
    // Toggle wishlist function
    function toggleWishlist(productId) {
        fetch('/wishlist/toggle', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify({ id: productId })
        })
        .then(response => response.json())
        .then(data => {
            if (data.added) {
                showToast('Added to wishlist!', 'success');
            } else {
                showToast('Removed from wishlist', 'info');
            }
        })
        .catch(() => {
            showToast('Please login to use wishlist', 'error');
        });
    }
    
    // Show toast notification
    function showToast(message, type = 'success') {
        const toast = document.getElementById('toast');
        const toastMessage = document.getElementById('toastMessage');
        const toastIcon = document.getElementById('toastIcon');
        
        toastMessage.textContent = message;
        
        if (type === 'success') {
            toastIcon.innerHTML = '<svg class="w-6 h-6 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>';
        } else if (type === 'error') {
            toastIcon.innerHTML = '<svg class="w-6 h-6 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>';
        } else {
            toastIcon.innerHTML = '<svg class="w-6 h-6 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>';
        }
        
        toast.classList.remove('translate-y-full', 'opacity-0');
        toast.classList.add('translate-y-0', 'opacity-100');
        
        setTimeout(() => {
            toast.classList.remove('translate-y-0', 'opacity-100');
            toast.classList.add('translate-y-full', 'opacity-0');
        }, 3000);
    }
    
    // Close modal on escape key
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            closeQuickView();
        }
    });
    
    // Close modal when clicking outside
    document.getElementById('quickViewModal')?.addEventListener('click', function(e) {
        if (e.target === this) {
            closeQuickView();
        }
    });
</script>
{% endblock %}