{% extends 'base.html.twig' %}

{% block title %}Product Catalog - EasySave{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50 transition-colors duration-300">
    <!-- Hero Section -->
    <div class="relative bg-gradient-to-r from-green-600 to-green-700 text-white py-12 sm:py-16">
        <div class="absolute inset-0 bg-black opacity-20"></div>
        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold mb-3 sm:mb-4 animate-fade-in">Product Catalog</h1>
            <p class="text-sm sm:text-base md:text-lg lg:text-2xl text-green-100 max-w-3xl mx-auto animate-slide-up px-2">
                Discover our carefully curated collection of premium products
            </p>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
        <!-- Filters Bar -->
        <div class="bg-white rounded-2xl shadow-lg mb-6 sm:mb-8 p-4 sm:p-6 transition-colors duration-300">
            <form method="GET" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4 items-end" id="filterForm">
                <!-- Search Input -->
                <div class="sm:col-span-1">
                    <label class="block text-xs sm:text-sm font-semibold text-gray-700 mb-1 sm:mb-2">Search Products</label>
                    <div class="relative">
                        <svg class="absolute left-3 top-1/2 transform -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                        <input 
                            type="text" 
                            name="q" 
                            id="searchInput"
                            value="{{ search }}" 
                            placeholder="Search by name, brand, or description..."
                            class="w-full pl-10 pr-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent transition"
                            autocomplete="off"
                        >
                        {% if search %}
                            <button type="button" onclick="clearSearch()" class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400 hover:text-gray-600">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                                </svg>
                            </button>
                        {% endif %}
                    </div>
                </div>

                <!-- Category Select -->
                <div>
                    <label class="block text-xs sm:text-sm font-semibold text-gray-700 mb-1 sm:mb-2">Category</label>
                    <select name="category" id="categorySelect" onchange="this.form.submit()" class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-green-500 bg-white transition">
                        <option value="">All Categories</option>
                        {% for category in categories %}
                            <option value="{{ category.id }}" {% if categoryId == category.id %}selected{% endif %}>{{ category.name }}</option>
                            {% if category.children|length > 0 %}
                                {% for subcategory in category.children %}
                                    <option value="{{ subcategory.id }}" {% if categoryId == subcategory.id %}selected{% endif %}>-- {{ subcategory.name }}</option>
                                {% endfor %}
                            {% endif %}
                        {% endfor %}
                    </select>
                </div>

                <!-- Sort Select -->
                <div>
                    <label class="block text-xs sm:text-sm font-semibold text-gray-700 mb-1 sm:mb-2">Sort By</label>
                    <select name="sort" id="sortSelect" onchange="this.form.submit()" class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-green-500 bg-white transition">
                        <option value="newest" {% if sort == 'newest' %}selected{% endif %}>✨ Newest First</option>
                        <option value="price_low" {% if sort == 'price_low' %}selected{% endif %}>💰 Price: Low to High</option>
                        <option value="price_high" {% if sort == 'price_high' %}selected{% endif %}>💰 Price: High to Low</option>
                        <option value="popular" {% if sort == 'popular' %}selected{% endif %}>⭐ Most Popular</option>
                    </select>
                </div>

                <button type="submit" class="hidden">Apply Filters</button>
            </form>

            <!-- Active Filters Display -->
            {% if search or categoryId %}
                <div class="mt-4 pt-4 border-t border-gray-200 flex flex-wrap gap-2 items-center">
                    <span class="text-sm text-gray-600">Active filters:</span>
                    {% if search %}
                        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm bg-green-100 text-green-700">
                            Search: "{{ search }}"
                            <a href="{{ path('app_catalog', { category: categoryId, sort: sort }) }}" class="ml-2 hover:text-green-900">&times;</a>
                        </span>
                    {% endif %}
                    {% if categoryId %}
                        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm bg-green-100 text-green-700">
                            Category filter applied
                            <a href="{{ path('app_catalog', { q: search, sort: sort }) }}" class="ml-2 hover:text-green-900">&times;</a>
                        </span>
                    {% endif %}
                    <a href="{{ path('app_catalog') }}" class="text-sm text-green-600 hover:text-green-700 font-medium">Clear all</a>
                </div>
            {% endif %}
        </div>

        <!-- Results Stats -->
        <div class="mb-6 sm:mb-8 flex flex-col sm:flex-row flex-wrap items-start sm:items-center justify-between gap-3 sm:gap-4">
            <div class="flex items-center space-x-2">
                <div class="w-1 h-8 bg-green-600 rounded-full"></div>
                <div>
                    <p class="text-xs sm:text-sm text-gray-600">
                        Showing <span class="font-semibold text-gray-900">{{ products|length }}</span> of 
                        <span class="font-semibold text-gray-900">{{ total }}</span> products
                        {% if search %} for "<span class="font-semibold text-gray-900">{{ search }}</span>"{% endif %}
                    </p>
                </div>
            </div>
            
            <!-- View Toggle -->
            <div class="flex items-center gap-2">
                <span class="text-xs sm:text-sm text-gray-500">View:</span>
                <button onclick="toggleView('grid')" class="view-btn p-2 rounded-lg bg-green-600 text-white transition" data-view="grid">
                    <svg class="w-4 sm:w-5 h-4 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
                    </svg>
                </button>
                <button onclick="toggleView('list')" class="view-btn p-2 rounded-lg bg-gray-200 text-gray-600 transition" data-view="list">
                    <svg class="w-4 sm:w-5 h-4 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
                    </svg>
                </button>
            </div>
        </div>

        {% if products|length > 0 %}
            <!-- Products Container -->
            <div id="products-container" class="transition-all duration-300">
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 sm:gap-6" id="products-grid">
                    {% for product in products %}
                        {% set activeDiscount = product.discounts|filter(d => d.isActive)|first %}
                        <div class="product-card group bg-white rounded-xl shadow-md hover:shadow-xl transition-all duration-300 overflow-hidden hover:-translate-y-1">
                            <!-- Image Container -->
                            <div class="relative overflow-hidden bg-gray-100 aspect-square">
                                {% if product.imagePath %}
                                    <img 
                                        src="{{ asset(product.imagePath) }}" 
                                        alt="{{ product.name }}" 
                                        class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                                        loading="lazy"
                                    >
                                {% else %}
                                    <div class="w-full h-full flex items-center justify-center text-gray-400">
                                        <svg class="w-20 h-20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                        </svg>
                                    </div>
                                {% endif %}

                                <!-- Badges -->
                                <div class="absolute top-3 left-3 flex flex-col gap-2">
                                    {% if activeDiscount %}
                                        <div class="bg-red-500 text-white px-2 py-1 rounded-lg text-xs font-bold shadow-md">
                                            {% if activeDiscount.type == 'percentage' %}
                                                -{{ activeDiscount.value }}% OFF
                                            {% else %}
                                                -PHP {{ activeDiscount.value }}
                                            {% endif %}
                                        </div>
                                    {% endif %}
                                    
                                    {% if product.stock < 10 and product.stock > 0 %}
                                        <div class="bg-yellow-500 text-white px-2 py-1 rounded-lg text-xs font-bold shadow-md">
                                            Only {{ product.stock }} left!
                                        </div>
                                    {% endif %}

                                    {% if product.createdAt and product.createdAt|date('U') > date('-7 days')|date('U') %}
                                        <div class="bg-blue-500 text-white px-2 py-1 rounded-lg text-xs font-bold shadow-md">
                                            New
                                        </div>
                                    {% endif %}
                                </div>

                                <!-- Wishlist Button -->
                                <button onclick="toggleWishlist({{ product.id }})" class="absolute top-3 right-3 bg-white p-2 rounded-full shadow-md hover:scale-110 transition-transform">
                                    <svg class="w-4 h-4 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                                    </svg>
                                </button>

                                <!-- Quick View Button -->
                                <button onclick="quickView({{ product.id }})" class="absolute bottom-3 left-1/2 transform -translate-x-1/2 bg-white text-gray-900 px-4 py-1.5 rounded-lg font-medium opacity-0 group-hover:opacity-100 transition-all duration-300 hover:bg-green-600 hover:text-white shadow-md text-sm">
                                    Quick View
                                </button>

                                <!-- Stock Status Overlay -->
                                {% if product.stock == 0 %}
                                    <div class="absolute inset-0 bg-black/60 flex items-center justify-center">
                                        <span class="text-white font-bold text-sm px-3 py-1.5 bg-red-600 rounded-lg">Out of Stock</span>
                                    </div>
                                {% endif %}
                            </div>

                            <!-- Content -->
                            <div class="p-4">
                                <!-- Brand and Rating -->
                                <div class="flex items-center justify-between mb-2">
                                    <span class="text-xs font-semibold text-green-600 uppercase">{{ product.brand }}</span>
                                    <div class="flex items-center gap-1">
                                        <div class="flex">
                                            {% set rating = product.avgRating|default(0) %}
                                            {% for i in 1..5 %}
                                                <svg class="w-3 h-3 {% if i <= rating %}text-yellow-400{% else %}text-gray-300{% endif %} fill-current" viewBox="0 0 20 20">
                                                    <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/>
                                                </svg>
                                            {% endfor %}
                                        </div>
                                        <span class="text-xs text-gray-600">({{ product.reviewsCount|default(0) }})</span>
                                    </div>
                                </div>

                                <!-- Product Name -->
                                <h3 class="text-base font-bold text-gray-900 mb-1 line-clamp-2 hover:text-green-600 transition">
                                    <a href="{{ path('app_product_show', {'id': product.id}) }}">
                                        {{ product.name }}
                                    </a>
                                </h3>

                                <!-- Price -->
                                <div class="mt-2 mb-3">
                                    {% if activeDiscount %}
                                        {% set discountedPrice = product.price %}
                                        {% if activeDiscount.type == 'percentage' %}
                                            {% set discountedPrice = product.price * (1 - (activeDiscount.value / 100)) %}
                                        {% else %}
                                            {% set discountedPrice = product.price - activeDiscount.value %}
                                        {% endif %}
                                        <div class="flex items-center gap-2">
                                            <span class="text-xl font-bold text-green-600">PHP {{ discountedPrice|number_format(2) }}</span>
                                            <span class="text-xs line-through text-gray-400">PHP {{ product.price|number_format(2) }}</span>
                                        </div>
                                    {% else %}
                                        <span class="text-xl font-bold text-gray-900">PHP {{ product.price|number_format(2) }}</span>
                                    {% endif %}
                                </div>

                                <!-- Actions -->
                                <div class="flex gap-2">
                                    {% if product.stock > 0 %}
                                        <button onclick="addToCart({{ product.id }})" class="flex-1 bg-green-600 hover:bg-green-700 text-white px-3 py-2 rounded-lg transition-all font-medium text-sm flex items-center justify-center gap-2">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-1.5 6M17 13l1.5 6M9 21h6M12 15v6" />
                                            </svg>
                                            Add to Cart
                                        </button>
                                    {% endif %}
                                    <a 
                                        href="{{ path('app_product_show', {'id': product.id}) }}" 
                                        class="px-3 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition-all font-medium text-sm flex items-center justify-center"
                                    >
                                        View
                                    </a>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>

            <!-- Pagination -->
            {% if pages > 1 %}
                <div class="mt-8 sm:mt-12 flex justify-center">
                    <nav class="flex items-center gap-1 sm:gap-2 bg-white rounded-full shadow-lg px-3 py-2">
                        {% if page > 1 %}
                            <a href="{{ path('app_catalog', { page: 1, q: search, category: categoryId, sort: sort }) }}" class="w-8 h-8 sm:w-10 sm:h-10 flex items-center justify-center rounded-full hover:bg-gray-100 transition">
                                <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 19l-7-7 7-7m8 14l-7-7 7-7" />
                                </svg>
                            </a>
                        {% endif %}

                        {% if page > 1 %}
                            <a href="{{ path('app_catalog', { page: page - 1, q: search, category: categoryId, sort: sort }) }}" class="px-3 py-2 rounded-full hover:bg-gray-100 transition">
                                <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                                </svg>
                            </a>
                        {% endif %}

                        {% for i in max(1, page - 2)..min(pages, page + 2) %}
                            {% if i == page %}
                                <span class="w-8 h-8 sm:w-10 sm:h-10 flex items-center justify-center bg-green-600 text-white rounded-full shadow-md text-sm">{{ i }}</span>
                            {% else %}
                                <a href="{{ path('app_catalog', { page: i, q: search, category: categoryId, sort: sort }) }}" class="w-8 h-8 sm:w-10 sm:h-10 flex items-center justify-center rounded-full hover:bg-gray-100 transition text-sm">{{ i }}</a>
                            {% endif %}
                        {% endfor %}

                        {% if page < pages %}
                            <a href="{{ path('app_catalog', { page: page + 1, q: search, category: categoryId, sort: sort }) }}" class="px-3 py-2 rounded-full hover:bg-gray-100 transition">
                                <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                </svg>
                            </a>
                        {% endif %}

                        {% if page < pages %}
                            <a href="{{ path('app_catalog', { page: pages, q: search, category: categoryId, sort: sort }) }}" class="w-8 h-8 sm:w-10 sm:h-10 flex items-center justify-center rounded-full hover:bg-gray-100 transition">
                                <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 5l7 7-7 7" />
                                </svg>
                            </a>
                        {% endif %}
                    </nav>
                </div>
            {% endif %}
        {% else %}
            <!-- Empty State -->
            <div class="bg-white rounded-2xl shadow-lg p-8 sm:p-16 text-center">
                <div class="max-w-md mx-auto">
                    <div class="w-24 h-24 sm:w-32 sm:h-32 mx-auto mb-4 sm:mb-6 bg-gray-100 rounded-full flex items-center justify-center">
                        <svg class="w-12 h-12 sm:w-16 sm:h-16 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z" />
                        </svg>
                    </div>
                    <h3 class="text-lg sm:text-2xl font-bold text-gray-900 mb-2">No products found</h3>
                    <p class="text-gray-600 text-sm sm:text-base mb-6">
                        {% if search %}
                            We couldn't find any products matching "<strong class="text-gray-900">{{ search }}</strong>".
                        {% else %}
                            No products are available in this category at the moment.
                        {% endif %}
                    </p>
                    <div class="flex flex-col sm:flex-row gap-3 justify-center">
                        <a href="{{ path('app_catalog') }}" class="inline-flex items-center justify-center gap-2 bg-green-600 hover:bg-green-700 text-white px-6 py-2 rounded-xl transition font-medium">
                            Browse All Products
                        </a>
                        {% if search %}
                            <a href="{{ path('app_catalog') }}" class="inline-flex items-center justify-center gap-2 bg-gray-200 text-gray-700 px-6 py-2 rounded-xl hover:bg-gray-300 transition font-medium">
                                Clear Search
                            </a>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
</div>

<!-- Quick View Modal -->
<div id="quickViewModal" class="fixed inset-0 bg-black/50 z-50 hidden items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-4xl w-full max-h-[90vh] overflow-y-auto">
        <div class="sticky top-0 bg-white border-b border-gray-200 p-4 flex justify-between items-center">
            <h3 class="text-xl font-bold text-gray-900">Quick View</h3>
            <button onclick="closeQuickView()" class="text-gray-500 hover:text-gray-700">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
        <div id="quickViewContent" class="p-6">
            <!-- Content loaded via AJAX -->
        </div>
    </div>
</div>

<!-- Toast Notification -->
<div id="toast" class="fixed bottom-4 right-4 bg-white shadow-lg rounded-lg p-4 transform translate-y-full opacity-0 transition-all duration-300 z-50 max-w-sm">
    <div class="flex items-center gap-3">
        <div id="toastIcon" class="w-6 h-6"></div>
        <p id="toastMessage" class="text-gray-900 text-sm"></p>
    </div>
</div>

<style>
    @keyframes fade-in {
        from { opacity: 0; }
        to { opacity: 1; }
    }
    
    @keyframes slide-up {
        from { 
            opacity: 0;
            transform: translateY(20px);
        }
        to { 
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    .animate-fade-in {
        animation: fade-in 1s ease-out;
    }
    
    .animate-slide-up {
        animation: slide-up 0.8s ease-out;
    }
    
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>

<script>
    function clearSearch() {
        window.location.href = '{{ path('app_catalog') }}' + '?category={{ categoryId }}&sort={{ sort }}';
    }
    
    function toggleView(view) {
        const grid = document.getElementById('products-grid');
        const buttons = document.querySelectorAll('.view-btn');
        
        buttons.forEach(btn => {
            if (btn.dataset.view === view) {
                btn.classList.remove('bg-gray-200', 'text-gray-600');
                btn.classList.add('bg-green-600', 'text-white');
            } else {
                btn.classList.remove('bg-green-600', 'text-white');
                btn.classList.add('bg-gray-200', 'text-gray-600');
            }
        });
        
        if (view === 'list') {
            grid.classList.remove('grid', 'grid-cols-1', 'sm:grid-cols-2', 'lg:grid-cols-3', 'xl:grid-cols-4');
            grid.classList.add('flex', 'flex-col', 'gap-4');
            document.querySelectorAll('.product-card').forEach(card => {
                card.classList.add('flex', 'flex-row', 'max-h-48');
                const imgContainer = card.querySelector('.aspect-square');
                if (imgContainer) {
                    imgContainer.classList.add('w-48', 'flex-shrink-0');
                    imgContainer.classList.remove('aspect-square');
                }
            });
        } else {
            grid.classList.remove('flex', 'flex-col', 'gap-4');
            grid.classList.add('grid', 'grid-cols-1', 'sm:grid-cols-2', 'lg:grid-cols-3', 'xl:grid-cols-4', 'gap-4', 'sm:gap-6');
            document.querySelectorAll('.product-card').forEach(card => {
                card.classList.remove('flex', 'flex-row', 'max-h-48');
                const imgContainer = card.querySelector('.w-48');
                if (imgContainer) {
                    imgContainer.classList.remove('w-48', 'flex-shrink-0');
                    imgContainer.classList.add('aspect-square');
                }
            });
        }
        
        localStorage.setItem('catalogView', view);
    }
    
    const savedView = localStorage.getItem('catalogView');
    if (savedView) {
        toggleView(savedView);
    }
    
    function quickView(productId) {
        const modal = document.getElementById('quickViewModal');
        const content = document.getElementById('quickViewContent');
        
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
        
        fetch(`/product/${productId}/quick-view`)
            .then(response => response.text())
            .then(html => {
                content.innerHTML = html;
            })
            .catch(error => {
                content.innerHTML = '<div class="text-center p-8 text-red-500">Failed to load product details</div>';
            });
    }
    
    function closeQuickView() {
        const modal = document.getElementById('quickViewModal');
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.style.overflow = '';
    }
    
    function addToCart(productId) {
        fetch('/cart/add', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify({ id: productId, quantity: 1 })
        })
        .then(response => response.json())
        .then(data => {
            showToast('Product added to cart!', 'success');
            if (typeof updateCartCount === 'function') {
                updateCartCount(data.cartCount);
            }
        })
        .catch(() => {
            showToast('Failed to add product to cart', 'error');
        });
    }
    
    function toggleWishlist(productId) {
        fetch('/wishlist/toggle', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify({ id: productId })
        })
        .then(response => response.json())
        .then(data => {
            if (data.added) {
                showToast('Added to wishlist!', 'success');
            } else {
                showToast('Removed from wishlist', 'info');
            }
        })
        .catch(() => {
            showToast('Please login to use wishlist', 'error');
        });
    }
    
    function showToast(message, type = 'success') {
        const toast = document.getElementById('toast');
        const toastMessage = document.getElementById('toastMessage');
        const toastIcon = document.getElementById('toastIcon');
        
        toastMessage.textContent = message;
        
        if (type === 'success') {
            toastIcon.innerHTML = '<svg class="w-6 h-6 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>';
        } else if (type === 'error') {
            toastIcon.innerHTML = '<svg class="w-6 h-6 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>';
        } else {
            toastIcon.innerHTML = '<svg class="w-6 h-6 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>';
        }
        
        toast.classList.remove('translate-y-full', 'opacity-0');
        toast.classList.add('translate-y-0', 'opacity-100');
        
        setTimeout(() => {
            toast.classList.remove('translate-y-0', 'opacity-100');
            toast.classList.add('translate-y-full', 'opacity-0');
        }, 3000);
    }
    
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            closeQuickView();
        }
    });
    
    document.getElementById('quickViewModal')?.addEventListener('click', function(e) {
        if (e.target === this) {
            closeQuickView();
        }
    });
</script>
{% endblock %}