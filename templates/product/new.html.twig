{% extends 'admin/index.html.twig' %}

{% block title %}New Product{% endblock %}

{% block body %}
    <div class="container mx-auto px-6 py-8">
        <h1 class="text-3xl font-bold mb-6 text-gray-800">Create new Product</h1>

        <div class="bg-white shadow-md rounded-lg p-6">
            {{ include('product/_form.html.twig') }}
            <a href="{{ path('app_product_index') }}" class="inline-flex items-center mt-4 text-blue-600 hover:underline gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
                </svg>
                Back to list
            </a>
        </div>
    </div>
{% endblock %}