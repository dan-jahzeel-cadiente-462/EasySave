{% extends 'auth/base.html.twig' %}

{% block title %}Admin Login{% endblock %}

{% block stylesheets %}
<style>
    .brand-green {
        color: #16a34a; /* Tailwind green-600 */
    }
    .bg-brand-green {
        background-color: #16a34a; /* Tailwind green-600 */
    }
    .bg-brand-green:hover {
        background-color: #15803d; /* Tailwind green-700 */
    }
    .ring-brand-green:focus {
        --tw-ring-color: #16a34a;
    }
    .border-brand-green:focus {
        border-color: #16a34a;
    }
    .glass-effect {
        background: rgba(255, 255, 255, 0.98);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(22, 163, 74, 0.1);
    }
</style>
{% endblock %}

{% block body %}
	<div class="min-h-screen flex items-center justify-center bg-gray-50" style="background-image: radial-gradient(circle at 2px 2px, rgba(22, 163, 74, 0.05) 1px, transparent 0); background-size: 32px 32px;">
		<div class="max-w-md w-full glass-effect shadow-2xl rounded-3xl p-12 relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-2 bg-brand-green"></div>
            
            <div class="text-center mb-10">
                <div class="inline-flex items-center justify-center w-20 h-20 bg-green-50 rounded-full mb-6 border border-green-100">
                    <svg class="w-10 h-10 brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                    </svg>
                </div>
			    <h1 class="text-3xl font-black text-gray-900 tracking-tight">System Admin</h1>
                <p class="text-gray-500 mt-3 font-medium">Railway Production Environment</p>
            </div>

			{# Show error if login failed #}
			{% if error %}
				<div class="mb-8 p-5 text-sm text-red-700 bg-red-50 border-l-4 border-red-500 rounded-lg flex items-start">
                    <svg class="w-5 h-5 mr-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
					<span class="font-bold">{{ error.messageKey|trans(error.messageData, 'security') }}</span>
				</div>
			{% endif %}

			{# Flash messages #}
			{% for message in app.flashes('success') %}
				<div class="mb-8 p-5 text-sm text-green-700 bg-green-50 border-l-4 border-brand-green rounded-lg flex items-start">
                    <svg class="w-5 h-5 mr-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
					<span class="font-bold">{{ message }}</span>
				</div>
			{% endfor %}

			<form method="post" class="space-y-8" x-data="{ loginType: '{{ last_login_type|default('email') }}' }">
				<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate_admin') }}">
				<input type="hidden" name="login_type" :value="loginType">

				<div class="space-y-4">
					<div class="flex items-center justify-between px-1">
					    <label class="text-xs font-bold text-gray-400 uppercase tracking-widest">Authentication Method</label>
                    </div>
					<div class="grid grid-cols-2 gap-2 rounded-2xl bg-gray-100 p-1.5" role="radiogroup">
						<button
							type="button"
							@click="loginType = 'email'"
							:class="loginType === 'email' ? 'bg-white text-green-600 shadow-sm' : 'text-gray-500 hover:text-gray-700'"
							class="rounded-xl px-4 py-3 text-sm font-black transition-all duration-200"
						>
							Email
						</button>
						<button
							type="button"
							@click="loginType = 'username'"
							:class="loginType === 'username' ? 'bg-white text-green-600 shadow-sm' : 'text-gray-500 hover:text-gray-700'"
							class="rounded-xl px-4 py-3 text-sm font-black transition-all duration-200"
						>
							Username
						</button>
					</div>
				</div>

				<div class="space-y-3">
					<label for="username" class="block text-sm font-bold text-gray-700" x-text="loginType === 'email' ? 'Admin Email Address' : 'Admin Username'"></label>
					<input
						:type="loginType === 'email' ? 'email' : 'text'"
						value="{{ last_username }}"
						name="_username"
						id="username"
						class="w-full px-5 py-4 bg-gray-50 border border-gray-200 rounded-2xl focus:outline-none focus:ring-4 ring-green-100 border-brand-green transition-all duration-200 font-medium"
						:placeholder="loginType === 'email' ? 'admin@easysave.com' : 'admin_account'"
						required
						autofocus
					>
				</div>

				<div class="space-y-3 relative">
					<label for="password" class="block text-sm font-bold text-gray-700">Security Access Key</label>
					<input type="password" name="_password" id="password" class="w-full px-5 py-4 bg-gray-50 border border-gray-200 rounded-2xl focus:outline-none focus:ring-4 ring-green-100 border-brand-green transition-all duration-200 pr-14 font-medium" placeholder="••••••••••••" required autocomplete="current-password">

					<div class="absolute bottom-4 right-5 flex items-center">
						<input type="checkbox" id="show_password" class="hidden">
						<label for="show_password" class="cursor-pointer text-gray-400 hover:brand-green transition-colors duration-200">
							<svg id="eye-open" class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
							</svg>
							<svg id="eye-closed" class="h-6 w-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.82L21 12 13.875 5.18M10.125 5.18L3 12l7.125 6.82"/>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15a3 3 0 100-6 3 3 0 000 6z"/>
							</svg>
						</label>
					</div>
				</div>

				<div class="flex items-center">
					<input type="checkbox" id="remember_me" name="_remember_me" class="h-5 w-5 text-brand-green focus:ring-brand-green border-gray-300 rounded-lg transition-all duration-200">
					<label for="remember_me" class="ml-3 block text-sm text-gray-600 font-bold cursor-pointer">Stay authenticated</label>
				</div>

				<button type="submit" class="w-full bg-brand-green text-white py-5 px-6 rounded-2xl font-black shadow-xl hover:shadow-2xl hover:bg-brand-green transform hover:-translate-y-1 transition-all duration-300 uppercase tracking-widest text-sm">
					Login to Control Panel
				</button>

				<div class="text-sm text-center pt-8 border-t border-gray-50">
					<a href="{{ path('app_user_login') }}" class="font-black brand-green hover:underline flex items-center justify-center">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                        </svg>
                        Switch to Staff/User Login
                    </a>
				</div>
			</form>
		</div>
	</div>

	<script>
		document.getElementById('show_password').addEventListener('change', function() {
			const password = document.getElementById('password');
			const eyeOpen = document.getElementById('eye-open');
			const eyeClosed = document.getElementById('eye-closed');
			
			if (this.checked) {
				password.type = 'text';
				eyeOpen.classList.add('hidden');
				eyeClosed.classList.remove('hidden');
			} else {
				password.type = 'password';
				eyeOpen.classList.remove('hidden');
				eyeClosed.classList.add('hidden');
			}
		});
	</script>
{% endblock %}
