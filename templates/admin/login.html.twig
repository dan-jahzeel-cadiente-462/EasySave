{% extends 'auth/base.html.twig' %}

{% block title %}Admin Control Panel - EasySave{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {# Use Tailwind CDN as a fallback to ensure the UI is consistent even if the build process is skipped #}
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            green: '#16a34a', // green-600
                            'green-dark': '#15803d', // green-700
                        }
                    }
                }
            }
        }
    </script>
    <style type="text/tailwindcss">
        @layer utilities {
            .glass-effect {
                @apply bg-white/95 backdrop-blur-md border border-brand-green/10;
            }
        }
    </style>
{% endblock %}

{% block body %}
	<div class="min-h-screen flex items-center justify-center bg-gray-50/50" style="background-image: radial-gradient(circle at 2px 2px, rgba(22, 163, 74, 0.05) 1px, transparent 0); background-size: 32px 32px;">
		<div class="max-w-md w-full glass-effect shadow-2xl rounded-3xl p-10 transform transition-all relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-2 bg-brand-green"></div>

            <div class="text-center mb-8">
                <div class="inline-flex items-center justify-center w-16 h-16 bg-green-100 rounded-full mb-4">
                    <svg class="w-8 h-8 text-brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                    </svg>
                </div>
			    <h1 class="text-3xl font-black text-gray-900 tracking-tight">Admin Login</h1>
                <p class="text-gray-500 mt-2 font-medium">Railway Production Control</p>
            </div>

			{# Show error if login failed #}
			{% if error %}
				<div class="mb-6 p-4 text-sm text-red-700 bg-red-50 border-l-4 border-red-500 rounded-r-lg animate-pulse font-bold">
					{{ error.messageKey|trans(error.messageData, 'security') }}
				</div>
			{% endif %}

			{# Flash messages #}
			{% for message in app.flashes('success') %}
				<div class="mb-6 p-4 text-sm text-green-700 bg-green-50 border-l-4 border-brand-green rounded-r-lg font-bold">
					{{ message }}
				</div>
			{% endfor %}
            {% for message in app.flashes('error') %}
				<div class="mb-6 p-4 text-sm text-red-700 bg-red-50 border-l-4 border-red-500 rounded-r-lg font-bold">
					{{ message }}
				</div>
			{% endfor %}

			<form method="post" class="space-y-6" x-data="{ loginType: '{{ last_login_type|default('email') }}' }">
				<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate_admin') }}">
				<input type="hidden" name="login_type" :value="loginType">

				<div class="space-y-3">
					<label class="block text-xs font-bold text-gray-400 uppercase tracking-widest ml-1">Authentication Method</label>
					<div class="grid grid-cols-2 gap-3 rounded-xl bg-gray-100 p-1.5" role="radiogroup">
						<button
							type="button"
							@click="loginType = 'email'"
							:class="loginType === 'email' ? 'bg-white text-brand-green shadow-md ring-1 ring-black/5' : 'text-gray-500 hover:text-gray-700'"
							class="rounded-lg px-4 py-2.5 text-sm font-black transition-all duration-200"
						>
							Email
						</button>
						<button
							type="button"
							@click="loginType = 'username'"
							:class="loginType === 'username' ? 'bg-white text-brand-green shadow-md ring-1 ring-black/5' : 'text-gray-500 hover:text-gray-700'"
							class="rounded-lg px-4 py-2.5 text-sm font-black transition-all duration-200"
						>
							Username
						</button>
					</div>
				</div>

				<div class="space-y-2">
					<label for="username" class="block text-sm font-bold text-gray-700 ml-1" x-text="loginType === 'email' ? 'Administrator Email' : 'Admin Username'"></label>
					<input
						:type="loginType === 'email' ? 'email' : 'text'"
						value="{{ last_username }}"
						name="_username"
						id="username"
						class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-4 focus:ring-green-100 focus:border-brand-green transition-all duration-200 font-medium"
						:placeholder="loginType === 'email' ? 'admin@easysave.com' : 'admin_user'"
						required
						autofocus
					>
				</div>

				<div class="space-y-2 relative">
					<label for="password" class="block text-sm font-bold text-gray-700 ml-1">Security Access Key</label>
					<input type="password" name="_password" id="password" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-4 focus:ring-green-100 focus:border-brand-green transition-all duration-200 pr-12 font-medium" placeholder="••••••••••••" required autocomplete="current-password">

					<div class="absolute bottom-3 right-4 flex items-center">
						<input type="checkbox" id="show_password" class="hidden">
						<label for="show_password" class="cursor-pointer text-gray-400 hover:text-brand-green transition-colors duration-200">
							<svg id="eye-open" class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
							</svg>
							<svg id="eye-closed" class="h-6 w-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.82L21 12 13.875 5.18M10.125 5.18L3 12l7.125 6.82"/>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15a3 3 0 100-6 3 3 0 000 6z"/>
							</svg>
						</label>
					</div>
				</div>

				<div class="flex items-center ml-1">
					<input type="checkbox" id="remember_me" name="_remember_me" class="h-5 w-5 text-brand-green focus:ring-brand-green border-gray-300 rounded-lg transition-all duration-200 cursor-pointer">
					<label for="remember_me" class="ml-3 block text-sm text-gray-600 font-bold cursor-pointer">Keep me signed in</label>
				</div>

				<button type="submit" class="w-full bg-brand-green text-white py-4 px-4 rounded-xl font-black shadow-lg hover:shadow-xl hover:bg-brand-green-dark transform hover:-translate-y-0.5 transition-all duration-200 uppercase tracking-widest text-sm">
					Access Dashboard
				</button>

				<div class="text-sm text-center pt-6 border-t border-gray-100">
					<a href="{{ path('app_user_login') }}" class="font-black text-brand-green hover:text-brand-green-dark hover:underline transition-colors duration-200">Return to User Login</a>
				</div>
			</form>
		</div>
	</div>

	<script>
		document.getElementById('show_password').addEventListener('change', function() {
			const password = document.getElementById('password');
			const eyeOpen = document.getElementById('eye-open');
			const eyeClosed = document.getElementById('eye-closed');
			
			if (this.checked) {
				password.type = 'text';
				eyeOpen.classList.add('hidden');
				eyeClosed.classList.remove('hidden');
			} else {
				password.type = 'password';
				eyeOpen.classList.remove('hidden');
				eyeClosed.classList.add('hidden');
			}
		});
	</script>
{% endblock %}
