{% extends 'auth/base.html.twig' %}

{% block title %}Admin Control Panel - EasySave{% endblock %}

{% block stylesheets %}
<style>
    :root {
        --brand-primary: #16a34a; /* green-600 */
        --brand-dark: #15803d;    /* green-700 */
        --brand-light: #f0fdf4;   /* green-50 */
    }
    .brand-green { color: var(--brand-primary); }
    .bg-brand-green { background-color: var(--brand-primary); }
    .bg-brand-green:hover { background-color: var(--brand-dark); }
    .border-brand-green { border-color: var(--brand-primary); }
    .ring-brand-green:focus { --tw-ring-color: var(--brand-primary); }
    
    .glass-panel {
        background: rgba(255, 255, 255, 0.98);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(22, 163, 74, 0.1);
    }
    .input-field {
        @apply w-full px-5 py-4 bg-gray-50 border border-gray-200 rounded-2xl transition-all duration-200 outline-none;
    }
    .input-field:focus {
        @apply ring-4 ring-green-100 border-green-600 bg-white;
    }
    [x-cloak] { display: none !important; }
</style>
{% endblock %}

{% block body %}
	<div class="min-h-screen flex items-center justify-center bg-gray-50 px-4 py-12" style="background-image: radial-gradient(circle at 2px 2px, rgba(22, 163, 74, 0.05) 1px, transparent 0); background-size: 32px 32px;">
		<div class="max-w-md w-full glass-panel shadow-2xl rounded-3xl p-10 md:p-12 relative overflow-hidden transition-all duration-300">
            <div class="absolute top-0 left-0 w-full h-2 bg-brand-green"></div>
            
            <div class="text-center mb-10">
                <div class="inline-flex items-center justify-center w-20 h-20 bg-green-50 rounded-full mb-6 border border-green-100 shadow-inner">
                    <svg class="w-10 h-10 brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                    </svg>
                </div>
			    <h1 class="text-3xl font-black text-gray-900 tracking-tight">Admin Login</h1>
                <p class="text-gray-500 mt-2 font-semibold">EasySave Production Control</p>
            </div>

			{# Error Alerts #}
			{% if error %}
				<div class="mb-8 p-4 text-sm text-red-700 bg-red-50 border-l-4 border-red-500 rounded-lg flex items-start animate-pulse">
                    <svg class="w-5 h-5 mr-3 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
					<span class="font-bold">{{ error.messageKey|trans(error.messageData, 'security') }}</span>
				</div>
			{% endif %}

			{# Flash Messages #}
			{% for message in app.flashes('success') %}
				<div class="mb-8 p-4 text-sm text-green-700 bg-green-50 border-l-4 border-brand-green rounded-lg flex items-start">
                    <svg class="w-5 h-5 mr-3 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
					<span class="font-bold">{{ message }}</span>
				</div>
			{% endfor %}
            {% for message in app.flashes('error') %}
				<div class="mb-8 p-4 text-sm text-red-700 bg-red-50 border-l-4 border-red-500 rounded-lg flex items-start">
                    <svg class="w-5 h-5 mr-3 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
					<span class="font-bold">{{ message }}</span>
				</div>
			{% endfor %}

			<form method="post" class="space-y-6" x-data="{ loginType: '{{ last_login_type|default('email') }}' }">
				<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate_admin') }}">
				<input type="hidden" name="login_type" :value="loginType">

				<div class="space-y-3">
					<label class="block text-xs font-black text-gray-400 uppercase tracking-widest ml-1">Identity Provider</label>
					<div class="grid grid-cols-2 gap-2 rounded-2xl bg-gray-100 p-1.5" role="radiogroup">
						<button
							type="button"
							@click="loginType = 'email'"
							:class="loginType === 'email' ? 'bg-white text-green-600 shadow-sm' : 'text-gray-500 hover:text-gray-700'"
							class="rounded-xl px-4 py-3 text-sm font-black transition-all duration-200"
						>
							Work Email
						</button>
						<button
							type="button"
							@click="loginType = 'username'"
							:class="loginType === 'username' ? 'bg-white text-green-600 shadow-sm' : 'text-gray-500 hover:text-gray-700'"
							class="rounded-xl px-4 py-3 text-sm font-black transition-all duration-200"
						>
							Username
						</button>
					</div>
				</div>

				<div class="space-y-2">
					<label for="username" class="block text-sm font-bold text-gray-700 ml-1" x-text="loginType === 'email' ? 'Admin Email Address' : 'Account Username'"></label>
					<input
						:type="loginType === 'email' ? 'email' : 'text'"
						value="{{ last_username }}"
						name="_username"
						id="username"
						class="w-full px-5 py-4 bg-gray-50 border border-gray-200 rounded-2xl focus:outline-none focus:ring-4 ring-green-100 border-green-600 transition-all duration-200 font-medium"
						:placeholder="loginType === 'email' ? 'admin@easysave.com' : 'administrator'"
						required
						autofocus
					>
				</div>

				<div class="space-y-2 relative">
					<label for="password" class="block text-sm font-bold text-gray-700 ml-1">Access Key</label>
					<input type="password" name="_password" id="password" class="w-full px-5 py-4 bg-gray-50 border border-gray-200 rounded-2xl focus:outline-none focus:ring-4 ring-green-100 border-green-600 transition-all duration-200 pr-14 font-medium" placeholder="••••••••••••" required autocomplete="current-password">

					<div class="absolute bottom-4 right-5 flex items-center">
						<input type="checkbox" id="show_password" class="hidden">
						<label for="show_password" class="cursor-pointer text-gray-400 hover:text-green-600 transition-colors duration-200">
							<svg id="eye-open" class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
							</svg>
							<svg id="eye-closed" class="h-6 w-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.82L21 12 13.875 5.18M10.125 5.18L3 12l7.125 6.82"/>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15a3 3 0 100-6 3 3 0 000 6z"/>
							</svg>
						</label>
					</div>
				</div>

				<div class="flex items-center ml-1">
					<input type="checkbox" id="remember_me" name="_remember_me" class="h-5 w-5 text-green-600 focus:ring-green-600 border-gray-300 rounded-lg transition-all duration-200 cursor-pointer">
					<label for="remember_me" class="ml-3 block text-sm text-gray-600 font-bold cursor-pointer">Keep session active</label>
				</div>

				<button type="submit" class="w-full bg-brand-green text-white py-5 px-6 rounded-2xl font-black shadow-xl hover:shadow-2xl transform hover:-translate-y-1 transition-all duration-300 uppercase tracking-widest text-sm">
					Unlock Control Panel
				</button>

				<div class="text-sm text-center pt-8 border-t border-gray-100 mt-4">
					<a href="{{ path('app_user_login') }}" class="font-black brand-green hover:underline flex items-center justify-center transition-all duration-200">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                        </svg>
                        Return to Public Login
                    </a>
				</div>
			</form>
		</div>
	</div>

	<script>
		document.getElementById('show_password').addEventListener('change', function() {
			const password = document.getElementById('password');
			const eyeOpen = document.getElementById('eye-open');
			const eyeClosed = document.getElementById('eye-closed');
			
			if (this.checked) {
				password.type = 'text';
				eyeOpen.classList.add('hidden');
				eyeClosed.classList.remove('hidden');
			} else {
				password.type = 'password';
				eyeOpen.classList.remove('hidden');
				eyeClosed.classList.add('hidden');
			}
		});
	</script>
{% endblock %}
