{% extends 'admin/base.html.twig' %}

{% block title %}User Details: {{ user.username }}{% endblock %}

{% block body %}
<div class="container mx-auto px-4 sm:px-8 py-8">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-semibold text-gray-800">User Details: <span class="text-indigo-600">{{ user.username }}</span></h1>
        <a href="{{ path('app_admin_user_management') }}" class="text-indigo-600 hover:text-indigo-900">&larr; Back to User List</a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Left Column: User Info & Addresses -->
        <div class="lg:col-span-1 space-y-6">
            <!-- User Information -->
            <div class="bg-white p-6 rounded-lg shadow">
                <h2 class="text-xl font-semibold mb-4 border-b pb-3">Profile Information</h2>
                <div class="space-y-3">
                    <div>
                        <p class="text-sm text-gray-500">User ID</p>
                        <p class="font-semibold text-gray-800">#{{ user.id }}</p>
                    </div>
                    <div>
                        <p class="text-sm text-gray-500">Username</p>
                        <p class="font-semibold text-gray-800">{{ user.username }}</p>
                    </div>
                    {#
                    <div>
                        <p class="text-sm text-gray-500">Email</p>
                        <p class="font-semibold text-gray-800">{{ user.email }}</p>
                    </div>
                    #}
                    <div>
                        <p class="text-sm text-gray-500">Roles</p>
                        <div class="flex flex-wrap gap-1 mt-1">
                            {% for role in user.roles %}
                                <span class="inline-block bg-blue-100 text-blue-800 text-xs px-2 py-1 rounded-full">{{ role }}</span>
                            {% endfor %}
                        </div>
                    </div>
                    {#
                    <div>
                        <p class="text-sm text-gray-500">Account Status</p>
                        {% if user.isVerified %}
                            <span class="inline-flex items-center gap-1 font-semibold text-green-600">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
                                Verified
                            </span>
                        {% else %}
                            <span class="inline-flex items-center gap-1 font-semibold text-red-600">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" /></svg>
                                Not Verified
                            </span>
                        {% endif %}
                    </div>
                    #}
                </div>
            </div>

            <!-- Addresses -->
            <div class="bg-white p-6 rounded-lg shadow">
                <h2 class="text-xl font-semibold mb-4 border-b pb-3">Shipping Addresses</h2>
                {% if user.addresses is not empty %}
                    <div class="space-y-4">
                        {% for address in user.addresses %}
                            <div class="text-sm p-3 bg-gray-50 rounded-md border">
                                <p class="font-semibold text-gray-800">{{ address.street }}, {{ address.cityMunicipality }}</p>
                                <p class="text-gray-600">{{ address.province }}, {{ address.postalCode }}, {# {{ address.country }} #}</p>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="text-sm text-gray-500 italic">No addresses found for this user.</p>
                {% endif %}
            </div>
        </div>

        <!-- Right Column: Order History -->
        <div class="lg:col-span-2">
            <div class="bg-white p-6 rounded-lg shadow">
                <h2 class="text-xl font-semibold mb-4 border-b pb-3">Order History</h2>
                {% if user.orders is not empty %}
                    <div class="overflow-x-auto">
                        <table class="min-w-full text-sm">
                            <thead class="bg-gray-50 text-left">
                                <tr>
                                    <th class="px-4 py-2 font-medium text-gray-600">Order ID</th>
                                    <th class="px-4 py-2 font-medium text-gray-600">Date</th>
                                    <th class="px-4 py-2 font-medium text-gray-600">Status</th>
                                    <th class="px-4 py-2 font-medium text-gray-600 text-right">Total</th>
                                    <th class="px-4 py-2 font-medium text-gray-600"></th>
                                </tr>
                            </thead>
                            <tbody class="divide-y">
                                {% for order in user.orders|sort((a, b) => b.createdAt <=> a.createdAt) %}
                                    <tr class="hover:bg-gray-50">
                                        <td class="px-4 py-3 font-mono text-gray-800">#{{ order.id }}</td>
                                        <td class="px-4 py-3 text-gray-600">{{ order.createdAt|date('M d, Y') }}</td>
                                        <td class="px-4 py-3">
                                            <span class="relative inline-block px-2 py-1 font-semibold leading-tight text-xs rounded-full 
                                                {{ order.status == 'Delivered' ? 'bg-green-200 text-green-900' : 
                                                   (order.status == 'Shipped' ? 'bg-blue-200 text-blue-900' : 
                                                   (order.status == 'Cancelled' ? 'bg-red-200 text-red-900' : 'bg-yellow-200 text-yellow-900')) }}">
                                                {{ order.status }}
                                            </span>
                                        </td>
                                        <td class="px-4 py-3 text-gray-800 font-semibold text-right">€{{ order.total|number_format(2) }}</td>
                                        <td class="px-4 py-3 text-right">
                                            <a href="{{ path('app_admin_order_show', {'id': order.id}) }}" class="text-indigo-600 hover:underline text-xs font-bold">View Order</a>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <p class="text-sm text-gray-500 italic">This user has not placed any orders yet.</p>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}