{% extends 'admin/base.html.twig' %}

{% block title %}User Management{% endblock %}

{% block body %}
<div class="container mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Title -->
    <h1 class="text-2xl font-bold mb-6 text-gray-800">User Management</h1>

    <!-- Table Wrapper (Scroll on mobile) -->
    <div class="overflow-x-auto bg-white shadow rounded-lg border border-gray-200">
        <table class="min-w-full text-sm text-left text-gray-700">
            <thead class="bg-gray-100 text-gray-800 uppercase text-xs font-semibold tracking-wider">
                <tr>
                    <th class="px-4 py-3">ID</th>
                    <th class="px-4 py-3">Username</th>
                    <!-- <th class="px-4 py-3">Email</th> -->
                    <th class="px-4 py-3">Roles</th>
                    <!-- <th class="px-4 py-3">Verified</th> -->
                    <th class="px-4 py-3 text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for user in users|default([]) %}
                    <tr class="border-b border-gray-200 hover:bg-gray-50">
                        <td class="px-4 py-3">{{ user.id }}</td>
                        <td class="px-4 py-3 font-medium text-gray-900">{{ user.username }}</td>
                        {# <td class="px-4 py-3">{{ user.email }}</td> #}
                        <td class="px-4 py-3">
                            {% for role in user.roles %}
                                <span class="inline-block bg-blue-100 text-blue-800 text-xs px-2 py-1 rounded-full mr-1 mb-1">{{ role }}</span>
                            {% endfor %}
                        </td>
                        {#}
                        <td class="px-4 py-3">
                            {% if user.isVerified %}
                                <span class="text-green-600 font-semibold">Yes</span>
                            {% else %}
                                <span class="text-red-600 font-semibold">No</span>
                            {% endif %}
                        </td>
                        #}
                        <td class="px-4 py-3 text-center">
                            <a href="{{ path('app_admin_user_show', {'id': user.id}) }}" class="text-blue-600 hover:underline mr-2">View</a>
                            {# The routes for edit and delete are not yet created.
                            <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="text-green-600 hover:underline mr-2">Edit</a>
                            {{ include('user_management/_delete_form.html.twig', {'user': user}) }} #}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="px-4 py-3 text-center text-gray-500">No users found.</td>
                    </tr>
                {% endfor %} 
            </tbody>
        </table>
    </div>
</div>
{% endblock %}