<!DOCTYPE html>
<html lang="en" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin</title>
    <script src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('build/app.css') }}">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script>
        // Set initial theme based on localStorage or system preference
        if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark')
        } else {
            document.documentElement.classList.remove('dark')
        }
    </script>
</head>

<body class="font-[Poppins] bg-gray-100 dark:bg-gray-900 h-screen w-screen overflow-hidden flex transition-colors duration-300" style="font-family:'Poppins', sans-serif">
    
    <!-- Sidebar -->
    {% include 'partials/admin/sidebar.html.twig' %}

    <!-- Main Content -->
    <div class="flex-1 flex flex-col overflow-hidden w-full">
        
        <!-- Navbar -->
        {% include 'partials/admin/navbar.html.twig' %}
        
        <!-- Flash Messages -->
        {% include 'partials/admin/_flashes.html.twig' %}
        
        <!-- Main Body -->
        <main class="flex-1 overflow-x-hidden overflow-y-auto bg-white dark:bg-gray-900 transition-colors duration-300">
            <div class="container mx-auto px-4 py-8">
                {% block body %}{% endblock %}
            </div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

    <script>
        // Sidebar state persistence
        document.addEventListener('alpine:init', () => {
            Alpine.store('sidebarOpen', localStorage.getItem('sidebarOpen') === 'true');
            
            Alpine.effect(() => {
                localStorage.setItem('sidebarOpen', Alpine.store('sidebarOpen'));
            });
        });
    </script>
</body>
</html>
