{% extends 'admin/base.html.twig' %}

{% block body %}
	<div class="max-w-5xl mx-auto py-8">
		<!-- Page Header -->
		<div class="mb-8">
			<a href="{{ path('app_product_index') }}" class="inline-flex items-center text-green-600 hover:text-green-800 font-medium transition-colors group">
				<svg class="w-5 h-5 mr-2 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
				</svg>
				Back to Products
			</a>
			<div class="mt-6">
				<h1 class="text-3xl font-bold text-gray-900">Edit Product</h1>
				<p class="text-gray-600 mt-2">Update product information and settings</p>
			</div>
		</div>

		<!-- Product Form -->
		<div class="bg-white rounded-xl shadow-lg overflow-hidden">
			<!-- Form Header -->
			<div class="bg-gradient-to-r from-green-50 to-emerald-50 px-8 py-6 border-b border-gray-200">
				<div class="flex items-center">
					<div class="bg-green-100 p-3 rounded-lg mr-4">
						<svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
						</svg>
					</div>
					<div>
						<h2 class="text-xl font-semibold text-gray-800">{{ product.name }}</h2>
						<p class="text-gray-600 text-sm">ID: {{ product.id }} • Last updated: {{ product.updatedAt|date('M d, Y') }}</p>
					</div>
				</div>
			</div>

			<div class="p-8">
				<!-- Error Messages -->
				{% if app.flashes('error')|length > 0 %}
					<div class="mb-8 p-4 bg-red-50 border-l-4 border-red-500 rounded-lg">
						<div class="flex items-center">
							<svg class="w-5 h-5 text-red-500 mr-3" fill="currentColor" viewBox="0 0 20 20">
								<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
							</svg>
							<h3 class="font-semibold text-red-800">Please correct the following errors:</h3>
						</div>
						<ul class="mt-2 text-red-700 space-y-1 text-sm ml-8">
							{% for message in app.flashes('error') %}
								<li class="flex items-start">
									<svg class="w-4 h-4 mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M10 5a1 1 0 011 1v3a1 1 0 11-2 0V6a1 1 0 011-1zm0 8a1 1 0 100 2 1 1 0 000-2z" clip-rule="evenodd" />
									</svg>
									<span>{{ message }}</span>
								</li>
							{% endfor %}
						</ul>
					</div>
				{% endif %}

				{{ form_start(form, {attr: {class: 'space-y-8'}}) }}
					
					<!-- Basic Information Card -->
					<div class="bg-gray-50 rounded-xl p-6 border border-gray-200">
						<h3 class="text-lg font-semibold text-gray-800 mb-6 pb-3 border-b border-gray-200">Basic Information</h3>
						
						<div class="space-y-6">
							<!-- Product Name -->
							<div>
								{{ form_row(form.name, {
									row_attr: {class: 'mb-0'},
									label_attr: {class: 'block text-sm font-medium text-gray-700 mb-2'},
									attr: {
										class: 'w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-colors text-gray-900 placeholder-gray-500'
									}
								}) }}
							</div>

							<!-- Brand -->
							<div>
								{{ form_row(form.brand, {
									row_attr: {class: 'mb-0'},
									label_attr: {class: 'block text-sm font-medium text-gray-700 mb-2'},
									attr: {
										class: 'w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-colors text-gray-900 placeholder-gray-500'
									}
								}) }}
							</div>

							<!-- Description -->
							<div>
								{{ form_row(form.description, {
									row_attr: {class: 'mb-0'},
									label_attr: {class: 'block text-sm font-medium text-gray-700 mb-2'},
									attr: {
										class: 'w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-colors text-gray-900 placeholder-gray-500',
										rows: 4
									}
								}) }}
							</div>

							<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
								<!-- Price -->
								<div>
									{{ form_row(form.price, {
										row_attr: {class: 'mb-0'},
										label_attr: {class: 'block text-sm font-medium text-gray-700 mb-2'},
										attr: {
											class: 'w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-colors text-gray-900 placeholder-gray-500'
										}
									}) }}
								</div>

								<!-- Stock -->
								<div>
									{{ form_row(form.stock, {
										row_attr: {class: 'mb-0'},
										label_attr: {class: 'block text-sm font-medium text-gray-700 mb-2'},
										attr: {
											class: 'w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-colors text-gray-900 placeholder-gray-500'
										}
									}) }}
								</div>
							</div>

							<!-- Category & Status -->
							<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
								<!-- Category -->
								<div>
									{{ form_row(form.category, {
										row_attr: {class: 'mb-0'},
										label_attr: {class: 'block text-sm font-medium text-gray-700 mb-2'},
										attr: {
											class: 'w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-colors text-gray-900'
										}
									}) }}
								</div>

								<!-- Is Active -->
								<div class="flex items-start">
									<div class="bg-white p-4 rounded-lg border border-gray-200 w-full">
										{{ form_row(form.isActive, {
											row_attr: {class: 'mb-0'},
											label_attr: {class: 'flex items-center cursor-pointer'},
											attr: {class: 'w-4 h-4 text-green-600 border-gray-300 rounded focus:ring-green-500'}
										}) }}
										<p class="text-xs text-gray-500 mt-2">When inactive, product won't be visible to customers</p>
									</div>
								</div>
							</div>
						</div>
					</div>

					<!-- Main Product Image Card -->
					<div class="bg-gray-50 rounded-xl p-6 border border-gray-200">
						<h3 class="text-lg font-semibold text-gray-800 mb-6 pb-3 border-b border-gray-200">Main Product Image</h3>
						
						<!-- Current Image -->
						{% if product.imagePath %}
							<div class="mb-8">
								<p class="text-sm font-medium text-gray-700 mb-4">Current Image</p>
								<div class="flex flex-col md:flex-row md:items-end gap-6">
									<div class="flex-shrink-0">
										<div class="w-48 h-48 bg-gradient-to-br from-gray-50 to-gray-100 rounded-xl overflow-hidden border-2 border-gray-300 shadow-sm">
											<img src="{{ asset(product.imagePath) }}" alt="{{ product.name }}" 
												 class="w-full h-full object-cover transition-transform hover:scale-105 duration-300">
										</div>
									</div>
									<div class="flex-1">
										<p class="text-sm font-medium text-gray-900">File: {{ product.imagePath|split('/')|last }}</p>
										<p class="text-xs text-gray-500 mt-1">Main product image displayed in listings</p>
									</div>
								</div>
							</div>
						{% endif %}

						<!-- Upload New Main Image -->
						<div class="space-y-4">
							{{ form_row(form.imageFile, {
								row_attr: {class: 'mb-0'},
								label_attr: {class: 'block text-sm font-medium text-gray-700 mb-2'},
								attr: {
									class: 'block w-full px-4 py-3 border-2 border-dashed border-gray-300 rounded-xl hover:border-blue-400 focus:border-blue-500 focus:ring-2 focus:ring-blue-500 focus:ring-opacity-50 transition-colors cursor-pointer file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100'
								},
								label: product.imagePath ? 'Replace Main Image' : 'Upload Main Image'
							}) }}
							<div class="flex items-center text-sm text-gray-600 bg-blue-50 rounded-lg p-3">
								<svg class="w-5 h-5 text-blue-500 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
									<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
								</svg>
								<span>Leave empty to keep current image. Max 5MB. Supported: JPG, PNG, GIF, WebP</span>
							</div>
						</div>
					</div>

					<!-- Additional Images Card -->
					<div class="bg-gray-50 rounded-xl p-6 border border-gray-200">
						<div class="flex items-center justify-between mb-6 pb-3 border-b border-gray-200">
							<div>
								<h3 class="text-lg font-semibold text-gray-800">Gallery Images</h3>
								<p class="text-sm text-gray-600 mt-1">Additional product images</p>
							</div>
							<span class="bg-blue-100 text-blue-800 text-xs font-medium px-3 py-1 rounded-full">
								{{ product.productImages|length }} image{{ product.productImages|length != 1 ? 's' : '' }}
							</span>
						</div>

						<!-- Current Gallery Images -->
						{% if product.productImages|length > 0 %}
							<div class="mb-8">
								<p class="text-sm font-medium text-gray-700 mb-4">Current Gallery</p>
								<div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
									{% for image in product.productImages %}
										<div class="relative group">
											<div class="aspect-square bg-gradient-to-br from-gray-50 to-gray-100 rounded-lg overflow-hidden border border-gray-300 shadow-sm">
												<img src="{{ asset(image.imagePath) }}" alt="Gallery image" 
													 class="w-full h-full object-cover transition-transform group-hover:scale-110 duration-300">
											</div>
											<div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-30 transition-all duration-300 rounded-lg flex items-center justify-center opacity-0 group-hover:opacity-100">
												<form method="post" action="{{ path('app_product_image_delete', {'product': product.id, 'imageId': image.id}) }}">
													<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ image.id) }}">
													<button type="submit" 
															class="p-2 bg-red-600 text-white rounded-full hover:bg-red-700 transition-colors transform translate-y-2 group-hover:translate-y-0 transition-transform duration-300"
															onclick="return confirm('Are you sure you want to delete this image?');">
														<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
															<path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
														</svg>
													</button>
												</form>
											</div>
										</div>
									{% endfor %}
								</div>
							</div>
						{% else %}
							<div class="mb-8 text-center py-8 border-2 border-dashed border-gray-300 rounded-xl bg-gradient-to-br from-gray-50 to-white">
								<svg class="w-12 h-12 text-gray-400 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
								</svg>
								<p class="text-gray-600">No additional images yet</p>
								<p class="text-sm text-gray-500 mt-1">Add images to create a product gallery</p>
							</div>
						{% endif %}

						<!-- Upload Multiple Images -->
						<div class="space-y-4">
							<label class="block">
								<span class="text-sm font-medium text-gray-700">Add More Images</span>
								<div class="mt-2">
									<input type="file" id="images" name="images[]" multiple accept="image/*"
										   class="block w-full px-4 py-3 border-2 border-dashed border-gray-300 rounded-xl hover:border-green-400 focus:border-green-500 focus:ring-2 focus:ring-green-500 focus:ring-opacity-50 transition-colors cursor-pointer file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-green-50 file:text-green-700 hover:file:bg-green-100">
								</div>
							</label>
							
							<div class="flex items-center text-sm text-gray-600 bg-green-50 rounded-lg p-3">
								<svg class="w-5 h-5 text-green-500 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
									<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
								</svg>
								<span>Select multiple images. Max 5MB per file. You can upload up to 10 images</span>
							</div>

							<!-- CSRF Token for Image Upload -->
							<input type="hidden" name="_token" value="{{ csrf_token('add_image' ~ product.id) }}">
							<div class="flex justify-end">
								<button type="button" 
										onclick="this.form.action='{{ path('app_product_image_add', {'product': product.id}) }}'; this.form.method='POST'; if(document.getElementById('images').files.length > 0) { this.closest('form').submit(); } else { alert('Please select at least one image to upload.'); }"
										class="inline-flex items-center px-5 py-2.5 bg-gradient-to-r from-green-600 to-emerald-600 text-white font-medium rounded-lg hover:from-green-700 hover:to-emerald-700 transition-all shadow-sm hover:shadow">
									<svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM6.293 6.707a1 1 0 010-1.414l3-3a1 1 0 011.414 0l3 3a1 1 0 01-1.414 1.414L11 5.414V13a1 1 0 11-2 0V5.414L7.707 6.707a1 1 0 01-1.414 0z" clip-rule="evenodd" />
									</svg>
									Upload Selected Images
								</button>
							</div>
						</div>
					</div>

					<!-- Action Buttons -->
					<div class="pt-8 border-t border-gray-200">
						<div class="flex flex-col sm:flex-row gap-4">
							<button type="submit"
									class="flex-1 px-6 py-3.5 bg-gradient-to-r from-green-600 to-emerald-600 text-white font-medium rounded-lg hover:from-green-700 hover:to-emerald-700 transition-all shadow-sm hover:shadow focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500">
								<div class="flex items-center justify-center">
									<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
									</svg>
									Save All Changes
								</div>
							</button>
							<a href="{{ path('app_product_index') }}"
							   class="flex-1 px-6 py-3.5 bg-white text-gray-700 font-medium rounded-lg border border-gray-300 hover:bg-gray-50 transition-all shadow-sm hover:shadow text-center">
								Cancel
							</a>
						</div>
						<p class="text-center text-xs text-gray-500 mt-4">
							All changes will be saved immediately. You can preview changes before publishing.
						</p>
					</div>
				{{ form_end(form) }}
			</div>
		</div>
	</div>
{% endblock %}