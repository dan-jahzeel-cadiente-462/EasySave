{% extends 'admin/base.html.twig' %}

{% block body %}
	<div class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
		<!-- Page Header -->
		<div class="mb-8">
			<a href="{{ path('app_product_index') }}" class="inline-flex items-center text-green-600 hover:text-green-800 font-medium transition-colors group mb-6">
				<svg class="w-5 h-5 mr-2 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
				</svg>
				Back to Products
			</a>
			<div class="flex justify-between items-end">
				<div>
					<h1 class="text-3xl font-bold text-gray-900">Edit Product</h1>
					<p class="text-gray-600 mt-2">Update product information and settings</p>
				</div>
				<div class="text-right">
					<span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
						Product ID: {{ product.id }}
					</span>
				</div>
			</div>
		</div>

		<!-- Error Messages -->
		{% if app.flashes('error')|length > 0 %}
			<div class="mb-8 bg-red-50 border-l-4 border-red-500 rounded-lg p-4">
				<div class="flex items-start">
					<svg class="w-5 h-5 text-red-500 mr-3 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
						<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
					</svg>
					<div>
						<h3 class="font-semibold text-red-800">Please correct the following errors:</h3>
						<ul class="mt-2 text-red-700 space-y-1">
							{% for message in app.flashes('error') %}
								<li class="flex items-start">
									<svg class="w-4 h-4 mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M10 5a1 1 0 011 1v3a1 1 0 11-2 0V6a1 1 0 011-1zm0 8a1 1 0 100 2 1 1 0 000-2z" clip-rule="evenodd" />
									</svg>
									<span>{{ message }}</span>
								</li>
							{% endfor %}
						</ul>
					</div>
				</div>
			</div>
		{% endif %}

		<!-- Two Column Layout -->
		<div class="flex flex-col lg:flex-row gap-8">
			<!-- Main Content Column -->
			<div class="flex-1 space-y-8">
				{{ form_start(form, {attr: {class: 'space-y-8', id: 'product-form'}}) }}
				
				<!-- Basic Information Card -->
				<div class="bg-white rounded-xl shadow-lg overflow-hidden border border-gray-200">
					<div class="bg-gradient-to-r from-blue-50 to-indigo-50 px-6 py-4 border-b border-gray-200">
						<div class="flex items-center">
							<div class="bg-blue-100 p-2 rounded-lg mr-3">
								<svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
								</svg>
							</div>
							<h3 class="text-lg font-semibold text-gray-800">Basic Information</h3>
						</div>
					</div>
					
					<div class="p-6 space-y-6">
						<!-- Product Name and Brand Row -->
						<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
							<div>
								{{ form_label(form.name, 'Product Name', {label_attr: {class: 'block text-sm font-semibold text-gray-700 mb-2'}}) }}
								{{ form_widget(form.name, {attr: {
									class: 'w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors',
									placeholder: 'Enter product name'
								}}) }}
								{{ form_errors(form.name) }}
							</div>
							<div>
								{{ form_label(form.brand, 'Brand', {label_attr: {class: 'block text-sm font-semibold text-gray-700 mb-2'}}) }}
								{{ form_widget(form.brand, {attr: {
									class: 'w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors',
									placeholder: 'Enter brand name'
								}}) }}
								{{ form_errors(form.brand) }}
							</div>
						</div>

						<!-- Description -->
						<div>
							{{ form_label(form.description, 'Description', {label_attr: {class: 'block text-sm font-semibold text-gray-700 mb-2'}}) }}
							{{ form_widget(form.description, {attr: {
								class: 'w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors',
								rows: 5,
								placeholder: 'Describe your product...'
							}}) }}
							{{ form_errors(form.description) }}
							<p class="text-xs text-gray-500 mt-1">Write a detailed description of your product</p>
						</div>

						<!-- Price and Stock Row -->
						<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
							<div>
								{{ form_label(form.price, 'Price (USD)', {label_attr: {class: 'block text-sm font-semibold text-gray-700 mb-2'}}) }}
								<div class="relative">
									<span class="absolute left-3 top-2.5 text-gray-500">$</span>
									{{ form_widget(form.price, {attr: {
										class: 'w-full pl-7 pr-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors',
										placeholder: '0.00'
									}}) }}
								</div>
								{{ form_errors(form.price) }}
							</div>
							<div>
								{{ form_label(form.stock, 'Stock Quantity', {label_attr: {class: 'block text-sm font-semibold text-gray-700 mb-2'}}) }}
								{{ form_widget(form.stock, {attr: {
									class: 'w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors',
									placeholder: '0'
								}}) }}
								{{ form_errors(form.stock) }}
							</div>
						</div>

						<!-- Category and Status Row -->
						<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
							<div>
								{{ form_label(form.category, 'Category', {label_attr: {class: 'block text-sm font-semibold text-gray-700 mb-2'}}) }}
								{{ form_widget(form.category, {attr: {
									class: 'w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors'
								}}) }}
								{{ form_errors(form.category) }}
							</div>
							<div>
								<div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg border border-gray-200">
									<div>
										{{ form_label(form.isActive, 'Product Status', {label_attr: {class: 'text-sm font-semibold text-gray-700'}}) }}
										<p class="text-xs text-gray-500 mt-1">Active products appear in store</p>
									</div>
									{{ form_widget(form.isActive, {attr: {
										class: 'w-5 h-5 text-blue-600 border-gray-300 rounded focus:ring-blue-500'
									}}) }}
								</div>
							</div>
						</div>
					</div>
				</div>

				<!-- Product Images Section -->
				<div class="bg-white rounded-xl shadow-lg overflow-hidden border border-gray-200">
					<div class="bg-gradient-to-r from-purple-50 to-pink-50 px-6 py-4 border-b border-gray-200">
						<div class="flex items-center justify-between">
							<div class="flex items-center">
								<div class="bg-purple-100 p-2 rounded-lg mr-3">
									<svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
									</svg>
								</div>
								<h3 class="text-lg font-semibold text-gray-800">Product Images</h3>
							</div>
							<span class="text-sm text-gray-600">{{ product.productImages|length }} gallery image(s)</span>
						</div>
					</div>
					
					<div class="p-6 space-y-8">
						<!-- Main Image -->
						<div>
							<h4 class="text-md font-semibold text-gray-800 mb-4">Main Product Image</h4>
							<div class="flex flex-col sm:flex-row gap-6 items-start">
								{% if product.imagePath %}
									<div class="flex-shrink-0">
										<div class="w-40 h-40 rounded-lg overflow-hidden border-2 border-gray-200 shadow-md">
											<img src="{{ asset(product.imagePath) }}" alt="{{ product.name }}" 
												 class="w-full h-full object-cover">
										</div>
									</div>
								{% endif %}
								<div class="flex-1">
									{{ form_label(form.imageFile, product.imagePath ? 'Replace Main Image' : 'Upload Main Image', {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-2'}}) }}
									{{ form_widget(form.imageFile, {attr: {
										class: 'block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 cursor-pointer'
									}}) }}
									{{ form_errors(form.imageFile) }}
									<p class="text-xs text-gray-500 mt-2">Max 5MB. JPG, PNG, GIF, WebP</p>
								</div>
							</div>
						</div>

						<!-- Gallery Images -->
						<div>
							<h4 class="text-md font-semibold text-gray-800 mb-4">Gallery Images</h4>
							
							{% if product.productImages|length > 0 %}
								<div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4 mb-6">
									{% for image in product.productImages %}
										<div class="relative group">
											<div class="aspect-square rounded-lg overflow-hidden border border-gray-200 shadow-sm">
												<img src="{{ asset(image.imagePath) }}" alt="Gallery image" 
													 class="w-full h-full object-cover">
											</div>
											<div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-50 transition-all rounded-lg flex items-center justify-center opacity-0 group-hover:opacity-100">
												<form method="post" action="{{ path('app_product_image_delete', {'product': product.id, 'imageId': image.id}) }}" class="inline" onsubmit="return confirm('Are you sure you want to delete this image?');">
													<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ image.id) }}">
													<button type="submit" 
															class="p-2 bg-red-600 text-white rounded-full hover:bg-red-700 transition-colors">
														<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
															<path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
														</svg>
													</button>
												</form>
											</div>
										</div>
									{% endfor %}
								</div>
							{% else %}
								<div class="text-center py-8 bg-gray-50 rounded-lg border-2 border-dashed border-gray-300 mb-6">
									<svg class="w-12 h-12 text-gray-400 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
									</svg>
									<p class="text-gray-600">No gallery images yet</p>
								</div>
							{% endif %}

							<!-- Add Gallery Images -->
							<div class="bg-gray-50 rounded-lg p-4">
								<label class="block text-sm font-medium text-gray-700 mb-2">Add More Images</label>
								<input type="file" id="images" name="images[]" multiple accept="image/*"
									   class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-green-50 file:text-green-700 hover:file:bg-green-100 cursor-pointer">
								<p class="text-xs text-gray-500 mt-2">Select multiple images. Max 5MB each, up to 10 images</p>
								<input type="hidden" name="_token" value="{{ csrf_token('add_image' ~ product.id) }}">
								<div class="mt-4">
									<button type="button" 
											onclick="this.form.action='{{ path('app_product_image_add', {'product': product.id}) }}'; this.form.method='POST'; if(document.getElementById('images').files.length > 0) { this.closest('form').submit(); } else { alert('Please select images to upload.'); }"
											class="inline-flex items-center px-4 py-2 bg-green-600 text-white text-sm font-medium rounded-lg hover:bg-green-700 transition-colors">
										<svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
											<path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM6.293 6.707a1 1 0 010-1.414l3-3a1 1 0 011.414 0l3 3a1 1 0 01-1.414 1.414L11 5.414V13a1 1 0 11-2 0V5.414L7.707 6.707a1 1 0 01-1.414 0z" clip-rule="evenodd" />
										</svg>
										Upload Gallery Images
									</button>
								</div>
							</div>
						</div>
					</div>
				</div>

				<!-- Form Actions -->
				<div class="bg-white rounded-xl shadow-lg overflow-hidden border border-gray-200 sticky bottom-0">
					<div class="px-6 py-4 bg-gray-50">
						<div class="flex flex-col sm:flex-row gap-3">
							<button type="submit"
									class="flex-1 px-6 py-3 bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-semibold rounded-lg hover:from-blue-700 hover:to-indigo-700 transition-all shadow-md">
								<div class="flex items-center justify-center">
									<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
									</svg>
									Save Changes
								</div>
							</button>
							<a href="{{ path('app_product_index') }}"
							   class="flex-1 px-6 py-3 bg-white text-gray-700 font-semibold rounded-lg border border-gray-300 hover:bg-gray-50 transition-colors text-center">
								Cancel
							</a>
						</div>
						<p class="text-center text-xs text-gray-500 mt-4">
							All changes will be saved immediately. You can preview changes before publishing.
						</p>
					</div>
				</div>
				
				{{ form_end(form) }}
			</div>

			<!-- Sidebar Column -->
			<div class="lg:w-80 space-y-6">
				<!-- Product Info Card -->
				<div class="bg-white rounded-xl shadow-lg overflow-hidden border border-gray-200 sticky top-6">
					<div class="bg-gradient-to-r from-gray-50 to-gray-100 px-5 py-4 border-b border-gray-200">
						<h3 class="font-semibold text-gray-800">Product Information</h3>
					</div>
					<div class="p-5 space-y-4">
						<div>
							<p class="text-xs text-gray-500 uppercase tracking-wider">Product Name</p>
							<p class="text-sm font-medium text-gray-900 mt-1">{{ product.name }}</p>
						</div>
						<div>
							<p class="text-xs text-gray-500 uppercase tracking-wider">Last Updated</p>
							<p class="text-sm text-gray-700 mt-1">{{ product.updatedAt|date('F d, Y') }}</p>
						</div>
						<div>
							<p class="text-xs text-gray-500 uppercase tracking-wider">Created</p>
							<p class="text-sm text-gray-700 mt-1">{{ product.createdAt|date('F d, Y') }}</p>
						</div>
						<div class="pt-3 border-t border-gray-200">
							<div class="flex justify-between items-center">
								<span class="text-sm text-gray-600">Current Status:</span>
								{% if product.isActive %}
									<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
										<svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
											<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
										</svg>
										Active
									</span>
								{% else %}
									<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
										<svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
											<path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
										</svg>
										Inactive
									</span>
								{% endif %}
							</div>
						</div>
					</div>
				</div>

				<!-- Stats Card -->
				<div class="bg-white rounded-xl shadow-lg overflow-hidden border border-gray-200">
					<div class="bg-gradient-to-r from-gray-50 to-gray-100 px-5 py-4 border-b border-gray-200">
						<h3 class="font-semibold text-gray-800">Inventory Statistics</h3>
					</div>
					<div class="p-5 space-y-3">
						<div class="flex justify-between items-center">
							<span class="text-sm text-gray-600">Unit Price</span>
							<span class="text-lg font-bold text-gray-900">${{ product.price|number_format(2) }}</span>
						</div>
						<div class="flex justify-between items-center">
							<span class="text-sm text-gray-600">Stock Quantity</span>
							<span class="text-lg font-bold {% if product.stock <= 5 %}text-red-600{% else %}text-gray-900{% endif %}">
								{{ product.stock }}
								{% if product.stock <= 5 %}
									<span class="text-xs font-normal text-red-500">(Low stock)</span>
								{% endif %}
							</span>
						</div>
						<div class="flex justify-between items-center pt-2 border-t border-gray-200">
							<span class="text-sm text-gray-600">Total Value</span>
							<span class="text-md font-semibold text-gray-900">${{ (product.price * product.stock)|number_format(2) }}</span>
						</div>
					</div>
				</div>

				<!-- Quick Actions Card -->
				<div class="bg-white rounded-xl shadow-lg overflow-hidden border border-gray-200">
					<div class="bg-gradient-to-r from-gray-50 to-gray-100 px-5 py-4 border-b border-gray-200">
						<h3 class="font-semibold text-gray-800">Quick Actions</h3>
					</div>
					<div class="p-5 space-y-3">
						<a href="{{ path('app_product_show', {'id': product.id}) }}" 
						   class="block w-full text-center px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors">
							View Product
						</a>
						<a href="{{ path('app_product_index') }}" 
						   class="block w-full text-center px-4 py-2 bg-gray-600 text-white text-sm font-medium rounded-lg hover:bg-gray-700 transition-colors">
							View All Products
						</a>
					</div>
				</div>

				<!-- Tips Card -->
				<div class="bg-blue-50 rounded-xl p-5 border border-blue-200">
					<div class="flex items-start">
						<svg class="w-5 h-5 text-blue-600 mr-3 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
							<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
						</svg>
						<div>
							<h4 class="text-sm font-semibold text-blue-900 mb-1">Pro Tip</h4>
							<p class="text-xs text-blue-800">High-quality images increase conversion rates by up to 40%</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
{% endblock %}