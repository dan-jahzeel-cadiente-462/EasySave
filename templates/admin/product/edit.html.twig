{% extends 'admin/base.html.twig' %}

{% block body %}
	<div class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
		<!-- Page Header -->
		{% include 'admin/product/includes/edit_page/page_header.html.twig' with {product: product} %}

		<!-- Error Messages -->
		{% include 'admin/product/includes/edit_page/error_messages.html.twig' %}

		<!-- Two Column Layout -->
		<div class="flex flex-col lg:flex-row gap-8">
			<!-- Main Content Column -->
			<div class="flex-1 space-y-8">
				{{ form_start(form, {attr: {class: 'space-y-8', id: 'product-form'}}) }}
				
				<!-- Basic Information Card -->
				<div class="bg-white rounded-xl shadow-lg overflow-hidden border border-gray-200">
					<div class="bg-gradient-to-r from-blue-50 to-indigo-50 px-6 py-4 border-b border-gray-200">
						<div class="flex items-center">
							<div class="bg-blue-100 p-2 rounded-lg mr-3">
								<svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
								</svg>
							</div>
							<h3 class="text-lg font-semibold text-gray-800">Basic Information</h3>
						</div>
					</div>
					
					<div class="p-6 space-y-6">
						<!-- Product Name and Brand Row -->
						<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
							<div>
								{{ form_label(form.name, 'Product Name', {label_attr: {class: 'block text-sm font-semibold text-gray-700 mb-2'}}) }}
								{{ form_widget(form.name, {attr: {
									class: 'w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors',
									placeholder: 'Enter product name'
								}}) }}
								{{ form_errors(form.name) }}
							</div>
							<div>
								{{ form_label(form.brand, 'Brand', {label_attr: {class: 'block text-sm font-semibold text-gray-700 mb-2'}}) }}
								{{ form_widget(form.brand, {attr: {
									class: 'w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors',
									placeholder: 'Enter brand name'
								}}) }}
								{{ form_errors(form.brand) }}
							</div>
						</div>

						<!-- Description -->
						<div>
							{{ form_label(form.description, 'Description', {label_attr: {class: 'block text-sm font-semibold text-gray-700 mb-2'}}) }}
							{{ form_widget(form.description, {attr: {
								class: 'w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors',
								rows: 5,
								placeholder: 'Describe your product...'
							}}) }}
							{{ form_errors(form.description) }}
							<p class="text-xs text-gray-500 mt-1">Write a detailed description of your product</p>
						</div>

						<!-- Price and Stock Row (fixed layout - two columns only, no discount) -->
						<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
							<div>
								{{ form_label(form.price, 'Price (USD)', {label_attr: {class: 'block text-sm font-semibold text-gray-700 mb-2'}}) }}
								<div class="relative">
									<span class="absolute left-3 top-2.5 text-gray-500">$</span>
									{{ form_widget(form.price, {attr: {
										class: 'w-full pl-7 pr-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors',
										placeholder: '0.00'
									}}) }}
								</div>
								{{ form_errors(form.price) }}
							</div>
							<div>
								{{ form_label(form.stock, 'Stock Quantity', {label_attr: {class: 'block text-sm font-semibold text-gray-700 mb-2'}}) }}
								{{ form_widget(form.stock, {attr: {
									class: 'w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors',
									placeholder: '0'
								}}) }}
								{{ form_errors(form.stock) }}
							</div>
						</div>

						<!-- Category and Status Row -->
						<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
							<div>
								{{ form_label(form.category, 'Category', {label_attr: {class: 'block text-sm font-semibold text-gray-700 mb-2'}}) }}
								{{ form_widget(form.category, {attr: {
									class: 'w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors bg-white hover:bg-gray-50 appearance-none cursor-pointer',
									style: 'background-image: url("data:image/svg+xml,%3csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 16 16%27%3e%3cpath fill=%27none%27 stroke=%27%239ca3af%27 stroke-linecap=%27round%27 stroke-linejoin=%27round%27 stroke-width=%272%27 d=%27M2 5l6 6 6-6%27/%3e%3c/svg%3e"); background-repeat: no-repeat; background-position: right 0.75rem center; background-size: 16px 12px; padding-right: 2.5rem;'
								}}) }}
								{{ form_errors(form.category) }}
							</div>
							<div>
								<div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg border border-gray-200">
									<div>
										{{ form_label(form.isActive, 'Product Status', {label_attr: {class: 'text-sm font-semibold text-gray-700'}}) }}
										<p class="text-xs text-gray-500 mt-1">Active products appear in store</p>
									</div>
									{{ form_widget(form.isActive, {attr: {
										class: 'w-5 h-5 text-blue-600 border-gray-300 rounded focus:ring-blue-500 cursor-pointer'
									}}) }}
								</div>
							</div>
						</div>

						<!-- Discounts Section -->
						{% include 'admin/product/includes/edit_page/discounts_section.html.twig' with {product: product, form: form} %}
					</div>
				</div>

				<!-- Product Images Section -->
				{% include 'admin/product/includes/edit_page/image_section.html.twig' with {product: product, form: form} %}
				
				<!-- Form Actions -->
				<div class="bg-white rounded-xl shadow-lg overflow-hidden border border-gray-200 sticky bottom-0">
					<div class="px-6 py-4 bg-gray-50">
						<div class="flex flex-col sm:flex-row gap-3">
							<button type="submit"
									class="flex-1 px-6 py-3 bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-semibold rounded-lg hover:from-blue-700 hover:to-indigo-700 transition-all shadow-md">
								<div class="flex items-center justify-center">
									<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
									</svg>
									Save Changes
								</div>
							</button>
							<a href="{{ path('app_product_index') }}"
							   class="flex-1 px-6 py-3 bg-white text-gray-700 font-semibold rounded-lg border border-gray-300 hover:bg-gray-50 transition-colors text-center">
								Cancel
							</a>
						</div>
						<p class="text-center text-xs text-gray-500 mt-4">
							All changes will be saved immediately. You can preview changes before publishing.
						</p>
					</div>
				</div>
				
				{{ form_rest(form) }}
				{{ form_end(form) }}
			</div>

			<!-- Sidebar Column -->
			{% include 'admin/product/includes/edit_page/sidebar_column.html.twig' with {product: product} %}
		</div>
	</div>
{% endblock %}
