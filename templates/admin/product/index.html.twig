{% extends 'admin/base.html.twig' %}

{% block body %}
<div class="container mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Title and Header -->
    <div class="mb-8">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
                <h1 class="text-2xl font-bold text-gray-900">
                    {% if is_granted('ROLE_ADMIN') %}
                        All Products
                    {% else %}
                        My Products
                    {% endif %}
                </h1>
                <p class="text-gray-600 mt-1">Manage and organize your product listings</p>
            </div>
            
            <!-- Create New Button -->
            {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_STAFF') %}
                <a href="{{ path('app_product_new') }}"
                   class="inline-flex items-center gap-2 px-4 py-2.5 bg-green-600 text-white font-medium rounded-lg shadow-sm hover:bg-green-700 focus:ring-2 focus:ring-green-500 focus:ring-offset-2 transition-all duration-200 text-sm">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                    </svg>
                    Add New Product
                </a>
            {% endif %}
        </div>
    </div>

    <!-- Search and Filter Toolbar -->
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5 mb-6">
        <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-5">
            <!-- Search Section -->
            <div class="flex-1">
                <label class="block text-sm font-medium text-gray-700 mb-2">Search Products</label>
                <form method="get" action="{{ path('app_product_index') }}" class="relative max-w-md">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                    </div>
                    <input type="search" 
                           name="q" 
                           value="{{ app.request.query.get('q') }}" 
                           placeholder="Search by product name, brand, or description..."
                           class="block w-full pl-10 pr-3 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 text-sm">
                    
                    {% if app.request.query.get('q') %}
                        <a href="{{ path('app_product_index') }}" 
                           class="absolute inset-y-0 right-0 pr-10 flex items-center text-sm text-gray-500 hover:text-gray-700">
                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                            </svg>
                        </a>
                    {% endif %}
                </form>
            </div>

            <!-- Filter and Sort Controls -->
            <div class="flex flex-col sm:flex-row gap-4">
                <!-- Category Filter -->
                <div class="w-full sm:w-48">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Filter by Category</label>
                    <select class="block w-full px-3 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 text-sm bg-white">
                        <option value="">All Categories</option>
                        {% for category in categories|default([]) %}
                            <option value="{{ category.id }}">{{ category.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                
                <!-- Stock Status Filter -->
                <div class="w-full sm:w-48">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Stock Status</label>
                    <select class="block w-full px-3 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 text-sm bg-white">
                        <option value="">All Status</option>
                        <option value="in_stock">In Stock</option>
                        <option value="low_stock">Low Stock</option>
                        <option value="out_of_stock">Out of Stock</option>
                    </select>
                </div>
                
                <!-- Apply Filters Button -->
                <div class="flex items-end">
                    <button type="button"
                            class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-gray-800 text-white font-medium rounded-lg hover:bg-gray-900 focus:ring-2 focus:ring-gray-800 focus:ring-offset-2 transition-all duration-200 text-sm h-[42px]">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
                        </svg>
                        Apply Filters
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Products Summary Stats -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
        <div class="bg-white p-5 rounded-xl border border-gray-200">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-600">Total Products</p>
                    <p class="text-2xl font-bold text-gray-900 mt-1">{{ products|length }}</p>
                </div>
                <div class="p-3 bg-blue-50 rounded-lg">
                    <svg class="w-6 h-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" />
                    </svg>
                </div>
            </div>
        </div>
        
        <div class="bg-white p-5 rounded-xl border border-gray-200">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-600">In Stock</p>
                    <p class="text-2xl font-bold text-emerald-600 mt-1">
                        {% set inStockCount = products|filter(p => p.stock > 0)|length %}
                        {{ inStockCount }}
                    </p>
                </div>
                <div class="p-3 bg-emerald-50 rounded-lg">
                    <svg class="w-6 h-6 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
            </div>
        </div>
        
        <div class="bg-white p-5 rounded-xl border border-gray-200">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-600">Out of Stock</p>
                    <p class="text-2xl font-bold text-rose-600 mt-1">
                        {% set outOfStockCount = products|filter(p => p.stock == 0)|length %}
                        {{ outOfStockCount }}
                    </p>
                </div>
                <div class="p-3 bg-rose-50 rounded-lg">
                    <svg class="w-6 h-6 text-rose-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                    </svg>
                </div>
            </div>
        </div>
        
        <div class="bg-white p-5 rounded-xl border border-gray-200">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-600">Total Value</p>
                    <p class="text-2xl font-bold text-purple-600 mt-1">
                        {% set totalValue = products|reduce((sum, p) => sum + (p.price * p.stock), 0) %}
                        {% if totalValue >= 1000000 %}
                            PHP{{ (totalValue / 1000000)|number_format(2) }}m
                        {% else %}
                            PHP{{ totalValue|number_format(0) }}
                        {% endif %}
                    </p>
                </div>
                <div class="p-3 bg-purple-50 rounded-lg">
                    <svg class="w-6 h-6 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
            </div>
        </div>
    </div>

    <!-- Products Table -->
    <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
            <div class="flex items-center justify-between">
                <h2 class="text-lg font-semibold text-gray-900">Product List</h2>
                <div class="flex items-center space-x-4">
                    <!-- View Toggle -->
                    <div class="flex items-center space-x-2">
                        <button type="button"
                                onclick="setView('grid')"
                                class="p-2 rounded-lg {{ view == 'grid' ? 'bg-indigo-100 text-indigo-700' : 'text-gray-500 hover:bg-gray-100' }} transition-colors">
                            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path>
                            </svg>
                        </button>
                        <button type="button"
                                onclick="setView('list')"
                                class="p-2 rounded-lg {{ view == 'list' ? 'bg-indigo-100 text-indigo-700' : 'text-gray-500 hover:bg-gray-100' }} transition-colors">
                            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path>
                            </svg>
                        </button>
                    </div>
                    <span class="text-sm text-gray-600">
                        {{ products|length }} products
                    </span>
                </div>
            </div>
        </div>
        
        {% if products|length > 0 %}
            {% if view == 'grid' %}
                <!-- Grid View -->
                <div class="p-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                        {% for product in products %}
                            <div class="bg-white border border-gray-200 rounded-lg shadow-sm hover:shadow-md transition-shadow duration-200 overflow-hidden">
                                <!-- Product Image -->
                                <div class="aspect-w-1 aspect-h-1 bg-gray-100">
                                    {% if product.imagePath %}
                                        <img class="w-full h-48 object-cover" src="{{ asset('uploads/products/' ~ product.imagePath) }}" alt="{{ product.name }}">
                                    {% else %}
                                        <img class="w-full h-48 object-cover" src="{{ asset('images/default/default-product-image.jpg') }}" alt="Default product image">
                                    {% endif %}
                                </div>

                                <!-- Product Info -->
                                <div class="p-4">
                                    <div class="mb-2">
                                        <span class="text-xs text-gray-500">#{{ product.id }}</span>
                                    </div>

                                    <h3 class="text-sm font-semibold text-gray-900 mb-1 line-clamp-2">{{ product.name }}</h3>

                                    {% if product.brand %}
                                        <p class="text-xs text-gray-600 mb-2">{{ product.brand }}</p>
                                    {% endif %}

                                    {% if product.category %}
                                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800 mb-2">
                                            {{ product.category.name }}
                                        </span>
                                    {% endif %}

                                    <div class="flex items-center justify-between mb-3">
                                        <span class="text-lg font-bold text-gray-900">PHP{{ product.price|number_format(2) }}</span>
                                        <div class="flex items-center">
                                            <span class="text-sm font-medium text-gray-900 mr-1">{{ product.stock }}</span>
                                            {% if product.stock <= 5 and product.stock > 0 %}
                                                <span class="text-xs text-amber-700 bg-amber-100 px-2 py-1 rounded-full">
                                                    Low
                                                </span>
                                            {% endif %}
                                        </div>
                                    </div>

                                    <!-- Status -->
                                    <div class="mb-3">
                                        {% if product.stock > 5 %}
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-100 text-emerald-800">
                                                In Stock
                                            </span>
                                        {% elseif product.stock > 0 %}
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800">
                                                Low Stock
                                            </span>
                                        {% else %}
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-rose-100 text-rose-800">
                                                Out of Stock
                                            </span>
                                        {% endif %}
                                    </div>

                                    {% if is_granted('ROLE_ADMIN') and product.createdBy %}
                                        <div class="text-xs text-gray-500 mb-3">
                                            Created by: {{ product.createdBy.username }}
                                        </div>
                                    {% endif %}

                                    <!-- Actions -->
                                    <div class="flex items-center justify-between">
                                        <div class="flex items-center space-x-2">
                                            <a href="{{ path('app_product_show', {'product': product.id}) }}"
                                               class="p-1.5 text-gray-500 hover:text-blue-600 hover:bg-blue-50 rounded-md transition-colors duration-200"
                                               title="View Details">
                                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                                                </svg>
                                            </a>
                                            <a href="{{ path('app_product_edit', {'product': product.id}) }}"
                                               class="p-1.5 text-gray-500 hover:text-yellow-600 hover:bg-yellow-50 rounded-md transition-colors duration-200"
                                               title="Edit Product">
                                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
                                                </svg>
                                            </a>
                                        </div>
                                        <form method="post"
                                              action="{{ path('app_product_delete', {'product': product.id}) }}"
                                              onsubmit="return confirm('Are you sure you want to delete this product? This action cannot be undone.');"
                                              class="inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ product.id) }}">
                                            <button type="submit"
                                                    class="p-1.5 text-gray-500 hover:text-red-600 hover:bg-red-50 rounded-md transition-colors duration-200"
                                                    title="Delete Product">
                                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09-1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                                                </svg>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% else %}
                <!-- List View -->
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">ID</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Product Name</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Brand</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Category</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Price</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Stock</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Status</th>
                                {% if is_granted('ROLE_ADMIN') %}
                                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Created By</th>
                                {% endif %}
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                        {% for product in products %}
                            <tr class="hover:bg-gray-50 transition-colors duration-150">
                                <!-- ID -->
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="text-sm text-gray-600">#{{ product.id }}</span>
                                </td>

                                <!-- Product Name -->
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-3">
                                        <div class="h-10 w-10 flex-shrink-0">
                                            {% if product.imagePath %}
                                                <img class="h-10 w-10 rounded-md object-cover" src="{{ asset('uploads/products/' ~ product.imagePath) }}" alt="{{ product.name }}">
                                            {% else %}
                                                <img class="h-10 w-10 rounded-md object-cover" src="{{ asset('images/default/default-product-image.jpg') }}" alt="Default product image">
                                            {% endif %}
                                        </div>
                                        <div class="text-sm font-semibold text-gray-900">{{ product.name }}</div>
                                    </div>
                                </td>

                                <!-- Brand -->
                                <td class="px-6 py-4">
                                    <span class="text-sm text-gray-700">{{ product.brand ?? 'N/A' }}</span>
                                </td>

                                <!-- Category -->
                                <td class="px-6 py-4">
                                    {% if product.category %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                            {{ product.category.name }}
                                        </span>
                                    {% else %}
                                        <span class="text-xs text-gray-500 italic">Uncategorized</span>
                                    {% endif %}
                                </td>

                                <!-- Price -->
                                <td class="px-6 py-4">
                                    <div class="text-sm font-semibold text-gray-900">PHP{{ product.price|number_format(2) }}</div>
                                </td>

                                <!-- Stock -->
                                <td class="px-6 py-4">
                                    <div class="flex items-center">
                                        <span class="text-sm font-medium text-gray-900 mr-2">{{ product.stock }}</span>
                                        {% if product.stock <= 5 and product.stock > 0 %}
                                            <span class="text-xs text-amber-700 bg-amber-100 px-2 py-1 rounded-full">
                                                Low Stock
                                            </span>
                                        {% endif %}
                                    </div>
                                </td>

                                <!-- Status -->
                                <td class="px-6 py-4">
                                    {% if product.stock > 5 %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-100 text-emerald-800">
                                            In Stock
                                        </span>
                                    {% elseif product.stock > 0 %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800">
                                            Low Stock
                                        </span>
                                    {% else %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-rose-100 text-rose-800">
                                            Out of Stock
                                        </span>
                                    {% endif %}
                                </td>

                                {% if is_granted('ROLE_ADMIN') %}
                                    <!-- Created By -->
                                    <td class="px-6 py-4">
                                        {% if product.createdBy %}
                                            <span class="text-sm font-medium text-gray-900">{{ product.createdBy.username }}</span>
                                        {% else %}
                                            <span class="text-xs text-gray-500 italic">System</span>
                                        {% endif %}
                                    </td>
                                {% endif %}

                                <!-- Actions -->
                                <td class="px-6 py-4">
                                    <div class="flex items-center space-x-3">
                                        <a href="{{ path('app_product_show', {'product': product.id}) }}"
                                           class="p-1.5 text-gray-500 hover:text-blue-600 hover:bg-blue-50 rounded-md transition-colors duration-200"
                                           title="View Details">
                                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                                            </svg>
                                        </a>
                                        <a href="{{ path('app_product_edit', {'product': product.id}) }}"
                                           class="p-1.5 text-gray-500 hover:text-yellow-600 hover:bg-yellow-50 rounded-md transition-colors duration-200"
                                           title="Edit Product">
                                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
                                            </svg>
                                        </a>
                                        <form method="post"
                                              action="{{ path('app_product_delete', {'product': product.id}) }}"
                                              onsubmit="return confirm('Are you sure you want to delete this product? This action cannot be undone.');"
                                              class="inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ product.id) }}">
                                            <button type="submit"
                                                    class="p-1.5 text-gray-500 hover:text-red-600 hover:bg-red-50 rounded-md transition-colors duration-200"
                                                    title="Delete Product">
                                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09-1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                                                </svg>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        {% else %}
            <!-- Empty State -->
            <div class="px-6 py-12 text-center">
                <div class="text-gray-400">
                    <svg class="w-16 h-16 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" />
                    </svg>
                    <h3 class="text-lg font-medium text-gray-700 mb-2">No products found</h3>
                    <p class="text-sm text-gray-500 mb-6 max-w-md mx-auto">
                        {% if is_granted('ROLE_ADMIN') %}
                            No products have been created yet. Start by adding your first product!
                        {% else %}
                            You haven't created any products yet. Start by adding your first product!
                        {% endif %}
                    </p>
                    {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_STAFF') %}
                        <a href="{{ path('app_product_new') }}" 
                           class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors duration-200">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                            </svg>
                            Create First Product
                        </a>
                    {% endif %}
                </div>
            </div>
        {% endif %}
    </div>
</div>

<script>
function setView(viewType) {
    const url = new URL(window.location);
    url.searchParams.set('view', viewType);
    window.location.href = url.toString();
}
</script>
{% endblock %}
