<div class="lg:w-80 space-y-6">
	<!-- Product Info Card -->
	<!-- <div class="bg-white rounded-xl shadow-lg overflow-hidden border border-gray-200 sticky top-6"> -->
		<div class="bg-white rounded-xl shadow-lg overflow-hidden border border-gray-200"> <div class="bg-gradient-to-r from-gray-50 to-gray-100 px-5 py-4 border-b border-gray-200">
			<h3 class="font-semibold text-gray-800">Product Information</h3>
		</div>
		<div class="p-5 space-y-4">
			<div>
				<p class="text-xs text-gray-500 uppercase tracking-wider">Product Name</p>
				<p class="text-sm font-medium text-gray-900 mt-1">{{ product.name }}</p>
			</div>
			<div>
				<p class="text-xs text-gray-500 uppercase tracking-wider">Last Updated</p>
				<p class="text-sm text-gray-700 mt-1">{{ product.updatedAt|date('F d, Y') }}</p>
			</div>
			<div>
				<p class="text-xs text-gray-500 uppercase tracking-wider">Created</p>
				<p class="text-sm text-gray-700 mt-1">{{ product.createdAt|date('F d, Y') }}</p>
			</div>
			<div class="pt-3 border-t border-gray-200">
				<div class="flex justify-between items-center">
					<span class="text-sm text-gray-600">Current Status:</span>
					{% if product.isActive %}
						<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
							<svg class="w-3 h-3 mr-1" fill="currentColor" viewbox="0 0 20 20">
								<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
							</svg>
							Active
						</span>
					{% else %}
						<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
							<svg class="w-3 h-3 mr-1" fill="currentColor" viewbox="0 0 20 20">
								<path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
							</svg>
							Inactive
						</span>
					{% endif %}
				</div>
			</div>
		</div>
	</div>

	<!-- Stats Card -->
	<div class="bg-white rounded-xl shadow-lg overflow-hidden border border-gray-200">
		<div class="bg-gradient-to-r from-gray-50 to-gray-100 px-5 py-4 border-b border-gray-200">
			<h3 class="font-semibold text-gray-800">Inventory Statistics</h3>
		</div>
		<div class="p-5 space-y-3">
			<div class="flex justify-between items-center">
				<span class="text-sm text-gray-600">Unit Price</span>
				<span class="text-lg font-bold text-gray-900">${{ product.price|number_format(2) }}</span>
			</div>
			<div class="flex justify-between items-center">
				<span class="text-sm text-gray-600">Stock Quantity</span>
				<span class="text-lg font-bold {% if product.stock <= 5 %}text-red-600{% else %}text-gray-900{% endif %}">
					{{ product.stock }}
					{% if product.stock <= 5 %}
						<span class="text-xs font-normal text-red-500">(Low stock)</span>
					{% endif %}
				</span>
			</div>
			<div class="flex justify-between items-center pt-2 border-t border-gray-200">
				<span class="text-sm text-gray-600">Total Value</span>
				<span class="text-md font-semibold text-gray-900">${{ (product.price * product.stock)|number_format(2) }}</span>
			</div>
		</div>
	</div>

	<!-- Quick Actions Card -->
	<div class="bg-white rounded-xl shadow-lg overflow-hidden border border-gray-200">
		<div class="bg-gradient-to-r from-gray-50 to-gray-100 px-5 py-4 border-b border-gray-200">
			<h3 class="font-semibold text-gray-800">Quick Actions</h3>
		</div>
		<div class="p-5 space-y-3">
			<a href="{{ path('app_product_show', {'id': product.id}) }}" class="block w-full text-center px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors">
				View Product
			</a>
			<a href="{{ path('app_product_index') }}" class="block w-full text-center px-4 py-2 bg-gray-600 text-white text-sm font-medium rounded-lg hover:bg-gray-700 transition-colors">
				View All Products
			</a>
		</div>
	</div>

	<!-- Tips Card -->
	<div class="bg-blue-50 rounded-xl p-5 border border-blue-200">
		<div class="flex items-start">
			<svg class="w-5 h-5 text-blue-600 mr-3 mt-0.5" fill="currentColor" viewbox="0 0 20 20">
				<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
			</svg>
			<div>
				<h4 class="text-sm font-semibold text-blue-900 mb-1">Pro Tip</h4>
				<p class="text-xs text-blue-800">High-quality images increase conversion rates by up to 40%</p>
			</div>
		</div>
	</div>
</div>
