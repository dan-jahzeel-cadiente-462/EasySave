<div class="px-6 py-12 text-center">
	<div class="text-gray-400">
		<svg class="w-16 h-16 mx-auto mb-4" fill="none" viewbox="0 0 24 24" stroke="currentColor">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z"/>
		</svg>
		<h3 class="text-lg font-medium text-gray-700 mb-2">No products found</h3>
		<p class="text-sm text-gray-500 mb-6 max-w-md mx-auto">
			{% if is_granted('ROLE_ADMIN') %}
				No products have been created yet. Start by adding your first product!
			{% else %}
				You haven't created any products yet. Start by adding your first product!
			{% endif %}
		</p>
		{% if is_granted('ROLE_ADMIN') or is_granted('ROLE_STAFF') %}
			<a href="{{ path('app_product_new') }}" class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors duration-200">
				<svg class="w-4 h-4" fill="none" viewbox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
				</svg>
				Create First Product
			</a>
		{% endif %}
	</div>
</div>
