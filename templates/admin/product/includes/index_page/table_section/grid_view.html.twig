<div class="p-6">
	<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
		{% for product in products %}
			{% set img = product.imagePath ?: '/images/default/default-product-image.jpg' %}
			<div
				class="bg-white border border-gray-200 rounded-lg shadow-sm hover:shadow-md transition-shadow duration-200 overflow-hidden flex flex-col">
				<!-- Product Image -->
				<div class="aspect-w-1 aspect-h-1 bg-gray-100">
					{% if product.imagePath %}
						<img class="w-full h-48 object-cover" src="{{ asset(img) }}" alt="{{ product.name }}">
					{% else %}
						<img class="w-full h-48 object-cover" src="{{ asset('images/default/default-product-image.jpg') }}" alt="Default product image">
					{% endif %}
				</div>

				<!-- Product Info -->
				<div class="p-4 flex-1 flex flex-col">
					<div class="mb-2">
						<span class="text-xs text-gray-500">#{{ product.id }}</span>
					</div>

					<h3 class="text-sm font-semibold text-gray-900 mb-1 line-clamp-2">{{ product.name }}</h3>

					{% if product.brand %}
						<p class="text-xs text-gray-600 mb-2">{{ product.brand }}</p>
					{% endif %}

					{% if product.category %}
						<span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800 mb-2">
							{{ product.category.name }}
						</span>
					{% endif %}

					<div class="flex items-center justify-between mb-3">
						<span class="text-lg font-bold text-gray-900">PHP{{ product.price|number_format(2) }}</span>
						<div class="flex items-center">
							<span class="text-sm font-medium text-gray-900 mr-1">{{ product.stock }}</span>
							{% if product.stock <= 5 and product.stock > 0 %}
								<span class="text-xs text-amber-700 bg-amber-100 px-2 py-1 rounded-full">
									Low
								</span>
							{% endif %}
						</div>
					</div>

					<!-- Status -->
					<div class="mb-3">
						{% if product.stock > 5 %}
							<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-100 text-emerald-800">
								In Stock
							</span>
						{% elseif product.stock > 0 %}
							<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800">
								Low Stock
							</span>
						{% else %}
							<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-rose-100 text-rose-800">
								Out of Stock
							</span>
						{% endif %}
					</div>

					<!-- Applied Discounts -->
					{% if product.discounts|length > 0 %}
						<div class="mb-3 pb-3 border-t border-gray-200">
							<p class="text-xs font-semibold text-gray-600 mb-1">Active Discounts:</p>
							<div class="flex flex-wrap gap-1">
								{% for discount in product.discounts %}
									{% if discount.isActive %}
										<span class="inline-flex items-center px-2 py-1 rounded text-xs font-medium bg-green-100 text-green-800">
											{% if discount.type == 'percentage' %}
												{{ discount.value }}%
											{% else %}
												PHP{{ discount.value }}
											{% endif %}
										</span>
									{% endif %}
								{% endfor %}
							</div>
						</div>
					{% endif %}

					{% if is_granted('ROLE_ADMIN') and product.createdBy %}
						<div class="text-xs text-gray-500 mb-3">
							Created by:
							{{ product.createdBy.username }}
						</div>
					{% endif %}

					<!-- Actions -->
					<div class="flex items-center justify-between mt-auto pt-3 border-t border-gray-200">
						<div class="flex items-center space-x-2">
							<a href="{{ path('app_admin_product_show', {'product': product.id}) }}" class="p-1.5 text-gray-500 hover:text-blue-600 hover:bg-blue-50 rounded-md transition-colors duration-200" title="View Details">
								<svg class="w-4 h-4" fill="none" viewbox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z"/>
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
								</svg>
							</a>
							<a href="{{ path('app_product_edit', {'product': product.id}) }}" class="p-1.5 text-gray-500 hover:text-yellow-600 hover:bg-yellow-50 rounded-md transition-colors duration-200" title="Edit Product">
								<svg class="w-4 h-4" fill="none" viewbox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10"/>
								</svg>
							</a>
						</div>
						<form method="post" action="{{ path('app_product_delete', {'product': product.id}) }}" onsubmit="return confirm('Are you sure you want to delete this product? This action cannot be undone.');" class="inline">
							<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ product.id) }}">
							<button type="submit" class="p-1.5 text-gray-500 hover:text-red-600 hover:bg-red-50 rounded-md transition-colors duration-200" title="Delete Product">
								<svg class="w-4 h-4" fill="none" viewbox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09-1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"/>
								</svg>
							</button>
						</form>
					</div>
				</div>
			</div>
		{% endfor %}
	</div>
</div>
