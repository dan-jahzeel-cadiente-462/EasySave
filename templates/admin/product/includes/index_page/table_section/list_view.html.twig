								{% if product.imagePath %}
									<img class="h-10 w-10 rounded-md object-cover" src="{{ asset('uploads/products/' ~ product.imagePath) }}" alt="{{ product.name }}">
								{% else %}
									<img class="h-10 w-10 rounded-md object-cover" src="{{ asset('images/default/default-product-image.jpg') }}" alt="Default product image">
								{% endif %}
								
							</div>
							<div class="text-sm font-semibold text-gray-900">{{ product.name }}</div>
						</div>
					</td>

					<!-- Brand -->
					<td class="px-6 py-4">
						<span class="text-sm text-gray-700">{{ product.brand ?? 'N/A' }}</span>
					</td>

					<!-- Category -->
					<td class="px-6 py-4">
						{% if product.category %}
							<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
								{{ product.category.name }}
							</span>
						{% else %}
							<span class="text-xs text-gray-500 italic">Uncategorized</span>
						{% endif %}
					</td>

					<!-- Price -->
					<td class="px-6 py-4">
						<div class="text-sm font-semibold text-gray-900">PHP{{ product.price|number_format(2) }}</div>
					</td>

					<!-- Stock -->
					<td class="px-6 py-4">
						<div class="flex items-center">
							<span class="text-sm font-medium text-gray-900 mr-2">{{ product.stock }}</span>
							{% if product.stock <= 5 and product.stock > 0 %}
								<span class="text-xs text-amber-700 bg-amber-100 px-2 py-1 rounded-full">
									Low Stock
								</span>
							{% endif %}
						</div>
					</td>

					<!-- Status -->
					<td class="px-6 py-4">
						{% if product.stock > 5 %}
							<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-100 text-emerald-800">
								In Stock
							</span>
						{% elseif product.stock > 0 %}
							<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800">
								Low Stock
							</span>
						{% else %}
							<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-rose-100 text-rose-800">
								Out of Stock
							</span>
						{% endif %}
					</td>

					{% if is_granted('ROLE_ADMIN') %}
						<!-- Created By -->
						<td class="px-6 py-4">
							{% if product.createdBy %}
								<span class="text-sm font-medium text-gray-900">{{ product.createdBy.username }}</span>
							{% else %}
								<span class="text-xs text-gray-500 italic">System</span>
							{% endif %}
						</td>
					{% endif %}

