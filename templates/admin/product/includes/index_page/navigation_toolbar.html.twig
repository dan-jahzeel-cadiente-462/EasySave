{# templates/admin/product/includes/index_page/navigation_toolbar.html.twig #}
<div class="flex flex-col sm:flex-row justify-between items-center gap-4 bg-white dark:bg-gray-800 p-4 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 mb-6">
    <form method="get" class="flex w-full sm:w-auto gap-2">
        <input type="text" name="q" value="{{ q }}" placeholder="Search products..." class="px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-gray-100 text-sm focus:ring-2 focus:ring-green-500 outline-none w-full sm:w-64">
        
        <select name="category" class="px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-gray-100 text-sm focus:ring-2 focus:ring-green-500 outline-none">
            <option value="">All Categories</option>
            {% for cat in categories %}
                <option value="{{ cat.id }}" {{ selectedCategory == cat.id ? 'selected' : '' }}>{{ cat.name }}</option>
            {% endfor %}
        </select>

        <button type="submit" class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg text-sm font-semibold transition">Filter</button>
    </form>

    <div class="flex gap-2">
        {% if totalPages > 1 %}
            <div class="flex items-center gap-1">
                {% if currentPage > 1 %}
                    <a href="{{ path('app_product_index', {'page': currentPage - 1, 'q': q, 'category': selectedCategory, 'sort': sort}) }}" class="px-3 py-1 rounded-lg bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 text-sm hover:bg-gray-300">Prev</a>
                {% endif %}
                
                <span class="px-3 py-1 text-sm text-gray-700 dark:text-gray-300 font-bold">Page {{ currentPage }} of {{ totalPages }}</span>

                {% if currentPage < totalPages %}
                    <a href="{{ path('app_product_index', {'page': currentPage + 1, 'q': q, 'category': selectedCategory, 'sort': sort}) }}" class="px-3 py-1 rounded-lg bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 text-sm hover:bg-gray-300">Next</a>
                {% endif %}
            </div>
        {% endif %}
    </div>
</div>
