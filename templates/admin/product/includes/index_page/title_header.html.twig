<div class="mb-8">
	<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
		<div>
			<h1 class="text-2xl font-bold text-gray-900">
				{% if is_granted('ROLE_ADMIN') %}
					All Products
				{% else %}
					My Products
				{% endif %}
			</h1>
			<p class="text-gray-600 mt-1">Manage and organize your product listings</p>
		</div>

		<!-- Create New Button -->
		{% if is_granted('ROLE_ADMIN') or is_granted('ROLE_STAFF') %}
			<a href="{{ path('app_product_new') }}" class="inline-flex items-center gap-2 px-4 py-2.5 bg-green-600 text-white font-medium rounded-lg shadow-sm hover:bg-green-700 focus:ring-2 focus:ring-green-500 focus:ring-offset-2 transition-all duration-200 text-sm">
				<svg class="w-4 h-4" fill="none" viewbox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
				</svg>
				Add New Product
			</a>
		{% endif %}
	</div>
</div>
