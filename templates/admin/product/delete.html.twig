{% extends 'admin/base.html.twig' %}

{% block body %}
	<div class="max-w-2xl mx-auto">
		<!-- Page Header -->
		<div class="mb-8">
			<a href="{{ path('app_admin_product_index') }}" class="text-blue-600 hover:text-blue-700 font-medium flex items-center">
				<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
				</svg>
				Back to Products
			</a>
		</div>

		<!-- Confirmation Card -->
		<div class="bg-white rounded-lg shadow-md overflow-hidden">
			<!-- Header -->
			<div class="bg-red-50 border-b border-red-200 p-8">
				<div class="flex items-center space-x-4">
					<div class="text-5xl text-red-500">⚠️</div>
					<div>
						<h1 class="text-2xl font-bold text-red-900">Delete Product</h1>
						<p class="text-red-700 mt-1">This action cannot be undone</p>
					</div>
				</div>
			</div>

			<!-- Content -->
			<div class="p-8">
				<!-- Product Details -->
				<div class="mb-8 p-6 bg-gray-50 rounded-lg border border-gray-200">
					<h3 class="text-lg font-semibold text-gray-800 mb-4">Product to Delete</h3>
					<div class="space-y-3">
						<div class="flex justify-between">
							<span class="text-gray-600 font-medium">Name:</span>
							<span class="text-gray-900 font-semibold">{{ product.name }}</span>
						</div>
						<div class="flex justify-between">
							<span class="text-gray-600 font-medium">Price:</span>
							<span class="text-gray-900 font-semibold">{{ product.price|number_format(2) }} €</span>
						</div>
						<div class="flex justify-between">
							<span class="text-gray-600 font-medium">Stock:</span>
							<span class="text-gray-900 font-semibold">{{ product.stock }} units</span>
						</div>
						{% if product.category %}
							<div class="flex justify-between">
								<span class="text-gray-600 font-medium">Category:</span>
								<span class="text-gray-900 font-semibold">{{ product.category.name }}</span>
							</div>
						{% endif %}
					</div>
				</div>

				<!-- Warning Message -->
				<div class="mb-8 p-4 bg-red-50 border border-red-200 rounded-lg">
					<p class="text-red-800">
						<strong>Warning:</strong> Deleting this product is permanent. The product will be removed from your inventory 
						and cannot be recovered. Are you sure you want to proceed?
					</p>
				</div>

				<!-- Confirmation Form -->
				<form method="POST" action="{{ path('app_admin_product_delete', {id: product.id}) }}" class="space-y-6">
					<!-- Hidden Confirm Field -->
					<input type="hidden" name="confirm" value="yes">

					<!-- Confirmation Checkbox -->
					<label class="flex items-start">
						<input type="checkbox" id="confirm_delete" name="confirm_check"
							class="w-4 h-4 mt-1 text-red-600 border-gray-300 rounded focus:ring-2 focus:ring-red-500"
							required>
						<span class="ml-3 text-sm text-gray-700">
							I understand this action is permanent and cannot be undone. I want to delete this product.
						</span>
					</label>

					<!-- Action Buttons -->
					<div class="flex gap-4 pt-4">
						<button type="submit" id="delete-btn"
							class="flex-1 px-6 py-3 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors font-medium disabled:opacity-50 disabled:cursor-not-allowed"
							disabled>
							Yes, Delete This Product
						</button>
						<a href="{{ path('app_admin_product_index') }}"
							class="flex-1 px-6 py-3 bg-gray-300 text-gray-800 rounded-lg hover:bg-gray-400 transition-colors font-medium text-center">
							Cancel
						</a>
					</div>
				</form>
			</div>
		</div>
	</div>

	<script>
		document.addEventListener('DOMContentLoaded', function() {
			const checkbox = document.getElementById('confirm_delete');
			const deleteBtn = document.getElementById('delete-btn');

			checkbox.addEventListener('change', function() {
				deleteBtn.disabled = !this.checked;
			});
		});
	</script>
{% endblock %}
