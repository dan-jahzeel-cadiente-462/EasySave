{% extends 'admin/base.html.twig' %}

{% block title %}Product Details{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="mb-8">
        <a href="{{ path('app_product_index') }}" class="inline-flex items-center text-green-600 hover:text-green-800 font-medium transition-colors group">
            <svg class="w-5 h-5 mr-2 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Back to Products
        </a>
        <div class="mt-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
                <h1 class="text-3xl font-bold text-gray-900">{{ product.name }}</h1>
                <p class="text-gray-600 mt-2">{{ product.brand }}</p>
            </div>
            <div class="flex gap-3">
                <a href="{{ path('app_product_edit', {'product': product.id}) }}" class="inline-flex items-center gap-2 px-4 py-2.5 bg-green-600 text-white font-medium rounded-lg shadow-sm hover:bg-green-700 focus:ring-2 focus:ring-green-500 focus:ring-offset-2 transition-all duration-200 text-sm">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                    </svg>
                    Edit Product
                </a>
                {{ include('admin/product/_delete_form.html.twig') }}
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Image Column -->
        <div class="lg:col-span-1">
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                <div class="p-6">
                    {# Main Image #}
                    {% if product.imagePath and product.imagePath is not empty %}
                        <div class="mb-6">
                            <a href="{{ asset(product.imagePath) }}" target="_blank" class="block rounded-lg overflow-hidden border hover:shadow-lg transition-shadow duration-300" data-lightbox="product-gallery" title="{{ product.name }} - Main Image">
                                <img src="{{ asset(product.imagePath) }}" alt="{{ product.name }} (Main Image)" class="w-full h-auto object-cover">
                            </a>
                        </div>
                    {% else %}
                        <div class="mb-6 bg-gray-100 rounded-lg h-48 flex items-center justify-center">
                            <p class="text-gray-500 text-sm">No image available</p>
                        </div>
                    {% endif %}
                    
                    {# Additional Images Gallery #}
                    {% set images = product.productImages|default([]) %}
                    {% if images is not empty %}
                        <div>
                            <h3 class="text-lg font-semibold text-gray-800 mb-4">Gallery</h3>
                            <div class="grid grid-cols-3 gap-3">
                                {% for image in images %}
                                    <a href="{{ asset(image.imagePath) }}" target="_blank" class="block rounded-md overflow-hidden border hover:shadow-md transition-shadow duration-300" data-lightbox="product-gallery" title="Product image {{ loop.index }}">
                                        <img src="{{ asset(image.imagePath) }}" alt="Product image {{ loop.index }}" class="w-full h-20 object-cover">
                                    </a>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Details Column -->
        <div class="lg:col-span-2">
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                <div class="bg-gradient-to-r from-green-50 to-emerald-50 px-6 py-4 border-b border-gray-200">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-sm font-medium text-gray-600">Category</p>
                            <div class="mt-1 flex flex-wrap gap-1">
                                {% set breadcrumbs = [] %}
                                {% set current_category = product.category %}
                                {% for i in 1..10 %}
                                    {% if current_category %}
                                        {% set breadcrumbs = [current_category] | merge(breadcrumbs) %}
                                        {% set current_category = current_category.parent %}
                                    {% endif %}
                                {% endfor %}
                                {% for category in breadcrumbs %}
                                    <a href="{{ path('app_category_show', {'category': category.id}) }}" class="text-green-600 hover:text-green-800 hover:underline font-medium">{{ category.name }}</a>
                                    {% if not loop.last %}<span class="text-gray-400">/</span>{% endif %}
                                {% endfor %}
                            </div>
                        </div>
                        <div class="text-right">
                            <p class="text-sm font-medium text-gray-600">Price</p>
                            <p class="text-3xl font-bold text-green-600 mt-1">PHP {{ product.price|number_format(2) }}</p>
                        </div>
                    </div>
                </div>

                <div class="p-6">
                    <!-- Stock Status -->
                    <div class="mb-6 pb-6 border-b border-gray-200">
                        <p class="text-sm font-medium text-gray-600 mb-2">Stock Status</p>
                        <div class="flex items-center gap-3">
                            <span class="text-2xl font-bold text-gray-900">{{ product.stock }} units</span>
                            {% if product.stock > 50 %}
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">In Stock</span>
                            {% elseif product.stock > 0 %}
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-yellow-100 text-yellow-800">Low Stock</span>
                            {% else %}
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-red-100 text-red-800">Out of Stock</span>
                            {% endif %}
                        </div>
                    </div>

                    <!-- Favorites -->
                    <div class="mb-6 pb-6 border-b border-gray-200 flex items-center gap-3 text-gray-600">
                        <svg class="w-5 h-5 text-red-600" fill="currentColor" viewBox="0 0 24 24">
                            <path d="m11.645 20.91-.007-.003-.022-.012a15.247 15.247 0 0 1-.383-.218 25.18 25.18 0 0 1-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0 1 12 5.052 5.5 5.5 0 0 1 16.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 0 1-4.244 3.17 15.247 15.247 0 0 1-.383.219l-.022.012-.007.004-.003.001a.752.752 0 0 1-.704 0l-.003-.001Z" />
                        </svg>
                        <span class="font-medium">{{ product.favorites.count }} favorites</span>
                    </div>

                    <!-- Description -->
                    <div>
                        <h3 class="text-lg font-semibold text-gray-800 mb-3">Description</h3>
                        <p class="text-gray-700 leading-relaxed">{{ product.description|nl2br }}</p>
                    </div>
                </div>
            </div>

            <!-- Metadata -->
            <div class="mt-6 bg-white rounded-xl shadow-sm border border-gray-200 p-6">
                <h3 class="text-lg font-semibold text-gray-800 mb-4">Metadata</h3>
                <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
                    <div>
                        <p class="text-sm text-gray-600">Product ID</p>
                        <p class="text-lg font-semibold text-gray-900 mt-1">#{{ product.id }}</p>
                    </div>
                    <div>
                        <p class="text-sm text-gray-600">Created At</p>
                        <p class="text-lg font-semibold text-gray-900 mt-1">{{ product.createdAt ? product.createdAt|date('M d, Y') : 'N/A' }}</p>
                    </div>
                    <div>
                        <p class="text-sm text-gray-600">Updated At</p>
                        <p class="text-lg font-semibold text-gray-900 mt-1">{{ product.updatedAt ? product.updatedAt|date('M d, Y') : 'N/A' }}</p>
                    </div>
                </div>
            </div>

            <!-- Applied Discounts Section -->
            {% if product.discounts|length > 0 %}
                <div class="mt-6 bg-blue-50 rounded-xl shadow-sm border border-blue-200 p-6">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-lg font-semibold text-gray-800 flex items-center gap-2">
                            <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z" />
                            </svg>
                            Applied Discounts
                        </h3>
                        <a href="{{ path('app_product_edit', {'product': product.id}) }}" class="text-sm text-blue-600 hover:text-blue-800 font-medium">
                            Manage
                        </a>
                    </div>
                    
                    <div class="space-y-3">
                        {% for discount in product.discounts %}
                            <div class="flex items-center justify-between bg-white p-4 rounded-lg border border-blue-200">
                                <div class="flex-1">
                                    <div class="flex items-center gap-2 mb-1">
                                        <h4 class="font-semibold text-gray-900">{{ discount.label }}</h4>
                                        {% if discount.isActive %}
                                            <span class="text-xs font-semibold bg-green-100 text-green-800 px-2 py-1 rounded">Active</span>
                                        {% else %}
                                            <span class="text-xs font-semibold bg-gray-100 text-gray-800 px-2 py-1 rounded">Inactive</span>
                                        {% endif %}
                                    </div>
                                    <p class="text-sm text-gray-600">
                                        {% if discount.type == 'percentage' %}
                                            <strong>{{ discount.value }}% Discount</strong>
                                        {% else %}
                                            <strong>PHP {{ discount.value }} Off</strong>
                                        {% endif %}
                                        {% if discount.startsAt or discount.endsAt %}
                                            <span class="text-gray-500">
                                                ({{ discount.startsAt ? discount.startsAt|date('M d, Y') : 'Start' }} 
                                                - 
                                                {{ discount.endsAt ? discount.endsAt|date('M d, Y') : 'No end' }})
                                            </span>
                                        {% endif %}
                                    </p>
                                </div>
                                <div class="text-right">
                                    {% if discount.isActive %}
                                        <span class="text-green-600 font-medium text-sm">Displayed to customers</span>
                                    {% else %}
                                        <span class="text-gray-500 font-medium text-sm">Not visible</span>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% else %}
                <div class="mt-6 bg-gray-50 rounded-xl shadow-sm border border-gray-200 p-6">
                    <div class="flex items-center justify-between">
                        <div>
                            <h3 class="text-lg font-semibold text-gray-800 mb-1">No Discounts Applied</h3>
                            <p class="text-gray-600 text-sm">This product doesn't have any active discounts yet.</p>
                        </div>
                        <a href="{{ path('app_product_edit', {'product': product.id}) }}" class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition font-medium text-sm whitespace-nowrap">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                            </svg>
                            Add Discount
                        </a>
                    </div>
                </div>
            {% endif %}

            {# {% include '/admin/products/show_page/reviews_card.html.twig' %} #}
        </div>
    </div>
</div>
{% endblock %}