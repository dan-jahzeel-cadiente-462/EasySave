{% extends 'admin/base.html.twig' %}

{% block body %}
	<div class="max-w-4xl mx-auto py-8">
		<!-- Page Header -->
		<div class="mb-8">
			<a href="{{ path('app_product_index') }}" class="inline-flex items-center text-green-600 hover:text-green-800 font-medium transition-colors group">
				<svg class="w-5 h-5 mr-2 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
				</svg>
				Back to Products
			</a>
			<div class="mt-6">
				<h1 class="text-3xl font-bold text-gray-900">Create New Product</h1>
				<p class="text-gray-600 mt-2">Add a new product to your inventory</p>
			</div>
		</div>

		<!-- Product Form Card -->
		<div class="bg-white rounded-xl shadow-lg overflow-hidden">
			<!-- Form Header -->
			<div class="bg-gradient-to-r from-green-50 to-emerald-50 px-8 py-6 border-b border-gray-200">
				<div class="flex items-center">
					<div class="bg-green-100 p-3 rounded-lg mr-4">
						<svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m0 0h6m-6-6H6m0 0H0" />
						</svg>
					</div>
					<h2 class="text-xl font-semibold text-gray-800">Product Details</h2>
				</div>
			</div>

			<div class="p-8">
				<!-- Error Messages -->
				{% if app.flashes('error')|length > 0 %}
					<div class="mb-8 p-4 bg-red-50 border-l-4 border-red-500 rounded-lg">
						<div class="flex items-center">
							<svg class="w-5 h-5 text-red-500 mr-3" fill="currentColor" viewBox="0 0 20 20">
								<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
							</svg>
							<h3 class="font-semibold text-red-800">Please correct the following errors:</h3>
						</div>
						<ul class="mt-2 text-red-700 space-y-1 text-sm ml-8">
							{% for message in app.flashes('error') %}
								<li>{{ message }}</li>
							{% endfor %}
						</ul>
					</div>
				{% endif %}

			{{ form_start(form, {attr: {class: 'space-y-8'}}) }}
					<!-- Basic Information Section -->
					<div class="bg-gray-50 rounded-xl p-6 border border-gray-200">
						<h3 class="text-lg font-semibold text-gray-800 mb-6 pb-3 border-b border-gray-200">Basic Information</h3>
						<div class="space-y-6">
							<!-- Product Name -->
							<div>
								{{ form_row(form.name, {
									row_attr: {class: 'mb-0'},
									label_attr: {class: 'block text-sm font-medium text-gray-700 mb-2'},
									attr: {class: 'w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-colors'}
								}) }}
							</div>

							<!-- Description -->
							<div>
								{{ form_row(form.description, {
									row_attr: {class: 'mb-0'},
									label_attr: {class: 'block text-sm font-medium text-gray-700 mb-2'},
									attr: {class: 'w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-colors', rows: 4}
								}) }}
							</div>

							<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
								<!-- Price -->
								<div>
									{{ form_row(form.price, {
										row_attr: {class: 'mb-0'},
										label_attr: {class: 'block text-sm font-medium text-gray-700 mb-2'},
										attr: {class: 'w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-colors'}
									}) }}
								</div>

								<!-- Stock -->
								<div>
									{{ form_row(form.stock, {
										row_attr: {class: 'mb-0'},
										label_attr: {class: 'block text-sm font-medium text-gray-700 mb-2'},
										attr: {class: 'w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-colors'}
									}) }}
								</div>
							</div>

							<!-- Category -->
							<div>
								{{ form_label(form.category, 'Category', {label_attr: {class: 'block text-sm font-semibold text-gray-700 mb-2'}}) }}
								{{ form_widget(form.category, {attr: {
									class: 'w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-colors bg-white hover:bg-gray-50 appearance-none cursor-pointer',
									style: 'background-image: url("data:image/svg+xml,%3csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 16 16%27%3e%3cpath fill=%27none%27 stroke=%27%239ca3af%27 stroke-linecap=%27round%27 stroke-linejoin=%27round%27 stroke-width=%272%27 d=%27M2 5l6 6 6-6%27/%3e%3c/svg%3e"); background-repeat: no-repeat; background-position: right 0.75rem center; background-size: 16px 12px; padding-right: 2.5rem;'
								}}) }}
								{{ form_errors(form.category) }}
							</div>

							<!-- Is Active -->
							<div>
								{{ form_row(form.isActive, {
									row_attr: {class: 'mb-0'},
									label_attr: {class: 'flex items-center'}
								}) }}
							</div>
						</div>
					</div>

					<!-- Discounts Section -->
					{% if form.discounts is defined %}
						<div class="bg-blue-50 rounded-xl p-6 border border-blue-200">
							<h3 class="text-lg font-semibold text-gray-900 mb-3 pb-3 border-b border-blue-200 flex items-center gap-2">
								<svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z" />
								</svg>
								Apply Discounts
							</h3>
							<p class="text-sm text-blue-700 mb-4">Optional: Select active discounts to apply to this product. Customers will see the discount on the catalog and product pages.</p>
							
							<div>
								{{ form_label(form.discounts, 'Available Discounts', {label_attr: {class: 'block text-sm font-semibold text-gray-700 mb-2'}}) }}
								{{ form_widget(form.discounts, {attr: {
									class: 'w-full min-h-[120px] px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors bg-white',
									multiple: 'multiple',
									'aria-label': 'Available Discounts'
								}}) }}
								{{ form_errors(form.discounts) }}
								<p class="text-xs text-gray-600 mt-2">Hold Ctrl (Cmd on Mac) to select multiple discounts. Only active discounts are available for selection.</p>
							</div>
						</div>
					{% endif %}

					<!-- Action Buttons -->
					<div class="flex gap-4">
						<button type="submit" class="flex-1 px-6 py-3 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors font-medium shadow-md hover:shadow-lg">
							<svg class="w-5 h-5 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8m0 8l-6-2m6 2l6-2" />
							</svg>
							Create Product
						</button>
						<a href="{{ path('app_product_index') }}" class="flex-1 px-6 py-3 bg-gray-200 text-gray-800 rounded-lg hover:bg-gray-300 transition-colors font-medium text-center">
							Cancel
						</a>
					</div>
				{{ form_end(form) }}
			</div>
		</div>
	</div>
{% endblock %}
