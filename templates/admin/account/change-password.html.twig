{% extends 'admin/account/base_profile.html.twig' %}

{% block profile_title %}Change Password{% endblock %}
{% block profile_description %}Update your password to keep your account secure{% endblock %}

{% block profile_content %}
<div class="max-w-md mx-auto bg-white shadow rounded-lg p-6 border border-gray-200">
    <form method="POST" action="{{ path('app_admin_account_change_password') }}" class="space-y-6" id="change-password-form">
        <!-- Current Password -->
        <div>
            <label for="current_password" class="block text-sm font-semibold text-gray-700 mb-2">Current Password</label>
            <input type="password" id="current_password" name="current_password" required 
                   class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent" 
                   placeholder="Enter current password">
        </div>

        <!-- New Password -->
        <div>
            <label for="new_password" class="block text-sm font-semibold text-gray-700 mb-2">New Password</label>
            <input type="password" id="new_password" name="new_password" required 
                   class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent" 
                   placeholder="Enter new password"
                   minlength="6">
            <p class="text-xs text-gray-500 mt-1">Password must be at least 6 characters long</p>
        </div>

        <!-- Confirm New Password -->
        <div>
            <label for="confirm_password" class="block text-sm font-semibold text-gray-700 mb-2">Confirm New Password</label>
            <input type="password" id="confirm_password" name="confirm_password" required 
                   class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent" 
                   placeholder="Confirm new password">
        </div>

        <!-- Password Requirements -->
        <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 text-sm text-blue-800">
            <p class="font-semibold mb-2">Password Requirements:</p>
            <ul class="list-disc list-inside space-y-1" id="password-requirements">
                <li class="requirement" data-requirement="length">At least 6 characters long</li>
                <li class="requirement" data-requirement="uppercase">At least one uppercase letter</li>
                <li class="requirement" data-requirement="lowercase">At least one lowercase letter</li>
                <li class="requirement" data-requirement="number">At least one number</li>
                <li class="requirement" data-requirement="match">Passwords match</li>
            </ul>
        </div>

        <!-- Form Actions -->
        <div class="flex justify-end gap-3 pt-4 border-t">
            <a href="{{ path('app_admin_account_view_profile_details') }}" 
               class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 font-semibold transition">
                Cancel
            </a>
            <button type="submit" 
                    class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg font-semibold transition disabled:opacity-50 disabled:cursor-not-allowed"
                    id="submit-btn">
                Change Password
            </button>
        </div>
    </form>
</div>

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('change-password-form');
    const newPassword = document.getElementById('new_password');
    const confirmPassword = document.getElementById('confirm_password');
    const submitBtn = document.getElementById('submit-btn');
    const requirements = document.querySelectorAll('#password-requirements .requirement');

    function updateRequirements() {
        const password = newPassword.value;
        const confirm = confirmPassword.value;
        
        let allValid = true;
        
        requirements.forEach(req => {
            const reqType = req.dataset.requirement;
            let isValid = false;
            
            switch(reqType) {
                case 'length':
                    isValid = password.length >= 6;
                    break;
                case 'uppercase':
                    isValid = /[A-Z]/.test(password);
                    break;
                case 'lowercase':
                    isValid = /[a-z]/.test(password);
                    break;
                case 'number':
                    isValid = /[0-9]/.test(password);
                    break;
                case 'match':
                    isValid = password && confirm && password === confirm;
                    break;
            }
            
            if (isValid) {
                req.classList.add('text-green-600');
                req.classList.remove('text-blue-800');
            } else {
                req.classList.remove('text-green-600');
                req.classList.add('text-blue-800');
                allValid = false;
            }
        });
        
        submitBtn.disabled = !allValid;
    }

    newPassword.addEventListener('input', updateRequirements);
    confirmPassword.addEventListener('input', updateRequirements);

    // Prevent form submission if validation fails
    form.addEventListener('submit', (e) => {
        if (submitBtn.disabled) {
            e.preventDefault();
            alert('Please meet all password requirements before submitting.');
        }
    });

    // Initial check
    updateRequirements();
});
</script>
{% endblock %}