{% extends 'admin/base.html.twig' %}

{% block title %}My Profile{% endblock %}

{% block body %}
<div class="container mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Page Header -->
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-800">My Profile</h1>
        <p class="text-gray-600 mt-1">Manage your account settings and preferences</p>
    </div>

    <!-- Include Tabs -->
    {% include 'admin/account/_tabs.html.twig' %}

    <!-- Tab Content -->
    <div class="mt-6">
        {% if app.current_route == 'app_admin_account_view_profile_details' %}
            {% include 'admin/profile/view-profile-details.html.twig' %}
        {% elseif app.current_route == 'app_admin_account_edit_profile_details' %}
            {% include 'admin/profile/edit-profile-details.html.twig' %}
        {% elseif app.current_route == 'app_admin_account_manage_data' %}
            {% include 'admin/profile/manage-data.html.twig' %}
        {% elseif app.current_route == 'app_admin_account_change_password' %}
            {% include 'admin/profile/change-password.html.twig' %}
        {% endif %}
    </div>
</div>
{% endblock %}