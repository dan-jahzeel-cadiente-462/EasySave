{% extends 'admin/base.html.twig' %}

{% block title %}My Profile{% endblock %}

{% block body %}
<div class="container mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-2xl font-bold text-gray-800 mb-6">My Profile</h1>

    <div class="max-w-2xl">
        <!-- Profile Information -->
        <div class="bg-white shadow rounded-lg p-6 border border-gray-200 mb-6">
            <h2 class="text-xl font-semibold mb-4 border-b pb-3">Account Information</h2>
            <div class="space-y-4">
                <div>
                    <p class="text-sm text-gray-500">User ID</p>
                    <p class="font-semibold text-gray-800">#{{ user.id }}</p>
                </div>
                <div>
                    <p class="text-sm text-gray-500">Username</p>
                    <p class="font-semibold text-gray-800">{{ user.username }}</p>
                </div>
                <div>
                    <p class="text-sm text-gray-500">Email</p>
                    <p class="font-semibold text-gray-800">{{ user.email|default('N/A') }}</p>
                </div>
                <div>
                    <p class="text-sm text-gray-500">Account Created</p>
                    <p class="font-semibold text-gray-800">{{ user.createdAt ? user.createdAt|date('M d, Y \a\t h:i A') : 'N/A' }}</p>
                </div>
                <div>
                    <p class="text-sm text-gray-500">Role</p>
                    {% if is_granted('ROLE_ADMIN') %}
                        <span class="inline-block bg-red-100 text-red-800 text-xs px-3 py-1 rounded-full font-semibold">ADMIN</span>
                    {% elseif is_granted('ROLE_STAFF') %}
                        <span class="inline-block bg-green-100 text-green-800 text-xs px-3 py-1 rounded-full font-semibold">STAFF</span>
                    {% endif %}
                </div>
                <div>
                    <p class="text-sm text-gray-500">Account Status</p>
                    <span class="inline-block bg-green-100 text-green-800 text-xs px-3 py-1 rounded-full font-semibold">Active</span>
                </div>
            </div>
        </div>

        <!-- Edit Full Name -->
        <div class="bg-white shadow rounded-lg p-6 border border-gray-200 mb-6">
            <h2 class="text-xl font-semibold mb-4 border-b pb-3">Edit Full Name</h2>
            <form method="POST" action="{{ path('app_admin_account_update_profile') }}" class="space-y-4">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label for="first_name" class="block text-sm font-semibold text-gray-700 mb-2">First Name</label>
                        <input type="text" id="first_name" name="first_name" value="{{ user.firstName|default('') }}" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent" placeholder="Enter first name">
                    </div>
                    <div>
                        <label for="last_name" class="block text-sm font-semibold text-gray-700 mb-2">Last Name</label>
                        <input type="text" id="last_name" name="last_name" value="{{ user.lastName|default('') }}" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent" placeholder="Enter last name">
                    </div>
                </div>
                <div class="flex justify-end">
                    <button type="submit" class="px-6 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg font-semibold transition">
                        Update Profile
                    </button>
                </div>
            </form>
        </div>

        <!-- Account Actions -->
        <div class="bg-white shadow rounded-lg p-6 border border-gray-200">
            <h2 class="text-xl font-semibold mb-4 border-b pb-3">Security</h2>
            <div class="space-y-3">
                <a href="{{ path('app_admin_account_change_password') }}" class="block w-full px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-center rounded-lg font-semibold transition">
                    Change Password
                </a>
                <a href="{{ path('app_logout') }}" class="block w-full px-4 py-2 bg-gray-600 hover:bg-gray-700 text-white text-center rounded-lg font-semibold transition">
                    Logout
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
