{% set tabs = [
    {
        route: 'app_admin_account_view_profile_details',
        label: 'General',
        icon: '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>'
    },
    {
        route: 'app_admin_account_edit_profile_details',
        label: 'Edit Profile',
        icon: '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>'
    },
    {
        route: 'app_admin_account_manage_data',
        label: 'Data Management',
        icon: '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4"/></svg>'
    },
    {
        route: 'app_admin_account_change_password',
        label: 'Security',
        icon: '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>'
    }
] %}

<div class="border-b border-gray-200 mb-6">
    <nav class="flex -mb-px space-x-8" aria-label="Tabs">
        {% for tab in tabs %}
            <a href="{{ path(tab.route) }}" 
               class="group inline-flex items-center px-1 py-4 border-b-2 font-medium text-sm transition-all duration-200
                   {{ app.current_route starts with tab.route 
                       ? 'border-indigo-600 text-indigo-600' 
                       : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' }}">
                <span class="mr-2 {{ app.current_route starts with tab.route ? 'text-indigo-600' : 'text-gray-400 group-hover:text-gray-500' }}">
                    {{ tab.icon|raw }}
                </span>
                {{ tab.label }}
                {% if tab.label == 'Security' and password_expiry_soon is defined and password_expiry_soon %}
                    <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                        Expiring soon
                    </span>
                {% endif %}
            </a>
        {% endfor %}
    </nav>
</div>