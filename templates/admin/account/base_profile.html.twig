{% extends 'admin/base.html.twig' %}

{% block body %}
<div class="container mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Page Header -->
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-800">{{ block('profile_title') }}</h1>
        <p class="text-gray-600 mt-1">{{ block('profile_description')|default('Manage your account settings and preferences') }}</p>
    </div>

    <!-- Include Tabs -->
    {% include 'admin/account/_tabs.html.twig' %}

    <!-- Tab Content -->
    <div class="mt-6">
        {% block profile_content %}{% endblock %}
    </div>
</div>
{% endblock %}

{% block profile_title %}My Profile{% endblock %}