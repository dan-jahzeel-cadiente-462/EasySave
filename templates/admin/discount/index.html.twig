{% extends 'admin/base.html.twig' %}

{% block title %}Discount index{% endblock %}

{% block body %}
    <h1>Discount index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Starts_at</th>
                <th>Ends_at</th>
                <th>Type</th>
                <th>Is_active</th>
                <th>Value</th>
                <th>Label</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for discount in discounts %}
            <tr>
                <td>{{ discount.id }}</td>
                <td>{{ discount.startsAt ? discount.startsAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ discount.endsAt ? discount.endsAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ discount.type }}</td>
                <td>{{ discount.isActive ? 'Yes' : 'No' }}</td>
                <td>{{ discount.value }}</td>
                <td>{{ discount.label }}</td>
                <td>
                    <a href="{{ path('app_discount_show', {'id': discount.id}) }}">show</a>
                    <a href="{{ path('app_discount_edit', {'id': discount.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="8">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_discount_new') }}">Create new</a>
{% endblock %}
