{{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Label -->
        <div class="md:col-span-2">
            <div>
                {{ form_label(form.label, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 dark:text-gray-300 mb-2'}}) }}
                {{ form_widget(form.label, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none transition', 'placeholder': 'e.g., Summer Sale 2024'}}) }}
                {{ form_errors(form.label) }}
            </div>
        </div>

        <!-- Type -->
        <div>
            <div>
                {{ form_label(form.type, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 dark:text-gray-300 mb-2'}}) }}
                {{ form_widget(form.type, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none transition'}}) }}
                {{ form_errors(form.type) }}
            </div>
        </div>

        <!-- Value -->
        <div>
            <div>
                {{ form_label(form.value, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 dark:text-gray-300 mb-2'}}) }}
                {{ form_widget(form.value, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none transition', 'type': 'number', 'step': '0.01', 'min': '0', 'placeholder': '10'}}) }}
                {{ form_errors(form.value) }}
                <p class="text-xs text-gray-500 mt-1">Enter percentage (%) or fixed amount (PHP)</p>
            </div>
        </div>

        <!-- Active Checkbox -->
        <div>
            <div class="flex items-center h-full">
                <label class="flex items-center cursor-pointer">
                    {{ form_widget(form.is_active, {'attr': {'class': 'w-4 h-4 text-green-600 rounded focus:ring-2 focus:ring-green-500 cursor-pointer'}}) }}
                    <span class="ml-3 text-sm font-medium text-gray-700">{{ form_label(form.is_active) }}</span>
                </label>
                {{ form_errors(form.is_active) }}
            </div>
        </div>

        <!-- Start Date -->
        <div>
            <div>
                {{ form_label(form.starts_at, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 dark:text-gray-300 mb-2'}}) }}
                {{ form_widget(form.starts_at, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none transition'}}) }}
                {{ form_errors(form.starts_at) }}
            </div>
        </div>

        <!-- End Date -->
        <div>
            <div>
                {{ form_label(form.ends_at, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 dark:text-gray-300 mb-2'}}) }}
                {{ form_widget(form.ends_at, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-green-500 focus:border-transparent outline-none transition'}}) }}
                {{ form_errors(form.ends_at) }}
            </div>
        </div>
    </div>

    <!-- Form Actions -->
    <div class="flex items-center justify-between pt-6 border-t border-gray-200">
        <a href="{{ path('app_discount_index') }}" class="px-4 py-2 text-gray-700 font-medium hover:text-gray-900 transition">
            Cancel
        </a>
        <button type="submit" class="inline-flex items-center gap-2 px-6 py-2.5 bg-green-600 text-white font-medium rounded-lg shadow-sm hover:bg-green-700 focus:ring-2 focus:ring-green-500 focus:ring-offset-2 transition-all duration-200">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            {{ button_label|default('Save Discount') }}
        </button>
    </div>

{{ form_rest(form) }}
{{ form_end(form) }}
