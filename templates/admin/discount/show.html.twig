{% extends 'admin/base.html.twig' %}

{% block title %}Discount{% endblock %}

{% block body %}
    <h1>Discount</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ discount.id }}</td>
            </tr>
            <tr>
                <th>Starts_at</th>
                <td>{{ discount.startsAt ? discount.startsAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Ends_at</th>
                <td>{{ discount.endsAt ? discount.endsAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Type</th>
                <td>{{ discount.type }}</td>
            </tr>
            <tr>
                <th>Is_active</th>
                <td>{{ discount.isActive ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>Value</th>
                <td>{{ discount.value }}</td>
            </tr>
            <tr>
                <th>Label</th>
                <td>{{ discount.label }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_discount_index') }}">back to list</a>

    <a href="{{ path('app_discount_edit', {'id': discount.id}) }}">edit</a>

    {{ include('discount/_delete_form.html.twig') }}
{% endblock %}
