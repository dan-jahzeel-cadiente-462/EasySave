{% extends 'admin/base.html.twig' %}

{% block title %}Discount Details - {{ discount.label }}{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="mb-8">
        <a href="{{ path('app_discount_index') }}" class="inline-flex items-center text-green-600 hover:text-green-800 font-medium transition-colors group mb-4">
            <svg class="w-5 h-5 mr-2 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            Back to Discounts
        </a>
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
                <h1 class="text-3xl font-bold text-gray-900">{{ discount.label }}</h1>
                <p class="text-gray-600 mt-1">ID: #{{ discount.id }}</p>
            </div>
            <div class="flex gap-3">
                <a href="{{ path('app_discount_edit', {'id': discount.id}) }}" class="inline-flex items-center gap-2 px-4 py-2.5 bg-green-600 text-white font-medium rounded-lg shadow-sm hover:bg-green-700 focus:ring-2 focus:ring-green-500 focus:ring-offset-2 transition-all duration-200">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                    </svg>
                    Edit
                </a>
                {{ include('admin/discount/_delete_form.html.twig') }}
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Details Card -->
        <div class="lg:col-span-2">
            <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-6">
                <h2 class="text-lg font-bold text-gray-900 mb-6">Discount Details</h2>

                <div class="space-y-6">
                    <!-- Discount Value -->
                    <div class="pb-6 border-b border-gray-200 last:border-0 last:pb-0">
                        <p class="text-sm font-medium text-gray-600 mb-2">Discount Value</p>
                        <div class="flex items-end gap-3">
                            <p class="text-4xl font-bold text-gray-900">
                                {% if discount.type == 'percentage' %}
                                    {{ discount.value }}<span class="text-2xl">%</span>
                                {% else %}
                                    PHP<span class="text-2xl">{{ discount.value }}</span>
                                {% endif %}
                            </p>
                            <span class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-sm font-medium {% if discount.type == 'percentage' %}bg-blue-100 text-blue-800{% else %}bg-purple-100 text-purple-800{% endif %} mb-2">
                                {% if discount.type == 'percentage' %}Percentage{% else %}Fixed Amount{% endif %}
                            </span>
                        </div>
                    </div>

                    <!-- Status -->
                    <div class="pb-6 border-b border-gray-200 last:border-0 last:pb-0">
                        <p class="text-sm font-medium text-gray-600 mb-3">Status</p>
                        <div class="flex items-center gap-3">
                            {% if discount.isActive %}
                                <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg text-sm font-medium bg-green-100 text-green-800">
                                    <span class="w-2 h-2 bg-green-600 rounded-full"></span>
                                    Enabled
                                </span>
                            {% else %}
                                <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg text-sm font-medium bg-red-100 text-red-800">
                                    <span class="w-2 h-2 bg-red-600 rounded-full"></span>
                                    Disabled
                                </span>
                            {% endif %}

                            <!-- Validity Status -->
                            {% if discount.isActive %}
                                {% if discount.startsAt and discount.startsAt > 'now'|date %}
                                    <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg text-sm font-medium bg-yellow-100 text-yellow-800">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                        </svg>
                                        Upcoming
                                    </span>
                                {% elseif discount.endsAt and discount.endsAt < 'now'|date %}
                                    <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg text-sm font-medium bg-gray-100 text-gray-800">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                                        </svg>
                                        Expired
                                    </span>
                                {% else %}
                                    <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg text-sm font-medium bg-green-100 text-green-800">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                                        </svg>
                                        Currently Active
                                    </span>
                                {% endif %}
                            {% endif %}
                        </div>
                    </div>

                    <!-- Date Range Timeline -->
                    <div class="pb-6 border-b border-gray-200 last:border-0 last:pb-0">
                        <p class="text-sm font-medium text-gray-600 mb-4">Validity Period</p>
                        <div class="space-y-2">
                            <div class="flex items-center gap-3">
                                <svg class="w-5 h-5 text-green-600 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                                </svg>
                                <div>
                                    <p class="text-sm text-gray-600">Start Date</p>
                                    <p class="font-semibold text-gray-900">{{ discount.startsAt ? discount.startsAt|date('F j, Y \a\t g:i A') : '—' }}</p>
                                </div>
                            </div>
                            <div class="flex items-center gap-3">
                                <svg class="w-5 h-5 text-red-600 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                                </svg>
                                <div>
                                    <p class="text-sm text-gray-600">End Date</p>
                                    <p class="font-semibold text-gray-900">{{ discount.endsAt ? discount.endsAt|date('F j, Y \a\t g:i A') : '—' }}</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar Info -->
        <div class="lg:col-span-1">
            <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-6">
                <h3 class="text-lg font-bold text-gray-900 mb-4">Info</h3>
                <div class="space-y-4">
                    <div>
                        <p class="text-xs uppercase text-gray-600 font-medium mb-1">Discount ID</p>
                        <p class="font-mono text-sm text-gray-900">{{ discount.id }}</p>
                    </div>
                    <div>
                        <p class="text-xs uppercase text-gray-600 font-medium mb-1">Type</p>
                        <p class="text-sm text-gray-900 capitalize">{{ discount.type }}</p>
                    </div>
                    <div>
                        <p class="text-xs uppercase text-gray-600 font-medium mb-1">Duration</p>
                        {% set start = discount.startsAt|date('U') %}
                        {% set end = discount.endsAt|date('U') %}
                        {% if end and start %}
                            {% set days = ((end - start) / 86400)|round %}
                            <p class="text-sm text-gray-900">{{ days }} days</p>
                        {% else %}
                            <p class="text-sm text-gray-900">Indefinite</p>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
