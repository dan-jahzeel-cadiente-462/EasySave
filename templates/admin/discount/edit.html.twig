{% extends 'admin/base.html.twig' %}

{% block title %}Edit Discount - {{ discount.label }}{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8">
        <a href="{{ path('app_discount_index') }}" class="inline-flex items-center text-green-600 hover:text-green-800 font-medium transition-colors group mb-4">
            <svg class="w-5 h-5 mr-2 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            Back to Discounts
        </a>
        <h1 class="text-3xl font-bold text-gray-900 mt-2">Edit Discount</h1>
        <p class="text-gray-600 mt-2">{{ discount.label }}</p>
    </div>

    <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-6 mb-6">
        {{ include('admin/discount/_form.html.twig', {'button_label': 'Update Discount'}) }}
    </div>

    <!-- Delete Section -->
    <div class="bg-white rounded-lg border border-red-200 shadow-sm p-6">
        <h2 class="text-lg font-bold text-red-900 mb-2">Danger Zone</h2>
        <p class="text-sm text-red-700 mb-4">Once you delete this discount, there is no going back. Please be certain.</p>
        {{ include('admin/discount/_delete_form.html.twig') }}
    </div>
</div>
{% endblock %}
