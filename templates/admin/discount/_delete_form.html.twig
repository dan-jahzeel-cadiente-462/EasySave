<form method="post" action="{{ path('app_discount_delete', {'id': discount.id}) }}" onsubmit="return confirm('Are you sure you want to delete this discount? This action cannot be undone.');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ discount.id) }}">
    <button type="submit" class="inline-flex items-center gap-2 px-4 py-2.5 bg-red-600 text-white font-medium rounded-lg shadow-sm hover:bg-red-700 focus:ring-2 focus:ring-red-500 focus:ring-offset-2 transition-all duration-200">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
        </svg>
        Delete Discount
    </button>
</form>
</form>
