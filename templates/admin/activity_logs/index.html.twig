{% extends 'admin/base.html.twig' %}

{% block title %}Activity Logs{% endblock %}

{% block body %}
<div class="container mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Title -->
    <div class="mb-6">
        <h1 class="text-3xl font-bold text-gray-800">Activity Logs</h1>
        <p class="text-gray-600 mt-1">System-wide activity log (Admin only - Read-only)</p>
    </div>

    <!-- Filter Card -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 mb-6 p-6">
        <h2 class="text-lg font-semibold text-gray-800 mb-4">Filter Logs</h2>
        <form method="GET" class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <!-- Action Filter -->
            <div>
                <label for="action" class="block text-sm font-medium text-gray-700 mb-1">Action</label>
                <select id="action" name="action" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500">
                    <option value="">All Actions</option>
                    <option value="LOGIN" {% if filter_action == 'LOGIN' %}selected{% endif %}>Login</option>
                    <option value="LOGOUT" {% if filter_action == 'LOGOUT' %}selected{% endif %}>Logout</option>
                    <option value="CREATE" {% if filter_action == 'CREATE' %}selected{% endif %}>Create</option>
                    <option value="UPDATE" {% if filter_action == 'UPDATE' %}selected{% endif %}>Update</option>
                    <option value="DELETE" {% if filter_action == 'DELETE' %}selected{% endif %}>Delete</option>
                </select>
            </div>

            <!-- User Filter -->
            <div>
                <label for="user" class="block text-sm font-medium text-gray-700 mb-1">User</label>
                <input type="text" id="user" name="user" value="{{ filter_user }}" placeholder="Username or ID" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500">
            </div>

            <!-- Date From -->
            <div>
                <label for="date_from" class="block text-sm font-medium text-gray-700 mb-1">From Date</label>
                <input type="date" id="date_from" name="date_from" value="{{ filter_date_from }}" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500">
            </div>

            <!-- Date To -->
            <div>
                <label for="date_to" class="block text-sm font-medium text-gray-700 mb-1">To Date</label>
                <input type="date" id="date_to" name="date_to" value="{{ filter_date_to }}" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500">
            </div>

            <!-- Submit Button -->
            <div class="flex items-end gap-2 md:col-span-4">
                <button type="submit" class="flex-1 px-4 py-2 bg-green-600 hover:bg-green-700 text-white rounded-lg font-medium transition">
                    Filter
                </button>
                <a href="{{ path('app_admin_activity_logs') }}" class="flex-1 px-4 py-2 bg-gray-300 hover:bg-gray-400 text-gray-800 rounded-lg font-medium transition text-center">
                    Reset
                </a>
            </div>
        </form>
    </div>

    <!-- Logs Table -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
        <table class="w-full">
            <thead class="bg-gray-50 border-b border-gray-200">
                <tr>
                    <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Timestamp</th>
                    <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">User</th>
                    <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Role</th>
                    <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Action</th>
                    <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Entity</th>
                    <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Description</th>
                    <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for log in logs %}
                    <tr class="border-b border-gray-200 hover:bg-gray-50">
                        <td class="px-6 py-4 text-sm text-gray-600">
                            {{ log.createdAt|date('Y-m-d H:i:s') }}
                        </td>
                        <td class="px-6 py-4 text-sm font-medium text-gray-900">
                            {{ log.user.username ?? 'System' }}
                        </td>
                        <td class="px-6 py-4 text-sm">
                            {% if log.user %}
                                {% if 'ROLE_ADMIN' in log.user.roles %}
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-red-100 text-red-800">Admin</span>
                                {% elseif 'ROLE_STAFF' in log.user.roles %}
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-800">Staff</span>
                                {% else %}
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-100 text-blue-800">User</span>
                                {% endif %}
                            {% endif %}
                        </td>
                        <td class="px-6 py-4 text-sm">
                            {% set actionColor = {
                                'LOGIN': 'bg-green-100 text-green-800',
                                'LOGOUT': 'bg-yellow-100 text-yellow-800',
                                'CREATE': 'bg-blue-100 text-blue-800',
                                'UPDATE': 'bg-purple-100 text-purple-800',
                                'DELETE': 'bg-red-100 text-red-800'
                            } %}
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold {{ actionColor[log.action] ?? 'bg-gray-100 text-gray-800' }}">
                                {{ log.action }}
                            </span>
                        </td>
                        <td class="px-6 py-4 text-sm text-gray-600">
                            {{ log.entityType }} {% if log.entityId %}(#{{ log.entityId }}){% endif %}
                        </td>
                        <td class="px-6 py-4 text-sm text-gray-600">
                            {{ log.description }}
                        </td>
                        <td class="px-6 py-4 text-sm">
                            <a href="{{ path('app_admin_activity_logs_show', {id: log.id}) }}" class="text-indigo-600 hover:text-indigo-800 font-medium">View</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="px-6 py-8 text-center text-gray-500">
                            No activity logs found
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <!-- Pagination Controls -->
    {% if total_logs > 0 %}
    <div class="mt-6 flex items-center justify-between bg-gray-50 border-t border-gray-200 px-6 py-4">
        <div class="text-sm text-gray-600">
            <p class="font-medium">Page {{ current_page }} of {{ total_pages }} • <span class="font-semibold">{{ total_logs }}</span> total entries</p>
        </div>
        <div class="flex gap-2">
            {% if current_page > 1 %}
                <a href="{{ path('app_admin_activity_logs', {
                    'page': current_page - 1,
                    'action': filter_action,
                    'user': filter_user,
                    'date_from': filter_date_from,
                    'date_to': filter_date_to
                }) }}" class="px-3 py-1 bg-green-600 hover:bg-green-700 text-white rounded font-medium text-sm transition">
                    ← Previous
                </a>
            {% else %}
                <button disabled class="px-3 py-1 bg-gray-300 text-gray-500 rounded font-medium text-sm cursor-not-allowed">
                    ← Previous
                </button>
            {% endif %}
            
            {% if current_page < total_pages %}
                <a href="{{ path('app_admin_activity_logs', {
                    'page': current_page + 1,
                    'action': filter_action,
                    'user': filter_user,
                    'date_from': filter_date_from,
                    'date_to': filter_date_to
                }) }}" class="px-3 py-1 bg-green-600 hover:bg-green-700 text-white rounded font-medium text-sm transition">
                    Next →
                </a>
            {% else %}
                <button disabled class="px-3 py-1 bg-gray-300 text-gray-500 rounded font-medium text-sm cursor-not-allowed">
                    Next →
                </button>
            {% endif %}
        </div>
    </div>
    {% endif %}

    <!-- Information Card -->
    <div class="mt-6 bg-blue-50 border border-blue-200 rounded-lg p-4">
        <div class="flex gap-3">
            <svg class="w-5 h-5 text-blue-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
            </svg>
            <p class="text-sm text-blue-800">
                <strong>Note:</strong> This activity log is read-only and automatically records all system activities. All user actions, logins, and entity modifications are tracked here for audit purposes.
            </p>
        </div>
    </div>
</div>
{% endblock %}
