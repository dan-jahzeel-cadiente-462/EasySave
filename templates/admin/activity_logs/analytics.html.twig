{% extends 'admin/base.html.twig' %}

{% block title %}Activity Logs Analytics{% endblock %}

{% block body %}
<div class="container mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="flex justify-between items-center mb-8">
        <div>
            <h1 class="text-3xl font-bold text-gray-800">Activity Analytics</h1>
            <p class="text-gray-600 mt-2">Comprehensive activity analysis and trends</p>
        </div>
        <a href="{{ path('app_admin_activity_logs') }}" class="bg-gray-500 hover:bg-gray-600 text-white font-semibold py-2 px-4 rounded-lg transition">
            Back to Logs
        </a>
    </div>

    <!-- Time Range Tabs -->
    <div class="bg-white rounded-lg shadow mb-6 p-4">
        <div class="flex gap-4 flex-wrap">
            <a href="{{ path('app_admin_activity_logs_analytics', {'range': 'day'}) }}" 
               class="px-4 py-2 rounded-lg font-semibold transition {% if range == 'day' %}bg-blue-500 text-white{% else %}bg-gray-200 text-gray-700 hover:bg-gray-300{% endif %}">
                Today
            </a>
            <a href="{{ path('app_admin_activity_logs_analytics', {'range': 'week'}) }}" 
               class="px-4 py-2 rounded-lg font-semibold transition {% if range == 'week' %}bg-blue-500 text-white{% else %}bg-gray-200 text-gray-700 hover:bg-gray-300{% endif %}">
                Last 7 Days
            </a>
            <a href="{{ path('app_admin_activity_logs_analytics', {'range': 'month'}) }}" 
               class="px-4 py-2 rounded-lg font-semibold transition {% if range == 'month' %}bg-blue-500 text-white{% else %}bg-gray-200 text-gray-700 hover:bg-gray-300{% endif %}">
                Last 30 Days
            </a>
            <a href="{{ path('app_admin_activity_logs_analytics', {'range': 'all'}) }}" 
               class="px-4 py-2 rounded-lg font-semibold transition {% if range == 'all' %}bg-blue-500 text-white{% else %}bg-gray-200 text-gray-700 hover:bg-gray-300{% endif %}">
                All Time
            </a>
        </div>
    </div>

    <!-- Charts Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
        <!-- Action Distribution Pie Chart -->
        <div class="bg-white rounded-lg shadow p-6">
            <h2 class="text-lg font-semibold text-gray-700 mb-4">Action Distribution</h2>
            <div class="relative h-80 w-full">
                <canvas id="actionPieChart"></canvas>
            </div>
        </div>

        <!-- Daily Activity Line Chart -->
        <div class="bg-white rounded-lg shadow p-6">
            <h2 class="text-lg font-semibold text-gray-700 mb-4">Daily Activity Trend</h2>
            <div class="relative h-80 w-full">
                <canvas id="dailyActivityChart"></canvas>
            </div>
        </div>

        <!-- User Activity Bar Chart -->
        <div class="bg-white rounded-lg shadow p-6">
            <h2 class="text-lg font-semibold text-gray-700 mb-4">Top Active Users</h2>
            <div class="relative h-80 w-full">
                <canvas id="userActivityChart"></canvas>
            </div>
        </div>

        <!-- Activity Summary Statistics -->
        <div class="bg-white rounded-lg shadow p-6">
            <h2 class="text-lg font-semibold text-gray-700 mb-4">Summary</h2>
            <div class="space-y-4">
                {% set totalActions = 0 %}
                {% for item in actionDistributionArray %}
                    {% set totalActions = totalActions + item.count %}
                {% endfor %}
                
                <div class="flex justify-between items-center border-b pb-3">
                    <span class="text-gray-600">Total Actions</span>
                    <span class="text-2xl font-bold text-blue-600">{{ totalActions }}</span>
                </div>
                
                <div class="flex justify-between items-center border-b pb-3">
                    <span class="text-gray-600">Date Range</span>
                    <span class="text-sm font-semibold text-gray-800">{{ startDate }} to {{ endDate }}</span>
                </div>


                {% if userActivityArray|length > 0 %}
                    <div class="mt-6">
                        <h3 class="text-md font-semibold text-gray-700 mb-3">Top Users</h3>
                        <div class="space-y-2">
                            {% for user in userActivityArray|slice(0, 5) %}
                                <div class="flex justify-between text-sm">
                                    <span class="text-gray-600">{{ user.username }}</span>
                                    <span class="font-semibold text-gray-800">{{ user.count }}</span>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    <!-- Recent Activities Table -->
    <div class="bg-white rounded-lg shadow overflow-hidden">
        <div class="px-6 py-4 border-b bg-gray-50">
            <h2 class="text-lg font-semibold text-gray-800">Recent Activities</h2>
        </div>
        
        <table class="w-full">
            <thead class="bg-gray-50 border-b">
                <tr>
                    <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Timestamp</th>
                    <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">User</th>
                    <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Action</th>
                    <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Entity</th>
                    <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Description</th>
                </tr>
            </thead>
            <tbody class="divide-y">
                {% for log in recentActivities %}
                    <tr class="hover:bg-gray-50">
                        <td class="px-6 py-4 text-sm text-gray-600">{{ log.createdAt|date('Y-m-d H:i:s') }}</td>
                        <td class="px-6 py-4 text-sm font-medium text-gray-900">
                            <a href="{{ path('app_admin_activity_logs_show', {'id': log.id}) }}" class="text-blue-600 hover:text-blue-800">
                                {{ log.user ? log.user.username : 'System' }}
                            </a>
                        </td>
                        <td class="px-6 py-4 text-sm">
                            <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-blue-100 text-blue-800">
                                {{ log.action }}
                            </span>
                        </td>
                        <td class="px-6 py-4 text-sm text-gray-600">{{ log.entityType }}</td>
                        <td class="px-6 py-4 text-sm text-gray-600">{{ log.description|slice(0, 50) }}{% if log.description|length > 50 %}...{% endif %}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="text-center py-6 text-gray-500">No activities found for the selected range.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
    function getRandomColors(count) {
        const colors = [
            '#3b82f6', '#ef4444', '#10b981', '#f59e0b', '#8b5cf6',
            '#ec4899', '#14b8a6', '#f97316', '#6366f1', '#d946ef'
        ];
        return colors.slice(0, Math.min(count, colors.length));
    }

    // Action Distribution Pie Chart
    (function() {
        const ctx = document.getElementById('actionPieChart');
        if (!ctx) return;

        const actionData = {{ actionDistribution|raw }};
        const labels = actionData.map(item => item.action);
        const data = actionData.map(item => item.count);
        const colors = getRandomColors(actionData.length);

        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: labels,
                datasets: [{
                    data: data,
                    backgroundColor: colors,
                    borderColor: '#fff',
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: { position: 'bottom' },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                const percentage = ((context.parsed / total) * 100).toFixed(1);
                                return context.label + ': ' + context.parsed + ' (' + percentage + '%)';
                            }
                        }
                    }
                }
            }
        });
    })();

    // Daily Activity Line Chart
    (function() {
        const ctx = document.getElementById('dailyActivityChart');
        if (!ctx) return;

        const dailyData = {{ dailyActivityData|raw }};
        const labels = dailyData.map(item => item.date);
        const data = dailyData.map(item => item.count);

        new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Daily Activity Count',
                    data: data,
                    borderColor: '#10b981',
                    backgroundColor: 'rgba(16, 185, 129, 0.1)',
                    tension: 0.4,
                    fill: true,
                    pointRadius: 4,
                    pointBackgroundColor: '#10b981',
                    pointBorderColor: '#fff',
                    pointBorderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: { display: true, position: 'top' },
                    tooltip: {
                        backgroundColor: 'rgba(0, 0, 0, 0.8)',
                        padding: 12
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { stepSize: 1 }
                    }
                }
            }
        });
    })();

    // User Activity Bar Chart
    (function() {
        const ctx = document.getElementById('userActivityChart');
        if (!ctx) return;

        const userData = {{ userActivityData|raw }};
        const labels = userData.map(item => item.username);
        const data = userData.map(item => item.count);
        const colors = getRandomColors(userData.length);

        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Activity Count',
                    data: data,
                    backgroundColor: colors,
                    borderRadius: 4
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    x: {
                        beginAtZero: true,
                        ticks: { stepSize: 1 }
                    }
                }
            }
        });
    })();
</script>
{% endblock %}
