{% extends 'admin/base.html.twig' %}

{% block title %}Reports{% endblock %}

{% block body %}
<div class="bg-white rounded-lg shadow p-6">
    <div class="flex justify-between items-center mb-8">
        <h1 class="text-3xl font-bold text-gray-800">Reports & Analytics</h1>
        <div class="flex gap-2 flex-wrap justify-end">
            <a href="{{ path('app_admin_reports_export_csv') }}" class="bg-green-500 hover:bg-green-600 text-white font-semibold py-2 px-4 rounded-lg transition flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                CSV
            </a>
            <a href="{{ path('app_admin_reports_export_json') }}" class="bg-green-500 hover:bg-green-600 text-white font-semibold py-2 px-4 rounded-lg transition flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                JSON
            </a>
            <a href="{{ path('app_admin_reports_export_excel') }}" class="bg-green-500 hover:bg-green-600 text-white font-semibold py-2 px-4 rounded-lg transition flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                Excel
            </a>
            <a href="{{ path('app_admin_activity_logs_analytics') }}" class="bg-green-500 hover:bg-green-600 text-white font-semibold py-2 px-4 rounded-lg transition flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
                Activity Analytics
            </a>
        </div>
    </div>

    <!-- Charts Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
        <!-- Monthly Revenue Bar Chart -->
        <div class="bg-gray-50 rounded-lg shadow-inner p-4">
            <h2 class="text-lg font-semibold text-gray-700 mb-4">Monthly Revenue</h2>
            <div class="relative h-80 w-full">
                <canvas id="reportsBarChart"></canvas>
            </div>
        </div>

        <!-- Top Products Horizontal Bar Chart -->
        <div class="bg-gray-50 rounded-lg shadow-inner p-4">
            <h2 class="text-lg font-semibold text-gray-700 mb-4">Top Products by Value</h2>
            <div class="relative h-80 w-full">
                <canvas id="reportsLineChart"></canvas>
            </div>
        </div>

        <!-- Action Distribution Pie Chart -->
        <div class="bg-gray-50 rounded-lg shadow-inner p-4">
            <h2 class="text-lg font-semibold text-gray-700 mb-4">Actions Distribution (Last 30 Days)</h2>
            <div class="relative h-80 w-full">
                <canvas id="actionPieChart"></canvas>
            </div>
        </div>

        <!-- Daily Activity Line Chart -->
        <div class="bg-gray-50 rounded-lg shadow-inner p-4">
            <h2 class="text-lg font-semibold text-gray-700 mb-4">Daily Activity Trend</h2>
            <div class="relative h-80 w-full">
                <canvas id="dailyActivityChart"></canvas>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
    // Helper function for colors
    function getRandomColors(count) {
        const colors = [
            '#3b82f6', '#ef4444', '#10b981', '#f59e0b', '#8b5cf6',
            '#ec4899', '#14b8a6', '#f97316', '#6366f1', '#d946ef'
        ];
        return colors.slice(0, count);
    }

    // Monthly Revenue Bar Chart
    (function() {
        const ctx = document.getElementById('reportsBarChart');
        if (!ctx) return;

        const chartData = {{ monthlySavingsData|raw }};
        const labels = chartData.map(item => item.month);
        const data = chartData.map(item => item.value);

        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Monthly Revenue (₱)',
                    data: data,
                    backgroundColor: '#3b82f6',
                    borderColor: '#1e40af',
                    borderWidth: 1,
                    borderRadius: 4,
                    hoverBackgroundColor: '#1e40af'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: { display: true, position: 'top' },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return '₱' + context.parsed.y.toLocaleString('en-PH', {minimumFractionDigits: 2, maximumFractionDigits: 2});
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return '₱' + value.toLocaleString('en-PH');
                            }
                        }
                    }
                }
            }
        });
    })();

    // Top Products Chart
    (function() {
        const ctx = document.getElementById('reportsLineChart');
        if (!ctx) return;

        const topProducts = {{ topProductsData|raw }};
        const labels = topProducts.slice(0, 5).map(p => p.name);
        const data = topProducts.slice(0, 5).map(p => p.value);
        const colors = getRandomColors(5);

        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: ['Top 5 Products'],
                datasets: labels.map((label, index) => ({
                    label: label,
                    data: [data[index]],
                    backgroundColor: colors[index]
                }))
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: { display: true, position: 'right' },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return '₱' + context.parsed.x.toLocaleString('en-PH', {minimumFractionDigits: 2, maximumFractionDigits: 2});
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return '₱' + value.toLocaleString('en-PH');
                            }
                        }
                    }
                }
            }
        });
    })();

    // Action Distribution Pie Chart
    (function() {
        const ctx = document.getElementById('actionPieChart');
        if (!ctx) return;

        const actionData = {{ actionDistribution|raw }};
        const labels = actionData.map(item => item.action);
        const data = actionData.map(item => item.count);
        const colors = getRandomColors(actionData.length);

        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: labels,
                datasets: [{
                    data: data,
                    backgroundColor: colors,
                    borderColor: '#fff',
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: { position: 'bottom' },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                const percentage = ((context.parsed / total) * 100).toFixed(1);
                                return context.label + ': ' + context.parsed + ' (' + percentage + '%)';
                            }
                        }
                    }
                }
            }
        });
    })();

    // Daily Activity Line Chart
    (function() {
        const ctx = document.getElementById('dailyActivityChart');
        if (!ctx) return;

        const dailyData = {{ dailyActivityData|raw }};
        const labels = dailyData.map(item => item.date);
        const data = dailyData.map(item => item.count);

        new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Daily Activity Count',
                    data: data,
                    borderColor: '#10b981',
                    backgroundColor: 'rgba(16, 185, 129, 0.1)',
                    tension: 0.4,
                    fill: true,
                    pointRadius: 4,
                    pointBackgroundColor: '#10b981',
                    pointBorderColor: '#fff',
                    pointBorderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: { display: true, position: 'top' },
                    tooltip: {
                        backgroundColor: 'rgba(0, 0, 0, 0.8)',
                        padding: 12
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { stepSize: 1 }
                    }
                }
            }
        });
    })();
</script>
{% endblock %}
