<div class="bg-white rounded-md border border-gray-200 overflow-hidden shadow-md mb-4 transition-transform duration-200 hover:shadow-lg hover:-translate-y-1 hover:bg-gray-50 dark:bg-gray-700 dark:border-gray-600 dark:hover:bg-gray-600 dark:hover:text-white dark:hover:shadow-lg dark:hover:-translate-y-1">
	<div class="px-4 py-4 border-b border-gray-200 bg-gray-50">
		<div class="flex items-center justify-between">
			<h2 class="text-md font-semibold text-gray-900">Categories</h2>
			<span class="text-sm text-gray-600">
				{% if searchQuery %}
					{{ categories|length }}
					results for "{{ searchQuery }}"
				{% else %}
					{{ categories|length }}
					categories
				{% endif %}
			</span>
		</div>
	</div>
	<div class="px-4 py-4 border-b border-gray-200 bg-gray-50 flex items-center justify-between gap-4 flex-wrap sm:flex-nowrap">
		<div class="flex items-center gap-2">
			<!-- Search Bar -->
			<div class="w-200 max-w-sm min-w-[200px]">
				<div class="relative">
					<input class="w-full bg-transparent placeholder:text-slate-400 text-slate-700 text-sm border border-slate-200 rounded-md pl-3 pr-28 py-2 transition duration-300 ease focus:outline-none focus:border-slate-400 hover:border-slate-300 shadow-sm focus:shadow" placeholder="Search Categories"/>
					<button class="absolute top-1 right-1 flex items-center rounded bg-slate-800 py-1 px-2.5 border border-2 border-slate-200 bg-gray-100 text-slate-400 center text-sm text-gray-900 transition-all shadow-sm hover:shadow focus:bg-slate-700 focus:shadow-none active:bg-slate-700 hover:bg-slate-700 active:shadow-none disabled:pointer-events-none disabled:opacity-30 disabled:shadow-none" type="button">
						<svg xmlns="http://www.w3.org/2000/svg" viewbox="0 0 24 24" fill="currentColor" class="w-4 h-4 mr-2">
							<path fill-rule="evenodd" d="M10.5 3.75a6.75 6.75 0 1 0 0 13.5 6.75 6.75 0 0 0 0-13.5ZM2.25 10.5a8.25 8.25 0 1 1 14.59 5.28l4.69 4.69a.75.75 0 1 1-1.06 1.06l-4.69-4.69A8.25 8.25 0 0 1 2.25 10.5Z" clip-rule="evenodd"/>
						</svg>
						Search
					</button>
				</div>
			</div>
			<!-- Create New Category -->
			<a href="{{ path('app_category_new') }}" class="inline-flex items-center gap-2 px-4 py-2 bg-gray-100 text-gray-700 text-sm font-medium rounded-md hover:bg-gray-200 transition-colors duration-200">
				<svg class="w-3 h-3" fill="none" viewbox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
				</svg>
				New Category
			</a>
			<!-- Filters -->
			<div class="relative">
				<button class="inline-flex items-center gap-1 px-3 py-2 bg-gray-100 text-gray-700 text-sm font-medium rounded-md hover:bg-gray-200 transition-colors duration-200" type="button">
					<svg class="w-4 h-4" fill="none" viewbox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V19l-4-4v-.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/>
					</svg>
					Filters
				</button>
				<!-- Dropdown menu (hidden by default) -->
				<div class="absolute right-0 mt-2 w-48 bg-white border border-gray-200 rounded-md shadow-lg py-1 z-20 hidden">
					<a href="#" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">Filter by Name</a>
					<a href="#" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">Filter by Creation Date</a>
					<a href="#" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">Filter by Product Count</a>
				</div>
			</div>
		</div>

		<div class="flex items-center gap-2">
			<form method="get" action="{{ path('app_category_index') }}" class="flex items-center gap-2">
				<input type="hidden" name="q" value="{{ searchQuery }}">
				<label for="sort_by_direction" class="text-sm text-gray-600">Sort by:</label>
				<select name="sort_by_direction" id="sort_by_direction" onchange="this.form.submit()" class="rounded-md border-gray-300 shadow-sm focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50 text-sm">
					<option value="name-asc" {{ sortBy == 'name' and sortDirection == 'asc' ? 'selected' : '' }}>Name (A-Z)</option>
					<option value="name-desc" {{ sortBy == 'name' and sortDirection == 'desc' ? 'selected' : '' }}>Name (Z-A)</option>
					<option value="createdAt-desc" {{ sortBy == 'createdAt' and sortDirection == 'desc' ? 'selected' : '' }}>Newest</option>
					<option value="createdAt-asc" {{ sortBy == 'createdAt' and sortDirection == 'asc' ? 'selected' : '' }}>Oldest</option>
					<option value="products-desc" {{ sortBy == 'products' and sortDirection == 'desc' ? 'selected' : '' }}>Products (Most)</option>
					<option value="products-asc" {{ sortBy == 'products' and sortDirection == 'asc' ? 'selected' : '' }}>Products (Fewest)</option>
				</select>
			</form>
		</div>
	</div>

	{% if categories|length > 0 %}
		<div class="overflow-x-auto">
			<table class="min-w-full divide-y divide-gray-200">
				<thead class="bg-gray-50">
					<tr>
						<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">ID</th>
						<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Name</th>
						<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Parent</th>
						<!-- <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Description</th> -->
						<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Products</th>
						{% if is_granted('ROLE_ADMIN') %}
							<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Creator</th>
						{% endif %}
						<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Actions</th>
					</tr>
				</thead>
				<tbody class="bg-white divide-y divide-gray-200">
					{% for category in categories %}
						<tr
							class="hover:bg-gray-50 transition-colors duration-150">
							<!-- ID -->
							<td class="px-6 py-2 whitespace-nowrap">
								<span class="text-sm text-gray-600">#{{ category.id }}</span>
							</td>

							<!-- Name -->
							<td class="px-6 py-2">
								<div class="text-sm font-semibold text-gray-900">{{ category.name }}</div>
							</td>

							<!-- Parent -->
							<td class="px-6 py-2">
								{% if category.parent %}
									{#
																											<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
																												{{ category.parent.name }}
																											</span>
																											#}
								{% else %}
									<span class="text-xs text-gray-500 italic">None</span>
								{% endif %}
							</td>

							{#
																					<!-- Description -->
																					<td class="px-6 py-2">
																						{% if category.description %}
																							<div class="text-sm text-gray-600 max-w-xs truncate">{{ category.description }}</div>
																						{% else %}
																							<span class="text-xs text-gray-500 italic">No description</span>
																						{% endif %}
																					</td>
																					#}

							<!-- Products Count -->
							<td class="px-6 py-2">
								<div class="flex items-center">
									<span class="text-sm font-medium text-gray-900 mr-2">{{ category.products|length }}</span>
									{#
																											{% if category.products|length > 0 %}
																												<span class="text-xs text-gray-500 bg-gray-100 px-2 py-1 rounded-full">
																													{{ category.products|length }}
																													products
																												</span>
																											{% endif %}
																											#}
								</div>
							</td>
							{% if is_granted('ROLE_ADMIN') %}
								<!-- Creator -->
								<td class="px-6 py-2">
									{% set creator = category.getCreatedBy() %}
									{% if creator is not null and creator.id > 0 %}
										<span class="text-sm font-medium text-gray-900">{{ creator.username }}</span>
									{% else %}
										<span class="text-xs text-gray-500 italic">
											{% if creator is null %}
												No Creator
											{% elseif creator.id == 0 %}
												User deleted
											{% else %}
												Unknown
											{% endif %}
										</span>
									{% endif %}
								</td>
							{% endif %}

							<!-- Actions -->
							<td class="px-6 py-2">
								<div class="flex items-center space-x-3">
									<a href="{{ path('app_category_show', {'category': category.id}) }}" class="p-1.5 text-gray-500 hover:text-blue-600 hover:bg-blue-50 rounded-md transition-colors duration-200" title="View Details">
										<svg class="w-4 h-4" fill="none" viewbox="0 0 24 24" stroke="currentColor">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z"/>
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
										</svg>
									</a>
									<a href="{{ path('app_category_edit', {'category': category.id}) }}" class="p-1.5 text-gray-500 hover:text-yellow-600 hover:bg-yellow-50 rounded-md transition-colors duration-200" title="Edit Category">
										<svg class="w-4 h-4" fill="none" viewbox="0 0 24 24" stroke="currentColor">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10"/>
										</svg>
									</a>
									<form method="post" action="{{ path('app_category_delete', {'category': category.id}) }}" onsubmit="return confirm('Are you sure you want to delete this category? This action cannot be undone.');" class="inline">
										<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ category.id) }}">
										<button type="submit" class="p-1.5 text-gray-500 hover:text-red-600 hover:bg-red-50 rounded-md transition-colors duration-200" title="Delete Category">
											<svg class="w-4 h-4" fill="none" viewbox="0 0 24 24" stroke="currentColor">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09-1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"/>
											</svg>
										</button>
									</form>
								</div>
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>

		<!-- Pagination -->
		{% if totalPages > 1 %}
			<div class="px-6 py-2 border-t border-gray-200 bg-gray-50">
				<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
					<div class="text-sm text-gray-600">
						Showing page
						<span class="font-semibold">{{ currentPage }}</span>
						of
						<span class="font-semibold">{{ totalPages }}</span>
						<span class="hidden sm:inline">
							•
						</span>
						<span class="block sm:inline">{{ totalItems }}
							total categories</span>
					</div>

					<div class="flex items-center space-x-2">
						{% set base_params = {q: searchQuery, sort: sortBy, direction: sortDirection} %}

						<!-- Previous Button -->
						<a href="{{ path('app_category_index', base_params|merge({page: currentPage - 1})) }}" class="inline-flex items-center px-3 py-2 border border-gray-300 rounded-lg text-sm font-medium transition
																								                                      {{ currentPage == 1 ? 'opacity-50 cursor-not-allowed bg-gray-100 text-gray-400' : 'bg-white text-gray-700 hover:bg-gray-50 hover:border-gray-400' }}">
							<svg class="w-4 h-4 mr-1" fill="none" viewbox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
							</svg>
							Previous
						</a>

						<!-- Page Numbers -->
						<div class="hidden sm:flex items-center space-x-1">
							{% for i in 1..totalPages %}
								{% if i == 1 or i == totalPages or (i >= currentPage - 1 and i <= currentPage + 1) %}
									<a href="{{ path('app_category_index', base_params|merge({page: i})) }}" class="inline-flex items-center px-3 py-2 border rounded-lg text-sm font-medium transition
																																	                                                  {{ currentPage == i ? 'bg-blue-600 text-white border-blue-600' : 'bg-white text-gray-700 border-gray-300 hover:bg-gray-50' }}">
										{{ i }}
									</a>
								{% elseif i == currentPage - 2 or i == currentPage + 2 %}
									<span class="px-2 text-gray-500">...</span>
								{% endif %}
							{% endfor %}
						</div>

						<!-- Next Button -->
						<a href="{{ path('app_category_index', base_params|merge({page: currentPage + 1})) }}" class="inline-flex items-center px-3 py-2 border border-gray-300 rounded-lg text-sm font-medium transition
																								                                      {{ currentPage == totalPages ? 'opacity-50 cursor-not-allowed bg-gray-100 text-gray-400' : 'bg-white text-gray-700 hover:bg-gray-50 hover:border-gray-400' }}">
							Next
							<svg class="w-4 h-4 ml-1" fill="none" viewbox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
							</svg>
						</a>
					</div>
				</div>
			</div>
		{% endif %}
	{% else %}
		<!-- Empty State -->
		<div class="px-6 py-12 text-center">
			<div class="text-gray-400">
				<svg class="w-16 h-16 mx-auto mb-4" fill="none" viewbox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.801 0A2.25 2.25 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.801 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z"/>
				</svg>
				<h3 class="text-lg font-medium text-gray-700 mb-2">No categories found</h3>
				<p class="text-sm text-gray-500 mb-6 max-w-md mx-auto">
					{% if searchQuery %}
						No categories match your search "{{ searchQuery }}". Try a different search term.
					{% else %}
						No categories have been created yet. Start by creating your first category.
					{% endif %}
				</p>
				<a href="{{ path('app_category_new') }}" class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors duration-200">
					<svg class="w-4 h-4" fill="none" viewbox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
					</svg>
					Create First Category
				</a>
			</div>
		</div>
	{% endif %}
</div>
