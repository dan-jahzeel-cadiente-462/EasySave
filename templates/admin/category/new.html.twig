{% extends 'admin/index.html.twig' %}

{% block title %}New Category{% endblock %}

{% block body %}
    <div class="container mx-auto px-6 py-10">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-8">
            <h1 class="text-3xl font-extrabold text-gray-800 tracking-tight">
                ✨ Create New Category
            </h1>
            <a 
                href="{{ path('app_category_index') }}"
                class="mt-4 md:mt-0 inline-flex items-center gap-2 px-4 py-2 text-sm font-medium 
                       text-gray-700 bg-gray-100 border border-gray-300 rounded-lg 
                       hover:bg-gray-200 hover:text-gray-900 transition duration-200"
            >
                ← Back to List
            </a>
        </div>

        <div class="bg-white border border-gray-200 rounded-2xl shadow-md hover:shadow-lg transition-shadow duration-300">
            <div class="p-8">
                {{ include('admin/category/_form.html.twig', {'button_label': '💾 Save'}) }}
            </div>
        </div>
    </div>
{% endblock %}