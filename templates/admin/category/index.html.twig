{% extends 'admin/index.html.twig' %}

{% block title %}Categories{% endblock %}

{% block body %}
<div class="container mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Title and Header -->
    <div class="mb-8">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
                <h1 class="text-2xl font-bold text-gray-900">Categories Management</h1>
                <p class="text-gray-600 mt-1">Organize and manage your product categories</p>
            </div>
            
            <!-- Create New Button -->
            <a href="{{ path('app_category_new') }}"
               class="inline-flex items-center gap-2 px-4 py-2.5 bg-green-600 text-white font-medium rounded-lg shadow-sm hover:bg-blue-700 focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-all duration-200 text-sm">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                New Category
            </a>
        </div>
    </div>

    <!-- Search and Filter Toolbar -->
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5 mb-6">
        <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-5">
            <!-- Search Section -->
            <div class="flex-1">
                <label class="block text-sm font-medium text-gray-700 mb-2">Search Categories</label>
                <form method="get" action="{{ path('app_category_index') }}" class="relative max-w-md">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                    </div>
                    <input type="search" 
                           name="q" 
                           value="{{ searchQuery }}" 
                           placeholder="Search by name or description..."
                           class="block w-full pl-10 pr-3 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm">
                    
                    <input type="hidden" name="sort" value="{{ sortBy }}">
                    <input type="hidden" name="direction" value="{{ sortDirection }}">
                    
                    {% if searchQuery %}
                        <a href="{{ path('app_category_index', {sort: sortBy, direction: sortDirection}) }}" 
                           class="absolute inset-y-0 right-0 pr-10 flex items-center text-sm text-gray-500 hover:text-gray-700">
                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                            </svg>
                        </a>
                    {% endif %}
                </form>
            </div>

            <!-- Sort Controls -->
            <div class="flex flex-col sm:flex-row gap-4">
                <div class="w-full sm:w-48">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Sort By</label>
                    <form method="get" action="{{ path('app_category_index') }}" class="w-full">
                        <input type="hidden" name="q" value="{{ searchQuery }}">
                        
                        {% set currentSort = sortBy ~ '-' ~ sortDirection %}
                        
                        <select name="sort_by_direction" 
                                onchange="this.form.submit()" 
                                class="block w-full px-3 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm bg-white">
                            
                            <option value="" disabled {% if not sortBy %}selected{% endif %}>Select sort...</option>
                            <option value="id-asc" {% if currentSort == 'id-asc' %}selected{% endif %}>ID (Ascending)</option>
                            <option value="id-desc" {% if currentSort == 'id-desc' %}selected{% endif %}>ID (Descending)</option>
                            <option value="name-asc" {% if currentSort == 'name-asc' %}selected{% endif %}>Name (A-Z)</option>
                            <option value="name-desc" {% if currentSort == 'name-desc' %}selected{% endif %}>Name (Z-A)</option>
                            <option value="parent-asc" {% if currentSort == 'parent-asc' %}selected{% endif %}>Parent (A-Z)</option>
                            <option value="parent-desc" {% if currentSort == 'parent-desc' %}selected{% endif %}>Parent (Z-A)</option>
                            <option value="products-desc" {% if currentSort == 'products-desc' %}selected{% endif %}>Products (High to Low)</option>
                            <option value="products-asc" {% if currentSort == 'products-asc' %}selected{% endif %}>Products (Low to High)</option>
                        </select>
                    </form>
                </div>
                
                <!-- Apply Filters Button -->
                <div class="flex items-end">
                    <button type="submit"
                            class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-gray-800 text-white font-medium rounded-lg hover:bg-gray-900 focus:ring-2 focus:ring-gray-800 focus:ring-offset-2 transition-all duration-200 text-sm h-[42px]">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
                        </svg>
                        Apply Filters
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Categories Summary Stats -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
        <div class="bg-white p-5 rounded-xl border border-gray-200">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-600">Total Categories</p>
                    <p class="text-2xl font-bold text-gray-900 mt-1">{{ totalItems }}</p>
                </div>
                <div class="p-3 bg-blue-50 rounded-lg">
                    <svg class="w-6 h-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8.25 6.75h7.5M8.25 12h7.5m-7.5 5.25h7.5M3.75 6.75h.007v.008H3.75V6.75zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zM3.75 12h.007v.008H3.75V12zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm-.375 5.25h.007v.008H3.75v-.008zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
                    </svg>
                </div>
            </div>
        </div>
        
        <div class="bg-white p-5 rounded-xl border border-gray-200">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-600">Parent Categories</p>
                    <p class="text-2xl font-bold text-emerald-600 mt-1">
                        {% set parentCount = categories|filter(c => c.parent == null)|length %}
                        {{ parentCount }}
                    </p>
                </div>
                <div class="p-3 bg-emerald-50 rounded-lg">
                    <svg class="w-6 h-6 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.25 12.75V12A2.25 2.25 0 014.5 9.75h15A2.25 2.25 0 0121.75 12v.75m-8.69-6.44l-2.12-2.12a1.5 1.5 0 00-1.061-.44H4.5A2.25 2.25 0 002.25 6v12a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9a2.25 2.25 0 00-2.25-2.25h-5.379a1.5 1.5 0 01-1.06-.44z" />
                    </svg>
                </div>
            </div>
        </div>
        
        <div class="bg-white p-5 rounded-xl border border-gray-200">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-600">Subcategories</p>
                    <p class="text-2xl font-bold text-amber-600 mt-1">
                        {% set subcategoryCount = categories|filter(c => c.parent != null)|length %}
                        {{ subcategoryCount }}
                    </p>
                </div>
                <div class="p-3 bg-amber-50 rounded-lg">
                    <svg class="w-6 h-6 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.25 7.125C2.25 6.504 2.754 6 3.375 6h6c.621 0 1.125.504 1.125 1.125v3.75c0 .621-.504 1.125-1.125 1.125h-6a1.125 1.125 0 01-1.125-1.125v-3.75zM14.25 8.625c0-.621.504-1.125 1.125-1.125h5.25c.621 0 1.125.504 1.125 1.125v8.25c0 .621-.504 1.125-1.125 1.125h-5.25a1.125 1.125 0 01-1.125-1.125v-8.25zM3.75 16.125c0-.621.504-1.125 1.125-1.125h5.25c.621 0 1.125.504 1.125 1.125v2.25c0 .621-.504 1.125-1.125 1.125h-5.25a1.125 1.125 0 01-1.125-1.125v-2.25z" />
                    </svg>
                </div>
            </div>
        </div>
        
        {#
        <div class="bg-white p-5 rounded-xl border border-gray-200">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-600">Avg Products/Category</p>
                    <p class="text-2xl font-bold text-purple-600 mt-1">
                        {% if categories|length > 0 %}
                            {% set totalProducts = categories|reduce((sum, c) => sum + c.products|length, 0) %}
                            {{ (totalProducts / categories|length)|round(1) }}
                        {% else %}
                            0
                        {% endif %}
                    </p>
                </div>
                <div class="p-3 bg-purple-50 rounded-lg">
                    <svg class="w-6 h-6 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" />
                    </svg>
                </div>
            </div>
        </div>
        #}
    </div>

    <!-- Categories Table -->
    <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
            <div class="flex items-center justify-between">
                <h2 class="text-lg font-semibold text-gray-900">Category List</h2>
                <span class="text-sm text-gray-600">
                    {% if searchQuery %}
                        {{ categories|length }} results for "{{ searchQuery }}"
                    {% else %}
                        {{ categories|length }} categories
                    {% endif %}
                </span>
            </div>
        </div>
        
        {% if categories|length > 0 %}
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">ID</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Name</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Parent</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Description</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Products</th>
                            {% if is_granted('ROLE_ADMIN') %}
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Creator</th>
                            {% endif %}
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                    {% for category in categories %}
                        <tr class="hover:bg-gray-50 transition-colors duration-150">
                            <!-- ID -->
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="text-sm text-gray-600">#{{ category.id }}</span>
                            </td>
                            
                            <!-- Name -->
                            <td class="px-6 py-4">
                                <div class="text-sm font-semibold text-gray-900">{{ category.name }}</div>
                            </td>
                            
                            <!-- Parent -->
                            <td class="px-6 py-4">
                                {% if category.parent %}
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                        {{ category.parent.name }}
                                    </span>
                                {% else %}
                                    <span class="text-xs text-gray-500 italic">None</span>
                                {% endif %}
                            </td>
                            
                            <!-- Description -->
                            <td class="px-6 py-4">
                                {% if category.description %}
                                    <div class="text-sm text-gray-600 max-w-xs truncate">{{ category.description }}</div>
                                {% else %}
                                    <span class="text-xs text-gray-500 italic">No description</span>
                                {% endif %}
                            </td>
                            
                            <!-- Products Count -->
                            <td class="px-6 py-4">
                                <div class="flex items-center">
                                    <span class="text-sm font-medium text-gray-900 mr-2">{{ category.products|length }}</span>
                                    {% if category.products|length > 0 %}
                                        <span class="text-xs text-gray-500 bg-gray-100 px-2 py-1 rounded-full">
                                            {{ category.products|length }} products
                                        </span>
                                    {% endif %}
                                </div>
                            </td>
                                {% if is_granted('ROLE_ADMIN') %}
                                <!-- Creator -->
                                <td class="px-6 py-4">
                                    {% set creator = category.getCreatedBy() %}
                                    {% if creator is not null and creator.id > 0 %}
                                        <span class="text-sm font-medium text-gray-900">{{ creator.username }}</span>
                                    {% else %}
                                        <span class="text-xs text-gray-500 italic">
                                        {% if creator is null %}
                                            No Creator
                                        {% elseif creator.id == 0 %}
                                            User deleted
                                        {% else %}
                                            Unknown
                                        {% endif %}
                                        </span>
                                    {% endif %}
                                </td>
                                {% endif %}
                            
                            <!-- Actions -->
                            <td class="px-6 py-4">
                                <div class="flex items-center space-x-3">
                                    <a href="{{ path('app_category_show', {'category': category.id}) }}"
                                       class="p-1.5 text-gray-500 hover:text-blue-600 hover:bg-blue-50 rounded-md transition-colors duration-200"
                                       title="View Details">
                                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                                        </svg>
                                    </a>
                                    <a href="{{ path('app_category_edit', {'category': category.id}) }}"
                                       class="p-1.5 text-gray-500 hover:text-yellow-600 hover:bg-yellow-50 rounded-md transition-colors duration-200"
                                       title="Edit Category">
                                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
                                        </svg>
                                    </a>
                                    <form method="post" 
                                          action="{{ path('app_category_delete', {'category': category.id}) }}" 
                                          onsubmit="return confirm('Are you sure you want to delete this category? This action cannot be undone.');"
                                          class="inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ category.id) }}">
                                        <button type="submit"
                                                class="p-1.5 text-gray-500 hover:text-red-600 hover:bg-red-50 rounded-md transition-colors duration-200"
                                                title="Delete Category">
                                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09-1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                                            </svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            
            <!-- Pagination -->
            {% if totalPages > 1 %}
                <div class="px-6 py-4 border-t border-gray-200 bg-gray-50">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                        <div class="text-sm text-gray-600">
                            Showing page <span class="font-semibold">{{ currentPage }}</span> of <span class="font-semibold">{{ totalPages }}</span>
                            <span class="hidden sm:inline"> • </span>
                            <span class="block sm:inline">{{ totalItems }} total categories</span>
                        </div>
                        
                        <div class="flex items-center space-x-2">
                            {% set base_params = {q: searchQuery, sort: sortBy, direction: sortDirection} %}

                            <!-- Previous Button -->
                            <a href="{{ path('app_category_index', base_params|merge({page: currentPage - 1})) }}"
                               class="inline-flex items-center px-3 py-2 border border-gray-300 rounded-lg text-sm font-medium transition
                                      {{ currentPage == 1 ? 'opacity-50 cursor-not-allowed bg-gray-100 text-gray-400' : 'bg-white text-gray-700 hover:bg-gray-50 hover:border-gray-400' }}">
                                <svg class="w-4 h-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                                </svg>
                                Previous
                            </a>
                            
                            <!-- Page Numbers -->
                            <div class="hidden sm:flex items-center space-x-1">
                                {% for i in 1..totalPages %}
                                    {% if i == 1 or i == totalPages or (i >= currentPage - 1 and i <= currentPage + 1) %}
                                        <a href="{{ path('app_category_index', base_params|merge({page: i})) }}"
                                           class="inline-flex items-center px-3 py-2 border rounded-lg text-sm font-medium transition
                                                  {{ currentPage == i ? 'bg-blue-600 text-white border-blue-600' : 'bg-white text-gray-700 border-gray-300 hover:bg-gray-50' }}">
                                            {{ i }}
                                        </a>
                                    {% elseif i == currentPage - 2 or i == currentPage + 2 %}
                                        <span class="px-2 text-gray-500">...</span>
                                    {% endif %}
                                {% endfor %}
                            </div>
                            
                            <!-- Next Button -->
                            <a href="{{ path('app_category_index', base_params|merge({page: currentPage + 1})) }}"
                               class="inline-flex items-center px-3 py-2 border border-gray-300 rounded-lg text-sm font-medium transition
                                      {{ currentPage == totalPages ? 'opacity-50 cursor-not-allowed bg-gray-100 text-gray-400' : 'bg-white text-gray-700 hover:bg-gray-50 hover:border-gray-400' }}">
                                Next
                                <svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                </svg>
                            </a>
                        </div>
                    </div>
                </div>
            {% endif %}
        {% else %}
            <!-- Empty State -->
            <div class="px-6 py-12 text-center">
                <div class="text-gray-400">
                    <svg class="w-16 h-16 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.801 0A2.25 2.25 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.801 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z" />
                    </svg>
                    <h3 class="text-lg font-medium text-gray-700 mb-2">No categories found</h3>
                    <p class="text-sm text-gray-500 mb-6 max-w-md mx-auto">
                        {% if searchQuery %}
                            No categories match your search "{{ searchQuery }}". Try a different search term.
                        {% else %}
                            No categories have been created yet. Start by creating your first category.
                        {% endif %}
                    </p>
                    <a href="{{ path('app_category_new') }}" 
                       class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors duration-200">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                        </svg>
                        Create First Category
                    </a>
                </div>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}