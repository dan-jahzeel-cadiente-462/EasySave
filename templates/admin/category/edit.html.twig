{% extends 'admin/index.html.twig' %}

{% block title %}Edit Category{% endblock %}

{% block body %}
    <div class="container mx-auto px-6 py-10">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-8">
            <h1 class="text-3xl font-extrabold text-gray-800 tracking-tight">
                ✏️ Edit Category
            </h1>
            <a 
                href="{{ path('app_category_index') }}"
                class="mt-4 md:mt-0 inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 border border-gray-300 rounded-lg hover:bg-gray-200 hover:text-gray-900 transition duration-200"
            >
                ← Back to List
            </a>
        </div>

        <div class="bg-white border border-gray-200 rounded-2xl shadow-md hover:shadow-lg transition-shadow duration-300">
            <div class="p-8 space-y-6">
                <h2 class="text-xl font-semibold text-gray-700 border-b border-gray-200 pb-3">
                    Category Details
                </h2>

                {{ include('admin/category/_form.html.twig', {'button_label': '💾 Update'}) }}
            </div>

            <div class="flex items-center justify-end px-8 py-5 bg-gray-50 border-t border-gray-200 rounded-b-2xl">
                {{ include('admin/category/_delete_form.html.twig') }}
            </div>
        </div>
    </div>
{% endblock %}
