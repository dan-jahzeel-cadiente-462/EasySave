{% extends 'admin/base.html.twig' %}

{% block title %}User Management{% endblock %}

{% block body %}
<div class="container mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Title & Create Button -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-4">
        <div>
            <h1 class="text-2xl font-bold text-gray-800">User Management</h1>
            <p class="text-sm text-gray-600 mt-1">Total: {{ users|length }} user(s)</p>
        </div>
        <a href="{{ path('app_admin_user_create') }}" class="inline-flex items-center px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg font-semibold transition duration-200 shadow-sm">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
            </svg>
            Create New User
        </a>
    </div>

    <!-- Enhanced Search & Filter Card with Collapsible Functionality -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 mb-6 overflow-hidden">
        <!-- Header with Toggle Button -->
        <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
            <div class="flex items-center">
                <svg class="w-5 h-5 text-indigo-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path>
                </svg>
                <h2 class="text-lg font-semibold text-gray-800">Search & Filter Users</h2>
                {% if app.request.query.get('search') or app.request.query.get('role') or app.request.query.get('status') %}
                <span class="ml-3 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-indigo-100 text-indigo-800">
                    <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                    </svg>
                    Filters Active
                </span>
                {% endif %}
            </div>
            <button type="button" 
                    id="filterToggle" 
                    class="p-2 text-gray-500 hover:text-gray-700 rounded-lg hover:bg-gray-100 transition-colors duration-200"
                    aria-label="Toggle filters">
                <svg id="filterToggleIcon" class="w-5 h-5 transform transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
            </button>
        </div>

        <!-- Collapsible Content -->
        <div id="filterContent" class="px-6 py-6 transition-all duration-300 ease-in-out overflow-hidden">
            <form method="GET" action="{{ path('app_user_management') }}" class="space-y-6">
                <!-- Search Bar with Dropdown Suggestions -->
                <div class="relative">
                    <label for="search" class="block text-sm font-medium text-gray-700 mb-2">
                        Search Users
                    </label>
                    <div class="relative group">
                        <input type="text" 
                               id="search" 
                               name="search" 
                               value="{{ app.request.query.get('search') }}"
                               placeholder="Search by username, email, or ID..."
                               class="w-full pl-12 pr-10 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 group-hover:border-indigo-400 shadow-sm"
                               autocomplete="off">
                        <div class="absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-400 group-hover:text-indigo-500 transition-colors">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                            </svg>
                        </div>
                        {% if app.request.query.get('search') %}
                        <button type="button" 
                                onclick="document.getElementById('search').value='';"
                                class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400 hover:text-gray-600 p-1 rounded-full hover:bg-gray-100">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                        </button>
                        {% endif %}
                    </div>
                    <div id="searchSuggestions" class="hidden absolute z-10 mt-1 w-full bg-white border border-gray-200 rounded-xl shadow-lg max-h-60 overflow-y-auto"></div>
                </div>

                <!-- Filter Grid with Smooth Dropdowns -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <!-- Role Filter with Enhanced Dropdown -->
                    <div class="relative">
                        <label for="role" class="block text-sm font-medium text-gray-700 mb-2">
                            Filter by Role
                        </label>
                        <div class="relative">
                            <select id="role" 
                                    name="role" 
                                    class="w-full pl-4 pr-10 py-3 appearance-none border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 bg-white transition-all duration-200 hover:border-gray-400 shadow-sm cursor-pointer">
                                <option value="">All Roles</option>
                                <option value="ROLE_ADMIN" {% if app.request.query.get('role') == 'ROLE_ADMIN' %}selected{% endif %}>Administrator</option>
                                <option value="ROLE_STAFF" {% if app.request.query.get('role') == 'ROLE_STAFF' %}selected{% endif %}>Staff</option>
                                <option value="ROLE_USER" {% if app.request.query.get('role') == 'ROLE_USER' %}selected{% endif %}>Regular User</option>
                            </select>
                            <div class="absolute inset-y-0 right-0 flex items-center px-3 pointer-events-none">
                                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                </svg>
                            </div>
                        </div>
                    </div>

                    <!-- Status Filter -->
                    <div class="relative">
                        <label for="status" class="block text-sm font-medium text-gray-700 mb-2">
                            Filter by Status
                        </label>
                        <div class="relative">
                            <select id="status" 
                                    name="status" 
                                    class="w-full pl-4 pr-10 py-3 appearance-none border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 bg-white transition-all duration-200 hover:border-gray-400 shadow-sm cursor-pointer">
                                <option value="">All Statuses</option>
                                <option value="active" {% if app.request.query.get('status') == 'active' %}selected{% endif %}>Active Only</option>
                                <option value="inactive" {% if app.request.query.get('status') == 'inactive' %}selected{% endif %}>Inactive Only</option>
                            </select>
                            <div class="absolute inset-y-0 right-0 flex items-center px-3 pointer-events-none">
                                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                </svg>
                            </div>
                        </div>
                    </div>

                    <!-- Quick Action Buttons -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2 opacity-0">
                            Quick Actions
                        </label>
                        <div class="flex gap-3">
                            <button type="button" 
                                    onclick="setQuickFilter('active_admins')" 
                                    class="flex-1 px-4 py-3 bg-red-50 hover:bg-red-100 border border-red-200 text-red-700 rounded-xl font-medium transition-all duration-200 hover:shadow-sm text-sm flex items-center justify-center group">
                                <svg class="w-4 h-4 mr-2 text-red-600 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                                </svg>
                                Active Admins
                            </button>
                            <button type="button" 
                                    onclick="setQuickFilter('recent_users')" 
                                    class="flex-1 px-4 py-3 bg-blue-50 hover:bg-blue-100 border border-blue-200 text-blue-700 rounded-xl font-medium transition-all duration-200 hover:shadow-sm text-sm flex items-center justify-center group">
                                <svg class="w-4 h-4 mr-2 text-blue-600 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                                Recent Users
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Sorting Section with Toggle -->
                <div class="border-t border-gray-100 pt-6">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-sm font-semibold text-gray-700 uppercase tracking-wider">Sorting Options</h3>
                        <button type="button" 
                                id="sortToggle" 
                                class="text-sm text-indigo-600 hover:text-indigo-800 font-medium flex items-center">
                            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                            </svg>
                            Show Options
                        </button>
                    </div>
                    
                    <div id="sortOptions" class="hidden grid grid-cols-1 md:grid-cols-2 gap-6 transition-all duration-300">
                        <div>
                            <div class="relative">
                                <label for="sort_by" class="block text-sm font-medium text-gray-700 mb-2">
                                    Sort By
                                </label>
                                <div class="relative">
                                    <select id="sort_by" 
                                            name="sort_by" 
                                            class="w-full pl-4 pr-10 py-3 appearance-none border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 bg-white transition-all duration-200 shadow-sm">
                                        <option value="id" {% if app.request.query.get('sort_by') == 'id' %}selected{% endif %}>User ID</option>
                                        <option value="username" {% if app.request.query.get('sort_by') == 'username' %}selected{% endif %}>Username</option>
                                        <option value="email" {% if app.request.query.get('sort_by') == 'email' %}selected{% endif %}>Email Address</option>
                                        <option value="createdAt" {% if app.request.query.get('sort_by') == 'createdAt' or not app.request.query.get('sort_by') %}selected{% endif %}>Date Created</option>
                                    </select>
                                    <div class="absolute inset-y-0 right-0 flex items-center px-3 pointer-events-none">
                                        <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"></path>
                                        </svg>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div>
                            <div class="relative">
                                <label for="sort_order" class="block text-sm font-medium text-gray-700 mb-2">
                                    Sort Direction
                                </label>
                                <div class="relative">
                                    <select id="sort_order" 
                                            name="sort_order" 
                                            class="w-full pl-4 pr-10 py-3 appearance-none border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 bg-white transition-all duration-200 shadow-sm">
                                        <option value="asc" {% if app.request.query.get('sort_order') == 'asc' or not app.request.query.get('sort_order') %}selected{% endif %}>Ascending (A-Z / Oldest)</option>
                                        <option value="desc" {% if app.request.query.get('sort_order') == 'desc' %}selected{% endif %}>Descending (Z-A / Newest)</option>
                                    </select>
                                    <div class="absolute inset-y-0 right-0 flex items-center px-3 pointer-events-none">
                                        <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4h13M3 8h9m-9 4h9m5-4v12m0 0l-4-4m4 4l4-4"></path>
                                        </svg>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="flex flex-wrap gap-3 pt-4 border-t border-gray-100">
                    <button type="submit" class="inline-flex items-center px-5 py-3 bg-gradient-to-r from-indigo-600 to-indigo-700 hover:from-indigo-700 hover:to-indigo-800 text-white font-semibold rounded-xl transition-all duration-300 shadow-md hover:shadow-lg transform hover:-translate-y-0.5">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path>
                        </svg>
                        Apply Filters
                    </button>
                    
                    <a href="{{ path('app_user_management') }}" class="inline-flex items-center px-5 py-3 border border-gray-300 text-gray-700 font-semibold rounded-xl hover:bg-gray-50 transition-all duration-300 shadow-sm hover:shadow">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                        Clear All
                    </a>
                    
                    <!-- Active Filters Display -->
                    {% if app.request.query.get('search') or app.request.query.get('role') or app.request.query.get('status') %}
                    <div class="flex-1 flex flex-wrap gap-2 items-center justify-end">
                        <span class="text-sm text-gray-600 font-medium">Active Filters:</span>
                        {% if app.request.query.get('search') %}
                        <span class="inline-flex items-center px-3 py-1.5 bg-indigo-50 text-indigo-700 text-sm font-medium rounded-full border border-indigo-200">
                            Search: "{{ app.request.query.get('search') }}"
                            <button type="button" 
                                    onclick="removeFilter('search')" 
                                    class="ml-2 text-indigo-600 hover:text-indigo-900">
                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                                </svg>
                            </button>
                        </span>
                        {% endif %}
                        {% if app.request.query.get('role') %}
                        <span class="inline-flex items-center px-3 py-1.5 bg-purple-50 text-purple-700 text-sm font-medium rounded-full border border-purple-200">
                            Role: {{ app.request.query.get('role')|replace({'ROLE_': ''}) }}
                            <button type="button" 
                                    onclick="removeFilter('role')" 
                                    class="ml-2 text-purple-600 hover:text-purple-900">
                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                                </svg>
                            </button>
                        </span>
                        {% endif %}
                        {% if app.request.query.get('status') %}
                        <span class="inline-flex items-center px-3 py-1.5 bg-green-50 text-green-700 text-sm font-medium rounded-full border border-green-200">
                            Status: {{ app.request.query.get('status')|capitalize }}
                            <button type="button" 
                                    onclick="removeFilter('status')" 
                                    class="ml-2 text-green-600 hover:text-green-900">
                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                                </svg>
                            </button>
                        </span>
                        {% endif %}
                    </div>
                    {% endif %}
                </div>
            </form>
        </div>
    </div>

    <!-- Table Wrapper -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <!-- Table Header with Results Count -->
        <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
                <div>
                    <h3 class="text-sm font-semibold text-gray-700 uppercase tracking-wider">Users List</h3>
                    <p class="text-xs text-gray-500 mt-1">
                        Showing {{ users|length }} user(s)
                        {% if app.request.query.get('search') %}
                            matching "<span class="font-semibold">{{ app.request.query.get('search') }}</span>"
                        {% endif %}
                        {% if app.request.query.get('role') %}
                            with role: <span class="font-semibold">{{ app.request.query.get('role')|replace({'ROLE_': ''}) }}</span>
                        {% endif %}
                    </p>
                </div>
                
                <!-- Export Options -->
                <div class="flex items-center space-x-2">
                    <button type="button" class="inline-flex items-center px-3 py-1.5 text-sm text-gray-600 hover:text-gray-900 border border-gray-300 rounded-lg hover:bg-gray-50 transition duration-150">
                        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                        </svg>
                        Backup
                        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                        </svg>
                    </button>
                    <button type="button" onclick="printTable()" class="inline-flex items-center px-3 py-1.5 text-sm text-gray-600 hover:text-gray-900 border border-gray-300 rounded-lg hover:bg-gray-50 transition duration-150">
                        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path>
                        </svg>
                        Print
                    </button>
                </div>
            </div>
        </div>

        <!-- Table -->
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">
                            <div class="flex items-center">
                                ID
                                <a href="{{ path('app_user_management', { 
                                    'search': app.request.query.get('search'),
                                    'role': app.request.query.get('role'),
                                    'status': app.request.query.get('status'),
                                    'sort_by': 'id',
                                    'sort_order': app.request.query.get('sort_by') == 'id' and app.request.query.get('sort_order') == 'asc' ? 'desc' : 'asc'
                                }) }}" class="ml-1 text-gray-400 hover:text-gray-600">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"></path>
                                    </svg>
                                </a>
                            </div>
                        </th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">
                            <div class="flex items-center">
                                Username
                                <a href="{{ path('app_user_management', { 
                                    'search': app.request.query.get('search'),
                                    'role': app.request.query.get('role'),
                                    'status': app.request.query.get('status'),
                                    'sort_by': 'username',
                                    'sort_order': app.request.query.get('sort_by') == 'username' and app.request.query.get('sort_order') == 'asc' ? 'desc' : 'asc'
                                }) }}" class="ml-1 text-gray-400 hover:text-gray-600">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"></path>
                                    </svg>
                                </a>
                            </div>
                        </th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">
                            <div class="flex items-center">
                                Email
                                <a href="{{ path('app_user_management', { 
                                    'search': app.request.query.get('search'),
                                    'role': app.request.query.get('role'),
                                    'status': app.request.query.get('status'),
                                    'sort_by': 'email',
                                    'sort_order': app.request.query.get('sort_by') == 'email' and app.request.query.get('sort_order') == 'asc' ? 'desc' : 'asc'
                                }) }}" class="ml-1 text-gray-400 hover:text-gray-600">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"></path>
                                    </svg>
                                </a>
                            </div>
                        </th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">
                            Role
                        </th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">
                            Status
                        </th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">
                            <div class="flex items-center">
                                Date Created
                                <a href="{{ path('app_user_management', { 
                                    'search': app.request.query.get('search'),
                                    'role': app.request.query.get('role'),
                                    'status': app.request.query.get('status'),
                                    'sort_by': 'createdAt',
                                    'sort_order': app.request.query.get('sort_by') == 'createdAt' and app.request.query.get('sort_order') == 'asc' ? 'desc' : 'asc'
                                }) }}" class="ml-1 text-gray-400 hover:text-gray-600">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"></path>
                                    </svg>
                                </a>
                            </div>
                        </th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">
                            Actions
                        </th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    {% for user in users|default([]) %}
                        <tr class="hover:bg-gray-50 transition-colors duration-150">
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="text-sm font-medium text-gray-900">#{{ user.id }}</span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm font-medium text-gray-900">{{ user.username }}</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm text-gray-900">{{ user.email }}</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                {% if 'ROLE_ADMIN' in user.roles %}
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                        <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                                        </svg>
                                        ADMIN
                                    </span>
                                {% elseif 'ROLE_STAFF' in user.roles %}
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                        <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                                        </svg>
                                        STAFF
                                    </span>
                                {% else %}
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                        USER
                                    </span>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                {% if user.isActive %}
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                        <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                                        </svg>
                                        Active
                                    </span>
                                {% else %}
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                        <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                                            <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                                        </svg>
                                        Inactive
                                    </span>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm text-gray-900">{{ user.createdAt ? user.createdAt|date('M d, Y') : 'N/A' }}</div>
                                <div class="text-xs text-gray-500">{{ user.createdAt ? user.createdAt|date('H:i') : '' }}</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                <div class="flex items-center space-x-2">
                                    <a href="{{ path('app_admin_user_show', {'id': user.id}) }}" 
                                       class="inline-flex items-center px-2.5 py-1.5 text-xs font-medium text-blue-600 hover:text-blue-900 bg-blue-50 hover:bg-blue-100 rounded-lg transition-colors duration-150">
                                        <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                        </svg>
                                        View
                                    </a>
                                    <a href="{{ path('app_admin_user_edit', {'id': user.id}) }}" 
                                       class="inline-flex items-center px-2.5 py-1.5 text-xs font-medium text-green-600 hover:text-green-900 bg-green-50 hover:bg-green-100 rounded-lg transition-colors duration-150">
                                        <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                        </svg>
                                        Edit
                                    </a>
                                    <button type="button" 
                                            onclick="confirmDelete({{ user.id }}, '{{ user.username|escape('js') }}')" 
                                            class="inline-flex items-center px-2.5 py-1.5 text-xs font-medium text-red-600 hover:text-red-900 bg-red-50 hover:bg-red-100 rounded-lg transition-colors duration-150">
                                        <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                        </svg>
                                        Delete
                                    </button>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" class="px-6 py-12 text-center">
                                <div class="flex flex-col items-center justify-center text-gray-500">
                                    <svg class="w-16 h-16 mb-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                                    </svg>
                                    <p class="text-lg font-medium mb-2">No users found</p>
                                    <p class="text-sm">Try adjusting your search or filters</p>
                                    {% if app.request.query.get('search') or app.request.query.get('role') or app.request.query.get('status') %}
                                        <a href="{{ path('app_user_management') }}" class="mt-4 text-sm text-indigo-600 hover:text-indigo-900 font-medium">
                                            Clear all filters
                                        </a>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
    <div class="bg-white rounded-xl p-6 max-w-md w-full mx-auto shadow-2xl">
        <div class="flex items-center mb-4">
            <div class="flex-shrink-0 flex items-center justify-center h-12 w-12 rounded-full bg-red-100">
                <svg class="h-6 w-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.998-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
                </svg>
            </div>
            <div class="ml-4">
                <h3 class="text-lg font-semibold text-gray-800">Confirm Delete</h3>
                <p class="text-sm text-gray-600 mt-1">This action cannot be undone</p>
            </div>
        </div>
        
        <p class="text-gray-700 mb-6">
            Are you sure you want to delete user <strong id="deleteUsername" class="font-semibold"></strong>?
            All associated data will be permanently removed.
        </p>
        
        <div class="flex justify-end gap-3">
            <button type="button" onclick="closeDeleteModal()" class="px-5 py-2.5 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 font-medium transition duration-200">
                Cancel
            </button>
            <form id="deleteForm" method="POST" style="display: inline;">
                <input type="hidden" name="_token" id="deleteToken" value="">
                <button type="submit" class="px-5 py-2.5 bg-red-600 hover:bg-red-700 text-white font-medium rounded-lg transition duration-200 shadow-sm">
                    Delete User
                </button>
            </form>
        </div>
    </div>
</div>

<style>
/* Custom styling for select options */
select option {
    padding: 8px 12px;
}

/* Smooth transitions */
#filterContent {
    transition: max-height 0.3s ease-in-out, opacity 0.3s ease-in-out;
}

/* Hide scrollbar for dropdowns */
select::-webkit-scrollbar {
    width: 6px;
}

select::-webkit-scrollbar-track {
    background: #f1f1f1;
    border-radius: 3px;
}

select::-webkit-scrollbar-thumb {
    background: #c1c1c1;
    border-radius: 3px;
}

select::-webkit-scrollbar-thumb:hover {
    background: #a1a1a1;
}
</style>

<script>
// Toggle filter section visibility
document.getElementById('filterToggle').addEventListener('click', function() {
    const content = document.getElementById('filterContent');
    const icon = document.getElementById('filterToggleIcon');
    
    if (content.classList.contains('hidden')) {
        content.classList.remove('hidden');
        content.style.maxHeight = content.scrollHeight + 'px';
        icon.style.transform = 'rotate(180deg)';
    } else {
        content.style.maxHeight = '0';
        setTimeout(() => {
            content.classList.add('hidden');
            icon.style.transform = 'rotate(0deg)';
        }, 300);
    }
});

// Toggle sort options
document.getElementById('sortToggle').addEventListener('click', function() {
    const sortOptions = document.getElementById('sortOptions');
    const button = this;
    
    if (sortOptions.classList.contains('hidden')) {
        sortOptions.classList.remove('hidden');
        sortOptions.style.maxHeight = sortOptions.scrollHeight + 'px';
        button.innerHTML = `
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path>
            </svg>
            Hide Options
        `;
    } else {
        sortOptions.style.maxHeight = '0';
        setTimeout(() => {
            sortOptions.classList.add('hidden');
            button.innerHTML = `
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
                Show Options
            `;
        }, 300);
    }
});

// Quick filter presets
function setQuickFilter(preset) {
    switch(preset) {
        case 'active_admins':
            document.getElementById('role').value = 'ROLE_ADMIN';
            document.getElementById('status').value = 'active';
            document.getElementById('sort_by').value = 'createdAt';
            document.getElementById('sort_order').value = 'desc';
            break;
        case 'recent_users':
            document.getElementById('role').value = 'ROLE_USER';
            document.getElementById('status').value = 'active';
            document.getElementById('sort_by').value = 'createdAt';
            document.getElementById('sort_order').value = 'desc';
            break;
    }
    
    // Submit the form
    document.querySelector('form').submit();
}

// Remove individual filter
function removeFilter(filterName) {
    const url = new URL(window.location.href);
    url.searchParams.delete(filterName);
    window.location.href = url.toString();
}

// Search suggestions
const searchInput = document.getElementById('search');
const suggestionsBox = document.getElementById('searchSuggestions');

searchInput.addEventListener('input', function() {
    const value = this.value.toLowerCase();
    
    if (value.length > 2) {
        // Show loading state
        suggestionsBox.innerHTML = '<div class="p-3 text-gray-500">Searching...</div>';
        suggestionsBox.classList.remove('hidden');
        
        // Simulate API call with timeout
        setTimeout(() => {
            const suggestions = [
                { type: 'username', value: 'admin' },
                { type: 'email', value: '@example.com' },
                { type: 'id', value: 'user ID' }
            ].filter(item => 
                item.type.includes(value) || 
                item.value.includes(value)
            );
            
            if (suggestions.length > 0) {
                suggestionsBox.innerHTML = suggestions.map(item => `
                    <div class="px-4 py-2 hover:bg-gray-50 cursor-pointer text-sm flex items-center border-b border-gray-100 last:border-0"
                         onclick="selectSuggestion('${item.type}: ${item.value}')">
                        <svg class="w-4 h-4 mr-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                        Search ${item.type}: "${item.value}"
                    </div>
                `).join('');
            } else {
                suggestionsBox.innerHTML = '<div class="p-3 text-gray-500">No suggestions found</div>';
            }
        }, 300);
    } else {
        suggestionsBox.classList.add('hidden');
    }
});

// Select suggestion
function selectSuggestion(value) {
    searchInput.value = value;
    suggestionsBox.classList.add('hidden');
    searchInput.focus();
}

// Close suggestions when clicking outside
document.addEventListener('click', function(e) {
    if (!searchInput.contains(e.target) && !suggestionsBox.contains(e.target)) {
        suggestionsBox.classList.add('hidden');
    }
});

// Delete Confirmation Modal Functions
function confirmDelete(userId, username) {
    document.getElementById('deleteUsername').textContent = username;
    document.getElementById('deleteToken').value = '{{ csrf_token('delete_user') }}' + userId;
    document.getElementById('deleteForm').action = '{{ path('app_admin_user_delete', {'id': '__USER_ID__'}) }}'.replace('__USER_ID__', userId);
    document.getElementById('deleteModal').classList.remove('hidden');
}

function closeDeleteModal() {
    document.getElementById('deleteModal').classList.add('hidden');
}

// Print Table Function
function printTable() {
    const printContent = `
        <html>
        <head>
            <title>User Management Report</title>
            <style>
                body { font-family: Arial, sans-serif; margin: 20px; }
                h1 { color: #333; margin-bottom: 20px; }
                table { width: 100%; border-collapse: collapse; margin-top: 20px; }
                th, td { border: 1px solid #ddd; padding: 8px; text-align: left; }
                th { background-color: #f5f5f5; }
                .badge { padding: 2px 6px; border-radius: 12px; font-size: 11px; }
                .admin { background-color: #fee2e2; color: #dc2626; }
                .staff { background-color: #dcfce7; color: #16a34a; }
                .user { background-color: #dbeafe; color: #2563eb; }
                .active { background-color: #dcfce7; color: #16a34a; }
                .inactive { background-color: #fee2e2; color: #dc2626; }
            </style>
        </head>
        <body>
            <h1>User Management Report</h1>
            <p>Generated on: ${new Date().toLocaleString()}</p>
            <p>Total Users: {{ users|length }}</p>
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Date Created</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                    <tr>
                        <td>#{{ user.id }}</td>
                        <td>{{ user.username }}</td>
                        <td>{{ user.email }}</td>
                        <td>
                            <span class="badge {% if 'ROLE_ADMIN' in user.roles %}admin{% elseif 'ROLE_STAFF' in user.roles %}staff{% else %}user{% endif %}">
                                {% if 'ROLE_ADMIN' in user.roles %}ADMIN{% elseif 'ROLE_STAFF' in user.roles %}STAFF{% else %}USER{% endif %}
                            </span>
                        </td>
                        <td>
                            <span class="badge {% if user.isActive %}active{% else %}inactive{% endif %}">
                                {{ user.isActive ? 'Active' : 'Inactive' }}
                            </span>
                        </td>
                        <td>{{ user.createdAt ? user.createdAt|date('M d, Y') : 'N/A' }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </body>
        </html>
    `;
    
    const printWindow = window.open('', '_blank');
    printWindow.document.write(printContent);
    printWindow.document.close();
    printWindow.focus();
    setTimeout(() => {
        printWindow.print();
        printWindow.close();
    }, 250);
}

// Initialize - check if filters are active and expand section
document.addEventListener('DOMContentLoaded', function() {
    const hasActiveFilters = {{ app.request.query.get('search') or app.request.query.get('role') or app.request.query.get('status') ? 'true' : 'false' }};
    
    if (hasActiveFilters) {
        const content = document.getElementById('filterContent');
        const icon = document.getElementById('filterToggleIcon');
        
        content.classList.remove('hidden');
        content.style.maxHeight = content.scrollHeight + 'px';
        icon.style.transform = 'rotate(180deg)';
        
        // Also show sort options if sorted
        if ({{ app.request.query.get('sort_by') or app.request.query.get('sort_order') ? 'true' : 'false' }}) {
            const sortOptions = document.getElementById('sortOptions');
            const sortToggle = document.getElementById('sortToggle');
            
            sortOptions.classList.remove('hidden');
            sortOptions.style.maxHeight = sortOptions.scrollHeight + 'px';
            sortToggle.innerHTML = `
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path>
                </svg>
                Hide Options
            `;
        }
    }
});

// Close modal on Escape key
document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
        closeDeleteModal();
    }
});

// Close modal when clicking outside
document.getElementById('deleteModal').addEventListener('click', (e) => {
    if (e.target.id === 'deleteModal') {
        closeDeleteModal();
    }
});
</script>
{% endblock %}