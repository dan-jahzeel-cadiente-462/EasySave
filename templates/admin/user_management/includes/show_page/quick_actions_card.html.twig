<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
	<h3 class="text-lg font-semibold text-gray-800 mb-4">Quick Actions</h3>
	<div class="space-y-3">
		<a href="{{ path('app_admin_user_edit', {'id': user.id}) }}" class="flex items-center justify-between w-full px-4 py-3 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 rounded-lg transition group">
			<div class="flex items-center gap-3">
				<div class="p-1.5 bg-indigo-100 rounded-lg">
					<svg class="w-4 h-4 text-indigo-600" fill="none" stroke="currentColor" viewbox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
					</svg>
				</div>
				<span class="font-medium">Edit Profile</span>
			</div>
			<svg class="w-4 h-4 opacity-0 group-hover:opacity-100 transition" fill="none" stroke="currentColor" viewbox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
			</svg>
		</a>

		<form method="POST" action="{{ path('app_admin_user_toggle_status', {'id': user.id}) }}">
			<input type="hidden" name="_token" value="{{ csrf_token('toggle_status' ~ user.id) }}">
			<button type="submit" onclick="return confirm('{% if user.isActive %}Deactivate{% else %}Reactivate{% endif %} this account?');" class="flex items-center justify-between w-full px-4 py-3 {% if user.isActive %}bg-yellow-50 hover:bg-yellow-100 text-yellow-700{% else %}bg-green-50 hover:bg-green-100 text-green-700{% endif %} rounded-lg transition group">
				<div class="flex items-center gap-3">
					<div class="p-1.5 {% if user.isActive %}bg-yellow-100{% else %}bg-green-100{% endif %} rounded-lg">
						<svg class="w-4 h-4 {% if user.isActive %}text-yellow-600{% else %}text-green-600{% endif %}" fill="none" stroke="currentColor" viewbox="0 0 24 24">
							{% if user.isActive %}
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/>
							{% else %}
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
							{% endif %}
						</svg>
					</div>
					<span class="font-medium">
						{% if user.isActive %}Deactivate Account{% else %}Reactivate Account
						{% endif %}
					</span>
				</div>
			</button>
		</form>

		<form method="POST" action="{{ path('app_admin_user_delete', {'id': user.id}) }}" onsubmit="return confirm('Permanently delete this user? This action cannot be undone.');">
			<input type="hidden" name="_token" value="{{ csrf_token('delete_user' ~ user.id) }}">
			<button type="submit" class="flex items-center justify-between w-full px-4 py-3 bg-red-50 hover:bg-red-100 text-red-700 rounded-lg transition group">
				<div class="flex items-center gap-3">
					<div class="p-1.5 bg-red-100 rounded-lg">
						<svg class="w-4 h-4 text-red-600" fill="none" stroke="currentColor" viewbox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
						</svg>
					</div>
					<span class="font-medium">Delete Account</span>
				</div>
			</button>
		</form>
	</div>
</div>
