<!-- Addresses Section -->
<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
	<div class="px-5 py-4 border-b border-gray-200">
		<h3 class="text-lg font-semibold text-gray-800">Shipping Addresses</h3>
		<p class="text-sm text-gray-500 mt-1">Delivery information for orders</p>
	</div>
	<div class="p-5">
		{% if user.addresses is not empty %}
			<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
				{% for address in user.addresses %}
					<div class="border border-gray-200 rounded-lg p-4 hover:border-indigo-300 transition">
						<div class="flex items-start justify-between mb-3">
							<div>
								<h4 class="font-medium text-gray-800">{{ address.street }}</h4>
								<p class="text-sm text-gray-600 mt-1">{{ address.cityMunicipality }},
									{{ address.province }}</p>
								<p class="text-sm text-gray-600">{{ address.postalCode }},
									{# {{ address.country }} #}
								</p>
							</div>
						</div>
						<div class="text-xs text-gray-500">
							<span class="inline-flex items-center gap-1">
								<svg class="w-3 h-3" fill="none" stroke="currentColor" viewbox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
								</svg>
								Shipping Address
							</span>
						</div>
					</div>
				{% endfor %}
			</div>
		{% else %}
			<div class="text-center py-8">
				<div class="mx-auto w-12 h-12 rounded-full bg-gray-100 flex items-center justify-center mb-3">
					<svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewbox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
					</svg>
				</div>
				<p class="text-gray-500 font-medium">No addresses found</p>
				<p class="text-sm text-gray-400 mt-1">This user hasn't added any shipping addresses yet.</p>
			</div>
		{% endif %}
	</div>
</div>
