<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
	<h3 class="text-lg font-semibold text-gray-800 mb-4">Role Management</h3>

	<div class="mb-6">
		<h4 class="text-sm font-medium text-gray-700 mb-3">Current Roles</h4>
		<div class="flex flex-wrap gap-2">
			{% for role in user.roles %}
				<span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-semibold
						                                {% if role == 'ROLE_ADMIN' %}bg-red-100 text-red-800 border border-red-200
						                                {% elseif role == 'ROLE_STAFF' %}bg-green-100 text-green-800 border border-green-200
						                                {% else %}bg-blue-100 text-blue-800 border border-blue-200{% endif %}">
					{% if role == 'ROLE_ADMIN' %}Administrator
						{% elseif role == 'ROLE_STAFF' %}Staff Member
						{% else %}Regular User
					{% endif %}
				</span>
			{% endfor %}
		</div>
	</div>

	{% if 'ROLE_ADMIN' not in user.roles %}
		<div>
			<h4 class="text-sm font-medium text-gray-700 mb-3">Staff Permissions</h4>
			<form method="POST" action="{{ path('app_admin_user_toggle_staff', {'id': user.id}) }}">
				<input type="hidden" name="_token" value="{{ csrf_token('toggle_staff' ~ user.id) }}">
				<div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
					<div>
						<p class="text-sm font-medium text-gray-700">Staff Access</p>
						<p class="text-xs text-gray-500">Allow backend access</p>
					</div>
					{% if 'ROLE_STAFF' in user.roles %}
						<button type="submit" onclick="return confirm('Remove staff permissions from this user?');" class="px-4 py-1.5 bg-red-500 hover:bg-red-600 text-white text-xs font-semibold rounded-lg transition">
							Remove
						</button>
					{% else %}
						<button type="submit" onclick="return confirm('Grant staff permissions to this user?');" class="px-4 py-1.5 bg-green-500 hover:bg-green-600 text-white text-xs font-semibold rounded-lg transition">
							Grant
						</button>
					{% endif %}
				</div>
			</form>
		</div>
	{% endif %}
</div>
