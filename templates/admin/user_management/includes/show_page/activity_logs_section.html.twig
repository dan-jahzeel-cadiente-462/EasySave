<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
	<div class="px-5 py-4 border-b border-gray-200">
		<div class="flex items-center justify-between">
			<div>
				<h3 class="text-lg font-semibold text-gray-800">Activity Log</h3>
				<!-- <p class="text-sm text-gray-500 mt-1">Recent purchases and transactions</p> -->
				{% for log in logs %}
					<div class="text-sm text-gray-600">
						{{ log.timestamp|date('M d, Y H:i') }}
						-
						{{ log.action }}
					</div>
				{% else %}
					<div class="text-sm text-gray-600">
						No activity logs available.
					</div>
				{% endfor %}
			</div>
			{% if user.orders|length > 0 %}
				<span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-indigo-100 text-indigo-800">
					{{ user.orders|length }}
					order{{ user.orders|length != 1 ? 's' : '' }}
				</span>
			{% endif %}
		</div>
	</div>
	<table class="min-w-full divide-y divide-gray-200">
		<thead class="gray-50"></thead>
	</table>
</div>
