<div
	class="bg-white rounded-xl shadow-sm border border-gray-200 mb-6 overflow-hidden">
	<!-- Header with Toggle Button -->
	<div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
		<div class="flex items-center">
			<svg class="w-5 h-5 text-indigo-600 mr-3" fill="none" stroke="currentColor" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path>
			</svg>
			<h2 class="text-lg font-semibold text-gray-800">Search & Filter Users</h2>
			{% if app.request.query.get('search') or app.request.query.get('role') or app.request.query.get('status') %}
				<span class="ml-3 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-indigo-100 text-indigo-800">
					<svg class="w-3 h-3 mr-1" fill="currentColor" viewbox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
						<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
					</svg>
					Filters Active
				</span>
			{% endif %}
		</div>
		<button type="button" id="filterToggle" class="p-2 text-gray-500 hover:text-gray-700 rounded-lg hover:bg-gray-100 transition-colors duration-200" aria-label="Toggle filters">
			<svg id="filterToggleIcon" class="w-5 h-5 transform transition-transform duration-300" fill="none" stroke="currentColor" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
			</svg>
		</button>
	</div>

	<!-- Collapsible Content -->
	<div id="filterContent" class="px-6 py-6 transition-all duration-300 ease-in-out overflow-hidden">
		<form
			method="GET" action="{{ path('app_user_management') }}" class="space-y-6">
			<!-- Search Bar with Dropdown Suggestions -->
			<div class="relative">
				<label for="search" class="block text-sm font-medium text-gray-700 mb-2">
					Search Users
				</label>
				<div class="relative group">
					<input type="text" id="search" name="search" value="{{ app.request.query.get('search') }}" placeholder="Search by username, email, or ID..." class="w-full pl-12 pr-10 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 group-hover:border-indigo-400 shadow-sm" autocomplete="off">
					<div class="absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-400 group-hover:text-indigo-500 transition-colors">
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
						</svg>
					</div>
					{% if app.request.query.get('search') %}
						<button type="button" onclick="document.getElementById('search').value='';" class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400 hover:text-gray-600 p-1 rounded-full hover:bg-gray-100">
							<svg class="w-4 h-4" fill="none" stroke="currentColor" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
							</svg>
						</button>
					{% endif %}
				</div>
				<div id="searchSuggestions" class="hidden absolute z-10 mt-1 w-full bg-white border border-gray-200 rounded-xl shadow-lg max-h-60 overflow-y-auto"></div>
			</div>

			<!-- Filter Grid with Smooth Dropdowns -->
			<div
				class="grid grid-cols-1 md:grid-cols-3 gap-6">
				<!-- Role Filter with Enhanced Dropdown -->
				<div class="relative">
					<label for="role" class="block text-sm font-medium text-gray-700 mb-2">
						Filter by Role
					</label>
					<div class="relative">
						<select id="role" name="role" class="w-full pl-4 pr-10 py-3 appearance-none border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 bg-white transition-all duration-200 hover:border-gray-400 shadow-sm cursor-pointer">
							<option value="">All Roles</option>
							<option value="ROLE_ADMIN" {% if app.request.query.get('role') == 'ROLE_ADMIN' %} selected {% endif %}>Administrator</option>
							<option value="ROLE_STAFF" {% if app.request.query.get('role') == 'ROLE_STAFF' %} selected {% endif %}>Staff</option>
							<option value="ROLE_USER" {% if app.request.query.get('role') == 'ROLE_USER' %} selected {% endif %}>Regular User</option>
						</select>
						<div class="absolute inset-y-0 right-0 flex items-center px-3 pointer-events-none">
							<svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
							</svg>
						</div>
					</div>
				</div>

				<!-- Status Filter -->
				<div class="relative">
					<label for="status" class="block text-sm font-medium text-gray-700 mb-2">
						Filter by Status
					</label>
					<div class="relative">
						<select id="status" name="status" class="w-full pl-4 pr-10 py-3 appearance-none border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 bg-white transition-all duration-200 hover:border-gray-400 shadow-sm cursor-pointer">
							<option value="">All Statuses</option>
							<option value="active" {% if app.request.query.get('status') == 'active' %} selected {% endif %}>Active Only</option>
							<option value="inactive" {% if app.request.query.get('status') == 'inactive' %} selected {% endif %}>Inactive Only</option>
						</select>
						<div class="absolute inset-y-0 right-0 flex items-center px-3 pointer-events-none">
							<svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
							</svg>
						</div>
					</div>
				</div>

				<!-- Quick Action Buttons -->
				<div>
					<label class="block text-sm font-medium text-gray-700 mb-2 opacity-0">
						Quick Actions
					</label>
					<div class="flex gap-3">
						<button type="button" onclick="setQuickFilter('active_admins')" class="flex-1 px-4 py-3 bg-red-50 hover:bg-red-100 border border-red-200 text-red-700 rounded-xl font-medium transition-all duration-200 hover:shadow-sm text-sm flex items-center justify-center group">
							<svg class="w-4 h-4 mr-2 text-red-600 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
							</svg>
							Active Admins
						</button>
						<button type="button" onclick="setQuickFilter('recent_users')" class="flex-1 px-4 py-3 bg-blue-50 hover:bg-blue-100 border border-blue-200 text-blue-700 rounded-xl font-medium transition-all duration-200 hover:shadow-sm text-sm flex items-center justify-center group">
							<svg class="w-4 h-4 mr-2 text-blue-600 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
							</svg>
							Recent Users
						</button>
					</div>
				</div>
			</div>

			<!-- Sorting Section with Toggle -->
			<div class="border-t border-gray-100 pt-6">
				<div class="flex items-center justify-between mb-4">
					<h3 class="text-sm font-semibold text-gray-700 uppercase tracking-wider">Sorting Options</h3>
					<button type="button" id="sortToggle" class="text-sm text-indigo-600 hover:text-indigo-800 font-medium flex items-center">
						<svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
						</svg>
						Show Options
					</button>
				</div>

				<div id="sortOptions" class="hidden grid grid-cols-1 md:grid-cols-2 gap-6 transition-all duration-300">
					<div>
						<div class="relative">
							<label for="sort_by" class="block text-sm font-medium text-gray-700 mb-2">
								Sort By
							</label>
							<div class="relative">
								<select id="sort_by" name="sort_by" class="w-full pl-4 pr-10 py-3 appearance-none border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 bg-white transition-all duration-200 shadow-sm">
									<option value="id" {% if app.request.query.get('sort_by') == 'id' %} selected {% endif %}>User ID</option>
									<option value="username" {% if app.request.query.get('sort_by') == 'username' %} selected {% endif %}>Username</option>
									<option value="email" {% if app.request.query.get('sort_by') == 'email' %} selected {% endif %}>Email Address</option>
									<option value="createdAt" {% if app.request.query.get('sort_by') == 'createdAt' or not app.request.query.get('sort_by') %} selected {% endif %}>Date Created</option>
								</select>
								<div class="absolute inset-y-0 right-0 flex items-center px-3 pointer-events-none">
									<svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"></path>
									</svg>
								</div>
							</div>
						</div>
					</div>

					<div>
						<div class="relative">
							<label for="sort_order" class="block text-sm font-medium text-gray-700 mb-2">
								Sort Direction
							</label>
							<div class="relative">
								<select id="sort_order" name="sort_order" class="w-full pl-4 pr-10 py-3 appearance-none border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 bg-white transition-all duration-200 shadow-sm">
									<option value="asc" {% if app.request.query.get('sort_order') == 'asc' or not app.request.query.get('sort_order') %} selected {% endif %}>Ascending (A-Z / Oldest)</option>
									<option value="desc" {% if app.request.query.get('sort_order') == 'desc' %} selected {% endif %}>Descending (Z-A / Newest)</option>
								</select>
								<div class="absolute inset-y-0 right-0 flex items-center px-3 pointer-events-none">
									<svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4h13M3 8h9m-9 4h9m5-4v12m0 0l-4-4m4 4l4-4"></path>
									</svg>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- Action Buttons -->
			<div class="flex flex-wrap gap-3 pt-4 border-t border-gray-100">
				<button type="submit" class="inline-flex items-center px-5 py-3 bg-gradient-to-r from-indigo-600 to-indigo-700 hover:from-indigo-700 hover:to-indigo-800 text-white font-semibold rounded-xl transition-all duration-300 shadow-md hover:shadow-lg transform hover:-translate-y-0.5">
					<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path>
					</svg>
					Apply Filters
				</button>

				<a href="{{ path('app_user_management') }}" class="inline-flex items-center px-5 py-3 border border-gray-300 text-gray-700 font-semibold rounded-xl hover:bg-gray-50 transition-all duration-300 shadow-sm hover:shadow">
					<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
					</svg>
					Clear All
				</a>

				<!-- Active Filters Display -->
				{% if app.request.query.get('search') or app.request.query.get('role') or app.request.query.get('status') %}
					<div class="flex-1 flex flex-wrap gap-2 items-center justify-end">
						<span class="text-sm text-gray-600 font-medium">Active Filters:</span>
						{% if app.request.query.get('search') %}
							<span class="inline-flex items-center px-3 py-1.5 bg-indigo-50 text-indigo-700 text-sm font-medium rounded-full border border-indigo-200">
								Search: "{{ app.request.query.get('search') }}"
								<button type="button" onclick="removeFilter('search')" class="ml-2 text-indigo-600 hover:text-indigo-900">
									<svg class="w-3 h-3" fill="none" stroke="currentColor" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
									</svg>
								</button>
							</span>
						{% endif %}
						{% if app.request.query.get('role') %}
							<span class="inline-flex items-center px-3 py-1.5 bg-purple-50 text-purple-700 text-sm font-medium rounded-full border border-purple-200">
								Role:
								{{ app.request.query.get('role')|replace({'ROLE_': ''}) }}
								<button type="button" onclick="removeFilter('role')" class="ml-2 text-purple-600 hover:text-purple-900">
									<svg class="w-3 h-3" fill="none" stroke="currentColor" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
									</svg>
								</button>
							</span>
						{% endif %}
						{% if app.request.query.get('status') %}
							<span class="inline-flex items-center px-3 py-1.5 bg-green-50 text-green-700 text-sm font-medium rounded-full border border-green-200">
								Status:
								{{ app.request.query.get('status')|capitalize }}
								<button type="button" onclick="removeFilter('status')" class="ml-2 text-green-600 hover:text-green-900">
									<svg class="w-3 h-3" fill="none" stroke="currentColor" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
									</svg>
								</button>
							</span>
						{% endif %}
					</div>
				{% endif %}
			</div>
		</form>
	</div>
</div>
