<!-- Table Wrapper -->
<div
	class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
	<!-- Table Header with Results Count -->
	<div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
		<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
			<div>
				<h3 class="text-sm font-semibold text-gray-700 uppercase tracking-wider">Users List</h3>
				<p class="text-xs text-gray-500 mt-1">
					Showing
					{{ users|length }}
					user(s)
					{% if app.request.query.get('search') %}
						matching "<span class="font-semibold">{{ app.request.query.get('search') }}</span>"
					{% endif %}
					{% if app.request.query.get('role') %}
						with role:
						<span class="font-semibold">{{ app.request.query.get('role')|replace({'ROLE_': ''}) }}</span>
					{% endif %}
				</p>
			</div>

			<!-- Export Options -->
			<div class="flex items-center space-x-2">
				<button type="button" class="inline-flex items-center px-3 py-1.5 text-sm text-gray-600 hover:text-gray-900 border border-gray-300 rounded-lg hover:bg-gray-50 transition duration-150">
					<svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
					</svg>
					Backup
					<svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
					</svg>
				</button>
				<button type="button" onclick="printTable()" class="inline-flex items-center px-3 py-1.5 text-sm text-gray-600 hover:text-gray-900 border border-gray-300 rounded-lg hover:bg-gray-50 transition duration-150">
					<svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path>
					</svg>
					Print
				</button>
			</div>
		</div>
	</div>

	<!-- Table -->
	<div class="overflow-x-auto">
		<table class="min-w-full divide-y divide-gray-200">
			<thead class="bg-gray-50">
				<tr>
					<th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">
						<div class="flex items-center">
							ID
							<a href="{{ path('app_user_management', { 'search': app.request.query.get('search'), 'role': app.request.query.get('role'), 'status': app.request.query.get('status'), 'sort_by': 'id', 'sort_order': app.request.query.get('sort_by') == 'id' and app.request.query.get('sort_order') == 'asc' ? 'desc' : 'asc' }) }}" class="ml-1 text-gray-400 hover:text-gray-600">
								<svg class="w-4 h-4" fill="none" stroke="currentColor" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"></path>
								</svg>
							</a>
						</div>
					</th>
					<th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">
						<div class="flex items-center">
							Username
							<a href="{{ path('app_user_management', { 'search': app.request.query.get('search'), 'role': app.request.query.get('role'), 'status': app.request.query.get('status'), 'sort_by': 'username', 'sort_order': app.request.query.get('sort_by') == 'username' and app.request.query.get('sort_order') == 'asc' ? 'desc' : 'asc' }) }}" class="ml-1 text-gray-400 hover:text-gray-600">
								<svg class="w-4 h-4" fill="none" stroke="currentColor" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"></path>
								</svg>
							</a>
						</div>
					</th>
					<th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">
						<div class="flex items-center">
							Email
							<a href="{{ path('app_user_management', { 'search': app.request.query.get('search'), 'role': app.request.query.get('role'), 'status': app.request.query.get('status'), 'sort_by': 'email', 'sort_order': app.request.query.get('sort_by') == 'email' and app.request.query.get('sort_order') == 'asc' ? 'desc' : 'asc' }) }}" class="ml-1 text-gray-400 hover:text-gray-600">
								<svg class="w-4 h-4" fill="none" stroke="currentColor" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"></path>
								</svg>
							</a>
						</div>
					</th>
					<th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">
						Role
					</th>
					<th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">
						Status
					</th>
					<th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">
						<div class="flex items-center">
							Date Created
							<a href="{{ path('app_user_management', { 'search': app.request.query.get('search'), 'role': app.request.query.get('role'), 'status': app.request.query.get('status'), 'sort_by': 'createdAt', 'sort_order': app.request.query.get('sort_by') == 'createdAt' and app.request.query.get('sort_order') == 'asc' ? 'desc' : 'asc' }) }}" class="ml-1 text-gray-400 hover:text-gray-600">
								<svg class="w-4 h-4" fill="none" stroke="currentColor" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"></path>
								</svg>
							</a>
						</div>
					</th>
					<th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">
						Actions
					</th>
				</tr>
			</thead>
			<tbody class="bg-white divide-y divide-gray-200">
				{% for user in users|default([]) %}
					<tr class="hover:bg-gray-50 transition-colors duration-150">
						<td class="px-6 py-4 whitespace-nowrap">
							<span class="text-sm font-medium text-gray-900">#{{ user.id }}</span>
						</td>
						<td class="px-6 py-4 whitespace-nowrap">
							<div class="text-sm font-medium text-gray-900">{{ user.username }}</div>
						</td>
						<td class="px-6 py-4 whitespace-nowrap">
							<div class="text-sm text-gray-900">{{ user.email }}</div>
						</td>
						<td class="px-6 py-4 whitespace-nowrap">
							{% if 'ROLE_ADMIN' in user.roles %}
								<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
									<svg class="w-3 h-3 mr-1" fill="currentColor" viewbox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
										<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
									</svg>
									ADMIN
								</span>
							{% elseif 'ROLE_STAFF' in user.roles %}
								<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
									<svg class="w-3 h-3 mr-1" fill="currentColor" viewbox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
										<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
									</svg>
									STAFF
								</span>
							{% else %}
								<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
									USER
								</span>
							{% endif %}
						</td>
						<td class="px-6 py-4 whitespace-nowrap">
							{% if user.isActive %}
								<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
									<svg class="w-3 h-3 mr-1" fill="currentColor" viewbox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
										<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
									</svg>
									Active
								</span>
							{% else %}
								<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
									<svg class="w-3 h-3 mr-1" fill="currentColor" viewbox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
										<path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
									</svg>
									Inactive
								</span>
							{% endif %}
						</td>
						<td class="px-6 py-4 whitespace-nowrap">
							<div class="text-sm text-gray-900">{{ user.createdAt ? user.createdAt|date('M d, Y') : 'N/A' }}</div>
							<div class="text-xs text-gray-500">{{ user.createdAt ? user.createdAt|date('H:i') : '' }}</div>
						</td>
						<td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
							<div class="flex items-center space-x-2">
								<a href="{{ path('app_admin_user_show', {'id': user.id}) }}" class="inline-flex items-center px-2.5 py-1.5 text-xs font-medium text-blue-600 hover:text-blue-900 bg-blue-50 hover:bg-blue-100 rounded-lg transition-colors duration-150">
									<svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
									</svg>
									View
								</a>
								<a href="{{ path('app_admin_user_edit', {'id': user.id}) }}" class="inline-flex items-center px-2.5 py-1.5 text-xs font-medium text-green-600 hover:text-green-900 bg-green-50 hover:bg-green-100 rounded-lg transition-colors duration-150">
									<svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
									</svg>
									Edit
								</a>
								<button type="button" onclick="confirmDelete({{ user.id }}, '{{ user.username|escape('js') }}')" class="inline-flex items-center px-2.5 py-1.5 text-xs font-medium text-red-600 hover:text-red-900 bg-red-50 hover:bg-red-100 rounded-lg transition-colors duration-150">
									<svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
									</svg>
									Delete
								</button>
							</div>
						</td>
					</tr>
				{% else %}
					<tr>
						<td colspan="7" class="px-6 py-12 text-center">
							<div class="flex flex-col items-center justify-center text-gray-500">
								<svg class="w-16 h-16 mb-4 text-gray-300" fill="none" stroke="currentColor" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
								</svg>
								<p class="text-lg font-medium mb-2">No users found</p>
								<p class="text-sm">Try adjusting your search or filters</p>
								{% if app.request.query.get('search') or app.request.query.get('role') or app.request.query.get('status') %}
									<a href="{{ path('app_user_management') }}" class="mt-4 text-sm text-indigo-600 hover:text-indigo-900 font-medium">
										Clear all filters
									</a>
								{% endif %}
							</div>
						</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>
</div>