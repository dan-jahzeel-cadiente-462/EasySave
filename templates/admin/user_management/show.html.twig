{% extends 'admin/base.html.twig' %}

{% block title %}User Details: {{ user.username }}{% endblock %}

{% block body %}
<div class="container mx-auto px-4 sm:px-8 py-8">
    <!-- Header Section -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
        <div>
            <h1 class="text-2xl font-bold text-gray-800">User Details</h1>
            <div class="flex items-center gap-3 mt-2">
                <div class="flex items-center">
                    <div class="w-8 h-8 rounded-full bg-indigo-100 flex items-center justify-center mr-2">
                        <span class="text-indigo-600 font-semibold">{{ user.username|first|upper }}</span>
                    </div>
                    <div>
                        <h2 class="text-lg font-semibold text-gray-700">{{ user.username }}</h2>
                        <p class="text-sm text-gray-500">{{ user.email|default('No email') }}</p>
                    </div>
                </div>
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold {% if user.isActive %}bg-green-100 text-green-800{% else %}bg-red-100 text-red-800{% endif %}">
                    {% if user.isActive %}Active{% else %}Inactive{% endif %}
                </span>
            </div>
        </div>
        <a href="{{ path('app_user_management') }}" class="inline-flex items-center gap-2 text-indigo-600 hover:text-indigo-800 font-medium">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Back to Users
        </a>
    </div>

    <!-- Main Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Left Column: Profile & Actions -->
        <div class="lg:col-span-1 space-y-6">
            <!-- User Card -->
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                <div class="bg-gradient-to-r from-indigo-500 to-indigo-600 p-4">
                    <div class="flex items-center gap-3">
                        <div class="w-12 h-12 rounded-full bg-white backdrop-blur-sm flex items-center justify-center">
                            <span class="text-white text-lg font-bold">{{ user.username|first|upper }}</span>
                        </div>
                        <div>
                            <h3 class="text-white font-semibold">{{ user.username }}</h3>
                            <p class="text-white/80 text-sm">User ID: #{{ user.id }}</p>
                        </div>
                    </div>
                </div>
                <div class="p-5">
                    <dl class="space-y-4">
                        <div>
                            <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide">Email</dt>
                            <dd class="mt-1 text-sm text-gray-900 font-medium">{{ user.email|default('Not provided') }}</dd>
                        </div>
                        <div>
                            <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide">Member Since</dt>
                            <dd class="mt-1 text-sm text-gray-900 font-medium">{{ user.createdAt ? user.createdAt|date('F j, Y') : 'N/A' }}</dd>
                        </div>
                        <div>
                            <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide">Account Status</dt>
                            <dd class="mt-1 text-sm text-gray-900 font-medium">
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium {% if user.isActive %}bg-green-100 text-green-800{% else %}bg-red-100 text-red-800{% endif %}">
                                    {% if user.isActive %}Active{% else %}Inactive{% endif %}
                                </span>
                            </dd>
                        </div>
                    </dl>
                </div>
            </div>

            <!-- Role Management Card -->
            {% include 'admin/user_management/includes/show_page/role_mgt_card.html.twig' %}

            <!-- Quick Actions Card -->
            {% include 'admin/user_management/includes/show_page/quick_actions_card.html.twig' %}
        </div>

        <!-- Right Column: User Data -->
        <div class="lg:col-span-2 space-y-6">
            <!-- Show addresses and orders only for non-admin users -->
            {% if 'ROLE_ADMIN' and 'ROLE_STAFF' not in user.roles %}

                <!-- Addresses Section -->
                {% include 'admin/user_management/includes/show_page/address_section.html.twig' %}

                <!-- Order History Section -->
                {% include 'admin/user_management/includes/show_page/order_history_section.html.twig' %}

            {% else %}
                
                <!-- Admin/Staff User Message -->
                {% include 'admin/user_management/includes/show_page/admin_user_message.html.twig' %}

            {% endif %}
            {% if is_granted('ROLE_ADMIN') %}

                <!-- Activity Log for each user -->
                {% include 'admin/user_management/includes/show_page/activity_logs_section.html.twig' %}
                
                {#
                <!-- Login History -->
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                    <div class="px-5 py-4 border-b border-gray-200">
                        <div class="flex items-center justify-between">
                            <div>
                                <h3 class="text-lg font-semibold text-gray-800">Login History</h3>
                                <p class="text-sm text-gray-500 mt-1">Recent login attempts for this account.</p>
                            </div>
                            {% if user.loginHistories|length > 0 %}
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-indigo-100 text-indigo-800">
                                    {{ user.loginHistories|length }} attempt{{ user.loginHistories|length != 1 ? 's' : '' }}
                                </span>
                            {% endif %}
                        </div>
                    </div>
                    <div class="p-5">
                        {% if user.loginHistories is not empty %}
                            <div class="overflow-hidden rounded-lg border border-gray-200">
                                <table class="min-w-full divide-y divide-gray-200">
                                    <thead class="bg-gray-50">
                                        <tr>
                                            <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date & Time</th>
                                            <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                                            <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">IP Address</th>
                                            <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Reason</th>
                                        </tr>
                                    </thead>
                                    <tbody class="bg-white divide-y divide-gray-200">
                                        {% for login in user.loginHistories|sort((a, b) => b.loginTimestamp <=> a.loginTimestamp)|slice(0, 15) %}
                                            <tr class="hover:bg-gray-50 transition">
                                                <td class="px-4 py-3 whitespace-nowrap">
                                                    <div class="text-sm text-gray-900">{{ login.loginTimestamp|date('M d, Y') }}</div>
                                                    <div class="text-xs text-gray-500">{{ login.loginTimestamp|date('h:i:s A') }}</div>
                                                </td>
                                                <td class="px-4 py-3 whitespace-nowrap">
                                                    {% if login.wasSuccessful %}
                                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Success</span>
                                                    {% else %}
                                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">Failed</span>
                                                    {% endif %}
                                                </td>
                                                <td class="px-4 py-3 whitespace-nowrap font-mono text-sm text-gray-700">{{ login.ipAddress }}</td>
                                                <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-500">{{ login.failureReason|default('N/A') }}</td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% else %}
                            <div class="text-center py-8">
                                <div class="mx-auto w-12 h-12 rounded-full bg-gray-100 flex items-center justify-center mb-3">
                                    <svg class="w-6 h-6 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 013 3m3 0a6 6 0 01-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1121.75 8.25z" /></svg>
                                </div>
                                <p class="text-gray-500 font-medium">No Login History</p>
                                <p class="text-sm text-gray-400 mt-1">There are no recorded login attempts for this user yet.</p>
                            </div>
                        {% endif %}
                    </div>
                </div>
                #}
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}