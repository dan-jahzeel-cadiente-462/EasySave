<div class="bg-white shadow rounded-lg p-6 border border-gray-200">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Profile Picture and Quick Actions -->
        <div class="flex flex-col items-center justify-start">
            <div class="mb-6 text-center">
                {% if user.profilePicture %}
                    <img src="{{ asset('uploads/profiles/' ~ user.profilePicture) }}" 
                         alt="{{ user.username }}" 
                         class="w-40 h-40 rounded-full mx-auto object-cover border-4 border-indigo-200">
                {% else %}
                    <div class="w-40 h-40 rounded-full mx-auto bg-gradient-to-br from-indigo-400 to-indigo-600 flex items-center justify-center border-4 border-gray-200">
                        <svg class="w-20 h-20 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                        </svg>
                    </div>
                {% endif %}
            </div>
            <div class="w-full space-y-2">
                <a href="{{ path('app_admin_account_edit_profile_details') }}" 
                   class="block text-center px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg font-semibold transition">
                    Change Picture
                </a>
            </div>
        </div>

        <!-- Account Information Section -->
        <div>
            <h2 class="text-lg font-semibold mb-6 text-gray-800 border-b pb-2">Account Information</h2>
            
            <div class="space-y-5">
                <!-- User ID -->
                <div class="flex items-center justify-between pb-4 border-b border-gray-100">
                    <div>
                        <p class="text-sm text-gray-500 font-medium">User ID</p>
                        <p class="text-lg font-semibold text-gray-800 mt-1">#{{ user.id }}</p>
                    </div>
                    <span class="text-indigo-600">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                    </span>
                </div>

                <!-- Username -->
                <div class="flex items-center justify-between pb-4 border-b border-gray-100">
                    <div>
                        <p class="text-sm text-gray-500 font-medium">Username</p>
                        <p class="text-lg font-semibold text-gray-800 mt-1">{{ user.username }}</p>
                    </div>
                    <span class="text-indigo-600">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                        </svg>
                    </span>
                </div>

                <!-- First Name -->
                <div class="flex items-center justify-between pb-4 border-b border-gray-100">
                    <div>
                        <p class="text-sm text-gray-500 font-medium">First Name</p>
                        <p class="text-lg font-semibold text-gray-800 mt-1">{{ user.firstName|default('Not provided') }}</p>
                    </div>
                </div>

                <!-- Last Name -->
                <div class="flex items-center justify-between pb-4 border-b border-gray-100">
                    <div>
                        <p class="text-sm text-gray-500 font-medium">Last Name</p>
                        <p class="text-lg font-semibold text-gray-800 mt-1">{{ user.lastName|default('Not provided') }}</p>
                    </div>
                </div>

                <!-- Email -->
                <div class="flex items-center justify-between pb-4 border-b border-gray-100">
                    <div>
                        <p class="text-sm text-gray-500 font-medium">Email</p>
                        <p class="text-lg font-semibold text-gray-800 mt-1">{{ user.email|default('Not provided') }}</p>
                    </div>
                    <span class="text-indigo-600">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                        </svg>
                    </span>
                </div>

                <!-- Role -->
                <div class="flex items-center justify-between pb-4 border-b border-gray-100">
                    <div>
                        <p class="text-sm text-gray-500 font-medium">Role</p>
                        <div class="mt-1">
                            {% if is_granted('ROLE_ADMIN') %}
                                <span class="inline-block bg-red-100 text-red-800 text-xs px-3 py-2 rounded-full font-semibold">ADMINISTRATOR</span>
                            {% elseif is_granted('ROLE_STAFF') %}
                                <span class="inline-block bg-blue-100 text-blue-800 text-xs px-3 py-2 rounded-full font-semibold">STAFF</span>
                            {% else %}
                                <span class="inline-block bg-gray-100 text-gray-800 text-xs px-3 py-2 rounded-full font-semibold">USER</span>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <!-- Account Status -->
                <div class="flex items-center justify-between pb-4 border-b border-gray-100">
                    <div>
                        <p class="text-sm text-gray-500 font-medium">Account Status</p>
                        <div class="mt-1">
                            <span class="inline-block bg-green-100 text-green-800 text-xs px-3 py-2 rounded-full font-semibold">Active</span>
                        </div>
                    </div>
                </div>

                <!-- Account Created -->
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-gray-500 font-medium">Member Since</p>
                        <p class="text-lg font-semibold text-gray-800 mt-1">
                            {{ user.createdAt ? user.createdAt|date('M d, Y') : 'N/A' }}
                        </p>
                    </div>
                    <span class="text-indigo-600">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                        </svg>
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="mt-8 pt-6 border-t flex justify-end gap-3">
        <a href="{{ path('app_admin_account_edit_profile_details') }}" 
           class="px-6 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg font-semibold transition">
            Edit Profile
        </a>
    </div>
</div>
