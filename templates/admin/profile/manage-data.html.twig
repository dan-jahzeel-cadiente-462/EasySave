
<div class="space-y-6">
    <!-- Data Backup Section -->
    <div class="bg-white shadow rounded-lg p-6 border border-gray-200">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h2 class="text-lg font-semibold text-gray-800">Data Backup</h2>
                <p class="text-gray-600 text-sm mt-1">Create and manage backups of your account data</p>
            </div>
            <svg class="w-8 h-8 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10"/>
            </svg>
        </div>

        <div class="space-y-3">
            <div class="p-4 bg-indigo-50 rounded-lg border border-indigo-200">
                <p class="text-sm text-gray-700 mb-3">Last backup: <span class="font-semibold text-gray-900">Never</span></p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                <!-- SQL Backup -->
                <button onclick="createBackup('sql')" class="flex items-center justify-center gap-2 p-3 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg font-semibold transition">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                    Create SQL Backup
                </button>

                <!-- CSV Backup -->
                <button onclick="createBackup('csv')" class="flex items-center justify-center gap-2 p-3 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg font-semibold transition">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                    Create CSV Backup
                </button>

                <!-- JSON Backup -->
                <button onclick="createBackup('json')" class="flex items-center justify-center gap-2 p-3 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-semibold transition">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                    Create JSON Backup
                </button>

                <!-- Excel Backup -->
                <button onclick="createBackup('excel')" class="flex items-center justify-center gap-2 p-3 bg-green-600 hover:bg-green-700 text-white rounded-lg font-semibold transition">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                    Create Excel Backup
                </button>
            </div>
        </div>
    </div>

    <!-- Data Export Section -->
    <div class="bg-white shadow rounded-lg p-6 border border-gray-200">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h2 class="text-xl font-semibold text-gray-800">Export Data</h2>
                <p class="text-gray-600 text-sm mt-1">Download all your account data in various formats</p>
            </div>
            <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
            </svg>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            <!-- Export as SQL -->
            <form method="POST" action="{{ path('app_admin_account_export_data') }}" class="w-full">
                <input type="hidden" name="format" value="sql">
                <button type="submit" class="w-full flex items-center justify-center gap-2 p-3 bg-indigo-100 hover:bg-indigo-200 text-indigo-700 rounded-lg font-semibold transition border border-indigo-300">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                    </svg>
                    Export SQL
                </button>
            </form>

            <!-- Export as CSV -->
            <form method="POST" action="{{ path('app_admin_account_export_data') }}" class="w-full">
                <input type="hidden" name="format" value="csv">
                <button type="submit" class="w-full flex items-center justify-center gap-2 p-3 bg-emerald-100 hover:bg-emerald-200 text-emerald-700 rounded-lg font-semibold transition border border-emerald-300">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                    </svg>
                    Export CSV
                </button>
            </form>

            <!-- Export as JSON -->
            <form method="POST" action="{{ path('app_admin_account_export_data') }}" class="w-full">
                <input type="hidden" name="format" value="json">
                <button type="submit" class="w-full flex items-center justify-center gap-2 p-3 bg-blue-100 hover:bg-blue-200 text-blue-700 rounded-lg font-semibold transition border border-blue-300">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                    </svg>
                    Export JSON
                </button>
            </form>

            <!-- Export as Excel -->
            <form method="POST" action="{{ path('app_admin_account_export_data') }}" class="w-full">
                <input type="hidden" name="format" value="excel">
                <button type="submit" class="w-full flex items-center justify-center gap-2 p-3 bg-green-100 hover:bg-green-200 text-green-700 rounded-lg font-semibold transition border border-green-300">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                    </svg>
                    Export Excel
                </button>
            </form>
        </div>
    </div>

    <!-- Data Import Section -->
    <div class="bg-white shadow rounded-lg p-6 border border-gray-200">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h2 class="text-xl font-semibold text-gray-800">Import Data</h2>
                <p class="text-gray-600 text-sm mt-1">Upload and import data from backup files</p>
            </div>
            <svg class="w-8 h-8 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4 4l-4-4m0 0l-4 4m4-4V4"/>
            </svg>
        </div>

        <form method="POST" action="{{ path('app_admin_account_import_data') }}" enctype="multipart/form-data" class="space-y-4">
            <!-- File Input -->
            <div>
                <label for="import_file" class="block text-sm font-semibold text-gray-700 mb-2">Choose File to Import</label>
                <div class="flex items-center gap-3">
                    <input type="file" id="import_file" name="import_file" accept=".sql,.csv,.json,.xlsx,.xls" required
                           class="flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent">
                    <button type="submit" class="px-6 py-2 bg-orange-600 hover:bg-orange-700 text-white rounded-lg font-semibold transition">
                        Import
                    </button>
                </div>
                <p class="text-xs text-gray-500 mt-2">Accepted formats: SQL, CSV, JSON, XLSX, XLS (max 10MB)</p>
            </div>

            <!-- Import Options -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 p-4 bg-amber-50 rounded-lg border border-amber-200">
                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="checkbox" name="merge_data" class="w-4 h-4 text-indigo-600 rounded">
                    <span class="text-sm text-gray-700">Merge with existing data</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="checkbox" name="skip_duplicates" class="w-4 h-4 text-indigo-600 rounded">
                    <span class="text-sm text-gray-700">Skip duplicate records</span>
                </label>
            </div>

            <!-- Warning Message -->
            <div class="p-4 bg-red-50 border border-red-200 rounded-lg">
                <p class="text-sm text-red-700">
                    <strong>⚠️ Warning:</strong> Importing data may overwrite existing information. Please ensure you have a backup before proceeding.
                </p>
            </div>
        </form>
    </div>

    <!-- Danger Zone -->
    <div class="bg-red-50 shadow rounded-lg p-6 border border-red-200">
        <div class="flex items-center justify-between mb-4">
            <div>
                <h2 class="text-xl font-semibold text-gray-800">Danger Zone</h2>
                <p class="text-gray-600 text-sm mt-1">Irreversible actions</p>
            </div>
            <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4v2m0 4v2m0-2a9 9 0 11-18 0 9 9 0 0118 0zm-1-14v2m0 0v-2"/>
            </svg>
        </div>

        <div class="p-4 bg-red-100 rounded-lg border border-red-300 mb-4">
            <p class="text-sm text-red-800">
                <strong>Note:</strong> Deleting your account data is permanent and cannot be undone. Please make sure you have exported your important data before proceeding.
            </p>
        </div>

        <button onclick="deleteAllData()" class="w-full px-6 py-3 bg-red-600 hover:bg-red-700 text-white rounded-lg font-semibold transition">
            Delete All Data
        </button>
    </div>
</div>

<script>
function createBackup(format) {
    const btn = event.target.closest('button');
    btn.disabled = true;
    btn.textContent = 'Creating backup...';

    fetch('{{ path("app_admin_account_create_backup") }}', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
        },
        body: JSON.stringify({format: format})
    }).then(response => {
        if (response.ok) {
            alert('Backup created successfully!');
            location.reload();
        } else {
            alert('Failed to create backup');
            btn.disabled = false;
            btn.textContent = 'Create ' + format.toUpperCase() + ' Backup';
        }
    }).catch(error => {
        alert('Error creating backup: ' + error);
        btn.disabled = false;
        btn.textContent = 'Create ' + format.toUpperCase() + ' Backup';
    });
}

function deleteAllData() {
    if (confirm('⚠️ Are you absolutely sure? This will DELETE ALL your data permanently. This action CANNOT be undone.\n\nType "DELETE" to confirm.')) {
        const confirmText = prompt('Please type DELETE to confirm:');
        if (confirmText === 'DELETE') {
            fetch('{{ path("app_admin_account_delete_data") }}', {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            }).then(response => {
                if (response.ok) {
                    alert('All data has been deleted. You will be logged out.');
                    window.location.href = '{{ path("app_home") }}';
                } else {
                    alert('Failed to delete data');
                }
            });
        }
    }
}
</script>
