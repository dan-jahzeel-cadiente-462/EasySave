{% extends 'admin/base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}
<div class="container mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-2xl font-bold mb-6 text-gray-800">Categories</h1>

    <div class="flex flex-col sm:flex-row justify-between items-start gap-4 mb-6">
        
        <div class="flex flex-col sm:flex-row flex-grow gap-4 w-full sm:w-3/4">

            <form method="get" action="{{ path('app_category_index') }}" class="flex-grow flex gap-2">
                <input type="search" name="q" value="{{ searchQuery }}" placeholder="Search by name or description..."
                       class="flex-grow px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-indigo-500 focus:border-indigo-500" />
                
                <input type="hidden" name="sort" value="{{ sortBy }}">
                <input type="hidden" name="direction" value="{{ sortDirection }}">
                
                <button type="submit" class="px-4 py-2 bg-green-600 hover:bg-green-700 text-white rounded-lg shadow transition">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5"><path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.093l3.321 3.321a.75.75 0 11-1.06 1.06l-3.321-3.321A7 7 0 012 9z" clip-rule="evenodd" /></svg>
                </button>

                {% if searchQuery %}
                    <a href="{{ path('app_category_index', {sort: sortBy, direction: sortDirection}) }}" class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg shadow hover:bg-gray-300 transition flex items-center">
                        Clear
                    </a>
                {% endif %}
            </form>

            <form method="get" action="{{ path('app_category_index') }}" class="flex-shrink-0 w-full sm:w-auto">
                <input type="hidden" name="q" value="{{ searchQuery }}">
                
                {% set currentSort = sortBy ~ '-' ~ sortDirection %}
                
                <select name="sort_by_direction" onchange="this.form.submit()" 
                        class="px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-indigo-500 focus:border-indigo-500 w-full sm:w-48">
                    
                    <option value="" disabled {% if not sortBy %}selected{% endif %}>Sort By...</option>

                    <option value="id-asc" {% if currentSort == 'id-asc' %}selected{% endif %}>ID (Ascending)</option>
                    <option value="id-desc" {% if currentSort == 'id-desc' %}selected{% endif %}>ID (Descending)</option>
                    
                    <option value="name-asc" {% if currentSort == 'name-asc' %}selected{% endif %}>Name (A-Z)</option>
                    <option value="name-desc" {% if currentSort == 'name-desc' %}selected{% endif %}>Name (Z-A)</option>
                    
                    <option value="parent-asc" {% if currentSort == 'parent-asc' %}selected{% endif %}>Parent (A-Z)</option>
                    <option value="parent-desc" {% if currentSort == 'parent-desc' %}selected{% endif %}>Parent (Z-A)</option>

                    <option value="products-desc" {% if currentSort == 'products-desc' %}selected{% endif %}>Products (High to Low)</option>
                    <option value="products-asc" {% if currentSort == 'products-asc' %}selected{% endif %}>Products (Low to High)</option>
                </select>
            </form>
        </div>
        
        <a href="{{ path('app_category_new') }}"
           class="flex items-center justify-center gap-2 px-4 py-2 bg-green-600 hover:bg-green-700 text-white font-medium rounded-lg shadow focus:ring-2 focus:ring-green-400 transition w-full sm:w-auto">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
            Create New
        </a>
    </div>

    <div class="overflow-x-auto bg-white shadow rounded-lg border border-gray-200">
        <table class="min-w-full text-sm text-left text-gray-700">
            <thead class="bg-gray-100 text-gray-800 uppercase text-xs font-semibold tracking-wider">
                <tr>
                    <th class="px-4 py-3">ID</th>
                    <th class="px-4 py-3">Name</th>
                    <th class="px-4 py-3">Parent</th>
                    <th class="px-4 py-3">Description</th>
                    <th class="px-4 py-3 text-center">No. of Products</th>
                    <th scope="col" class="relative px-4 py-3"><span class="sr-only">Actions</span></th>
                </tr>
            </thead>

            <tbody>
            {% for category in categories %}
                <tr class="border-b hover:bg-gray-50 transition">
                    <td class="px-4 py-3 whitespace-nowrap">{{ category.id }}</td>
                    <td class="px-4 py-3 font-medium text-gray-800">{{ category.name }}</td>

                    <td class="px-4 py-3">
                        {% if category.parent %}
                            {{ category.parent.name }}
                        {% else %}
                            <span class="text-gray-400 italic">None</span>
                        {% endif %}
                    </td>
                    
                    {% if category.description %}
                       <td class="px-4 py-3 max-w-[250px] truncate">{{ category.description }}</td>
                    {% else %}
                        <td class="px-4 py-3 text-gray-500 italic">N/A</td>
                    {% endif %}
                    
                    <td class="px-4 py-3 text-center">{{ category.products|length }}</td>

                    <td class="px-4 py-3 text-center">
                        <div class="flex justify-center gap-2 flex-wrap">

                            <a href="{{ path('app_category_show', {'category': category.id}) }}" class="text-indigo-600 hover:text-indigo-900" title="Show">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" 
                                stroke="currentColor" class="w-5 h-5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                                </svg>
                                <span class="sr-only">Show</span>
                            </a>

                            <a href="{{ path('app_category_edit', {'category': category.id}) }}" class="text-yellow-600 hover:text-yellow-900" title="Edit">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
                                </svg>
                                <span class="sr-only">Edit</span>
                            </a>

                            <form method="post" action="{{ path('app_category_delete', {'category': category.id}) }}" onsubmit="return confirm('Are you sure you want to delete this category?');"
                            class="inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ category.id) }}">
                                <button type="submit" class="text-red-600 hover:text-red-900" title="Delete">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09-1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                                        </svg>
                                        <span class="sr-only">Delete</span>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="px-4 py-6 text-center text-gray-500">
                            No categories found.
                            {% if searchQuery %}
                                <span class="block mt-1">Try clearing the search filter.</span>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% if totalPages > 1 %}
        <div class="flex justify-between items-center mt-6 p-4 bg-white rounded-lg shadow border border-gray-200">
            <div class="text-sm text-gray-600">
                Page <b>{{ currentPage }}</b> of {{ totalPages }}&nbsp;&nbsp;<b>{{ totalItems }}</b> total categories
            </div>
            
            <div class="flex items-center space-x-2">
                {% set base_params = {q: searchQuery, sort: sortBy, direction: sortDirection} %}

                <a href="{{ path('app_category_index', base_params|merge({page: currentPage - 1})) }}"
                class="px-3 py-1 border rounded-lg transition {{ currentPage == 1 ? 'pointer-events-none opacity-50 bg-gray-100 text-gray-400' : 'bg-white text-gray-700 hover:bg-indigo-50 hover:text-indigo-600' }}"
                aria-disabled="{{ currentPage == 1 ? 'true' : 'false' }}">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5"><path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 01-.02 1.06L9.468 10l3.29 3.71a.75.75 0 11-1.04 1.08l-3.5-4a.75.75 0 010-1.08l3.5-4a.75.75 0 011.06.02z" clip-rule="evenodd" /></svg>
                </a>
                
                {% for i in 1..totalPages %}
                    <a href="{{ path('app_category_index', base_params|merge({page: i})) }}"
                    class="hidden sm:block px-3 py-1 border rounded-lg text-sm transition {{ currentPage == i ? 'bg-green-600 text-white font-semibold border-green-600' : 'bg-white text-gray-700 hover:bg-green-50 hover:text-green-600' }}">
                        {{ i }}
                    </a>
                {% endfor %}
                
                <a href="{{ path('app_category_index', base_params|merge({page: currentPage + 1})) }}"
                class="px-3 py-1 border rounded-lg transition {{ currentPage == totalPages ? 'pointer-events-none opacity-50 bg-gray-100 text-gray-400' : 'bg-white text-gray-700 hover:bg-green-50 hover:text-green-600' }}"
                aria-disabled="{{ currentPage == totalPages ? 'true' : 'false' }}">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L10.532 10 7.239 6.29a.75.75 0 111.04-1.08l3.5 4a.75.75 0 010 1.08l-3.5 4a.75.75 0 01-1.06-.02z" clip-rule="evenodd" /></svg>
                </a>
            </div>
        </div>
    {% endif %}

</div>
{% endblock %}