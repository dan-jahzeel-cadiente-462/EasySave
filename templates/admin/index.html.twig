{% extends 'admin/base.html.twig' %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/@tailwindplus/elements@1" type="module"></script>
{% endblock %}

{% block title %}Admin - Dashboard{% endblock %}

{% block body %}
    <h1 class="text-2xl font-bold mb-6 text-gray-800">Dashboard</h1>

    <!-- ======== SUMMARY CARDS ======== -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
        <!-- Total Categories -->
        <div class="p-4 bg-gradient-to-r from-green-500 to-green-600 text-white rounded-xl shadow-sm flex flex-col justify-between">
            <h2 class="text-sm font-medium text-green-100">Total Categories</h2>
            <div class="text-3xl font-bold mt-2">{{ categoryCount }}</div>
        </div>

        <!-- Total Users -->
        <div class="p-4 bg-gradient-to-r from-green-500 to-green-600 text-white rounded-xl shadow-sm flex items-center justify-between">
            <div>
                <h2 class="text-sm font-medium text-green-100">Total Users</h2>
                <div class="text-3xl font-bold mt-2">{{ userCount }}</div>
            </div>
            <div class="opacity-80">
                {% include 'icons/user.html.twig' %}
            </div>
        </div>

        <!-- Total Products -->
        <div class="p-4 bg-gradient-to-r from-green-500 to-green-600 text-white rounded-xl shadow-sm flex flex-col justify-between">
            <h2 class="text-sm font-medium text-green-100">Total Products</h2>
            <div class="text-3xl font-bold mt-2">{{ productCount }}</div>
        </div>

        <!-- Total Inventory Value -->
        <div class="p-4 bg-gradient-to-r from-green-500 to-green-600 text-white rounded-xl shadow-sm flex flex-col justify-between">
            <h2 class="text-sm font-medium text-green-100">Total Inventory Value</h2>
            <div class="text-3xl font-bold mt-2">₱{{ totalValue|number_format(2, '.', ',') }}</div>
        </div>
    </div>

    <!-- ======== RECENT ORDERS ======== -->
    <div class="bg-white border border-gray-200 shadow-sm rounded-xl mb-8 overflow-hidden">
        <div class="flex flex-col md:flex-row md:items-center justify-between px-6 py-4 border-b bg-gray-50">
            <h2 class="text-lg font-semibold text-gray-800">Recent Orders</h2>
            <a href="{{ path('app_admin_order_index') }}" class="flex items-center gap-2 text-sm text-green-700 hover:text-green-900 mt-2 md:mt-0">
                <span>View in Orders</span>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" />
                </svg>
            </a>
        </div>

        <div class="overflow-x-auto">
            <table class="min-w-full text-sm text-left text-gray-700">
                <thead class="bg-gray-100 text-gray-800 uppercase text-xs font-semibold">
                    <tr>
                        <th class="px-6 py-3">Order ID</th>
                        <th class="px-6 py-3">Customer</th>
                        <th class="px-6 py-3">Date</th>
                        <th class="px-6 py-3">Total</th>
                        <th class="px-6 py-3">Status</th>
                        <th class="px-6 py-3 text-center">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    {% for order in recentOrders %}
                        <tr class="hover:bg-gray-50 transition">
                            <td class="px-6 py-3 font-mono text-gray-800">#{{ order.id }}</td>
                            <td class="px-6 py-3 font-medium text-gray-900">{{ order.customer.username }}</td>
                            <td class="px-6 py-3 text-gray-600">{{ order.createdAt|date('M d, Y') }}</td>
                            <td class="px-6 py-3 text-gray-800 font-semibold">₱{{ order.total|number_format(2, '.', ',') }}</td>
                            <td class="px-6 py-3">
                                {% set status_classes = {
                                    'Pending': 'bg-yellow-100 text-yellow-800',
                                    'Shipped': 'bg-blue-100 text-blue-800',
                                    'Delivered': 'bg-green-100 text-green-800',
                                    'Cancelled': 'bg-red-100 text-red-800'
                                } %}
                                <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold {{ status_classes[order.status] ?? 'bg-gray-100 text-gray-800' }}">
                                    {{ order.status }}
                                </span>
                            </td>
                            <td class="px-6 py-3 text-center">
                                <a href="{{ path('app_admin_order_show', {'id': order.id}) }}" class="text-green-600 hover:text-green-800 font-semibold">View</a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center py-6 text-gray-500">No recent orders found.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
