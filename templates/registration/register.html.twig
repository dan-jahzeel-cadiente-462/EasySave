{% extends 'auth/base.html.twig' %}

{% block title %}Register
{% endblock %}

{% block body %}
	{# 1. Outer Wrapper: Ensures perfect vertical and horizontal centering #}
	<div
		class="min-h-screen flex items-center justify-center bg-white dark:bg-gray-900 transition-colors duration-300">

		{# 2. Inner Form Container #}
		<div class="max-w-md w-full bg-white dark:bg-gray-800 shadow-lg rounded-lg p-8 transition-colors duration-300">
			<h1 class="text-2xl font-bold mb-6 text-gray-800 dark:text-white transition-colors duration-300">Sign-Up</h1>

			{{ form_errors(registrationForm) }}

			{{ form_start(registrationForm, {'attr': {'class': 'space-y-4'}}) }}

			{# Username Field #}
			<div>
				{{ form_label(registrationForm.username, null, {'label_attr': {'class': 'block text-gray-700 dark:text-gray-300 font-medium mb-2 transition-colors duration-300'}}) }}
				{{ form_widget(registrationForm.username, {'attr': {'class': 'w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-green-500 dark:focus:ring-green-400 transition-colors duration-300'}}) }}
				{{ form_errors(registrationForm.username) }}
			</div>

			{# Password Field with Show Toggle #}
			<div>
				{{ form_label(registrationForm.plainPassword, 'Password', {'label_attr': {'class': 'block text-gray-700 dark:text-gray-300 font-medium mb-2 transition-colors duration-300'}}) }}

				{# Relative wrapper for the icon #}
				<div
					class="relative">
					{# Input Field with padding #}
					{{ form_widget(registrationForm.plainPassword, {'attr': {
                        'class': 'w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-green-500 dark:focus:ring-green-400 pr-10 transition-colors duration-300',
                        'id': 'password-input'
                    }})}}
					{{ form_errors(registrationForm.plainPassword) }}

					{# Icon Toggle - Absolute positioned #}
					<div
						class="absolute inset-y-0 right-0 flex items-center pr-3">
						{# Hidden Checkbox drives the JS logic #}
						<input
						type="checkbox" id="show-password" class="hidden">

						{# Label acts as the clickable icon. Icons need to be outside the label for JS to access them by ID easily. #}
						<label
							for="show-password" class="cursor-pointer text-gray-400 dark:text-gray-500 hover:text-gray-600 dark:hover:text-gray-400 transition duration-150" aria-label="Toggle password visibility">

							{# Eye Open Icon (Visible by default) #}
							<svg id="eye-open" class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
							</svg>
							{# Eye Closed/Slashed Icon (Hidden by default) #}
							<svg id="eye-closed" class="h-5 w-5 hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.82L21 12 13.875 5.18M10.125 5.18L3 12l7.125 6.82"/>
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15a3 3 0 100-6 3 3 0 000 6z"/>
							</svg>
						</label>
					</div>
				</div>
			</div>

			{# Terms Checkbox #}
			<div class="flex items-center">
				{{ form_widget(registrationForm.agreeTerms, {'attr': {'class': 'mr-2 accent-green-600 dark:accent-green-500'}}) }}
				{{ form_label(registrationForm.agreeTerms, null, {'label_attr': {'class': 'text-gray-700 dark:text-gray-300 transition-colors duration-300'}}) }}
				{{ form_errors(registrationForm.agreeTerms) }}
			</div>

			<button type="submit" class="w-full bg-green-600 dark:bg-green-700 text-white py-2 px-4 rounded-lg hover:bg-green-700 dark:hover:bg-green-600 transition duration-300">
				Register
			</button>

			<div class="text-sm text-center text-gray-600 dark:text-gray-400 transition-colors duration-300">
				Already have an account?
				<a href="{{ path('app_login') }}" class="text-green-600 dark:text-green-400 hover:underline font-medium transition-colors duration-300">Login here</a>
			</div>

			{{ form_end(registrationForm) }}
		</div>
	</div>
{% endblock %}
