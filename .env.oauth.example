# This file is a "template" of what your .env.local file should look like
# See .env.local.dist for the default configuration

###> OAuth Configuration ###
# Get these from https://console.cloud.google.com/
# 1. Create OAuth 2.0 Credentials (Web application)
# 2. Set authorized origins and redirect URIs
# 3. Copy Client ID and Secret below

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret-here
###< OAuth Configuration ###

###> Brevo Email Service Configuration ###
# Get API Key from https://www.brevo.com/
# Account Settings -> API Key -> Copy v3 API Key

# Using Brevo API (Recommended)
MAILER_DSN=brevo+api://YOUR_BREVO_API_KEY@default

# Alternative: Using SMTP
# For Gmail: Requires App Password (not regular password)
# MAILER_DSN=smtp://your-email@gmail.com:your-app-password@smtp.gmail.com:587?encryption=tls

# For Mailgun SMTP
# MAILER_DSN=smtp://postmaster@sandboxXXX.mailgun.org:password@smtp.mailgun.org:587?encryption=tls

# For SendGrid SMTP  
# MAILER_DSN=smtp://apikey:SG.xxx@smtp.sendgrid.net:587?encryption=tls
###< Brevo Email Service Configuration ###

###> Email Sender Configuration ###
# Set the "from" email address for automated emails
MAILER_FROM_ADDRESS=noreply@easysave.local
MAILER_FROM_NAME="EasySave"
###< Email Sender Configuration ###
